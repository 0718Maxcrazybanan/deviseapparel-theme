    "custom_liquid_g3zGrb": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<a href=\"/pages/faq\" class=\"devise-process-desktop\" id=\"deviseProcessDesktop\">\n  <span>?</span>\n  <div>\n    <strong>Så fungerar det</strong>\n    <small>Fundersam? Tryck här!</small>\n  </div>\n</a>\n\n<style>\n  .devise-process-desktop {\n    position: fixed;\n    right: 28px;\n    bottom: 175px;\n    z-index: 10000;\n\n    display: none;\n    align-items: center;\n    gap: 12px;\n\n    min-width: 220px;\n    padding: 12px 16px 12px 12px;\n    border-radius: 18px;\n\n    background: rgba(17, 17, 17, 0.92);\n    color: #FFFFFF;\n    border: 1px solid rgba(255, 222, 89, 0.22);\n\n    font-family: Inter, Arial, sans-serif;\n    text-decoration: none;\n\n    box-shadow:\n      0 18px 55px rgba(0, 0, 0, 0.45),\n      0 0 34px rgba(255, 222, 89, 0.08);\n\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n\n    opacity: 0;\n    visibility: hidden;\n    transform: translateY(16px);\n    pointer-events: none;\n\n    transition: 0.22s ease;\n  }\n\n  .devise-process-desktop.is-visible {\n    opacity: 1;\n    visibility: visible;\n    transform: translateY(0);\n    pointer-events: auto;\n  }\n\n  .devise-process-desktop:hover {\n    border-color: rgba(255, 222, 89, 0.5);\n    transform: translateY(-3px);\n    box-shadow:\n      0 22px 65px rgba(0, 0, 0, 0.55),\n      0 0 42px rgba(255, 222, 89, 0.16);\n  }\n\n  .devise-process-desktop > span {\n    width: 42px;\n    height: 42px;\n    border-radius: 14px;\n\n    background: #FFDE59;\n    color: #0A0A0A;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    font-size: 20px;\n    font-weight: 950;\n    flex-shrink: 0;\n  }\n\n  .devise-process-desktop strong {\n    display: block;\n    color: #FFFFFF;\n    font-size: 13px;\n    font-weight: 950;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    line-height: 1.2;\n  }\n\n  .devise-process-desktop small {\n    display: block;\n    color: #A0A0A0;\n    font-size: 12px;\n    font-weight: 700;\n    margin-top: 3px;\n    line-height: 1.2;\n  }\n\n  @media (min-width: 769px) {\n    .devise-process-desktop {\n      display: flex;\n    }\n  }\n\n  @media (max-width: 768px) {\n    .devise-process-desktop {\n      display: none !important;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const processBtn = document.getElementById(\"deviseProcessDesktop\");\n\n    if (!processBtn) return;\n\n    let formIsVisible = false;\n\n    const formTarget = document.querySelector(\n      \"#devise-custom-order-form, .dof-section, .devise-order-section, #ContactForm, #contact_form, .contact-form, form[action*='/contact']\"\n    );\n\n    function updateProcessButton() {\n      const isDesktop = window.innerWidth >= 769;\n      const hasScrolledEnough = window.scrollY > 320;\n\n      if (isDesktop && hasScrolledEnough && !formIsVisible) {\n        processBtn.classList.add(\"is-visible\");\n      } else {\n        processBtn.classList.remove(\"is-visible\");\n      }\n    }\n\n    if (formTarget) {\n      const observer = new IntersectionObserver(\n        function (entries) {\n          entries.forEach(function (entry) {\n            formIsVisible = entry.isIntersecting;\n            updateProcessButton();\n          });\n        },\n        {\n          threshold: 0.12,\n          rootMargin: \"0px 0px -20% 0px\"\n        }\n      );\n\n      observer.observe(formTarget);\n    }\n\n    window.addEventListener(\"scroll\", updateProcessButton, { passive: true });\n    window.addEventListener(\"resize\", updateProcessButton);\n\n    document.addEventListener(\"shopify:section:load\", updateProcessButton);\n\n    updateProcessButton();\n  });\n</script>",
        "background_color": "{{ settings.color_palette.background }}",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_PgpLgL": {
      "type": "custom-liquid",
      "name": "sticky pc",
      "settings": {
        "custom_liquid": "<div class=\"devise-sticky-custom-order\" id=\"deviseStickyCustomOrder\">\n  <div class=\"devise-sticky-custom-order__content\">\n    <span>Custom orders</span>\n    <strong>Skapa din egen hoodie</strong>\n    <p>Berätta din idé och få prisförslag snabbt.</p>\n  </div>\n\n  <a href=\"#devise-custom-order-form\" class=\"devise-sticky-custom-order__btn\">\n    Starta order →\n  </a>\n</div>\n\n<style>\n  .devise-sticky-custom-order {\n    position: fixed;\n    right: 28px;\n    bottom: 28px;\n    z-index: 9999;\n    width: 340px;\n    background:\n      linear-gradient(180deg, rgba(21,21,21,0.96) 0%, rgba(12,12,12,0.96) 100%);\n    border: 1px solid rgba(255, 222, 89, 0.22);\n    border-radius: 20px;\n    padding: 18px;\n    box-shadow:\n      0 24px 70px rgba(0,0,0,0.55),\n      0 0 35px rgba(255,222,89,0.08),\n      inset 0 1px 0 rgba(255,255,255,0.06);\n    font-family: Inter, Arial, sans-serif;\n    color: #FFFFFF;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: 14px;\n    align-items: center;\n    opacity: 0;\n    transform: translateY(18px) scale(0.96);\n    pointer-events: none;\n    transition:\n      opacity 0.25s ease,\n      transform 0.25s ease,\n      border-color 0.25s ease,\n      box-shadow 0.25s ease;\n    backdrop-filter: blur(14px);\n  }\n\n  .devise-sticky-custom-order.is-visible {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n    pointer-events: auto;\n  }\n\n  .devise-sticky-custom-order:hover {\n    border-color: rgba(255, 222, 89, 0.55);\n    box-shadow:\n      0 28px 80px rgba(0,0,0,0.62),\n      0 0 45px rgba(255,222,89,0.12),\n      inset 0 1px 0 rgba(255,255,255,0.08);\n  }\n\n  .devise-sticky-custom-order__content span {\n    display: inline-flex;\n    align-items: center;\n    width: fit-content;\n    background: rgba(255, 222, 89, 0.12);\n    border: 1px solid rgba(255, 222, 89, 0.22);\n    color: #FFDE59;\n    border-radius: 999px;\n    padding: 5px 9px;\n    font-size: 10px;\n    font-weight: 950;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-bottom: 8px;\n  }\n\n  .devise-sticky-custom-order__content strong {\n    display: block;\n    color: #FFFFFF;\n    font-size: 15px;\n    line-height: 1.15;\n    font-weight: 950;\n    letter-spacing: -0.03em;\n  }\n\n  .devise-sticky-custom-order__content p {\n    margin: 5px 0 0;\n    color: #A0A0A0;\n    font-size: 12px;\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  .devise-sticky-custom-order__btn {\n    min-height: 42px;\n    padding: 0 14px;\n    border-radius: 999px;\n    background: #FFDE59;\n    color: #0A0A0A;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    white-space: nowrap;\n    font-size: 12px;\n    font-weight: 950;\n    transition: 0.2s ease;\n  }\n\n  .devise-sticky-custom-order__btn:hover {\n    transform: translateY(-2px);\n    background: #FFFFFF;\n    color: #0A0A0A;\n  }\n\n  @media (max-width: 989px) {\n    .devise-sticky-custom-order {\n      display: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    const stickyBox = document.getElementById(\"deviseStickyCustomOrder\");\n    const formSelector = \"#devise-custom-order-form\";\n\n    if (!stickyBox) return;\n\n    function getTargetForm() {\n      return document.querySelector(formSelector);\n    }\n\n    function shouldShowSticky() {\n      const isDesktop = window.matchMedia(\"(min-width: 990px)\").matches;\n      if (!isDesktop) return false;\n\n      const scrollPassed = window.scrollY > 420;\n      if (!scrollPassed) return false;\n\n      const targetForm = getTargetForm();\n\n      if (!targetForm) {\n        return true;\n      }\n\n      const rect = targetForm.getBoundingClientRect();\n\n      const formIsClose =\n        rect.top < window.innerHeight * 0.88 &&\n        rect.bottom > 0;\n\n      return !formIsClose;\n    }\n\n    function updateSticky() {\n      stickyBox.classList.toggle(\"is-visible\", shouldShowSticky());\n    }\n\n    window.addEventListener(\"scroll\", updateSticky, { passive: true });\n    window.addEventListener(\"resize\", updateSticky);\n\n    document.addEventListener(\"shopify:section:load\", updateSticky);\n\n    stickyBox.querySelector(\"a\").addEventListener(\"click\", function (event) {\n      const targetForm = getTargetForm();\n\n      if (!targetForm) return;\n\n      event.preventDefault();\n\n      targetForm.scrollIntoView({\n        behavior: \"smooth\",\n        block: \"start\"\n      });\n    });\n\n    updateSticky();\n  })();\n</script>",
