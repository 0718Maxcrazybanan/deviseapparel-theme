    "custom_liquid_yDgR6h": {
      "type": "custom-liquid",
      "name": "Form",
      "settings": {
        "custom_liquid": "<script>\n/* =========================================================\n   DEVISEAPPAREL – ÄNDRA PRISER HÄR\n   ========================================================= */\n\nwindow.DEVISE_PRICING = {\n  baseProducts: {\n    \"Hoodie\": 399,\n    \"T-shirt\": 249,\n    \"Zip Hoodie\": 399,\n    \"Sweatshirt\": 399\n  },\n\n  placementFees: {\n    \"Fram\": 100,\n    \"Bak\": 100,\n    \"Fram och bak\": 150\n  },\n\n  sizeFees: {\n    \"XS\": 0,\n    \"S\": 0,\n    \"M\": 0,\n    \"L\": 0,\n    \"XL\": 0,\n    \"XXL\": 0,\n    \"3XL\": 0\n  },\n\n  colorFees: {\n    \"Svart\": 0,\n    \"Vit\": 0,\n    \"Grå\": 0,\n    \"Mörkgrå\": 0,\n    \"Beige\": 0,\n    \"Navy\": 0,\n    \"Blå\": 0,\n    \"Röd\": 0,\n    \"Grön\": 0,\n    \"Brun\": 0,\n    \"Rosa\": 0,\n    \"Lila\": 0,\n    \"Annan färg\": 0\n  },\n\n  uploadFee: 0\n};\n</script>\n\n<section class=\"devise-order-section\">\n  <div class=\"devise-form-card\">\n    {% form 'contact', id: 'devise-custom-order-form' %}\n\n      {% if form.posted_successfully? %}\n        <div class=\"devise-success\">\n          Tack! Din förfrågan har skickats. Vi återkommer så snabbt som möjligt.\n        </div>\n      {% endif %}\n\n      {{ form.errors | default_errors }}\n\n      <textarea id=\"deviseOrderBody\" name=\"contact[body]\" hidden></textarea>\n      <input type=\"hidden\" id=\"deviseUploadedFileName\" name=\"contact[Uppladdad fil]\" value=\"Ingen fil uppladdad\">\n      <input type=\"hidden\" id=\"devisePriceEstimateField\" name=\"contact[Prisestimat]\" value=\"0 kr\">\n      <input type=\"hidden\" id=\"deviseOtherColorHidden\" name=\"contact[Annan färg]\" value=\"\">\n\n      <div class=\"devise-progress-head\">\n        <div class=\"devise-progress\">\n          <div class=\"devise-progress-item active\" data-progress=\"1\">\n            <span>1</span>\n            <small>Din idé</small>\n          </div>\n\n          <div class=\"devise-line\"></div>\n\n          <div class=\"devise-progress-item\" data-progress=\"2\">\n            <span>2</span>\n            <small>Produkt</small>\n          </div>\n\n          <div class=\"devise-line\"></div>\n\n          <div class=\"devise-progress-item\" data-progress=\"3\">\n            <span>3</span>\n            <small>Tryck</small>\n          </div>\n\n          <div class=\"devise-line\"></div>\n\n          <div class=\"devise-progress-item\" data-progress=\"4\">\n            <span>4</span>\n            <small>Kontakt</small>\n          </div>\n        </div>\n\n        <div class=\"devise-step-count\">\n          Steg <span id=\"deviseCurrentStep\">1</span> / 4\n        </div>\n      </div>\n\n      <div class=\"devise-layout\">\n        <div class=\"devise-form-left\">\n\n          <!-- STEP 1 -->\n          <div class=\"devise-step active\" data-step=\"1\">\n            <h3>Berätta om din idé</h3>\n\n            <label class=\"devise-label\" for=\"deviseIdea\">\n              Beskriv din idé <b>*</b>\n            </label>\n\n            <div class=\"devise-textarea-wrap\">\n              <textarea\n                id=\"deviseIdea\"\n                name=\"contact[Idébeskrivning]\"\n                maxlength=\"500\"\n                placeholder=\"T.ex. motiv, text, stil, placering, färg, känsla...\"\n              ></textarea>\n              <small><span id=\"deviseCharCount\">0</span>/500</small>\n            </div>\n\n            <p class=\"devise-error\" data-error=\"idea\"></p>\n\n            <label class=\"devise-label\" for=\"deviseDesignLink\">\n              Länk till design / Canva / Drive / inspiration\n            </label>\n\n            <input\n              id=\"deviseDesignLink\"\n              class=\"devise-input\"\n              type=\"url\"\n              name=\"contact[Designlänk]\"\n              placeholder=\"https://...\"\n            >\n\n            <div class=\"devise-upload-box\" id=\"deviseUploadBox\">\n              <input id=\"deviseFileInput\" type=\"file\" accept=\"image/png,image/jpeg,image/jpg,image/svg+xml,application/pdf\">\n\n              <div class=\"devise-upload-content\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M12 3l4.5 4.5h-3V14h-3V7.5h-3L12 3Zm-7 13h3v3h8v-3h3v6H5v-6Z\"/>\n                </svg>\n\n                <strong>Ladda upp bild för preview</strong>\n                <span>PNG, JPG, SVG eller PDF</span>\n                <small>Filnamn skickas med i mailet</small>\n              </div>\n            </div>\n\n            <p class=\"devise-file-name\" id=\"deviseFileName\">Ingen fil vald</p>\n          </div>\n\n          <!-- STEP 2 -->\n          <div class=\"devise-step\" data-step=\"2\">\n            <h3>Välj produkt</h3>\n\n            <label class=\"devise-label\">\n              Vad vill kunden skapa? <b>*</b>\n            </label>\n\n            <div class=\"devise-option-grid\">\n              <label class=\"devise-product-option\">\n                <input type=\"radio\" name=\"contact[Produkt]\" value=\"Hoodie\">\n\n                <span class=\"devise-option-box\">\n                  <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n                    <path d=\"M21 19c2.4-7 7-11 11-11s8.6 4 11 11\"/>\n                    <path d=\"M21 19l-7 10v25h36V29l-7-10\"/>\n                    <path d=\"M26 20c0 4.5 2.5 7.5 6 7.5s6-3 6-7.5\"/>\n                    <path d=\"M27 40h10\"/>\n                    <path d=\"M25 40c1.2 7 4.5 11 7 11s5.8-4 7-11\"/>\n                    <path d=\"M29 23v7\"/>\n                    <path d=\"M35 23v7\"/>\n                  </svg>\n                  <em>Hoodie</em>\n                </span>\n              </label>\n\n              <label class=\"devise-product-option\">\n                <input type=\"radio\" name=\"contact[Produkt]\" value=\"T-shirt\">\n\n                <span class=\"devise-option-box\">\n                  <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n                    <path d=\"M22 14l10 5 10-5 11 7-7 12-5-3v23H23V30l-5 3-7-12 11-7Z\"/>\n                    <path d=\"M27 18h10\"/>\n                    <path d=\"M26 52h12\"/>\n                  </svg>\n                  <em>T-shirt</em>\n                </span>\n              </label>\n\n              <label class=\"devise-product-option\">\n                <input type=\"radio\" name=\"contact[Produkt]\" value=\"Zip Hoodie\">\n\n                <span class=\"devise-option-box\">\n                  <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n                    <path d=\"M21 19c2.4-7 7-11 11-11s8.6 4 11 11\"/>\n                    <path d=\"M21 19l-7 10v25h36V29l-7-10\"/>\n                    <path d=\"M26 20c0 4.5 2.5 7.5 6 7.5s6-3 6-7.5\"/>\n                    <path d=\"M32 19v35\"/>\n                    <path d=\"M29.5 30h5\"/>\n                    <path d=\"M29.5 36h5\"/>\n                    <path d=\"M29.5 42h5\"/>\n                    <path d=\"M21 41h9\"/>\n                    <path d=\"M34 41h9\"/>\n                    <path d=\"M29 23v7\"/>\n                    <path d=\"M35 23v7\"/>\n                  </svg>\n                  <em>Zip Hoodie</em>\n                </span>\n              </label>\n\n              <label class=\"devise-product-option\">\n                <input type=\"radio\" name=\"contact[Produkt]\" value=\"Sweatshirt\">\n\n                <span class=\"devise-option-box\">\n                  <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n                    <path d=\"M22 15h20l10 11-8 9-4-6v24H24V29l-4 6-8-9 10-11Z\"/>\n                    <path d=\"M27 17h10\"/>\n                    <path d=\"M24 52h16\"/>\n                    <path d=\"M18 34l-4 17\"/>\n                    <path d=\"M46 34l4 17\"/>\n                  </svg>\n                  <em>Sweatshirt</em>\n                </span>\n              </label>\n            </div>\n\n            <p class=\"devise-error\" data-error=\"product\"></p>\n\n            <label class=\"devise-label\">\n              Färg <b>*</b>\n            </label>\n\n            <div class=\"devise-swatches\">\n              <label title=\"Svart\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Svart\" data-color=\"#050505\">\n                <span style=\"background:\"></span>\n              </label>\n\n              <label title=\"Vit\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Vit\" data-color=\"#f5f5f5\">\n                <span style=\"background:#f5f5f5\"></span>\n              </label>\n\n              <label title=\"Grå\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Grå\" data-color=\"#9ca3af\">\n                <span style=\"background:#9ca3af\"></span>\n              </label>\n\n              <label title=\"Mörkgrå\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Mörkgrå\" data-color=\"#4b5563\">\n                <span style=\"background:#4b5563\"></span>\n              </label>\n\n              <label title=\"Beige\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Beige\" data-color=\"#e7d8c7\">\n                <span style=\"background:#e7d8c7\"></span>\n              </label>\n\n              <label title=\"Navy\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Navy\" data-color=\"#1f2a44\">\n                <span style=\"background:#1f2a44\"></span>\n              </label>\n\n              <label title=\"Blå\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Blå\" data-color=\"#2563eb\">\n                <span style=\"background:#2563eb\"></span>\n              </label>\n\n              <label title=\"Röd\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Röd\" data-color=\"#dc2626\">\n                <span style=\"background:#dc2626\"></span>\n              </label>\n\n              <label title=\"Grön\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Grön\" data-color=\"#15803d\">\n                <span style=\"background:#15803d\"></span>\n              </label>\n\n              <label title=\"Brun\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Brun\" data-color=\"#7c4a2d\">\n                <span style=\"background:#7c4a2d\"></span>\n              </label>\n\n              <label title=\"Rosa\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Rosa\" data-color=\"#ec4899\">\n                <span style=\"background:#ec4899\"></span>\n              </label>\n\n              <label title=\"Lila\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Lila\" data-color=\"#7c3aed\">\n                <span style=\"background:#7c3aed\"></span>\n              </label>\n\n              <label class=\"devise-other-swatch\" title=\"Annan färg\">\n                <input type=\"radio\" name=\"contact[Färg]\" value=\"Annan färg\" data-color=\"#d1d5db\">\n                <span>+</span>\n              </label>\n            </div>\n\n            <p class=\"devise-error\" data-error=\"color\"></p>\n\n            <div class=\"devise-other-color-wrap\" id=\"deviseOtherColorWrap\">\n              <label class=\"devise-label\" for=\"deviseOtherColor\">\n                Skriv annan färg <b>*</b>\n              </label>\n\n              <input\n                id=\"deviseOtherColor\"\n                class=\"devise-input\"\n                type=\"text\"\n                placeholder=\"T.ex. vinröd, babyblå, ljuslila...\"\n              >\n\n              <p class=\"devise-error\" data-error=\"othercolor\"></p>\n            </div>\n\n            <label class=\"devise-label\">\n              Storlek <b>*</b>\n            </label>\n\n            <div class=\"devise-size-grid\">\n              <label><input type=\"radio\" name=\"contact[Storlek]\" value=\"XS\"><span>XS</span></label>\n              <label><input type=\"radio\" name=\"contact[Storlek]\" value=\"S\"><span>S</span></label>\n              <label><input type=\"radio\" name=\"contact[Storlek]\" value=\"M\"><span>M</span></label>\n              <label><input type=\"radio\" name=\"contact[Storlek]\" value=\"L\"><span>L</span></label>\n              <label><input type=\"radio\" name=\"contact[Storlek]\" value=\"XL\"><span>XL</span></label>\n              <label><input type=\"radio\" name=\"contact[Storlek]\" value=\"XXL\"><span>XXL</span></label>\n              <label><input type=\"radio\" name=\"contact[Storlek]\" value=\"3XL\"><span>3XL</span></label>\n            </div>\n\n            <p class=\"devise-error\" data-error=\"size\"></p>\n\n            <label class=\"devise-label\" for=\"deviseQuantity\">\n              Antal <b>*</b>\n            </label>\n\n            <input id=\"deviseQuantity\" class=\"devise-input\" type=\"number\" min=\"1\" value=\"1\" name=\"contact[Antal]\">\n\n            <p class=\"devise-error\" data-error=\"quantity\"></p>\n          </div>\n\n          <!-- STEP 3 -->\n          <div class=\"devise-step\" data-step=\"3\">\n            <h3>Tryckdetaljer</h3>\n\n            <label class=\"devise-label\">\n              Placering av tryck <b>*</b>\n            </label>\n\n            <div class=\"devise-placement-grid\">\n              <label>\n                <input type=\"radio\" name=\"contact[Tryckplacering]\" value=\"Fram\">\n\n                <span>\n                  <b>Fram</b>\n                  <small>Bröst eller stort framtryck</small>\n                </span>\n              </label>\n\n              <label>\n                <input type=\"radio\" name=\"contact[Tryckplacering]\" value=\"Bak\">\n\n                <span>\n                  <b>Bak</b>\n                  <small>Ryggtryck / stort motiv</small>\n                </span>\n              </label>\n\n              <label>\n                <input type=\"radio\" name=\"contact[Tryckplacering]\" value=\"Fram och bak\">\n\n                <span>\n                  <b>Fram & bak</b>\n                  <small>Logo fram + design bak</small>\n                </span>\n              </label>\n            </div>\n\n            <p class=\"devise-error\" data-error=\"placement\"></p>\n\n            <label class=\"devise-label\" for=\"devisePrintText\">\n              Text som ska stå på plagget\n            </label>\n\n            <input\n              id=\"devisePrintText\"\n              class=\"devise-input\"\n              type=\"text\"\n              name=\"contact[Text på plagget]\"\n              placeholder=\"Valfritt\"\n            >\n\n            <label class=\"devise-label\" for=\"deviseNotes\">\n              Extra information\n            </label>\n\n            <textarea\n              id=\"deviseNotes\"\n              class=\"devise-notes\"\n              name=\"contact[Extra information]\"\n              maxlength=\"1000\"\n              placeholder=\"Tryckstorlek, passform, material, textfärg, referenser, särskilda önskemål...\"\n            ></textarea>\n          </div>\n\n          <!-- STEP 4 -->\n          <div class=\"devise-step\" data-step=\"4\">\n            <h3>Kontakt & sammanfattning</h3>\n\n            <div class=\"devise-summary\" id=\"deviseSummary\"></div>\n\n            <div class=\"devise-two\">\n              <div>\n                <label class=\"devise-label\" for=\"deviseName\">Namn <b>*</b></label>\n                <input id=\"deviseName\" class=\"devise-input\" type=\"text\" name=\"contact[name]\" placeholder=\"Ditt namn\">\n                <p class=\"devise-error\" data-error=\"name\"></p>\n              </div>\n\n              <div>\n                <label class=\"devise-label\" for=\"deviseEmail\">Email <b>*</b></label>\n                <input id=\"deviseEmail\" class=\"devise-input\" type=\"email\" name=\"contact[email]\" placeholder=\"din@email.se\">\n                <p class=\"devise-error\" data-error=\"email\"></p>\n              </div>\n            </div>\n\n            <div class=\"devise-two\">\n              <div>\n                <label class=\"devise-label\" for=\"devisePhone\">Telefon <b>*</b></label>\n                <input id=\"devisePhone\" class=\"devise-input\" type=\"tel\" name=\"contact[phone]\" placeholder=\"070 000 00 00\">\n                <p class=\"devise-error\" data-error=\"phone\"></p>\n              </div>\n\n              <div>\n                <label class=\"devise-label\" for=\"deviseCompany\">Företag / förening</label>\n                <input id=\"deviseCompany\" class=\"devise-input\" type=\"text\" name=\"contact[Företag]\" placeholder=\"Valfritt\">\n              </div>\n            </div>\n          </div>\n\n          <div class=\"devise-actions\">\n            <button type=\"button\" class=\"devise-btn devise-btn-prev\" id=\"devisePrev\">\n              ← Föregående\n            </button>\n\n            <button type=\"button\" class=\"devise-btn devise-btn-next\" id=\"deviseNext\">\n              Nästa steg →\n            </button>\n\n            <button type=\"submit\" class=\"devise-btn devise-btn-submit\" id=\"deviseSubmit\">\n              Skicka beställning →\n            </button>\n          </div>\n        </div>\n\n        <div class=\"devise-form-right\">\n          <div class=\"devise-preview-card\">\n            <div class=\"devise-preview-head\">\n              <strong>Live preview</strong>\n              <span>Mockup</span>\n            </div>\n\n            <div class=\"devise-price-card\">\n              <div class=\"devise-price-card__top\">\n                <strong>Prisestimat</strong>\n                <span id=\"deviseEstimateTotal\">0 kr</span>\n              </div>\n\n              <div class=\"devise-price-breakdown\" id=\"devisePriceBreakdown\"></div>\n\n              <p class=\"devise-price-note\">\n                Uppskattat pris. Exakt pris bekräftas innan produktion.\n              </p>\n            </div>\n\n            <div class=\"devise-mockup\" id=\"deviseMockup\">\n              <div class=\"devise-garment\">\n                <div class=\"devise-hood\"></div>\n                <div class=\"devise-body\"></div>\n                <div class=\"devise-sleeve left\"></div>\n                <div class=\"devise-sleeve right\"></div>\n                <div class=\"devise-pocket\"></div>\n                <div class=\"devise-zip\"></div>\n\n                <div class=\"devise-design-print\" id=\"deviseDesignPrint\">\n                  <span>YOUR DESIGN HERE</span>\n                  <img id=\"devisePreviewImage\" alt=\"\">\n                </div>\n              </div>\n            </div>\n\n            <p class=\"devise-preview-note\">\n              Förhandsvisningen är ungefärlig. Exakt placering och storlek bekräftas innan tryck.\n            </p>\n          </div>\n        </div>\n      </div>\n    {% endform %}\n  </div>\n\n  <div class=\"devise-trust-row\">\n    <div>\n      <span>✓</span>\n      <strong>ENKELT</strong>\n      <p>Steg-för-steg formulär</p>\n    </div>\n\n    <div>\n      <span>⚡</span>\n      <strong>SNABBT</strong>\n      <p>Svar inom 24h</p>\n    </div>\n\n    <div>\n      <span>🔒</span>\n      <strong>SÄKERT</strong>\n      <p>Din information är trygg</p>\n    </div>\n\n    <div>\n      <span>★</span>\n      <strong>INGEN BETALNING</strong>\n      <p>Du betalar först när du är nöjd</p>\n    </div>\n  </div>\n</section>\n\n<style>\n  .devise-order-section {\n    background: #0A0A0A;\n    color: #FFFFFF;\n    font-family: Inter, Arial, sans-serif;\n    padding: 56px 20px 34px;\n  }\n\n  .devise-order-section * {\n    box-sizing: border-box;\n  }\n\n  .devise-form-card {\n    max-width: 1280px;\n    margin: 0 auto;\n    background: #111111;\n    border: 1px solid rgba(255,255,255,0.10);\n    border-radius: 24px;\n    padding: 30px;\n    box-shadow: 0 30px 90px rgba(0,0,0,0.42);\n  }\n\n  .devise-success {\n    background: rgba(255,222,89,0.12);\n    border: 1px solid rgba(255,222,89,0.35);\n    color: #FFDE59;\n    padding: 14px 16px;\n    border-radius: 12px;\n    margin-bottom: 20px;\n    font-weight: 800;\n  }\n\n  .devise-progress-head {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 24px;\n    margin-bottom: 30px;\n  }\n\n  .devise-progress {\n    flex: 1;\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n  }\n\n  .devise-progress-item {\n    min-width: 84px;\n    text-align: center;\n  }\n\n  .devise-progress-item span {\n    width: 34px;\n    height: 34px;\n    border-radius: 999px;\n    background: #252525;\n    border: 1px solid rgba(255,255,255,0.14);\n    color: #A0A0A0;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 900;\n    font-size: 14px;\n  }\n\n  .devise-progress-item small {\n    display: block;\n    margin-top: 9px;\n    color: #A0A0A0;\n    font-size: 12px;\n    font-weight: 700;\n  }\n\n  .devise-progress-item.active span,\n  .devise-progress-item.done span {\n    background: #FFDE59;\n    color: #0A0A0A;\n    border-color: #FFDE59;\n  }\n\n  .devise-progress-item.active small {\n    color: #FFFFFF;\n  }\n\n  .devise-line {\n    flex: 1;\n    height: 1px;\n    background: rgba(255,255,255,0.14);\n    margin-top: 17px;\n  }\n\n  .devise-step-count {\n    color: #FFDE59;\n    font-weight: 900;\n    font-size: 14px;\n    white-space: nowrap;\n  }\n\n  .devise-layout {\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    gap: 28px;\n  }\n\n  .devise-step {\n    display: none;\n  }\n\n  .devise-step.active {\n    display: block;\n  }\n\n  .devise-step h3 {\n    margin: 0 0 20px;\n    font-size: 28px;\n    letter-spacing: -0.04em;\n    font-weight: 950;\n  }\n\n  .devise-label {\n    display: block;\n    color: #FFFFFF;\n    font-size: 14px;\n    font-weight: 850;\n    margin: 18px 0 9px;\n  }\n\n  .devise-label b {\n    color: #EF4444;\n  }\n\n  .devise-input,\n  .devise-notes,\n  .devise-textarea-wrap textarea {\n    width: 100%;\n    background: #0D0D0D;\n    border: 1px solid rgba(255,255,255,0.16);\n    color: #FFFFFF;\n    border-radius: 12px;\n    outline: none;\n    font-family: inherit;\n    font-size: 14px;\n    transition: 0.18s ease;\n  }\n\n  .devise-input::placeholder,\n  .devise-notes::placeholder,\n  .devise-textarea-wrap textarea::placeholder {\n    color: #777777;\n  }\n\n  .devise-input {\n    min-height: 48px;\n    padding: 0 14px;\n  }\n\n  .devise-notes {\n    min-height: 136px;\n    padding: 14px;\n    resize: vertical;\n  }\n\n  .devise-textarea-wrap {\n    position: relative;\n  }\n\n  .devise-textarea-wrap textarea {\n    min-height: 145px;\n    padding: 15px;\n    resize: vertical;\n  }\n\n  .devise-textarea-wrap small {\n    position: absolute;\n    right: 14px;\n    bottom: 12px;\n    color: #A0A0A0;\n    font-size: 11px;\n  }\n\n  .devise-input:focus,\n  .devise-notes:focus,\n  .devise-textarea-wrap textarea:focus {\n    border-color: #FFDE59;\n    box-shadow: 0 0 0 3px rgba(255,222,89,0.14);\n  }\n\n  .devise-upload-box {\n    margin-top: 18px;\n    border: 1px dashed rgba(255,255,255,0.28);\n    border-radius: 14px;\n    min-height: 150px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    background: rgba(255,255,255,0.02);\n    cursor: pointer;\n    transition: 0.2s ease;\n  }\n\n  .devise-upload-box:hover,\n  .devise-upload-box.dragging {\n    border-color: #FFDE59;\n    background: rgba(255,222,89,0.05);\n  }\n\n  .devise-upload-box input {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    cursor: pointer;\n  }\n\n  .devise-upload-content {\n    text-align: center;\n    pointer-events: none;\n  }\n\n  .devise-upload-content svg {\n    width: 34px;\n    height: 34px;\n    fill: #FFFFFF;\n    margin-bottom: 12px;\n  }\n\n  .devise-upload-content strong,\n  .devise-upload-content span,\n  .devise-upload-content small {\n    display: block;\n  }\n\n  .devise-upload-content strong {\n    color: #FFFFFF;\n    font-size: 14px;\n    margin-bottom: 5px;\n  }\n\n  .devise-upload-content span,\n  .devise-upload-content small {\n    color: #A0A0A0;\n    font-size: 12px;\n  }\n\n  .devise-file-name {\n    color: #FFDE59;\n    font-size: 12px;\n    margin: 10px 0 0;\n    font-weight: 800;\n  }\n\n  .devise-option-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 14px;\n  }\n\n  .devise-product-option {\n    display: block;\n    min-width: 0;\n  }\n\n  .devise-product-option input,\n  .devise-swatches input,\n  .devise-size-grid input,\n  .devise-placement-grid input {\n    display: none;\n  }\n\n  .devise-option-box {\n    width: 100%;\n    height: 138px;\n    min-height: 138px;\n    border: 1px solid rgba(255,255,255,0.14);\n    border-radius: 16px;\n    background: #151515;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    gap: 12px;\n    color: #FFFFFF;\n    cursor: pointer;\n    transition: 0.2s ease;\n    padding: 12px;\n    text-align: center;\n  }\n\n  .devise-option-box svg {\n    width: 46px;\n    height: 46px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2.4;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    flex-shrink: 0;\n  }\n\n  .devise-option-box em {\n    font-style: normal;\n    font-size: 14px;\n    font-weight: 850;\n    line-height: 1.2;\n    white-space: nowrap;\n  }\n\n  .devise-product-option input:checked + .devise-option-box {\n    border-color: #FFDE59;\n    color: #FFDE59;\n    box-shadow: 0 0 22px rgba(255,222,89,0.12);\n  }\n\n  .devise-swatches {\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n\n  .devise-swatches span {\n    display: flex;\n    width: 34px;\n    height: 34px;\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.38);\n    cursor: pointer;\n    transition: 0.18s ease;\n    align-items: center;\n    justify-content: center;\n    color: #0A0A0A;\n    font-size: 18px;\n    font-weight: 900;\n  }\n\n  .devise-swatches input:checked + span {\n    box-shadow: 0 0 0 3px #111111, 0 0 0 5px #FFDE59;\n  }\n\n  .devise-other-swatch span {\n    background: #E5E7EB;\n  }\n\n  .devise-other-color-wrap {\n    display: none;\n  }\n\n  .devise-other-color-wrap.is-visible {\n    display: block;\n  }\n\n  .devise-size-grid {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .devise-size-grid span {\n    min-width: 56px;\n    height: 42px;\n    border-radius: 10px;\n    border: 1px solid rgba(255,255,255,0.14);\n    background: #151515;\n    color: #FFFFFF;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 13px;\n    font-weight: 900;\n    cursor: pointer;\n    transition: 0.18s ease;\n  }\n\n  .devise-size-grid input:checked + span {\n    background: #FFDE59;\n    color: #0A0A0A;\n    border-color: #FFDE59;\n  }\n\n  .devise-placement-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 12px;\n  }\n\n  .devise-placement-grid span {\n    min-height: 96px;\n    border: 1px solid rgba(255,255,255,0.14);\n    background: #151515;\n    border-radius: 12px;\n    padding: 14px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 6px;\n    cursor: pointer;\n    transition: 0.18s ease;\n  }\n\n  .devise-placement-grid b {\n    color: #FFFFFF;\n    font-size: 14px;\n  }\n\n  .devise-placement-grid small {\n    color: #A0A0A0;\n    font-size: 12px;\n    line-height: 1.35;\n  }\n\n  .devise-placement-grid input:checked + span {\n    border-color: #FFDE59;\n    box-shadow: 0 0 22px rgba(255,222,89,0.12);\n  }\n\n  .devise-placement-grid input:checked + span b {\n    color: #FFDE59;\n  }\n\n  .devise-two {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n\n  .devise-error {\n    color: #EF4444;\n    font-size: 12px;\n    font-weight: 750;\n    min-height: 16px;\n    margin: 6px 0 0;\n  }\n\n  .devise-preview-card {\n    background: #151515;\n    border: 1px solid rgba(255,255,255,0.13);\n    border-radius: 18px;\n    padding: 18px;\n    position: sticky;\n    top: 18px;\n  }\n\n  .devise-preview-head {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 14px;\n  }\n\n  .devise-preview-head strong {\n    color: #FFFFFF;\n    font-weight: 950;\n  }\n\n  .devise-preview-head span {\n    color: #FFDE59;\n    font-size: 12px;\n    font-weight: 900;\n  }\n\n  .devise-price-card {\n    background: #101010;\n    border: 1px solid rgba(255,222,89,0.16);\n    border-radius: 14px;\n    padding: 14px;\n    margin-bottom: 16px;\n  }\n\n  .devise-price-card__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 10px;\n  }\n\n  .devise-price-card__top strong {\n    font-size: 14px;\n    color: #FFFFFF;\n  }\n\n  .devise-price-card__top span {\n    color: #FFDE59;\n    font-size: 22px;\n    font-weight: 950;\n    letter-spacing: -0.03em;\n  }\n\n  .devise-price-breakdown {\n    display: grid;\n    gap: 6px;\n  }\n\n  .devise-price-row {\n    display: flex;\n    justify-content: space-between;\n    gap: 12px;\n    color: #CFCFCF;\n    font-size: 12px;\n  }\n\n  .devise-price-note {\n    color: #A0A0A0;\n    font-size: 11px;\n    margin: 10px 0 0;\n    line-height: 1.45;\n  }\n\n  .devise-mockup {\n    min-height: 380px;\n    border-radius: 16px;\n    background: radial-gradient(circle at center, #2a2a2a 0%, #101010 72%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n\n  .devise-garment {\n    --garment-color: #050505;\n    width: 260px;\n    height: 300px;\n    position: relative;\n  }\n\n  .devise-body {\n    position: absolute;\n    left: 52px;\n    top: 84px;\n    width: 156px;\n    height: 190px;\n    border-radius: 34px 34px 18px 18px;\n    background: var(--garment-color);\n    border: 1px solid rgba(255,255,255,0.18);\n    box-shadow: inset 0 0 35px rgba(255,255,255,0.08);\n  }\n\n  .devise-hood {\n    position: absolute;\n    left: 78px;\n    top: 24px;\n    width: 104px;\n    height: 92px;\n    border-radius: 50% 50% 34px 34px;\n    background: var(--garment-color);\n    border: 1px solid rgba(255,255,255,0.18);\n  }\n\n  .devise-sleeve {\n    position: absolute;\n    top: 100px;\n    width: 56px;\n    height: 150px;\n    background: var(--garment-color);\n    border: 1px solid rgba(255,255,255,0.15);\n  }\n\n  .devise-sleeve.left {\n    left: 10px;\n    border-radius: 28px 10px 22px 22px;\n    transform: rotate(12deg);\n  }\n\n  .devise-sleeve.right {\n    right: 10px;\n    border-radius: 10px 28px 22px 22px;\n    transform: rotate(-12deg);\n  }\n\n  .devise-pocket {\n    position: absolute;\n    left: 92px;\n    top: 206px;\n    width: 76px;\n    height: 36px;\n    border-radius: 6px 6px 18px 18px;\n    border: 1px solid rgba(255,255,255,0.22);\n    z-index: 3;\n  }\n\n  .devise-zip {\n    display: none;\n    position: absolute;\n    left: 129px;\n    top: 84px;\n    width: 2px;\n    height: 190px;\n    background: rgba(255,255,255,0.35);\n    z-index: 4;\n  }\n\n  .devise-design-print {\n    position: absolute;\n    left: 87px;\n    top: 132px;\n    width: 86px;\n    height: 76px;\n    z-index: 5;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n  }\n\n  .devise-design-print span {\n    color: #FFDE59;\n    font-size: 16px;\n    line-height: 0.95;\n    font-weight: 950;\n    letter-spacing: -0.04em;\n  }\n\n  .devise-design-print img {\n    display: none;\n    max-width: 100%;\n    max-height: 100%;\n    object-fit: contain;\n  }\n\n  .devise-preview-note {\n    color: #A0A0A0;\n    font-size: 12px;\n    line-height: 1.5;\n    margin: 14px 0 0;\n  }\n\n  .devise-preview-card.is-zip .devise-zip {\n    display: block;\n  }\n\n  .devise-preview-card.is-tshirt .devise-hood,\n  .devise-preview-card.is-sweatshirt .devise-hood {\n    display: none;\n  }\n\n  .devise-preview-card.is-tshirt .devise-body,\n  .devise-preview-card.is-sweatshirt .devise-body {\n    top: 70px;\n  }\n\n  .devise-preview-card.is-tshirt .devise-pocket,\n  .devise-preview-card.is-sweatshirt .devise-pocket {\n    display: none;\n  }\n\n  .devise-actions {\n    display: flex;\n    justify-content: space-between;\n    gap: 12px;\n    margin-top: 28px;\n  }\n\n  .devise-btn {\n    min-height: 50px;\n    border-radius: 10px;\n    padding: 0 20px;\n    border: 1px solid #FFDE59;\n    font-family: inherit;\n    font-weight: 950;\n    cursor: pointer;\n    transition: 0.2s ease;\n  }\n\n  .devise-btn-prev {\n    background: transparent;\n    color: #FFDE59;\n  }\n\n  .devise-btn-next,\n  .devise-btn-submit {\n    background: #FFDE59;\n    color: #0A0A0A;\n  }\n\n  .devise-btn:hover {\n    transform: translateY(-2px);\n  }\n\n  .devise-btn-prev.is-hidden,\n  .devise-btn-submit {\n    display: none;\n  }\n\n  .devise-summary {\n    background: #151515;\n    border: 1px solid rgba(255,222,89,0.18);\n    border-radius: 14px;\n    padding: 16px;\n    margin-bottom: 20px;\n  }\n\n  .devise-summary-row {\n    display: flex;\n    justify-content: space-between;\n    gap: 18px;\n    padding: 9px 0;\n    border-bottom: 1px solid rgba(255,255,255,0.08);\n  }\n\n  .devise-summary-row:last-child {\n    border-bottom: 0;\n  }\n\n  .devise-summary-row span {\n    color: #A0A0A0;\n    font-size: 13px;\n  }\n\n  .devise-summary-row strong {\n    color: #FFFFFF;\n    font-size: 13px;\n    text-align: right;\n  }\n\n  .devise-trust-row {\n    max-width: 1280px;\n    margin: 28px auto 0;\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n  }\n\n  .devise-trust-row div {\n    display: grid;\n    grid-template-columns: 42px 1fr;\n    column-gap: 12px;\n    align-items: center;\n  }\n\n  .devise-trust-row span {\n    grid-row: span 2;\n    width: 42px;\n    height: 42px;\n    border-radius: 999px;\n    background: #252525;\n    color: #FFDE59;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 950;\n  }\n\n  .devise-trust-row strong {\n    font-size: 13px;\n    color: #FFFFFF;\n    font-weight: 950;\n  }\n\n  .devise-trust-row p {\n    margin: 4px 0 0;\n    color: #A0A0A0;\n    font-size: 13px;\n  }\n\n  @media (max-width: 1050px) {\n    .devise-layout {\n      grid-template-columns: 1fr;\n    }\n\n    .devise-preview-card {\n      position: relative;\n      top: auto;\n    }\n\n    .devise-trust-row {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (max-width: 700px) {\n    .devise-order-section {\n      padding: 40px 14px 28px;\n    }\n\n    .devise-form-card {\n      padding: 18px;\n      border-radius: 18px;\n    }\n\n    .devise-progress-head {\n      flex-direction: column;\n    }\n\n    .devise-progress {\n      width: 100%;\n      gap: 4px;\n    }\n\n    .devise-progress-item {\n      min-width: auto;\n      flex: 0 0 auto;\n    }\n\n    .devise-progress-item small {\n      display: none;\n    }\n\n    .devise-option-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    .devise-option-box {\n      height: 126px;\n      min-height: 126px;\n    }\n\n    .devise-option-box svg {\n      width: 40px;\n      height: 40px;\n    }\n\n    .devise-option-box em {\n      font-size: 13px;\n    }\n\n    .devise-placement-grid,\n    .devise-two,\n    .devise-trust-row {\n      grid-template-columns: 1fr;\n    }\n\n    .devise-actions {\n      flex-direction: column;\n    }\n\n    .devise-btn {\n      width: 100%;\n    }\n\n    .devise-mockup {\n      min-height: 330px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const form = document.getElementById(\"devise-custom-order-form\");\n    if (!form) return;\n\n    const PRICING = window.DEVISE_PRICING || {};\n    let currentStep = 1;\n    const totalSteps = 4;\n\n    const steps = form.querySelectorAll(\".devise-step\");\n    const progressItems = form.querySelectorAll(\".devise-progress-item\");\n    const currentStepEl = document.getElementById(\"deviseCurrentStep\");\n    const prevBtn = document.getElementById(\"devisePrev\");\n    const nextBtn = document.getElementById(\"deviseNext\");\n    const submitBtn = document.getElementById(\"deviseSubmit\");\n\n    const idea = document.getElementById(\"deviseIdea\");\n    const charCount = document.getElementById(\"deviseCharCount\");\n    const fileInput = document.getElementById(\"deviseFileInput\");\n    const fileName = document.getElementById(\"deviseFileName\");\n    const hiddenFileName = document.getElementById(\"deviseUploadedFileName\");\n    const hiddenOtherColor = document.getElementById(\"deviseOtherColorHidden\");\n    const otherColorInput = document.getElementById(\"deviseOtherColor\");\n    const otherColorWrap = document.getElementById(\"deviseOtherColorWrap\");\n\n    const previewImg = document.getElementById(\"devisePreviewImage\");\n    const designPrint = document.getElementById(\"deviseDesignPrint\");\n    const previewCard = document.querySelector(\".devise-preview-card\");\n    const garment = document.querySelector(\".devise-garment\");\n    const summary = document.getElementById(\"deviseSummary\");\n    const orderBody = document.getElementById(\"deviseOrderBody\");\n    const estimateTotal = document.getElementById(\"deviseEstimateTotal\");\n    const estimateField = document.getElementById(\"devisePriceEstimateField\");\n    const priceBreakdown = document.getElementById(\"devisePriceBreakdown\");\n\n    const errors = {\n      idea: form.querySelector('[data-error=\"idea\"]'),\n      product: form.querySelector('[data-error=\"product\"]'),\n      color: form.querySelector('[data-error=\"color\"]'),\n      othercolor: form.querySelector('[data-error=\"othercolor\"]'),\n      size: form.querySelector('[data-error=\"size\"]'),\n      quantity: form.querySelector('[data-error=\"quantity\"]'),\n      placement: form.querySelector('[data-error=\"placement\"]'),\n      name: form.querySelector('[data-error=\"name\"]'),\n      email: form.querySelector('[data-error=\"email\"]'),\n      phone: form.querySelector('[data-error=\"phone\"]')\n    };\n\n    function formatPrice(value) {\n      return Math.round(value) + \" kr\";\n    }\n\n    function getValue(name) {\n      const field = form.querySelector('[name=\"' + name + '\"]');\n      if (!field) return \"\";\n\n      if (field.type === \"radio\") {\n        const checked = form.querySelector('[name=\"' + name + '\"]:checked');\n        return checked ? checked.value : \"\";\n      }\n\n      return field.value.trim();\n    }\n\n    function clearErrors() {\n      Object.keys(errors).forEach(function (key) {\n        if (errors[key]) errors[key].textContent = \"\";\n      });\n    }\n\n    function showStep(step) {\n      currentStep = step;\n\n      steps.forEach(function (panel) {\n        panel.classList.toggle(\"active\", Number(panel.dataset.step) === currentStep);\n      });\n\n      progressItems.forEach(function (item) {\n        const index = Number(item.dataset.progress);\n\n        item.classList.toggle(\"active\", index === currentStep);\n        item.classList.toggle(\"done\", index < currentStep);\n        item.querySelector(\"span\").textContent = index < currentStep ? \"✓\" : index;\n      });\n\n      currentStepEl.textContent = currentStep;\n\n      prevBtn.classList.toggle(\"is-hidden\", currentStep === 1);\n      nextBtn.style.display = currentStep === totalSteps ? \"none\" : \"inline-flex\";\n      submitBtn.style.display = currentStep === totalSteps ? \"inline-flex\" : \"none\";\n\n      if (currentStep === totalSteps) {\n        updateSummary();\n      }\n    }\n\n    function validateStep(step) {\n      clearErrors();\n      let valid = true;\n\n      if (step === 1) {\n        if (!idea.value.trim()) {\n          errors.idea.textContent = \"Beskriv idén innan du går vidare.\";\n          valid = false;\n        }\n      }\n\n      if (step === 2) {\n        if (!getValue(\"contact[Produkt]\")) {\n          errors.product.textContent = \"Välj produkt.\";\n          valid = false;\n        }\n\n        if (!getValue(\"contact[Färg]\")) {\n          errors.color.textContent = \"Välj färg.\";\n          valid = false;\n        }\n\n        if (getValue(\"contact[Färg]\") === \"Annan färg\" && !otherColorInput.value.trim()) {\n          errors.othercolor.textContent = \"Skriv vilken färg du vill ha.\";\n          valid = false;\n        }\n\n        if (!getValue(\"contact[Storlek]\")) {\n          errors.size.textContent = \"Välj storlek.\";\n          valid = false;\n        }\n\n        const qty = Number(document.getElementById(\"deviseQuantity\").value);\n        if (!qty || qty < 1) {\n          errors.quantity.textContent = \"Ange minst 1 i antal.\";\n          valid = false;\n        }\n      }\n\n      if (step === 3) {\n        if (!getValue(\"contact[Tryckplacering]\")) {\n          errors.placement.textContent = \"Välj tryckplacering.\";\n          valid = false;\n        }\n      }\n\n      if (step === 4) {\n        const name = document.getElementById(\"deviseName\").value.trim();\n        const email = document.getElementById(\"deviseEmail\").value.trim();\n        const phone = document.getElementById(\"devisePhone\").value.trim();\n\n        if (!name) {\n          errors.name.textContent = \"Skriv ditt namn.\";\n          valid = false;\n        }\n\n        if (!email || !email.includes(\"@\")) {\n          errors.email.textContent = \"Skriv en giltig email.\";\n          valid = false;\n        }\n\n        if (!phone) {\n          errors.phone.textContent = \"Skriv telefonnummer.\";\n          valid = false;\n        }\n      }\n\n      return valid;\n    }\n\n    function updatePreviewFromProduct(value) {\n      previewCard.classList.remove(\"is-zip\", \"is-tshirt\", \"is-sweatshirt\");\n\n      if (value === \"Zip Hoodie\") previewCard.classList.add(\"is-zip\");\n      if (value === \"T-shirt\") previewCard.classList.add(\"is-tshirt\");\n      if (value === \"Sweatshirt\") previewCard.classList.add(\"is-sweatshirt\");\n    }\n\n    function updatePreviewColor(input) {\n      if (!input) return;\n      garment.style.setProperty(\"--garment-color\", input.dataset.color || \"#050505\");\n    }\n\n    function toggleOtherColorField() {\n      const color = getValue(\"contact[Färg]\");\n      const visible = color === \"Annan färg\";\n\n      otherColorWrap.classList.toggle(\"is-visible\", visible);\n      hiddenOtherColor.value = visible ? otherColorInput.value.trim() : \"\";\n    }\n\n    function getEstimateData() {\n      const product = getValue(\"contact[Produkt]\");\n      const color = getValue(\"contact[Färg]\");\n      const size = getValue(\"contact[Storlek]\");\n      const placement = getValue(\"contact[Tryckplacering]\");\n      const quantity = Math.max(1, Number(getValue(\"contact[Antal]\") || 1));\n\n      const basePrice = (PRICING.baseProducts && PRICING.baseProducts[product]) || 0;\n      const placementFee = (PRICING.placementFees && PRICING.placementFees[placement]) || 0;\n      const sizeFee = (PRICING.sizeFees && PRICING.sizeFees[size]) || 0;\n      const colorFee = (PRICING.colorFees && PRICING.colorFees[color]) || 0;\n      const uploadFee = hiddenFileName.value && hiddenFileName.value !== \"Ingen fil uppladdad\"\n        ? (PRICING.uploadFee || 0)\n        : 0;\n\n      const perItem = basePrice + placementFee + sizeFee + colorFee + uploadFee;\n      const total = perItem * quantity;\n\n      return {\n        product,\n        color,\n        size,\n        placement,\n        quantity,\n        basePrice,\n        placementFee,\n        sizeFee,\n        colorFee,\n        uploadFee,\n        perItem,\n        total\n      };\n    }\n\n    function updateEstimate() {\n      const estimate = getEstimateData();\n\n      estimateTotal.textContent = formatPrice(estimate.total);\n      estimateField.value = formatPrice(estimate.total);\n\n      const rows = [\n        { label: \"Baspris\", value: estimate.basePrice },\n        { label: \"Tryckplacering\", value: estimate.placementFee },\n        { label: \"Storlek\", value: estimate.sizeFee },\n        { label: \"Färg\", value: estimate.colorFee },\n        { label: \"Designfil\", value: estimate.uploadFee },\n        { label: \"Antal\", value: \"x \" + estimate.quantity }\n      ];\n\n      priceBreakdown.innerHTML = rows.map(function (row) {\n        return '<div class=\"devise-price-row\"><span>' + row.label + '</span><strong>' +\n          (typeof row.value === \"number\" ? formatPrice(row.value) : row.value) +\n          '</strong></div>';\n      }).join(\"\");\n    }\n\n    function updateSummary() {\n      const chosenColor = getValue(\"contact[Färg]\") === \"Annan färg\"\n        ? \"Annan färg: \" + (otherColorInput.value.trim() || \"Ej angiven\")\n        : (getValue(\"contact[Färg]\") || \"Ej valt\");\n\n      const data = {\n        \"Idé\": getValue(\"contact[Idébeskrivning]\"),\n        \"Designlänk\": getValue(\"contact[Designlänk]\") || \"Ingen länk\",\n        \"Uppladdad fil\": hiddenFileName.value || \"Ingen fil\",\n        \"Produkt\": getValue(\"contact[Produkt]\") || \"Ej valt\",\n        \"Färg\": chosenColor,\n        \"Storlek\": getValue(\"contact[Storlek]\") || \"Ej valt\",\n        \"Antal\": getValue(\"contact[Antal]\") || \"1\",\n        \"Tryckplacering\": getValue(\"contact[Tryckplacering]\") || \"Ej valt\",\n        \"Text på plagget\": getValue(\"contact[Text på plagget]\") || \"Ingen text\",\n        \"Extra information\": getValue(\"contact[Extra information]\") || \"Ingen extra information\",\n        \"Prisestimat\": estimateField.value\n      };\n\n      summary.innerHTML = Object.keys(data).map(function (key) {\n        return '<div class=\"devise-summary-row\"><span>' + key + '</span><strong>' + data[key] + '</strong></div>';\n      }).join(\"\");\n\n      orderBody.value =\n        \"NY CUSTOM BESTÄLLNING - DEVISEAPPAREL\\n\\n\" +\n        Object.keys(data).map(function (key) {\n          return key + \": \" + data[key];\n        }).join(\"\\n\") +\n        \"\\n\\nKund: \" + getValue(\"contact[name]\") +\n        \"\\nEmail: \" + getValue(\"contact[email]\") +\n        \"\\nTelefon: \" + getValue(\"contact[phone]\") +\n        \"\\nFöretag: \" + (getValue(\"contact[Företag]\") || \"Ej angivet\");\n    }\n\n    idea.addEventListener(\"input\", function () {\n      charCount.textContent = idea.value.length;\n    });\n\n    form.querySelectorAll('[name=\"contact[Produkt]\"]').forEach(function (input) {\n      input.addEventListener(\"change\", function () {\n        updatePreviewFromProduct(input.value);\n        updateEstimate();\n      });\n    });\n\n    form.querySelectorAll('[name=\"contact[Färg]\"]').forEach(function (input) {\n      input.addEventListener(\"change\", function () {\n        updatePreviewColor(input);\n        toggleOtherColorField();\n        updateEstimate();\n      });\n    });\n\n    form.querySelectorAll('[name=\"contact[Storlek]\"]').forEach(function (input) {\n      input.addEventListener(\"change\", updateEstimate);\n    });\n\n    form.querySelectorAll('[name=\"contact[Tryckplacering]\"]').forEach(function (input) {\n      input.addEventListener(\"change\", updateEstimate);\n    });\n\n    document.getElementById(\"deviseQuantity\").addEventListener(\"input\", updateEstimate);\n\n    otherColorInput.addEventListener(\"input\", function () {\n      hiddenOtherColor.value = otherColorInput.value.trim();\n      updateEstimate();\n    });\n\n    fileInput.addEventListener(\"change\", function () {\n      const file = fileInput.files[0];\n      if (!file) return;\n\n      fileName.textContent = file.name;\n      hiddenFileName.value = file.name;\n      updateEstimate();\n\n      if (file.type.startsWith(\"image/\")) {\n        const reader = new FileReader();\n\n        reader.onload = function (event) {\n          previewImg.src = event.target.result;\n          previewImg.style.display = \"block\";\n          designPrint.querySelector(\"span\").style.display = \"none\";\n        };\n\n        reader.readAsDataURL(file);\n      } else {\n        previewImg.style.display = \"none\";\n        designPrint.querySelector(\"span\").style.display = \"block\";\n      }\n    });\n\n    nextBtn.addEventListener(\"click\", function () {\n      if (!validateStep(currentStep)) return;\n      showStep(currentStep + 1);\n    });\n\n    prevBtn.addEventListener(\"click\", function () {\n      showStep(currentStep - 1);\n    });\n\n    form.addEventListener(\"submit\", function (event) {\n      for (let i = 1; i <= totalSteps; i++) {\n        if (!validateStep(i)) {\n          event.preventDefault();\n          showStep(i);\n          return;\n        }\n      }\n\n      updateSummary();\n    });\n\n    toggleOtherColorField();\n    updateEstimate();\n    showStep(1);\n  });\n</script>",
        "background_color": "{{ settings.color_palette.background }}",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
