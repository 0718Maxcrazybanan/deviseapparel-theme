    "custom_liquid_FqABND": {
      "type": "custom-liquid",
      "name": "popup",
      "settings": {
        "custom_liquid": "<div class=\"devise-email-popup\" id=\"deviseEmailPopup\" aria-hidden=\"true\">\n  <div class=\"devise-email-popup__overlay\" data-popup-close></div>\n\n  <div class=\"devise-email-popup__box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"devisePopupTitle\">\n    <button class=\"devise-email-popup__close\" type=\"button\" data-popup-close aria-label=\"Stäng popup\">\n      ×\n    </button>\n\n    <div class=\"devise-email-popup__badge\">\n      Tillfälligt Erbjudande\n    </div>\n\n    <h2 id=\"devisePopupTitle\">\n      Få 10% rabatt\n    </h2>\n\n    <p>\n      Skriv in din email och få en rabattkod skickad till dig.\n    </p>\n\n    {% form 'customer', id: 'devise-popup-newsletter-form', class: 'devise-email-popup__form' %}\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,popup_10_discount\">\n\n      {% if form.posted_successfully? %}\n        <div class=\"devise-email-popup__success\">\n          Tack! Kolla din inkorg för din rabattkod.\n        </div>\n      {% else %}\n        {% if form.errors %}\n          <div class=\"devise-email-popup__error\">\n            {{ form.errors | default_errors }}\n          </div>\n        {% endif %}\n\n        <div class=\"devise-email-popup__field\">\n          <input\n            type=\"email\"\n            name=\"contact[email]\"\n            id=\"devisePopupEmail\"\n            placeholder=\"din@email.se\"\n            required\n            autocomplete=\"email\"\n          >\n\n          <button type=\"submit\">\n            Få Rabattkod →\n          </button>\n        </div>\n\n        <small>\n          Ingen spam. Endast erbjudanden, drops och viktig info från DeviseApparel.\n        </small>\n      {% endif %}\n    {% endform %}\n  </div>\n</div>\n\n<style>\n  .devise-email-popup {\n    position: fixed;\n    inset: 0;\n    z-index: 99999;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    padding: 18px;\n    font-family: Inter, Arial, sans-serif;\n  }\n\n  .devise-email-popup.is-visible {\n    display: flex;\n  }\n\n  .devise-email-popup__overlay {\n    position: absolute;\n    inset: 0;\n    background: rgba(0,0,0,0.72);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n  }\n\n  .devise-email-popup__box {\n    position: relative;\n    width: min(100%, 455px);\n    background:\n      radial-gradient(circle at 18% 0%, rgba(255,222,89,0.18), transparent 34%),\n      linear-gradient(180deg, #151515 0%, #0D0D0D 100%);\n    border: 1px solid rgba(255,222,89,0.24);\n    border-radius: 26px;\n    padding: 34px;\n    color: #FFFFFF;\n    box-shadow:\n      0 34px 110px rgba(0,0,0,0.72),\n      0 0 46px rgba(255,222,89,0.10),\n      inset 0 1px 0 rgba(255,255,255,0.06);\n    transform: translateY(14px) scale(0.96);\n    opacity: 0;\n    animation: devisePopupIn 0.28s ease forwards;\n  }\n\n  @keyframes devisePopupIn {\n    to {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n    }\n  }\n\n  .devise-email-popup__close {\n    position: absolute;\n    top: 16px;\n    right: 16px;\n    width: 34px;\n    height: 34px;\n    border: 1px solid rgba(255,255,255,0.12);\n    border-radius: 999px;\n    background: rgba(255,255,255,0.04);\n    color: #FFFFFF;\n    font-size: 24px;\n    line-height: 1;\n    cursor: pointer;\n    transition: 0.18s ease;\n  }\n\n  .devise-email-popup__close:hover {\n    background: #FFDE59;\n    color: #0A0A0A;\n    border-color: #FFDE59;\n  }\n\n  .devise-email-popup__badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: #FFDE59;\n    color: #0A0A0A;\n    border-radius: 999px;\n    padding: 7px 13px;\n    font-size: 10px;\n    font-weight: 950;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-bottom: 16px;\n  }\n\n  .devise-email-popup h2 {\n    margin: 0;\n    font-size: clamp(34px, 6vw, 52px);\n    line-height: 0.96;\n    letter-spacing: -0.06em;\n    font-weight: 950;\n  }\n\n  .devise-email-popup p {\n    margin: 14px 0 22px;\n    color: #A0A0A0;\n    font-size: 15px;\n    line-height: 1.55;\n    font-weight: 550;\n  }\n\n  .devise-email-popup__field {\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: 10px;\n    background: #0A0A0A;\n    border: 1px solid rgba(255,255,255,0.14);\n    border-radius: 14px;\n    padding: 7px;\n  }\n\n  .devise-email-popup__field input {\n    min-width: 0;\n    height: 46px;\n    background: transparent;\n    border: 0;\n    outline: 0;\n    color: #FFFFFF;\n    font-family: inherit;\n    font-size: 14px;\n    padding: 0 10px;\n  }\n\n  .devise-email-popup__field input::placeholder {\n    color: #777777;\n  }\n\n  .devise-email-popup__field button {\n    height: 46px;\n    border: 0;\n    border-radius: 10px;\n    padding: 0 16px;\n    background: #FFDE59;\n    color: #0A0A0A;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 950;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: 0.2s ease;\n  }\n\n  .devise-email-popup__field button:hover {\n    background: #FFFFFF;\n    transform: translateY(-1px);\n  }\n\n  .devise-email-popup small {\n    display: block;\n    margin-top: 12px;\n    color: #777777;\n    font-size: 11px;\n    line-height: 1.45;\n    text-align: center;\n  }\n\n  .devise-email-popup__success {\n    background: rgba(255,222,89,0.12);\n    border: 1px solid rgba(255,222,89,0.35);\n    color: #FFDE59;\n    padding: 14px 16px;\n    border-radius: 12px;\n    font-size: 14px;\n    font-weight: 850;\n  }\n\n  .devise-email-popup__error {\n    background: rgba(239,68,68,0.10);\n    border: 1px solid rgba(239,68,68,0.35);\n    color: #EF4444;\n    padding: 12px 14px;\n    border-radius: 12px;\n    margin-bottom: 14px;\n    font-size: 13px;\n    font-weight: 750;\n  }\n\n  body.devise-popup-open {\n    overflow: hidden;\n  }\n\n  @media (max-width: 520px) {\n    .devise-email-popup__box {\n      padding: 26px 20px;\n      border-radius: 22px;\n    }\n\n    .devise-email-popup__field {\n      grid-template-columns: 1fr;\n    }\n\n    .devise-email-popup__field button {\n      width: 100%;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const popup = document.getElementById(\"deviseEmailPopup\");\n    if (!popup) return;\n\n    const storageKey = \"devise_email_popup_closed\";\n    const submittedKey = \"devise_email_popup_submitted\";\n    const delay = 1200;\n    const hideDays = 7;\n\n    function setWithExpiry(key, value, days) {\n      const now = new Date();\n      const item = {\n        value: value,\n        expiry: now.getTime() + days * 24 * 60 * 60 * 1000\n      };\n      localStorage.setItem(key, JSON.stringify(item));\n    }\n\n    function getWithExpiry(key) {\n      const itemStr = localStorage.getItem(key);\n      if (!itemStr) return null;\n\n      try {\n        const item = JSON.parse(itemStr);\n        const now = new Date();\n\n        if (now.getTime() > item.expiry) {\n          localStorage.removeItem(key);\n          return null;\n        }\n\n        return item.value;\n      } catch (e) {\n        localStorage.removeItem(key);\n        return null;\n      }\n    }\n\n    function openPopup() {\n      popup.classList.add(\"is-visible\");\n      popup.setAttribute(\"aria-hidden\", \"false\");\n      document.body.classList.add(\"devise-popup-open\");\n\n      const emailInput = document.getElementById(\"devisePopupEmail\");\n      if (emailInput) {\n        setTimeout(function () {\n          emailInput.focus();\n        }, 200);\n      }\n    }\n\n    function closePopup() {\n      popup.classList.remove(\"is-visible\");\n      popup.setAttribute(\"aria-hidden\", \"true\");\n      document.body.classList.remove(\"devise-popup-open\");\n      setWithExpiry(storageKey, \"true\", hideDays);\n    }\n\n    popup.querySelectorAll(\"[data-popup-close]\").forEach(function (button) {\n      button.addEventListener(\"click\", closePopup);\n    });\n\n    document.addEventListener(\"keydown\", function (event) {\n      if (event.key === \"Escape\" && popup.classList.contains(\"is-visible\")) {\n        closePopup();\n      }\n    });\n\n    const form = document.getElementById(\"devise-popup-newsletter-form\");\n    if (form) {\n      form.addEventListener(\"submit\", function () {\n        localStorage.setItem(submittedKey, \"true\");\n      });\n    }\n\n    const hasSubmitted = localStorage.getItem(submittedKey) === \"true\";\n    const hasClosed = getWithExpiry(storageKey) === \"true\";\n\n    {% if form.posted_successfully? %}\n      openPopup();\n      localStorage.setItem(submittedKey, \"true\");\n    {% else %}\n      if (!hasSubmitted && !hasClosed) {\n        setTimeout(openPopup, delay);\n      }\n    {% endif %}\n  });\n</script>",
