          </div>

          <div class="ai-custom-order-form__buttons-{{ ai_gen_id }}">
            <button type="button" class="ai-custom-order-form__button-{{ ai_gen_id }} ai-custom-order-form__button-secondary-{{ ai_gen_id }}" id="prev-step4-{{ ai_gen_id }}">
              Previous
            </button>
            <button type="submit" class="ai-custom-order-form__button-{{ ai_gen_id }}" id="submit-form-{{ ai_gen_id }}">
              Submit Order
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>

    <div class="ai-custom-order-form__buttons-{{ ai_gen_id }}" id="nav-buttons-{{ ai_gen_id }}">
      <button type="button" class="ai-custom-order-form__button-{{ ai_gen_id }} ai-custom-order-form__button-secondary-{{ ai_gen_id }}" id="prev-button-{{ ai_gen_id }}" style="display: none;">
        Previous
      </button>
      <button type="button" class="ai-custom-order-form__button-{{ ai_gen_id }}" id="next-button-{{ ai_gen_id }}">
        Next
      </button>
    </div>

    <div class="ai-custom-order-form__success-{{ ai_gen_id }}" id="success-message-{{ ai_gen_id }}">
      <div class="ai-custom-order-form__success-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
          <circle cx="32" cy="32" r="28" fill="none" stroke="currentColor" stroke-width="4"/>
          <path d="M20 32l8 8 16-16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 class="ai-custom-order-form__success-title-{{ ai_gen_id }}">Order Submitted!</h3>
      <p class="ai-custom-order-form__success-message-{{ ai_gen_id }}">Thank you for your custom order. We'll be in touch soon!</p>
    </div>
  </div>
</custom-order-form-{{ ai_gen_id }}>

<script>
(function() {
  class CustomOrderForm{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentStep = 1;
      this.formData = {
        garment: '',
        color: '',
        size: '',
        quantity: 1,
        printPlacement: '',
        designIdea: '',
        additionalNotes: ''
      };
    }

    connectedCallback() {
      this.setupEventListeners();
    }

    setupEventListeners() {
      const designIdea = this.querySelector('#design-idea-{{ ai_gen_id }}');
      const charCount = this.querySelector('#char-count-{{ ai_gen_id }}');
      
      if (designIdea && charCount) {
        designIdea.addEventListener('input', () => {
          charCount.textContent = designIdea.value.length;
          this.formData.designIdea = designIdea.value;
        });
      }

      const garmentCards = this.querySelectorAll('.ai-custom-order-form__garment-card-{{ ai_gen_id }}');
      garmentCards.forEach(card => {
        card.addEventListener('click', () => {
          garmentCards.forEach(c => c.classList.remove('selected'));
          card.classList.add('selected');
          this.formData.garment = card.dataset.garment;
          this.checkStep1AutoAdvance();
        });
      });

      const colorSwatches = this.querySelectorAll('.ai-custom-order-form__color-swatch-{{ ai_gen_id }}');
      colorSwatches.forEach(swatch => {
        swatch.addEventListener('click', () => {
          colorSwatches.forEach(s => s.classList.remove('selected'));
          swatch.classList.add('selected');
          this.formData.color = swatch.dataset.color;
        });
      });

      const sizeButtons = this.querySelectorAll('.ai-custom-order-form__size-button-{{ ai_gen_id }}');
      sizeButtons.forEach(button => {
        button.addEventListener('click', () => {
          sizeButtons.forEach(b => b.classList.remove('selected'));
          button.classList.add('selected');
          this.formData.size = button.dataset.size;
          this.checkStep1AutoAdvance();
        });
      });

      const fileUpload = this.querySelector('#file-upload-{{ ai_gen_id }}');
      const fileInput = this.querySelector('#file-input-{{ ai_gen_id }}');
      const filePreview = this.querySelector('#file-preview-{{ ai_gen_id }}');
      const previewImage = this.querySelector('#preview-image-{{ ai_gen_id }}');

      if (fileUpload && fileInput) {
        fileUpload.addEventListener('click', () => fileInput.click());
        
        fileInput.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = (event) => {
              if (previewImage && filePreview) {
                previewImage.src = event.target.result;
                filePreview.classList.add('active');
              }
            };
            reader.readAsDataURL(file);
          }
        });
      }

      const nextButton = this.querySelector('#next-button-{{ ai_gen_id }}');
      const prevButton = this.querySelector('#prev-button-{{ ai_gen_id }}');
      const prevStep4 = this.querySelector('#prev-step4-{{ ai_gen_id }}');

      if (nextButton) {
        nextButton.addEventListener('click', () => this.nextStep());
      }

      if (prevButton) {
        prevButton.addEventListener('click', () => this.prevStep());
      }

      if (prevStep4) {
        prevStep4.addEventListener('click', () => this.prevStep());
      }

      const quantity = this.querySelector('#quantity-{{ ai_gen_id }}');
      if (quantity) {
        quantity.addEventListener('change', () => {
          this.formData.quantity = parseInt(quantity.value) || 1;
        });
      }

      const printPlacement = this.querySelector('#print-placement-{{ ai_gen_id }}');
      if (printPlacement) {
        printPlacement.addEventListener('change', () => {
          this.formData.printPlacement = printPlacement.value;
        });
      }

      const additionalNotes = this.querySelector('#additional-notes-{{ ai_gen_id }}');
      if (additionalNotes) {
        additionalNotes.addEventListener('input', () => {
          this.formData.additionalNotes = additionalNotes.value;
        });
      }

      const form = this.querySelector('form');
      if (form) {
        form.addEventListener('submit', (e) => {
          if (!this.validateStep4()) {
            e.preventDefault();
            return;
          }
          this.populateFormFields();
        });
      }
    }

    checkStep1AutoAdvance() {
      if (this.formData.garment && this.formData.size) {
        setTimeout(() => {
          this.nextStep();
        }, 300);
      }
    }

    validateStep1() {
      const error = this.querySelector('#step1-error-{{ ai_gen_id }}');
      if (!this.formData.garment || !this.formData.size) {
        if (error) error.classList.add('active');
        return false;
      }
      if (error) error.classList.remove('active');
      return true;
    }

    validateStep2() {
      const error = this.querySelector('#step2-error-{{ ai_gen_id }}');
      const quantity = this.querySelector('#quantity-{{ ai_gen_id }}');
      if (!quantity || parseInt(quantity.value) < 1) {
        if (error) error.classList.add('active');
        return false;
      }
      if (error) error.classList.remove('active');
      return true;
    }

    validateStep3() {
      const error = this.querySelector('#step3-error-{{ ai_gen_id }}');
      if (!this.formData.printPlacement) {
        if (error) error.classList.add('active');
        return false;
      }
      if (error) error.classList.remove('active');
      return true;
    }

    validateStep4() {
      const error = this.querySelector('#step4-error-{{ ai_gen_id }}');
      const name = this.querySelector('#contact-name-{{ ai_gen_id }}');
      const email = this.querySelector('#contact-email-{{ ai_gen_id }}');
      
      if (!name || !email || !name.value || !email.value) {
        if (error) error.classList.add('active');
        return false;
      }
      if (error) error.classList.remove('active');
      return true;
    }

    nextStep() {
      if (this.currentStep === 1 && !this.validateStep1()) return;
      if (this.currentStep === 2 && !this.validateStep2()) return;
      if (this.currentStep === 3 && !this.validateStep3()) return;

      if (this.currentStep < 4) {
        this.currentStep++;
        this.updateStep();
      }
    }

    prevStep() {
      if (this.currentStep > 1) {
        this.currentStep--;
        this.updateStep();
      }
    }

    updateStep() {
      const steps = this.querySelectorAll('.ai-custom-order-form__step-{{ ai_gen_id }}');
      const progressSteps = this.querySelectorAll('.ai-custom-order-form__progress-step-{{ ai_gen_id }}');
      const prevButton = this.querySelector('#prev-button-{{ ai_gen_id }}');
      const nextButton = this.querySelector('#next-button-{{ ai_gen_id }}');
      const navButtons = this.querySelector('#nav-buttons-{{ ai_gen_id }}');

      steps.forEach((step, index) => {
        if (index + 1 === this.currentStep) {
          step.classList.add('active');
        } else {
          step.classList.remove('active');
        }
      });

      progressSteps.forEach((step, index) => {
        if (index + 1 <= this.currentStep) {
          step.classList.add('active');
        } else {
          step.classList.remove('active');
        }
      });

      if (prevButton) {
        prevButton.style.display = this.currentStep > 1 ? 'block' : 'none';
      }

      if (this.currentStep === 2) {
        this.updateStep2Summary();
      }

      if (this.currentStep === 4) {
        this.updateStep4Summary();
        if (navButtons) navButtons.style.display = 'none';
      } else {
        if (navButtons) navButtons.style.display = 'flex';
      }

      if (nextButton) {
        nextButton.style.display = this.currentStep < 4 ? 'block' : 'none';
      }
    }

    updateStep2Summary() {
      const summaryGarment = this.querySelector('#summary-garment-{{ ai_gen_id }}');
      const summaryColor = this.querySelector('#summary-color-{{ ai_gen_id }}');
      const summarySize = this.querySelector('#summary-size-{{ ai_gen_id }}');

      if (summaryGarment) summaryGarment.textContent = this.formData.garment || '-';
      if (summaryColor) summaryColor.textContent = this.formData.color || '-';
      if (summarySize) summarySize.textContent = this.formData.size || '-';
    }

    updateStep4Summary() {
      const finalGarment = this.querySelector('#final-garment-{{ ai_gen_id }}');
      const finalColor = this.querySelector('#final-color-{{ ai_gen_id }}');
      const finalSize = this.querySelector('#final-size-{{ ai_gen_id }}');
      const finalQuantity = this.querySelector('#final-quantity-{{ ai_gen_id }}');
      const finalPlacement = this.querySelector('#final-placement-{{ ai_gen_id }}');

      if (finalGarment) finalGarment.textContent = this.formData.garment || '-';
      if (finalColor) finalColor.textContent = this.formData.color || '-';
      if (finalSize) finalSize.textContent = this.formData.size || '-';
      if (finalQuantity) finalQuantity.textContent = this.formData.quantity || '-';
      if (finalPlacement) finalPlacement.textContent = this.formData.printPlacement || '-';
    }

    populateFormFields() {
      const formGarment = this.querySelector('#form-garment-{{ ai_gen_id }}');
      const formColor = this.querySelector('#form-color-{{ ai_gen_id }}');
      const formSize = this.querySelector('#form-size-{{ ai_gen_id }}');
      const formQuantity = this.querySelector('#form-quantity-{{ ai_gen_id }}');
      const formPlacement = this.querySelector('#form-placement-{{ ai_gen_id }}');
      const formDesign = this.querySelector('#form-design-{{ ai_gen_id }}');
      const formNotes = this.querySelector('#form-notes-{{ ai_gen_id }}');

      if (formGarment) formGarment.value = this.formData.garment;
      if (formColor) formColor.value = this.formData.color;
      if (formSize) formSize.value = this.formData.size;
      if (formQuantity) formQuantity.value = this.formData.quantity;
      if (formPlacement) formPlacement.value = this.formData.printPlacement;
      if (formDesign) formDesign.value = this.formData.designIdea;
      if (formNotes) formNotes.value = this.formData.additionalNotes;
    }
  }

  customElements.define('custom-order-form-{{ ai_gen_id }}', CustomOrderForm{{ ai_gen_id }});
})();
</script>

