        <div class="ai-custom-order-form__error-{{ ai_gen_id }}" id="step3-error-{{ ai_gen_id }}">
          Please select a print placement.
        </div>
      </div>

      <div class="ai-custom-order-form__step-{{ ai_gen_id }}" data-step="4">
        <h3 class="ai-custom-order-form__step-title-{{ ai_gen_id }}">Step 4: Contact Information</h3>
        
        <div class="ai-custom-order-form__summary-{{ ai_gen_id }}">
          <h4 class="ai-custom-order-form__summary-title-{{ ai_gen_id }}">Order Summary</h4>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Garment:</span>
            <span id="final-garment-{{ ai_gen_id }}">-</span>
          </div>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Color:</span>
            <span id="final-color-{{ ai_gen_id }}">-</span>
          </div>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Size:</span>
            <span id="final-size-{{ ai_gen_id }}">-</span>
          </div>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Quantity:</span>
            <span id="final-quantity-{{ ai_gen_id }}">-</span>
          </div>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Print Placement:</span>
            <span id="final-placement-{{ ai_gen_id }}">-</span>
          </div>
        </div>

        {%- form 'contact' -%}
          <input type="hidden" name="contact[order_type]" value="Custom Apparel Order">
          <input type="hidden" name="contact[garment]" id="form-garment-{{ ai_gen_id }}">
          <input type="hidden" name="contact[color]" id="form-color-{{ ai_gen_id }}">
          <input type="hidden" name="contact[size]" id="form-size-{{ ai_gen_id }}">
          <input type="hidden" name="contact[quantity]" id="form-quantity-{{ ai_gen_id }}">
          <input type="hidden" name="contact[print_placement]" id="form-placement-{{ ai_gen_id }}">
          <input type="hidden" name="contact[design_idea]" id="form-design-{{ ai_gen_id }}">
          <input type="hidden" name="contact[additional_notes]" id="form-notes-{{ ai_gen_id }}">

          <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
            <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Name</label>
            <input 
              type="text" 
              class="ai-custom-order-form__input-{{ ai_gen_id }}" 
              name="contact[name]"
              id="contact-name-{{ ai_gen_id }}"
              required
            >
