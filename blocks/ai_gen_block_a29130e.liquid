          <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
            <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Email</label>
            <input 
              type="email" 
              class="ai-custom-order-form__input-{{ ai_gen_id }}" 
              name="contact[email]"
              id="contact-email-{{ ai_gen_id }}"
              required
            >
