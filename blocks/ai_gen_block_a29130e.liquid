{% doc %}
  @prompt
    Complete a 4-step custom apparel order form block for a streetwear brand. Use black #0a0a0a background, gold #ffde59 accent, white text, Inter font. Step 1: text area for design idea with 500 char counter, 5 garment cards with SVG icons (Hoodie, T-Shirt, Zip Hoodie, Sweatshirt, Tank Top), 7 color swatches, 7 size buttons and file upload with preview. Auto-advance to step 2 when garment and size are both selected. Step 2: color and size confirmation plus quantity. Step 3: print placement and notes. Step 4: contact form with order summary and submit to Shopify contact form. Gold next and previous buttons. Validate each step before advancing. Mobile responsive.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-order-form-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: 40px 20px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .ai-custom-order-form__container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-custom-order-form__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-custom-order-form__title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 16px;
  }

  .ai-custom-order-form__subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    opacity: 0.8;
    margin: 0;
  }

  .ai-custom-order-form__progress-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-bottom: 40px;
    gap: 8px;
  }

  .ai-custom-order-form__progress-step-{{ ai_gen_id }} {
    flex: 1;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    transition: background-color 0.3s ease;
  }

  .ai-custom-order-form__progress-step-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.accent_color }};
  }

  .ai-custom-order-form__step-{{ ai_gen_id }} {
    display: none;
  }

  .ai-custom-order-form__step-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-custom-order-form__step-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 24px;
  }

  .ai-custom-order-form__field-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-custom-order-form__label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-custom-order-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    resize: vertical;
    min-height: 100px;
  }

  .ai-custom-order-form__textarea-{{ ai_gen_id }}::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .ai-custom-order-form__char-counter-{{ ai_gen_id }} {
    text-align: right;
    color: {{ block.settings.text_color }};
    font-size: 12px;
    margin-top: 4px;
    opacity: 0.7;
  }

  .ai-custom-order-form__garment-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }

  .ai-custom-order-form__garment-card-{{ ai_gen_id }} {
    background-color: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-custom-order-form__garment-card-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: {{ block.settings.accent_color }};
  }

  .ai-custom-order-form__garment-card-{{ ai_gen_id }}.selected {
    background-color: rgba(255, 222, 89, 0.1);
    border-color: {{ block.settings.accent_color }};
  }

  .ai-custom-order-form__garment-icon-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    margin: 0 auto 12px;
  }

  .ai-custom-order-form__garment-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.text_color }};
  }

  .ai-custom-order-form__garment-card-{{ ai_gen_id }}.selected .ai-custom-order-form__garment-icon-{{ ai_gen_id }} svg {
    fill: {{ block.settings.accent_color }};
  }

  .ai-custom-order-form__garment-name-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
  }

  .ai-custom-order-form__color-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-custom-order-form__color-swatch-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 3px solid transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-custom-order-form__color-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-custom-order-form__color-swatch-{{ ai_gen_id }}.selected {
    border-color: {{ block.settings.accent_color }};
    box-shadow: 0 0 0 2px {{ block.settings.background_color }}, 0 0 0 4px {{ block.settings.accent_color }};
  }

  .ai-custom-order-form__size-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-custom-order-form__size-button-{{ ai_gen_id }} {
    min-width: 60px;
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-custom-order-form__size-button-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: {{ block.settings.accent_color }};
  }

  .ai-custom-order-form__size-button-{{ ai_gen_id }}.selected {
    background-color: {{ block.settings.accent_color }};
    border-color: {{ block.settings.accent_color }};
    color: {{ block.settings.background_color }};
  }

  .ai-custom-order-form__file-upload-{{ ai_gen_id }} {
    border: 2px dashed rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    padding: 32px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-custom-order-form__file-upload-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.accent_color }};
    background-color: rgba(255, 255, 255, 0.05);
  }

  .ai-custom-order-form__file-input-{{ ai_gen_id }} {
    display: none;
  }

  .ai-custom-order-form__file-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-custom-order-form__file-preview-{{ ai_gen_id }} {
    margin-top: 16px;
    display: none;
  }

  .ai-custom-order-form__file-preview-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-custom-order-form__preview-image-{{ ai_gen_id }} {
    max-width: 200px;
    max-height: 200px;
    border-radius: 8px;
    margin: 0 auto;
  }

  .ai-custom-order-form__input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .ai-custom-order-form__input-{{ ai_gen_id }}::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .ai-custom-order-form__select-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .ai-custom-order-form__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    margin-top: 32px;
  }

  .ai-custom-order-form__button-{{ ai_gen_id }} {
    flex: 1;
    padding: 16px 32px;
    background-color: {{ block.settings.accent_color }};
    border: none;
    border-radius: 8px;
    color: {{ block.settings.background_color }};
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-custom-order-form__button-{{ ai_gen_id }}:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .ai-custom-order-form__button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .ai-custom-order-form__button-secondary-{{ ai_gen_id }} {
    background-color: rgba(255, 255, 255, 0.1);
    color: {{ block.settings.text_color }};
  }

  .ai-custom-order-form__summary-{{ ai_gen_id }} {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }

  .ai-custom-order-form__summary-title-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 16px;
  }

  .ai-custom-order-form__summary-item-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    margin-bottom: 8px;
  }

  .ai-custom-order-form__error-{{ ai_gen_id }} {
    color: #ff6b6b;
    font-size: 14px;
    margin-top: 8px;
    display: none;
  }

  .ai-custom-order-form__error-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-custom-order-form__success-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px;
    display: none;
  }

  .ai-custom-order-form__success-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-custom-order-form__success-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
  }

  .ai-custom-order-form__success-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.accent_color }};
  }

  .ai-custom-order-form__success-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 16px;
  }

  .ai-custom-order-form__success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-order-form-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-custom-order-form__title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-custom-order-form__garment-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 12px;
    }

    .ai-custom-order-form__garment-card-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-custom-order-form__garment-icon-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-custom-order-form__buttons-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<custom-order-form-{{ ai_gen_id }} class="ai-custom-order-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-order-form__container-{{ ai_gen_id }}">
    <div class="ai-custom-order-form__header-{{ ai_gen_id }}">
      <h2 class="ai-custom-order-form__title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h2>
      <p class="ai-custom-order-form__subtitle-{{ ai_gen_id }}">{{ block.settings.form_subtitle }}</p>
    </div>

    <div class="ai-custom-order-form__progress-{{ ai_gen_id }}">
      <div class="ai-custom-order-form__progress-step-{{ ai_gen_id }} active" data-step="1"></div>
      <div class="ai-custom-order-form__progress-step-{{ ai_gen_id }}" data-step="2"></div>
      <div class="ai-custom-order-form__progress-step-{{ ai_gen_id }}" data-step="3"></div>
      <div class="ai-custom-order-form__progress-step-{{ ai_gen_id }}" data-step="4"></div>
    </div>

    <div class="ai-custom-order-form__steps-{{ ai_gen_id }}">
      <div class="ai-custom-order-form__step-{{ ai_gen_id }} active" data-step="1">
        <h3 class="ai-custom-order-form__step-title-{{ ai_gen_id }}">Step 1: Design Details</h3>
        
        <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
          <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Describe your design idea</label>
          <textarea 
            class="ai-custom-order-form__textarea-{{ ai_gen_id }}" 
            id="design-idea-{{ ai_gen_id }}"
            maxlength="500"
            placeholder="Tell us about your custom design..."
          ></textarea>
          <div class="ai-custom-order-form__char-counter-{{ ai_gen_id }}">
            <span id="char-count-{{ ai_gen_id }}">0</span>/500
          </div>
        </div>

        <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
          <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Select garment type</label>
          <div class="ai-custom-order-form__garment-grid-{{ ai_gen_id }}">
            <div class="ai-custom-order-form__garment-card-{{ ai_gen_id }}" data-garment="hoodie">
              <div class="ai-custom-order-form__garment-icon-{{ ai_gen_id }}">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                  <path d="M32 8c-4 0-8 2-10 6L8 20v24h8V28l8-4v32h24V24l8 4v16h8V20L42 14c-2-4-6-6-10-6zm0 4c2.5 0 4.5 1.5 6 4l10 4v12h-4V24l-10-5v30H30V19l-10 5v8h-4V16l10-4c1.5-2.5 3.5-4 6-4z"/>
                </svg>
              </div>
              <div class="ai-custom-order-form__garment-name-{{ ai_gen_id }}">Hoodie</div>
            </div>
            <div class="ai-custom-order-form__garment-card-{{ ai_gen_id }}" data-garment="tshirt">
              <div class="ai-custom-order-form__garment-icon-{{ ai_gen_id }}">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                  <path d="M32 8L20 14l-12 6v12h8V24l8-4v36h24V20l8 4v8h8V20l-12-6L32 8zm0 4l8 4 8 4v6h-4v-6l-10-5v34H30V15l-10 5v6h-4v-6l8-4 8-4z"/>
                </svg>
              </div>
              <div class="ai-custom-order-form__garment-name-{{ ai_gen_id }}">T-Shirt</div>
            </div>
            <div class="ai-custom-order-form__garment-card-{{ ai_gen_id }}" data-garment="ziphoodie">
              <div class="ai-custom-order-form__garment-icon-{{ ai_gen_id }}">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                  <path d="M32 8c-4 0-8 2-10 6L8 20v24h8V28l8-4v32h8V24h-2V16h4v8h-2v32h8V24l8 4v16h8V20L42 14c-2-4-6-6-10-6zm0 4c2.5 0 4.5 1.5 6 4l10 4v12h-4V24l-10-5v2h-4v-2l-10 5v8h-4V16l10-4c1.5-2.5 3.5-4 6-4z"/>
                </svg>
              </div>
              <div class="ai-custom-order-form__garment-name-{{ ai_gen_id }}">Zip Hoodie</div>
            </div>
            <div class="ai-custom-order-form__garment-card-{{ ai_gen_id }}" data-garment="sweatshirt">
              <div class="ai-custom-order-form__garment-icon-{{ ai_gen_id }}">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                  <path d="M32 10c-3 0-6 1.5-8 4L12 18v20h6V24l8-3v31h20V21l8 3v14h6V18L48 14c-2-2.5-5-4-8-4h-8zm0 4h8c2 0 3.5 1 5 2.5l10 3.5v10h-2V22l-10-4v32H26V18l-10 4v8h-2v-10l10-3.5c1.5-1.5 3-2.5 5-2.5h3z"/>
                </svg>
              </div>
              <div class="ai-custom-order-form__garment-name-{{ ai_gen_id }}">Sweatshirt</div>
            </div>
            <div class="ai-custom-order-form__garment-card-{{ ai_gen_id }}" data-garment="tanktop">
              <div class="ai-custom-order-form__garment-icon-{{ ai_gen_id }}">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28 8v8h8V8l8 4v44H20V12l8-4zm4 4v4h-4v-4h4zm-8 4v40h16V16H24z"/>
                </svg>
              </div>
              <div class="ai-custom-order-form__garment-name-{{ ai_gen_id }}">Tank Top</div>
            </div>
          </div>
        </div>

        <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
          <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Select color</label>
          <div class="ai-custom-order-form__color-swatches-{{ ai_gen_id }}">
            <div class="ai-custom-order-form__color-swatch-{{ ai_gen_id }}" data-color="Black" style="background-color: #000000;"></div>
            <div class="ai-custom-order-form__color-swatch-{{ ai_gen_id }}" data-color="White" style="background-color: #FFFFFF;"></div>
            <div class="ai-custom-order-form__color-swatch-{{ ai_gen_id }}" data-color="Navy" style="background-color: #001f3f;"></div>
            <div class="ai-custom-order-form__color-swatch-{{ ai_gen_id }}" data-color="Gray" style="background-color: #808080;"></div>
            <div class="ai-custom-order-form__color-swatch-{{ ai_gen_id }}" data-color="Red" style="background-color: #FF4136;"></div>
            <div class="ai-custom-order-form__color-swatch-{{ ai_gen_id }}" data-color="Green" style="background-color: #2ECC40;"></div>
            <div class="ai-custom-order-form__color-swatch-{{ ai_gen_id }}" data-color="Blue" style="background-color: #0074D9;"></div>
          </div>
        </div>

        <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
          <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Select size</label>
          <div class="ai-custom-order-form__size-buttons-{{ ai_gen_id }}">
            <button type="button" class="ai-custom-order-form__size-button-{{ ai_gen_id }}" data-size="XS">XS</button>
            <button type="button" class="ai-custom-order-form__size-button-{{ ai_gen_id }}" data-size="S">S</button>
            <button type="button" class="ai-custom-order-form__size-button-{{ ai_gen_id }}" data-size="M">M</button>
            <button type="button" class="ai-custom-order-form__size-button-{{ ai_gen_id }}" data-size="L">L</button>
            <button type="button" class="ai-custom-order-form__size-button-{{ ai_gen_id }}" data-size="XL">XL</button>
            <button type="button" class="ai-custom-order-form__size-button-{{ ai_gen_id }}" data-size="XXL">XXL</button>
            <button type="button" class="ai-custom-order-form__size-button-{{ ai_gen_id }}" data-size="XXXL">XXXL</button>
          </div>
        </div>

        <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
          <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Upload design file (optional)</label>
          <div class="ai-custom-order-form__file-upload-{{ ai_gen_id }}" id="file-upload-{{ ai_gen_id }}">
            <input type="file" class="ai-custom-order-form__file-input-{{ ai_gen_id }}" id="file-input-{{ ai_gen_id }}" accept="image/*">
            <div class="ai-custom-order-form__file-label-{{ ai_gen_id }}">Click to upload or drag and drop</div>
          </div>
          <div class="ai-custom-order-form__file-preview-{{ ai_gen_id }}" id="file-preview-{{ ai_gen_id }}">
            <img class="ai-custom-order-form__preview-image-{{ ai_gen_id }}" id="preview-image-{{ ai_gen_id }}" alt="Preview">
          </div>
        </div>

        <div class="ai-custom-order-form__error-{{ ai_gen_id }}" id="step1-error-{{ ai_gen_id }}">
          Please select both a garment type and size to continue.
        </div>
      </div>

      <div class="ai-custom-order-form__step-{{ ai_gen_id }}" data-step="2">
        <h3 class="ai-custom-order-form__step-title-{{ ai_gen_id }}">Step 2: Confirm Selection</h3>
        
        <div class="ai-custom-order-form__summary-{{ ai_gen_id }}">
          <h4 class="ai-custom-order-form__summary-title-{{ ai_gen_id }}">Your Selection</h4>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Garment:</span>
            <span id="summary-garment-{{ ai_gen_id }}">-</span>
          </div>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Color:</span>
            <span id="summary-color-{{ ai_gen_id }}">-</span>
          </div>
          <div class="ai-custom-order-form__summary-item-{{ ai_gen_id }}">
            <span>Size:</span>
            <span id="summary-size-{{ ai_gen_id }}">-</span>
          </div>
        </div>

        <div class="ai-custom-order-form__field-{{ ai_gen_id }}">
          <label class="ai-custom-order-form__label-{{ ai_gen_id }}">Quantity</label>
          <input type="number" class="ai-custom-order-form__input-{{ ai_gen_id }}" id="quantity-{{ ai_gen_id }}" min="1" value="1">
        </div>

        <div class="ai-custom-order-form__error-{{ ai_gen_id }}" id="step2-error-{{ ai_gen_id }}">
          Please enter a valid quantity (minimum 1).
        </div>
      </div>

      <div class="ai-custom-order-form__step-{{ ai_gen_id }}" data-step="3">
        <h3 class="ai-custom-order-form__step-title-{{ ai_gen_id }}">Step 3: Print Details</h3>
        
