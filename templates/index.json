    "custom_liquid_GyfDyp": {
      "type": "custom-liquid",
      "name": "Design showcase",
      "settings": {
        "custom_liquid": "{% comment %}\n  =====================================================\n  ÄNDRA DESSA TVÅ LÄNKAR\n  =====================================================\n{% endcomment %}\n\n{% assign devise_editorial_image_url = 'https://cdn.shopify.com/s/files/1/1008/9958/6435/files/Skarmbild_2026-07-14_200137.png?v=1784052328' %}\n{% assign devise_editorial_button_url = '/pages/contact' %}\n\n{% assign devise_editorial_image_alt = 'Designverktyg för att skapa en egen tröja' %}\n{% assign devise_editorial_id = section.id | default: 'devise-editorial-v4' %}\n\n\n<section\n  id=\"DeviseEditorial-{{ devise_editorial_id }}\"\n  class=\"devise-editorial-v4\"\n>\n  <div class=\"devise-editorial-v4__shell\">\n\n    <div class=\"devise-editorial-v4__media devise-editorial-v4__reveal\">\n      <div class=\"devise-editorial-v4__image-frame\">\n\n        {% unless devise_editorial_image_url == blank\n          or devise_editorial_image_url == 'KLISTRA_IN_DIN_SHOPIFY_BILDLANK_HÄR'\n        %}\n\n          <img\n            class=\"devise-editorial-v4__image\"\n            src=\"{{ devise_editorial_image_url | escape }}\"\n            alt=\"{{ devise_editorial_image_alt | escape }}\"\n            width=\"1600\"\n            height=\"1000\"\n            loading=\"lazy\"\n            decoding=\"async\"\n          >\n\n        {% else %}\n\n          <div class=\"devise-editorial-v4__placeholder\">\n            Lägg in bildlänken högst upp i koden\n          </div>\n\n        {% endunless %}\n\n      </div>\n    </div>\n\n\n    <div class=\"devise-editorial-v4__content\">\n\n      <p class=\"devise-editorial-v4__eyebrow devise-editorial-v4__reveal\">\n        Designa själv\n      </p>\n\n      <h2 class=\"devise-editorial-v4__title devise-editorial-v4__reveal\">\n        Designa din egen tröja\n      </h2>\n\n      <p class=\"devise-editorial-v4__description devise-editorial-v4__reveal\">\n        Skapa en tröja som är helt din egen. Lägg till text och bilder\n        och forma designen precis som du vill.\n      </p>\n\n      <div\n        class=\"devise-editorial-v4__steps devise-editorial-v4__reveal\"\n        aria-label=\"Välj produkt, designa och beställ\"\n      >\n        <span class=\"devise-editorial-v4__step\">Välj produkt</span>\n\n        <svg\n          class=\"devise-editorial-v4__step-arrow\"\n          viewBox=\"0 0 20 20\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <path\n            d=\"M4 10h10M10 6l4 4-4 4\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.9\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          ></path>\n        </svg>\n\n        <span class=\"devise-editorial-v4__step\">Designa</span>\n\n        <svg\n          class=\"devise-editorial-v4__step-arrow\"\n          viewBox=\"0 0 20 20\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <path\n            d=\"M4 10h10M10 6l4 4-4 4\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.9\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          ></path>\n        </svg>\n\n        <span class=\"devise-editorial-v4__step\">Beställ</span>\n      </div>\n\n      <a\n        class=\"\n          devise-editorial-v4__button\n          devise-editorial-v4__button--desktop\n          devise-editorial-v4__reveal\n        \"\n        href=\"{{ devise_editorial_button_url }}\"\n      >\n        <span>Designa</span>\n\n        <svg\n          viewBox=\"0 0 24 24\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <path\n            d=\"M5 12h14M13 6l6 6-6 6\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          ></path>\n        </svg>\n      </a>\n\n    </div>\n\n\n    <div class=\"devise-editorial-v4__mobile-cta devise-editorial-v4__reveal\">\n\n      <div\n        class=\"\n          devise-editorial-v4__steps\n          devise-editorial-v4__steps--mobile\n        \"\n        aria-label=\"Välj produkt, designa och beställ\"\n      >\n        <span class=\"devise-editorial-v4__step\">Välj produkt</span>\n\n        <svg\n          class=\"devise-editorial-v4__step-arrow\"\n          viewBox=\"0 0 20 20\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <path\n            d=\"M4 10h10M10 6l4 4-4 4\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.9\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          ></path>\n        </svg>\n\n        <span class=\"devise-editorial-v4__step\">Designa</span>\n\n        <svg\n          class=\"devise-editorial-v4__step-arrow\"\n          viewBox=\"0 0 20 20\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <path\n            d=\"M4 10h10M10 6l4 4-4 4\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.9\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          ></path>\n        </svg>\n\n        <span class=\"devise-editorial-v4__step\">Beställ</span>\n      </div>\n\n      <a\n        class=\"\n          devise-editorial-v4__button\n          devise-editorial-v4__button--mobile\n        \"\n        href=\"{{ devise_editorial_button_url }}\"\n      >\n        <span>Handla nu</span>\n\n        <svg\n          viewBox=\"0 0 24 24\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <path\n            d=\"M5 12h14M13 6l6 6-6 6\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          ></path>\n        </svg>\n      </a>\n\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n  #DeviseEditorial-{{ devise_editorial_id }} {\n    --devise-black: #080808;\n    --devise-white: #ffffff;\n    --devise-yellow: #ffde59;\n    --devise-muted-text: rgba(255, 255, 255, 0.82);\n    --devise-dark-border: rgba(255, 255, 255, 0.16);\n    --devise-soft-line: rgba(255, 255, 255, 0.08);\n\n    width: 100%;\n    overflow: hidden;\n\n    padding:\n      clamp(34px, 4.2vw, 64px)\n      clamp(12px, 2.6vw, 34px);\n\n    background: var(--devise-white);\n    color: var(--devise-white);\n\n    font-family: inherit;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }} *,\n  #DeviseEditorial-{{ devise_editorial_id }} *::before,\n  #DeviseEditorial-{{ devise_editorial_id }} *::after {\n    box-sizing: border-box;\n  }\n\n  /*\n    =====================================================\n    HUVUDLAYOUT\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__shell {\n    display: grid;\n\n    grid-template-columns:\n      minmax(0, 1.24fr)\n      minmax(430px, 0.76fr);\n\n    grid-template-areas:\n      \"media content\";\n\n    width: min(1460px, 100%);\n    min-height: clamp(470px, 39vw, 620px);\n\n    margin: 0 auto;\n    overflow: hidden;\n\n    border: 1px solid var(--devise-black);\n    background: var(--devise-black);\n\n    box-shadow:\n      9px 9px 0 #d8b900;\n  }\n\n  /*\n    =====================================================\n    BILDDEL\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__media {\n    grid-area: media;\n\n    display: grid;\n    place-items: center;\n\n    min-width: 0;\n    overflow: hidden;\n\n    padding:\n      clamp(14px, 1.4vw, 18px);\n\n    background: var(--devise-black);\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__image-frame {\n    position: relative;\n\n    display: grid;\n    place-items: center;\n\n    width: 100%;\n    height: 100%;\n    min-height: 420px;\n\n    overflow: hidden;\n\n    border: 1px solid #000000;\n    background: #000000;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__image-frame::after {\n    content: \"\";\n\n    position: absolute;\n    inset: 0;\n\n    box-shadow:\n      inset 0 0 0 1px\n      rgba(255, 255, 255, 0.04);\n\n    pointer-events: none;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__image {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n    max-height: 590px;\n\n    object-fit: contain;\n    object-position: center;\n\n    background: #000000;\n\n    transform: scale(1.01);\n\n    transition:\n      transform 1.15s\n      cubic-bezier(0.16, 1, 0.3, 1),\n      filter 1.15s ease;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__placeholder {\n    display: grid;\n    place-items: center;\n\n    width: 100%;\n    min-height: 420px;\n\n    padding: 30px;\n\n    background: #ffffff;\n    color: #555555;\n\n    font-size: 14px;\n    font-weight: 750;\n    text-align: center;\n  }\n\n  /*\n    =====================================================\n    TEXTDEL\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__content {\n    grid-area: content;\n\n    position: relative;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: flex-start;\n\n    min-width: 0;\n    overflow: hidden;\n\n    padding:\n      clamp(36px, 3.8vw, 52px)\n      clamp(34px, 3.8vw, 54px);\n\n    background: var(--devise-black);\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__content::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: 0;\n    top: 20px;\n    bottom: 20px;\n\n    width: 1px;\n\n    background: var(--devise-soft-line);\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__content::after {\n    content: \"\";\n\n    position: absolute;\n\n    right: -72px;\n    bottom: -72px;\n\n    width: 180px;\n    height: 180px;\n\n    border:\n      1px solid\n      rgba(255, 222, 89, 0.20);\n\n    border-radius: 50%;\n\n    box-shadow:\n      0 0 0 28px\n      rgba(255, 222, 89, 0.04),\n      0 0 0 56px\n      rgba(255, 222, 89, 0.02);\n\n    pointer-events: none;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__eyebrow {\n    position: relative;\n    z-index: 1;\n\n    display: inline-flex;\n    align-items: center;\n\n    gap: 10px;\n\n    margin: 0 0 14px;\n\n    color: var(--devise-yellow);\n\n    font-size: 11px;\n    font-weight: 900;\n    line-height: 1;\n\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__eyebrow::before {\n    content: \"\";\n\n    width: 32px;\n    height: 2px;\n\n    background: currentColor;\n  }\n\n  /*\n    Rubriken får nu brytas inom textpanelen.\n    Det gör att hela rubriken alltid syns på dator.\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__title {\n    position: relative;\n    z-index: 1;\n\n    width: 100%;\n    max-width: 100%;\n\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size:\n      clamp(34px, 3.55vw, 58px);\n\n    font-weight: 900;\n    font-style: italic;\n\n    line-height: 0.96;\n    letter-spacing: -0.055em;\n\n    white-space: normal;\n    overflow-wrap: normal;\n    word-break: normal;\n    text-wrap: balance;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__description {\n    position: relative;\n    z-index: 1;\n\n    max-width: 31rem;\n\n    margin: 22px 0 0;\n\n    color: var(--devise-muted-text);\n\n    font-size:\n      clamp(15px, 1.05vw, 18px);\n\n    line-height: 1.55;\n  }\n\n  /*\n    =====================================================\n    PROCESSRAD\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__steps {\n    position: relative;\n    z-index: 1;\n\n    display: inline-flex;\n    flex-wrap: wrap;\n    align-items: center;\n\n    gap: 10px;\n\n    margin-top: 26px;\n    padding: 10px 14px;\n\n    border:\n      1px solid\n      var(--devise-dark-border);\n\n    background:\n      rgba(255, 255, 255, 0.03);\n\n    color: #ffffff;\n\n    font-size: 13px;\n    font-weight: 800;\n    line-height: 1;\n\n    -webkit-font-smoothing: antialiased;\n    text-rendering: geometricPrecision;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__step {\n    display: inline-flex;\n    align-items: center;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__step-arrow {\n    width: 14px;\n    height: 14px;\n\n    flex: 0 0 auto;\n\n    color: var(--devise-yellow);\n  }\n\n  /*\n    =====================================================\n    KNAPP\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__button {\n    position: relative;\n    z-index: 1;\n    isolation: isolate;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 11px;\n\n    min-width: 168px;\n    min-height: 54px;\n\n    margin-top: 18px;\n    padding: 0 24px;\n\n    overflow: hidden;\n\n    border:\n      1px solid\n      var(--devise-yellow);\n\n    background: var(--devise-yellow);\n    color: #090909;\n\n    font-size: 15px;\n    font-weight: 900;\n    line-height: 1;\n\n    text-decoration: none;\n\n    transition:\n      color 0.35s ease,\n      transform 0.35s\n      cubic-bezier(0.16, 1, 0.3, 1),\n      box-shadow 0.35s ease;\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__button::before {\n    content: \"\";\n\n    position: absolute;\n    z-index: 0;\n\n    ins