    "custom_liquid_hacJyt": {
      "type": "custom-liquid",
      "name": "Shirt showcase",
      "settings": {
        "custom_liquid": "{% comment %}\n  =====================================================\n  ÄNDRA DESSA FYRA VÄRDEN\n  =====================================================\n\n  Produktens handle är den sista delen av produktens URL.\n\n  Exempel:\n  /products/schizophrenic-and-strapped?variant=58441926541699\n  Handle: systembolaget-t-shirt\n{% endcomment %}\n\n{% assign devise_ready_collection_url = '/collections/frontpage' %}\n\n{% assign devise_ready_product_1_handle = 'schizophrenic-and-strapped' %}\n{% assign devise_ready_product_2_handle = 'STAMMIS' %}\n{% assign devise_ready_product_3_handle = 'OFFICER' %}\n\n\n{% comment %}\n  =====================================================\n  TEXTER OCH PRODUKTER\n  =====================================================\n{% endcomment %}\n\n{% assign devise_ready_eyebrow = 'Färdiga tröjor' %}\n{% assign devise_ready_heading = 'Tröjor som vänder blickar' %}\n\n{% assign devise_ready_description = 'Färdiga motiv för dig som vill sticka ut. Satiriska och lätt provocerande tryck för fester, svensexor, kompisresor och kvällar som inte behöver tas så seriöst.' %}\n\n{% assign devise_ready_product_1 = all_products[devise_ready_product_1_handle] %}\n{% assign devise_ready_product_2 = all_products[devise_ready_product_2_handle] %}\n{% assign devise_ready_product_3 = all_products[devise_ready_product_3_handle] %}\n\n{% assign devise_ready_id = section.id | default: 'devise-readywear' %}\n\n\n<section\n  id=\"DeviseReadywear-{{ devise_ready_id }}\"\n  class=\"devise-readywear\"\n  data-devise-readywear\n>\n  <div class=\"devise-readywear__shell\">\n\n    {% comment %}\n      =====================================================\n      INTRODUKTION\n      =====================================================\n    {% endcomment %}\n\n    <header class=\"devise-readywear__header\">\n\n      <div class=\"devise-readywear__intro devise-readywear__reveal\">\n\n        <p class=\"devise-readywear__eyebrow\">\n          {{ devise_ready_eyebrow }}\n        </p>\n\n        <h2 class=\"devise-readywear__heading\">\n          {{ devise_ready_heading }}\n        </h2>\n\n      </div>\n\n\n      <div class=\"devise-readywear__summary devise-readywear__reveal\">\n\n        <p>\n          {{ devise_ready_description }}\n        </p>\n\n        <a\n          class=\"devise-readywear__collection-link\"\n          href=\"{{ devise_ready_collection_url }}\"\n        >\n          <span>Se alla färdiga tröjor</span>\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            aria-hidden=\"true\"\n            focusable=\"false\"\n          >\n            <path\n              d=\"M5 12h14M13 6l6 6-6 6\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            ></path>\n          </svg>\n        </a>\n\n      </div>\n\n    </header>\n\n\n    {% comment %}\n      =====================================================\n      PRODUKTUPPLÄGG\n      =====================================================\n    {% endcomment %}\n\n    <div class=\"devise-readywear__layout\">\n\n      {% comment %}\n        =====================================================\n        STOR UTVALD PRODUKT\n        =====================================================\n      {% endcomment %}\n\n      {% if devise_ready_product_1 != blank %}\n\n        {% assign devise_ready_description_1 = devise_ready_product_1.description | strip_html | strip | truncatewords: 19 %}\n\n        <article\n          class=\"\n            devise-readywear__card\n            devise-readywear__card--featured\n            devise-readywear__reveal\n          \"\n        >\n\n          <a\n            class=\"devise-readywear__media\"\n            href=\"{{ devise_ready_product_1.url }}\"\n            aria-label=\"Visa {{ devise_ready_product_1.title | escape }}\"\n          >\n\n            {% if devise_ready_product_1.featured_image %}\n\n              <img\n                src=\"{{ devise_ready_product_1.featured_image | image_url: width: 1400 }}\"\n                srcset=\"\n                  {{ devise_ready_product_1.featured_image | image_url: width: 500 }} 500w,\n                  {{ devise_ready_product_1.featured_image | image_url: width: 800 }} 800w,\n                  {{ devise_ready_product_1.featured_image | image_url: width: 1100 }} 1100w,\n                  {{ devise_ready_product_1.featured_image | image_url: width: 1400 }} 1400w\n                \"\n                sizes=\"\n                  (max-width: 760px) calc(100vw - 48px),\n                  (max-width: 1050px) calc(100vw - 80px),\n                  56vw\n                \"\n                alt=\"{{ devise_ready_product_1.featured_image.alt | default: devise_ready_product_1.title | escape }}\"\n                width=\"{{ devise_ready_product_1.featured_image.width }}\"\n                height=\"{{ devise_ready_product_1.featured_image.height }}\"\n                loading=\"lazy\"\n                decoding=\"async\"\n              >\n\n            {% endif %}\n\n            <span class=\"devise-readywear__number\">\n              01\n            </span>\n\n            <span class=\"devise-readywear__image-label\">\n              Utvald\n            </span>\n\n          </a>\n\n\n          <div class=\"devise-readywear__featured-info\">\n\n            <div class=\"devise-readywear__product-copy\">\n\n              <p class=\"devise-readywear__category\">\n                Färdig design\n              </p>\n\n              <h3>\n                <a href=\"{{ devise_ready_product_1.url }}\">\n                  {{ devise_ready_product_1.title }}\n                </a>\n              </h3>\n\n              {% if devise_ready_description_1 != blank %}\n\n                <p class=\"devise-readywear__product-description\">\n                  {{ devise_ready_description_1 }}\n                </p>\n\n              {%