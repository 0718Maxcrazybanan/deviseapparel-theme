    "custom_liquid_GyfDyp": {
      "type": "custom-liquid",
      "name": "Design showcase",
      "settings": {
        "custom_liquid": "{% comment %}\n  =====================================================\n  ÄNDRA ENDAST DESSA LÄNKAR\n  =====================================================\n{% endcomment %}\n\n{% assign devise_editorial_image_url = 'https://cdn.shopify.com/s/files/1/1008/9958/6435/files/Skarmbild_2026-07-14_200137.png?v=1784052328' %}\n{% assign devise_editorial_button_url = '/collections/all' %}\n\n{% comment %}\n  Bildlänken hämtar du från:\n  Shopify → Innehåll → Filer → kopiera länk\n\n  Knappens länk kan exempelvis vara:\n  /collections/all\n  /collections/designa-sjalv\n  /products/din-produkt\n{% endcomment %}\n\n\n{% comment %}\n  =====================================================\n  ÖVRIGA INSTÄLLNINGAR\n  =====================================================\n{% endcomment %}\n\n{% assign devise_editorial_image_alt = 'Designverktyg för att skapa en egen tröja' %}\n\n{% assign devise_editorial_background = '#EEF1EA' %}\n{% assign devise_editorial_text_panel = '#0A0A0A' %}\n{% assign devise_editorial_image_background = '#E4E7DF' %}\n{% assign devise_editorial_accent = '#FFDE59' %}\n{% assign devise_editorial_accent_hover = '#F0C928' %}\n{% assign devise_editorial_border = '#0A0A0A' %}\n\n{% assign devise_editorial_id = section.id | default: 'devise-editorial' %}\n\n\n<section\n  id=\"DeviseEditorial-{{ devise_editorial_id }}\"\n  class=\"devise-editorial\"\n  data-devise-editorial\n>\n  <div class=\"devise-editorial__shell\">\n\n    {% comment %}\n      =====================================================\n      BILD\n      =====================================================\n    {% endcomment %}\n\n    <div class=\"devise-editorial__media\">\n\n      <div class=\"devise-editorial__image-wrap\">\n\n        {% unless devise_editorial_image_url == blank\n          or devise_editorial_image_url == 'KListra_IN_DIN_SHOPIFY_BILDLANK_HAR'\n        %}\n\n          <img\n            class=\"devise-editorial__image\"\n            src=\"{{ devise_editorial_image_url | escape }}\"\n            alt=\"{{ devise_editorial_image_alt | escape }}\"\n            width=\"1600\"\n            height=\"1000\"\n            loading=\"lazy\"\n            decoding=\"async\"\n          >\n\n        {% else %}\n\n          <div class=\"devise-editorial__placeholder\">\n            Lägg in bildlänken högst upp i koden\n          </div>\n\n        {% endunless %}\n\n      </div>\n\n    </div>\n\n\n    {% comment %}\n      =====================================================\n      TEXT OCH KNAPP\n      =====================================================\n    {% endcomment %}\n\n    <div class=\"devise-editorial__content\">\n\n      <p class=\"devise-editorial__eyebrow\">\n        Designa Själv\n      </p>\n\n      <h2 class=\"devise-editorial__title\">\n        Designa Din Egna Tröja\n      </h2>\n\n      <p class=\"devise-editorial__description\">\n        Våran Hemsida erbjuder möjligheten att designa din egna tröja,\n        där du skapar exakt det du vill bära!\n        <br>\n        Med stor variation av redigeringsverktyg.\n      </p>\n\n      <div\n        class=\"devise-editorial__steps\"\n        aria-label=\"Välj Produkt, Designa, Beställ\"\n      >\n        <span>Välj Produkt</span>\n\n        <span\n          class=\"devise-editorial__steps-arrow\"\n          aria-hidden=\"true\"\n        >\n          →\n        </span>\n\n        <span>Designa</span>\n\n        <span\n          class=\"devise-editorial__steps-arrow\"\n          aria-hidden=\"true\"\n        >\n          →\n        </span>\n\n        <span>Beställ</span>\n      </div>\n\n      <a\n        class=\"devise-editorial__button\"\n        href=\"{{ devise_editorial_button_url }}\"\n      >\n        <span>Handla nu</span>\n\n        <svg\n          viewBox=\"0 0 24 24\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <path\n            d=\"M5 12h14M13 6l6 6-6 6\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          ></path>\n        </svg>\n      </a>\n\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n  #DeviseEditorial-{{ devise_editorial_id }} {\n    --devise-editorial-background:\n      {{ devise_editorial_background }};\n\n    --devise-editorial-panel:\n      {{ devise_editorial_text_panel }};\n\n    --devise-editorial-media:\n      {{ devise_editorial_image_background }};\n\n    --devise-editorial-accent:\n      {{ devise_editorial_accent }};\n\n    --devise-editorial-accent-hover:\n      {{ devise_editorial_accent_hover }};\n\n    --devise-editorial-border:\n      {{ devise_editorial_border }};\n\n    position: relative;\n    isolation: isolate;\n\n    width: 100%;\n    overflow: hidden;\n\n    padding:\n      clamp(48px, 6vw, 92px)\n      clamp(12px, 3vw, 48px);\n\n    background:\n      var(--devise-editorial-background);\n\n    color: var(--devise-editorial-border);\n\n    font-family:\n      Inter,\n      Arial,\n      sans-serif;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }} *,\n  #DeviseEditorial-{{ devise_editorial_id }} *::before,\n  #DeviseEditorial-{{ devise_editorial_id }} *::after {\n    box-sizing: border-box;\n  }\n\n\n  /*\n    =====================================================\n    YTTRE LAYOUT\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__shell {\n    display: grid;\n\n    grid-template-columns:\n      minmax(0, 1.18fr)\n      minmax(390px, 0.82fr);\n\n    width: min(1500px, 100%);\n    min-height: clamp(520px, 44vw, 680px);\n\n    margin: 0 auto;\n\n    border:\n      1px solid\n      var(--devise-editorial-border);\n\n    background: #F8F8F5;\n\n    box-shadow:\n      12px 12px 0\n      #D1AA00;\n  }\n\n\n  /*\n    =====================================================\n    BILD\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__media {\n    position: relative;\n\n    display: grid;\n    place-items: center;\n\n    min-width: 0;\n    overflow: hidden;\n\n    border-right:\n      1px solid\n      var(--devise-editorial-border);\n\n    background:\n      var(--devise-editorial-media);\n\n    transition:\n      opacity 0.7s ease,\n      transform 0.7s\n      cubic-bezier(0.2, 0.7, 0.2, 1);\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__media::before {\n    content: \"\";\n\n    position: absolute;\n    z-index: 0;\n\n    inset: 20px;\n\n    border:\n      1px solid\n      rgba(10, 10, 10, 0.14);\n\n    pointer-events: none;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__image-wrap {\n    position: relative;\n    z-index: 1;\n\n    display: grid;\n    place-items: center;\n\n    width: 100%;\n    height: 100%;\n    min-height: 520px;\n\n    padding:\n      clamp(22px, 3vw, 48px);\n\n    overflow: hidden;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__image {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n    max-height: 590px;\n\n    object-fit: contain;\n    object-position: center;\n\n    border: 0;\n\n    background: #FFFFFF;\n\n    box-shadow:\n      0 18px 46px\n      rgba(0, 0, 0, 0.12);\n\n    transition:\n      transform 0.5s\n      cubic-bezier(0.2, 0.7, 0.2, 1),\n      box-shadow 0.5s ease;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__placeholder {\n    display: grid;\n    place-items: center;\n\n    width: 100%;\n    min-height: 380px;\n\n    padding: 30px;\n\n    border:\n      1px dashed\n      rgba(10, 10, 10, 0.35);\n\n    background: #FFFFFF;\n    color: #555555;\n\n    font-size: 14px;\n    font-weight: 800;\n    text-align: center;\n  }\n\n\n  /*\n    =====================================================\n    TEXT\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__content {\n    position: relative;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: flex-start;\n\n    overflow: hidden;\n\n    padding:\n      clamp(42px, 4.8vw, 82px);\n\n    background:\n      var(--devise-editorial-panel);\n\n    color: #FFFFFF;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__content::after {\n    content: \"\";\n\n    position: absolute;\n\n    right: -110px;\n    bottom: -110px;\n\n    width: 220px;\n    height: 220px;\n\n    border:\n      1px solid\n      rgba(255, 222, 89, 0.38);\n\n    border-radius: 50%;\n\n    box-shadow:\n      0 0 0 34px\n      rgba(255, 222, 89, 0.05),\n      0 0 0 68px\n      rgba(255, 222, 89, 0.035);\n\n    pointer-events: none;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__eyebrow {\n    position: relative;\n    z-index: 1;\n\n    display: inline-flex;\n    align-items: center;\n\n    gap: 10px;\n\n    margin: 0 0 20px;\n\n    color:\n      var(--devise-editorial-accent);\n\n    font-size: 12px;\n    font-weight: 900;\n    line-height: 1;\n\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n\n    transition:\n      opacity 0.55s ease,\n      transform 0.55s ease;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__eyebrow::before {\n    content: \"\";\n\n    width: 34px;\n    height: 3px;\n\n    background: currentColor;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__title {\n    position: relative;\n    z-index: 1;\n\n    max-width: 11ch;\n\n    margin: 0;\n\n    color: #FFFFFF;\n\n    font-size:\n      clamp(40px, 4.7vw, 72px);\n\n    font-weight: 900;\n    font-style: italic;\n\n    line-height: 0.96;\n    letter-spacing: -0.055em;\n\n    text-wrap: balance;\n\n    transition:\n      opacity 0.55s ease 0.06s,\n      transform 0.55s ease 0.06s;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__description {\n    position: relative;\n    z-index: 1;\n\n    max-width: 38rem;\n\n    margin: 26px 0 0;\n\n    color:\n      rgba(255, 255, 255, 0.78);\n\n    font-size:\n      clamp(15px, 1.2vw, 18px);\n\n    line-height: 1.65;\n\n    transition:\n      opacity 0.55s ease 0.12s,\n      transform 0.55s ease 0.12s;\n  }\n\n\n  /*\n    =====================================================\n    STEG\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__steps {\n    position: relative;\n    z-index: 1;\n\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n\n    gap: 10px;\n\n    margin-top: 34px;\n    padding: 12px 14px;\n\n    border:\n      1px solid\n      rgba(255, 255, 255, 0.18);\n\n    background:\n      rgba(255, 255, 255, 0.045);\n\n    color: #FFFFFF;\n\n    font-size: 12px;\n    font-weight: 850;\n    line-height: 1.25;\n\n    letter-spacing: 0.02em;\n\n    transition:\n      opacity 0.55s ease 0.18s,\n      transform 0.55s ease 0.18s;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__steps-arrow {\n    color:\n      var(--devise-editorial-accent);\n\n    font-weight: 900;\n  }\n\n\n  /*\n    =====================================================\n    KNAPP\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__button {\n    position: relative;\n    z-index: 1;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 12px;\n\n    min-width: 164px;\n    min-height: 54px;\n\n    margin-top: 22px;\n    padding: 0 24px;\n\n    border:\n      1px solid\n      var(--devise-editorial-accent);\n\n    border-radius: 0;\n\n    background:\n      var(--devise-editorial-accent);\n\n    color:\n      var(--devise-editorial-border);\n\n    font-size: 15px;\n    font-weight: 900;\n    line-height: 1;\n\n    text-decoration: none;\n\n    transition:\n      opacity 0.55s ease 0.24s,\n      transform 0.2s ease,\n      background 0.2s ease,\n      box-shadow 0.2s ease;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__button svg {\n    width: 18px;\n    height: 18px;\n\n    transition:\n      transform 0.2s ease;\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__button:hover {\n    background:\n      var(--devise-editorial-accent-hover);\n\n    transform: translateY(-2px);\n\n    box-shadow:\n      0 8px 0\n      rgba(255, 255, 255, 0.12);\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__button:hover svg {\n    transform: translateX(3px);\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial__button:focus-visible {\n    outline:\n      3px solid\n      #FFFFFF;\n\n    outline-offset: 4px;\n  }\n\n\n  /*\n    =====================================================\n    ANIMATION VID SCROLL\n    =====================================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}.is-ready:not(.is-visible)\n  .devise-editorial__media {\n    opacity: 0;\n    transform: translateY(24px);\n  }\n\n\n  #DeviseEditorial-{{ devise_editorial_id }}.is-ready:not(.is-visible)\n  .devise-editorial__eyebrow,\n  #DeviseEditorial-{{ devise_editorial_id }}.is-ready:not(.is-visible)\n  .devise-editorial__title,\n  #DeviseEditorial-{{ devise_editorial_id }}.is-ready:not(.is-visible)\n  .devise-editorial__description,\n  #DeviseEditorial-{{ devise_editorial_id }}.is-ready:not(.is-visible)\n  .devise-editorial__steps,\n  #DeviseEditorial-{{ devise_editorial_id }}.is-ready:not(.is-visible)\n  .devise-editorial__button {\n    opacity: 0;\n    transform: translateY(18px);\n  }\n\n\n  /*\n    =====================================================\n    DESKTOP HOVER\n    =====================================================\n  */\n\n  @media (hover: hover) and (pointer: fine) {\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__media:hover\n    .devise-editorial__image {\n      transform: scale(1.018);\n\n      box-shadow:\n        0 24px 60px\n        rgba(0, 0, 0, 0.16);\n    }\n  }\n\n\n  /*\n    =====================================================\n    SURFPLATTA\n    =====================================================\n  */\n\n  @media (max-width: 980px) {\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__shell {\n      grid-template-columns: 1fr;\n\n      min-height: 0;\n\n      box-shadow:\n        8px 8px 0\n        #D1AA00;\n    }\n\n\n    /*\n      Texten kommer först på mobil och surfplatta.\n      Kunden ser budskapet och knappen innan en hög bild.\n    */\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__content {\n      order: 1;\n\n      padding:\n        52px\n        clamp(24px, 6vw, 54px);\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__media {\n      order: 2;\n\n      border-top:\n        1px solid\n        var(--devise-editorial-border);\n\n      border-right: 0;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__image-wrap {\n      min-height: 0;\n      aspect-ratio: 16 / 10;\n\n      padding:\n        clamp(18px, 5vw, 38px);\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__image {\n      max-height: none;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__title {\n      max-width: 13ch;\n    }\n  }\n\n\n  /*\n    =====================================================\n    MOBIL\n    =====================================================\n  */\n\n  @media (max-width: 560px) {\n    #DeviseEditorial-{{ devise_editorial_id }} {\n      padding:\n        40px 12px 48px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__shell {\n      box-shadow:\n        5px 5px 0\n        #D1AA00;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__content {\n      padding:\n        34px 22px 30px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__content::after {\n      right: -85px;\n      bottom: -85px;\n\n      width: 150px;\n      height: 150px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__eyebrow {\n      margin-bottom: 16px;\n\n      font-size: 10px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__eyebrow::before {\n      width: 26px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__title {\n      max-width: 12ch;\n\n      font-size:\n        clamp(36px, 12vw, 52px);\n\n      line-height: 0.98;\n      letter-spacing: -0.05em;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__description {\n      margin-top: 20px;\n\n      font-size: 15px;\n      line-height: 1.55;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__steps {\n      justify-content: center;\n\n      width: 100%;\n\n      gap: 8px;\n\n      margin-top: 26px;\n      padding: 11px 10px;\n\n      font-size: 11px;\n      text-align: center;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__button {\n      width: 100%;\n      min-height: 56px;\n\n      margin-top: 14px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__image-wrap {\n      aspect-ratio: 4 / 3;\n\n      padding: 14px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__media::before {\n      inset: 10px;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__placeholder {\n      min-height: 240px;\n    }\n  }\n\n\n  /*\n    =====================================================\n    RESPEKTERA MINSKADE ANIMATIONER\n    =====================================================\n  */\n\n  @media (prefers-reduced-motion: reduce) {\n    #DeviseEditorial-{{ devise_editorial_id }} *,\n    #DeviseEditorial-{{ devise_editorial_id }} *::before,\n    #DeviseEditorial-{{ devise_editorial_id }} *::after {\n      animation: none !important;\n      transition: none !important;\n      scroll-behavior: auto !important;\n    }\n\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__media,\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__eyebrow,\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__title,\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__description,\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__steps,\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial__button {\n      opacity: 1 !important;\n      transform: none !important;\n    }\n  }\n</style>\n\n\n<script>\n  (function () {\n    const section = document.getElementById(\n      \"DeviseEditorial-{{ devise_editorial_id }}\"\n    );\n\n    if (!section) {\n      return;\n    }\n\n    const reducedMotion = window.matchMedia(\n      \"(prefers-reduced-motion: reduce)\"\n    ).matches;\n\n    if (\n      reducedMotion ||\n      !(\"IntersectionObserver\" in window)\n    ) {\n      section.classList.add(\"is-visible\");\n      return;\n    }\n\n    section.classList.add(\"is-ready\");\n\n    const observer = new IntersectionObserver(\n      function (entries) {\n        entries.forEach(function (entry) {\n          if (!entry.isIntersecting) {\n            return;\n          }\n\n          section.classList.add(\"is-visible\");\n          observer.unobserve(section);\n        });\n      },\n      {\n        threshold: 0.15\n      }\n    );\n\n    observer.observe(section);\n  })();\n</script>",
