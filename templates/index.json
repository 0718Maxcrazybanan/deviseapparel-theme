ial-v4__media {\n      padding: 10px;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__image-frame {\n      aspect-ratio:\n        16 / 10;\n\n      border:\n        1px solid #000000;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__placeholder {\n      min-height: 210px;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__mobile-cta {\n      grid-area: mobile-cta;\n\n      display: flex;\n      flex-direction: column;\n\n      padding:\n        2px 10px 12px;\n\n      background:\n        var(--devise-black);\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__steps--mobile {\n      display: inline-flex;\n\n      width: 100%;\n\n      justify-content: center;\n\n      gap: 8px;\n\n      margin: 0 0 10px;\n      padding: 9px 8px;\n\n      font-size: 11px;\n      text-align: center;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__step-arrow {\n      width: 13px;\n      height: 13px;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__button--mobile {\n      width: 100%;\n      min-height: 52px;\n\n      margin: 0;\n    }\n  }\n\n  /*\n    =====================================================\n    MINSKADE ANIMATIONER\n    =====================================================\n  */\n\n  @media (prefers-reduced-motion: reduce) {\n    #DeviseEditorial-{{ devise_editorial_id }} *,\n    #DeviseEditorial-{{ devise_editorial_id }} *::before,\n    #DeviseEditorial-{{ devise_editorial_id }} *::after {\n      animation: none !important;\n      transition: none !important;\n      scroll-behavior: auto !important;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__reveal {\n      opacity: 1 !important;\n      transform: none !important;\n    }\n  }\n</style>\n\n\n<script>\n  (function () {\n    const section = document.getElementById(\n      \"DeviseEditorial-{{ devise_editorial_id }}\"\n    );\n\n    if (!section) {\n      return;\n    }\n\n    const reducedMotion = window.matchMedia(\n      \"(prefers-reduced-motion: reduce)\"\n    ).matches;\n\n    if (\n      reducedMotion ||\n      !(\"IntersectionObserver\" in window)\n    ) {\n      section.classList.add(\"is-visible\");\n      return;\n    }\n\n    section.classList.add(\"is-ready\");\n\n    const observer = new IntersectionObserver(\n      function (entries) {\n        entries.forEach(function (entry) {\n          if (!entry.isIntersecting) {\n            return;\n          }\n\n          section.classList.add(\"is-visible\");\n          observer.unobserve(section);\n        });\n      },\n      {\n        threshold: 0.12\n      }\n    );\n\n    observer.observe(section);\n  })();\n</script>",
