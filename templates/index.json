{
  "sections": {
    "custom_liquid_ULmi8h": {
      "type": "custom-liquid",
      "name": "Produkter",
      "settings": {
        "custom_liquid": "{% assign devise_collection_handle = 'home-page' %}\n{% assign devise_collection = collections[devise_collection_handle] %}\n\n{% comment %}\n  =====================================================\n  FÄRGER\n  =====================================================\n{% endcomment %}\n\n{% assign color_section_background = '#EEF1EA' %}\n\n{% assign color_label_text = '#0A0A0A' %}\n{% assign color_heading_text = '#0A0A0A' %}\n{% assign color_description_text = '#474747' %}\n\n{% assign color_product_title = '#0A0A0A' %}\n{% assign color_product_title_hover = '#555555' %}\n{% assign color_product_price = '#0A0A0A' %}\n\n{% assign color_image_background = '#E4E7DF' %}\n{% assign color_image_border = '#CDD1C8' %}\n{% assign color_image_border_hover = '#0A0A0A' %}\n\n{% assign color_customize_background = '#0A0A0A' %}\n{% assign color_customize_text = '#FFFFFF' %}\n{% assign color_customize_hover = '#242424' %}\n\n{% assign color_design_link = '#C79B00' %}\n{% assign color_design_link_hover = '#9E7A00' %}\n\n{% assign color_soldout_background = '#D6D9D2' %}\n{% assign color_soldout_text = '#777777' %}\n\n{% assign color_popup_background = '#FFFFFF' %}\n{% assign color_popup_border = '#0A0A0A' %}\n{% assign color_popup_overlay = 'rgba(0, 0, 0, 0.55)' %}\n\n<section\n  class=\"devise-direct-products\"\n  data-devise-product-section\n>\n  <div class=\"devise-direct-inner\">\n\n    <div class=\"devise-direct-head\">\n      <span>Senaste beställningarna</span>\n\n      <h2>Köp direkt</h2>\n\n      <p>\n        Klicka in på en produkt eller lägg den direkt i kundvagnen\n      </p>\n    </div>\n\n    <div class=\"devise-direct-grid\">\n\n      {% for product in devise_collection.products limit: 50 %}\n\n        <article\n          class=\"devise-direct-card{% if forloop.index > 10 %} devise-direct-hidden{% endif %}\"\n        >\n\n          <a\n            href=\"{{ product.url }}\"\n            class=\"devise-direct-image\"\n            aria-label=\"Öppna {{ product.title | escape }}\"\n          >\n\n            {% if product.featured_image %}\n\n              <img\n                src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                srcset=\"\n                  {{ product.featured_image | image_url: width: 360 }} 360w,\n                  {{ product.featured_image | image_url: width: 540 }} 540w,\n                  {{ product.featured_image | image_url: width: 720 }} 720w,\n                  {{ product.featured_image | image_url: width: 900 }} 900w\n                \"\n                sizes=\"\n                  (max-width: 560px) 46vw,\n                  (max-width: 820px) 48vw,\n                  (max-width: 1100px) 31vw,\n                  23vw\n                \"\n                alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                loading=\"lazy\"\n                width=\"{{ product.featured_image.width }}\"\n                height=\"{{ product.featured_image.height }}\"\n              >\n\n            {% else %}\n\n              <div class=\"devise-direct-placeholder\">\n                DeviseApparel\n              </div>\n\n            {% endif %}\n\n          </a>\n\n          <div class=\"devise-direct-content\">\n\n            <a\n              href=\"{{ product.url }}\"\n              class=\"devise-direct-title\"\n            >\n              {{ product.title }}\n            </a>\n\n            <div class=\"devise-direct-price\">\n              {{ product.price | money }}\n            </div>\n\n            {% if product.available %}\n\n              <button\n                type=\"button\"\n                class=\"devise-direct-customize\"\n                data-devise-open=\"devisePopup-{{ product.id }}\"\n                aria-haspopup=\"dialog\"\n                aria-controls=\"devisePopup-{{ product.id }}\"\n              >\n                Anpassa\n              </button>\n\n            {% else %}\n\n              <button\n                type=\"button\"\n                class=\"devise-direct-customize devise-direct-soldout\"\n                disabled\n              >\n                Slutsåld\n              </button>\n\n            {% endif %}\n\n            <a\n              href=\"/pages/custom-order\"\n              class=\"devise-direct-design-link\"\n            >\n              Skapa egen design\n            </a>\n\n          </div>\n\n        </article>\n\n      {% endfor %}\n\n    </div>\n\n    {% if devise_collection.products_count > 10 %}\n\n      <div class=\"devise-direct-more-wrap\">\n\n        <button\n          type=\"button\"\n          class=\"devise-direct-more\"\n          data-devise-more\n        >\n          Se mer\n        </button>\n\n      </div>\n\n    {% endif %}\n\n  </div>\n\n  {% comment %}\n    =====================================================\n    POPUP FÖR STORLEK OCH VARIANT\n    =====================================================\n  {% endcomment %}\n\n  {% for product in devise_collection.products limit: 50 %}\n\n    {% if product.available %}\n\n      <div\n        class=\"devise-direct-popup\"\n        id=\"devisePopup-{{ product.id }}\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"devisePopupTitle-{{ product.id }}\"\n        hidden\n      >\n\n        <button\n          type=\"button\"\n          class=\"devise-direct-popup-overlay\"\n          data-devise-close\n          aria-label=\"Stäng popup\"\n        ></button>\n\n        <div class=\"devise-direct-popup-panel\">\n\n          <button\n            type=\"button\"\n            class=\"devise-direct-popup-close\"\n            data-devise-close\n            aria-label=\"Stäng popup\"\n          >\n            ×\n          </button>\n\n          <div class=\"devise-direct-popup-product\">\n\n            <a\n              href=\"{{ product.url }}\"\n              class=\"devise-direct-popup-image\"\n            >\n\n              {% if product.featured_image %}\n\n                <img\n                  src=\"{{ product.featured_image | image_url: width: 420 }}\"\n                  alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                  loading=\"lazy\"\n                  width=\"{{ product.featured_image.width }}\"\n                  height=\"{{ product.featured_image.height }}\"\n                >\n\n              {% endif %}\n\n            </a>\n\n            <div class=\"devise-direct-popup-info\">\n\n              <span>Anpassa produkt</span>\n\n              <a\n                href=\"{{ product.url }}\"\n                id=\"devisePopupTitle-{{ product.id }}\"\n              >\n                {{ product.title }}\n              </a>\n\n              <strong>\n                {{ product.price | money }}\n              </strong>\n\n            </div>\n\n          </div>\n\n          {% comment %}\n            Vanligt Shopify-formulär.\n            Ingen fetch eller egen AJAX används.\n          {% endcomment %}\n\n          <form\n            method=\"post\"\n            action=\"{{ routes.cart_add_url }}\"\n            enctype=\"multipart/form-data\"\n            class=\"devise-direct-popup-form\"\n          >\n\n            {% if product.variants.size > 1 %}\n\n              <label for=\"deviseVariant-{{ product.id }}\">\n                Välj storlek eller variant\n              </label>\n\n              <select\n                id=\"deviseVariant-{{ product.id }}\"\n                name=\"id\"\n                class=\"devise-direct-popup-select\"\n                required\n              >\n\n                {% for variant in product.variants %}\n\n                  <option\n                    value=\"{{ variant.id }}\"\n                    {% if variant.id == product.selected_or_first_available_variant.id %}\n                      selected\n                    {% endif %}\n                    {% unless variant.available %}\n                      disabled\n                    {% endunless %}\n                  >\n                    {{ variant.title }}\n\n                    {% unless variant.available %}\n                      — Slutsåld\n                    {% endunless %}\n                  </option>\n\n                {% endfor %}\n\n              </select>\n\n            {% else %}\n\n              <input\n                type=\"hidden\"\n                name=\"id\"\n                value=\"{{ product.selected_or_first_available_variant.id }}\"\n              >\n\n            {% endif %}\n\n            <input\n              type=\"hidden\"\n              name=\"quantity\"\n              value=\"1\"\n            >\n\n            {% comment %}\n              Kunden skickas tillbaka till samma sida\n              efter att produkten lagts till.\n            {% endcomment %}\n\n            <input\n              type=\"hidden\"\n              name=\"return_to\"\n              value=\"{{ request.path }}\"\n            >\n\n            <button\n              type=\"submit\"\n              name=\"add\"\n              class=\"devise-direct-popup-submit\"\n            >\n              Lägg i kundvagnen\n            </button>\n\n          </form>\n\n        </div>\n\n      </div>\n\n    {% endif %}\n\n  {% endfor %}\n\n</section>\n\n<style>\n  .devise-direct-products {\n    --section-background: {{ color_section_background }};\n\n    --label-text: {{ color_label_text }};\n    --heading-text: {{ color_heading_text }};\n    --description-text: {{ color_description_text }};\n\n    --product-title: {{ color_product_title }};\n    --product-title-hover: {{ color_product_title_hover }};\n    --product-price: {{ color_product_price }};\n\n    --image-background: {{ color_image_background }};\n    --image-border: {{ color_image_border }};\n    --image-border-hover: {{ color_image_border_hover }};\n\n    --customize-background: {{ color_customize_background }};\n    --customize-text: {{ color_customize_text }};\n    --customize-hover: {{ color_customize_hover }};\n\n    --design-link: {{ color_design_link }};\n    --design-link-hover: {{ color_design_link_hover }};\n\n    --soldout-background: {{ color_soldout_background }};\n    --soldout-text: {{ color_soldout_text }};\n\n    --popup-background: {{ color_popup_background }};\n    --popup-border: {{ color_popup_border }};\n    --popup-overlay: {{ color_popup_overlay }};\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n\n    padding: 64px clamp(12px, 2vw, 32px);\n\n    background: var(--section-background);\n    color: var(--heading-text);\n\n    font-family: Inter, Arial, sans-serif;\n  }\n\n  .devise-direct-products *,\n  .devise-direct-products *::before,\n  .devise-direct-products *::after {\n    box-sizing: border-box;\n  }\n\n  .devise-direct-inner {\n    width: 100%;\n    max-width: none;\n    margin: 0;\n  }\n\n  /* Rubrik — samma stil som originalet */\n\n  .devise-direct-head {\n    max-width: 680px;\n    margin-bottom: 30px;\n  }\n\n  .devise-direct-head span {\n    display: inline-block;\n\n    margin-bottom: 12px;\n\n    color: var(--label-text);\n\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .devise-direct-head h2 {\n    margin: 0;\n\n    color: var(--heading-text);\n\n    font-size: clamp(34px, 5vw, 58px);\n    line-height: 0.96;\n    letter-spacing: -0.06em;\n    font-weight: 950;\n  }\n\n  .devise-direct-head p {\n    margin: 14px 0 0;\n\n    color: var(--description-text);\n\n    font-size: 15px;\n    line-height: 1.6;\n  }\n\n  /* Produktgrid */\n\n  .devise-direct-grid {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n\n    gap: 38px clamp(14px, 1.8vw, 30px);\n\n    width: 100%;\n  }\n\n  .devise-direct-hidden {\n    display: none;\n  }\n\n  .devise-direct-card {\n    min-width: 0;\n    background: transparent;\n  }\n\n  /* Fyrkantig produktbild */\n\n  .devise-direct-image {\n    position: relative;\n    display: block;\n\n    width: 100%;\n    aspect-ratio: 1 / 1;\n\n    overflow: hidden;\n\n    border: 1px solid var(--image-border);\n    border-radius: 0;\n\n    background: var(--image-background);\n    text-decoration: none;\n\n    transition:\n      border-color 0.22s ease,\n      transform 0.22s ease;\n  }\n\n  .devise-direct-card:hover .devise-direct-image {\n    border-color: var(--image-border-hover);\n    transform: translateY(-3px);\n  }\n\n  .devise-direct-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n\n    transition: transform 0.3s ease;\n  }\n\n  .devise-direct-card:hover .devise-direct-image img {\n    transform: scale(1.025);\n  }\n\n  .devise-direct-placeholder {\n    display: grid;\n    place-items: center;\n\n    width: 100%;\n    height: 100%;\n\n    color: var(--heading-text);\n\n    font-size: 17px;\n    font-weight: 900;\n  }\n\n  .devise-direct-content {\n    padding: 15px 0 0;\n  }\n\n  .devise-direct-title {\n    display: block;\n\n    min-height: 38px;\n\n    color: var(--product-title);\n\n    font-size: 15px;\n    line-height: 1.25;\n    font-weight: 850;\n\n    text-decoration: none;\n\n    transition: color 0.2s ease;\n  }\n\n  .devise-direct-title:hover {\n    color: var(--product-title-hover);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .devise-direct-price {\n    margin-top: 9px;\n\n    color: var(--product-price);\n\n    font-size: 17px;\n    font-weight: 950;\n  }\n\n  /* Svart Anpassa-knapp */\n\n  .devise-direct-customize {\n    width: 100%;\n    min-height: 44px;\n\n    margin-top: 14px;\n\n    border: 1px solid var(--customize-background);\n    border-radius: 0;\n\n    background: var(--customize-background);\n    color: var(--customize-text);\n\n    font: inherit;\n    font-size: 13px;\n    font-weight: 950;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-direct-customize:hover {\n    background: var(--customize-hover);\n    transform: translateY(-2px);\n  }\n\n  .devise-direct-soldout {\n    border-color: var(--soldout-background);\n\n    background: var(--soldout-background);\n    color: var(--soldout-text);\n\n    cursor: not-allowed;\n  }\n\n  .devise-direct-soldout:hover {\n    transform: none;\n  }\n\n  /* Gul text under knappen */\n\n  .devise-direct-design-link {\n    display: inline-flex;\n\n    margin-top: 12px;\n\n    color: var(--design-link);\n\n    font-size: 12px;\n    font-weight: 900;\n    line-height: 1.4;\n\n    text-decoration: none;\n\n    transition: color 0.2s ease;\n  }\n\n  .devise-direct-design-link:hover {\n    color: var(--design-link-hover);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  /* Se mer */\n\n  .devise-direct-more-wrap {\n    display: flex;\n    justify-content: center;\n\n    margin-top: 40px;\n  }\n\n  .devise-direct-more {\n    min-height: 46px;\n    padding: 0 28px;\n\n    border: 1px solid var(--heading-text);\n    border-radius: 0;\n\n    background: transparent;\n    color: var(--heading-text);\n\n    font: inherit;\n    font-size: 13px;\n    font-weight: 950;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      color 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-direct-more:hover {\n    background: var(--heading-text);\n    color: #FFFFFF;\n    transform: translateY(-2px);\n  }\n\n  /* Popup */\n\n  .devise-direct-popup[hidden] {\n    display: none !important;\n  }\n\n  .devise-direct-popup {\n    position: fixed;\n    z-index: 99999;\n    inset: 0;\n\n    display: grid;\n    place-items: center;\n\n    padding: 20px;\n  }\n\n  .devise-direct-popup-overlay {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    padding: 0;\n    border: 0;\n\n    background: var(--popup-overlay);\n\n    cursor: pointer;\n    opacity: 0;\n\n    transition: opacity 0.2s ease;\n  }\n\n  .devise-direct-popup-panel {\n    position: relative;\n    z-index: 1;\n\n    width: min(100%, 540px);\n    max-height: calc(100vh - 40px);\n    overflow-y: auto;\n\n    padding: 24px;\n\n    border: 1px solid var(--popup-border);\n    border-radius: 0;\n\n    background: var(--popup-background);\n    color: var(--heading-text);\n\n    box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.18);\n\n    opacity: 0;\n    transform: translateY(14px);\n\n    transition:\n      opacity 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-direct-popup.is-open\n  .devise-direct-popup-overlay {\n    opacity: 1;\n  }\n\n  .devise-direct-popup.is-open\n  .devise-direct-popup-panel {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .devise-direct-popup-close {\n    position: absolute;\n    z-index: 2;\n\n    top: 12px;\n    right: 12px;\n\n    display: grid;\n    place-items: center;\n\n    width: 38px;\n    height: 38px;\n\n    padding: 0;\n\n    border: 1px solid var(--heading-text);\n    border-radius: 0;\n\n    background: #FFFFFF;\n    color: var(--heading-text);\n\n    font: inherit;\n    font-size: 25px;\n    line-height: 1;\n\n    cursor: pointer;\n  }\n\n  .devise-direct-popup-product {\n    display: grid;\n    grid-template-columns: 120px minmax(0, 1fr);\n\n    gap: 20px;\n    align-items: center;\n\n    padding-right: 36px;\n  }\n\n  .devise-direct-popup-image {\n    display: block;\n\n    overflow: hidden;\n    aspect-ratio: 1 / 1;\n\n    border: 1px solid var(--image-border);\n    border-radius: 0;\n\n    background: var(--image-background);\n  }\n\n  .devise-direct-popup-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n  }\n\n  .devise-direct-popup-info span {\n    display: block;\n\n    margin-bottom: 7px;\n\n    color: #606060;\n\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .devise-direct-popup-info a {\n    display: block;\n\n    margin: 0 0 10px;\n\n    color: var(--heading-text);\n\n    font-size: clamp(22px, 4vw, 30px);\n    line-height: 1.03;\n    font-weight: 950;\n    letter-spacing: -0.04em;\n\n    text-decoration: none;\n  }\n\n  .devise-direct-popup-info a:hover {\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .devise-direct-popup-info strong {\n    color: var(--heading-text);\n\n    font-size: 16px;\n    font-weight: 950;\n  }\n\n  /* Vanligt Shopify-formulär */\n\n  .devise-direct-popup-form {\n    margin-top: 24px;\n  }\n\n  .devise-direct-popup-form label {\n    display: block;\n\n    margin-bottom: 8px;\n\n    color: var(--heading-text);\n\n    font-size: 12px;\n    font-weight: 850;\n  }\n\n  .devise-direct-popup-select {\n    width: 100%;\n    min-height: 50px;\n\n    padding: 0 12px;\n\n    border: 1px solid var(--heading-text);\n    border-radius: 0;\n\n    background: #FFFFFF;\n    color: var(--heading-text);\n\n    font: inherit;\n    font-size: 14px;\n    font-weight: 700;\n\n    outline: none;\n  }\n\n  .devise-direct-popup-select:focus {\n    outline: 2px solid #FFDE59;\n    outline-offset: 2px;\n  }\n\n  .devise-direct-popup-submit {\n    width: 100%;\n    min-height: 50px;\n\n    margin-top: 12px;\n\n    border: 1px solid #0A0A0A;\n    border-radius: 0;\n\n    background: #FFDE59;\n    color: #0A0A0A;\n\n    font: inherit;\n    font-size: 14px;\n    font-weight: 950;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-direct-popup-submit:hover {\n    background: #F2CC32;\n    transform: translateY(-2px);\n  }\n\n  body.devise-direct-popup-open {\n    overflow: hidden;\n  }\n\n  /* Mindre datorer */\n\n  @media (max-width: 1350px) {\n    .devise-direct-grid {\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 1050px) {\n    .devise-direct-grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 760px) {\n    .devise-direct-products {\n      padding: 44px 12px 56px;\n    }\n\n    .devise-direct-head {\n      margin-bottom: 26px;\n    }\n\n    .devise-direct-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 30px 10px;\n    }\n  }\n\n  /* Mobil */\n\n  @media (max-width: 560px) {\n    .devise-direct-head span {\n      margin-bottom: 9px;\n      font-size: 10px;\n    }\n\n    .devise-direct-head h2 {\n      font-size: 30px;\n      line-height: 1;\n      letter-spacing: -0.05em;\n    }\n\n    .devise-direct-head p {\n      margin-top: 10px;\n      font-size: 13px;\n    }\n\n    .devise-direct-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 28px 9px;\n    }\n\n    .devise-direct-content {\n      padding-top: 10px;\n    }\n\n    .devise-direct-title {\n      min-height: 32px;\n\n      font-size: 12px;\n      line-height: 1.25;\n    }\n\n    .devise-direct-price {\n      margin-top: 6px;\n      font-size: 14px;\n    }\n\n    .devise-direct-customize {\n      min-height: 38px;\n      margin-top: 10px;\n\n      font-size: 11px;\n    }\n\n    .devise-direct-design-link {\n      margin-top: 8px;\n      font-size: 10px;\n    }\n\n    .devise-direct-popup {\n      padding: 12px;\n    }\n\n    .devise-direct-popup-panel {\n      width: 100%;\n      max-height: calc(100vh - 24px);\n\n      padding: 18px 14px;\n\n      box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.18);\n    }\n\n    .devise-direct-popup-product {\n      grid-template-columns: 82px minmax(0, 1fr);\n\n      gap: 13px;\n      padding-right: 34px;\n    }\n\n    .devise-direct-popup-info a {\n      font-size: 20px;\n    }\n\n    .devise-direct-popup-info strong {\n      font-size: 14px;\n    }\n\n    .devise-direct-popup-form {\n      margin-top: 18px;\n    }\n\n    .devise-direct-popup-select,\n    .devise-direct-popup-submit {\n      min-height: 46px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .devise-direct-products *,\n    .devise-direct-products *::before,\n    .devise-direct-products *::after {\n      transition: none !important;\n      animation: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function initDeviseDirectProducts(section) {\n      if (\n        !section ||\n        section.dataset.deviseInitialized === \"true\"\n      ) {\n        return;\n      }\n\n      section.dataset.deviseInitialized = \"true\";\n\n      let lastFocusedElement = null;\n      let closeTimer = null;\n\n      function openPopup(popup) {\n        if (!popup) {\n          return;\n        }\n\n        if (closeTimer) {\n          window.clearTimeout(closeTimer);\n        }\n\n        lastFocusedElement = document.activeElement;\n\n        popup.hidden = false;\n\n        document.body.classList.add(\n          \"devise-direct-popup-open\"\n        );\n\n        window.requestAnimationFrame(function () {\n          popup.classList.add(\"is-open\");\n\n          const closeButton = popup.querySelector(\n            \".devise-direct-popup-close\"\n          );\n\n          if (closeButton) {\n            closeButton.focus();\n          }\n        });\n      }\n\n      function closePopup(popup) {\n        if (!popup) {\n          return;\n        }\n\n        popup.classList.remove(\"is-open\");\n\n        closeTimer = window.setTimeout(function () {\n          popup.hidden = true;\n\n          document.body.classList.remove(\n            \"devise-direct-popup-open\"\n          );\n\n          if (\n            lastFocusedElement &&\n            typeof lastFocusedElement.focus === \"function\"\n          ) {\n            lastFocusedElement.focus();\n          }\n        }, 200);\n      }\n\n      section\n        .querySelectorAll(\"[data-devise-open]\")\n        .forEach(function (button) {\n          button.addEventListener(\"click\", function () {\n            const popupId = button.getAttribute(\n              \"data-devise-open\"\n            );\n\n            const popup = document.getElementById(\n              popupId\n            );\n\n            openPopup(popup);\n          });\n        });\n\n      section\n        .querySelectorAll(\"[data-devise-close]\")\n        .forEach(function (button) {\n          button.addEventListener(\"click\", function () {\n            const popup = button.closest(\n              \".devise-direct-popup\"\n            );\n\n            closePopup(popup);\n          });\n        });\n\n      document.addEventListener(\n        \"keydown\",\n        function (event) {\n          if (event.key !== \"Escape\") {\n            return;\n          }\n\n          const openPopupElement =\n            section.querySelector(\n              \".devise-direct-popup.is-open\"\n            );\n\n          if (openPopupElement) {\n            closePopup(openPopupElement);\n          }\n        }\n      );\n\n      const moreButton =\n        section.querySelector(\"[data-devise-more]\");\n\n      if (moreButton) {\n        moreButton.addEventListener(\n          \"click\",\n          function () {\n            const hiddenCards =\n              Array.prototype.slice.call(\n                section.querySelectorAll(\n                  \".devise-direct-hidden\"\n                )\n              );\n\n            hiddenCards\n              .slice(0, 10)\n              .forEach(function (card) {\n                card.classList.remove(\n                  \"devise-direct-hidden\"\n                );\n              });\n\n            if (\n              !section.querySelector(\n                \".devise-direct-hidden\"\n              )\n            ) {\n              moreButton.style.display = \"none\";\n            }\n          }\n        );\n\n        if (\n          !section.querySelector(\n            \".devise-direct-hidden\"\n          )\n        ) {\n          moreButton.style.display = \"none\";\n        }\n      }\n    }\n\n    function initializeDeviseSections() {\n      document\n        .querySelectorAll(\n          \"[data-devise-product-section]\"\n        )\n        .forEach(initDeviseDirectProducts);\n    }\n\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\n        \"DOMContentLoaded\",\n        initializeDeviseSections\n      );\n    } else {\n      initializeDeviseSections();\n    }\n\n    document.addEventListener(\n      \"shopify:section:load\",\n      initializeDeviseSections\n    );\n  })();\n</script>",
