{
  "sections": {
    "custom_liquid_ULmi8h": {
      "type": "custom-liquid",
      "name": "Produkter",
      "settings": {
        "custom_liquid": "{% assign devise_collection_handle = 'home-page' %}\n{% assign devise_collection = collections[devise_collection_handle] %}\n\n{% assign color_section_background = '#F4F0E7' %}\n{% assign color_heading = '#111111' %}\n{% assign color_text = '#414141' %}\n{% assign color_muted = '#6E6A61' %}\n{% assign color_image_background = '#E9E4D9' %}\n{% assign color_image_border = '#DDD6C8' %}\n{% assign color_button_background = '#FFDE59' %}\n{% assign color_button_text = '#111111' %}\n{% assign color_button_hover = '#F4CC28' %}\n{% assign color_accent_green = '#668A4A' %}\n{% assign color_accent_yellow = '#FFDE59' %}\n{% assign color_modal_background = '#FFFDF8' %}\n{% assign color_modal_border = '#DDD6C8' %}\n\n<section class=\"devise-summer-products\" data-devise-products-section>\n\n  <span\n    class=\"devise-summer-products__sun\"\n    aria-hidden=\"true\"\n  ></span>\n\n  <span\n    class=\"devise-summer-products__wave\"\n    aria-hidden=\"true\"\n  ></span>\n\n  <div class=\"devise-summer-products__inner\">\n\n    <header class=\"devise-summer-products__head\">\n\n      <div>\n        <span class=\"devise-summer-products__eyebrow\">\n          Senaste beställningarna\n        </span>\n\n        <h2>\n          Anpassa din favorit\n        </h2>\n      </div>\n\n      <p>\n        Välj en produkt och tryck på Anpassa. Du väljer storlek\n        direkt i popup-fönstret utan att lämna sidan.\n      </p>\n\n    </header>\n\n    <div class=\"devise-summer-products__grid\">\n\n      {% for product in devise_collection.products limit: 50 %}\n\n        <article\n          class=\"devise-summer-card{% if forloop.index > 10 %} devise-summer-card--hidden{% endif %}\"\n        >\n\n          <div class=\"devise-summer-card__image\">\n\n            {% if product.featured_image %}\n\n              <img\n                src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                srcset=\"\n                  {{ product.featured_image | image_url: width: 360 }} 360w,\n                  {{ product.featured_image | image_url: width: 540 }} 540w,\n                  {{ product.featured_image | image_url: width: 720 }} 720w,\n                  {{ product.featured_image | image_url: width: 900 }} 900w\n                \"\n                sizes=\"\n                  (max-width: 640px) 46vw,\n                  (max-width: 1000px) 31vw,\n                  20vw\n                \"\n                alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                loading=\"lazy\"\n                width=\"{{ product.featured_image.width }}\"\n                height=\"{{ product.featured_image.height }}\"\n              >\n\n            {% else %}\n\n              <div class=\"devise-summer-card__placeholder\">\n                DeviseApparel\n              </div>\n\n            {% endif %}\n\n          </div>\n\n          <div class=\"devise-summer-card__content\">\n\n            <div class=\"devise-summer-card__topline\">\n\n              <h3>\n                {{ product.title }}\n              </h3>\n\n              <span class=\"devise-summer-card__price\">\n                {{ product.price | money }}\n              </span>\n\n            </div>\n\n            {% if product.available %}\n\n              <button\n                type=\"button\"\n                class=\"devise-summer-card__button\"\n                data-devise-open-modal=\"deviseProductModal-{{ product.id }}\"\n                aria-haspopup=\"dialog\"\n              >\n                Anpassa\n              </button>\n\n            {% else %}\n\n              <button\n                type=\"button\"\n                class=\"devise-summer-card__button devise-summer-card__button--soldout\"\n                disabled\n              >\n                Slutsåld\n              </button>\n\n            {% endif %}\n\n            <a\n              href=\"/pages/custom-order\"\n              class=\"devise-summer-card__custom-link\"\n            >\n              Skapa en helt egen design →\n            </a>\n\n          </div>\n\n        </article>\n\n      {% endfor %}\n\n    </div>\n\n    {% if devise_collection.products_count > 10 %}\n\n      <div class=\"devise-summer-products__more-wrap\">\n\n        <button\n          type=\"button\"\n          class=\"devise-summer-products__more\"\n          data-devise-show-more\n        >\n          Se fler produkter\n        </button>\n\n      </div>\n\n    {% endif %}\n\n  </div>\n\n  {% comment %}\n    Popups för storlek och variant\n  {% endcomment %}\n\n  {% for product in devise_collection.products limit: 50 %}\n\n    {% if product.available %}\n\n      <div\n        class=\"devise-product-modal\"\n        id=\"deviseProductModal-{{ product.id }}\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"deviseModalTitle-{{ product.id }}\"\n        hidden\n      >\n\n        <button\n          type=\"button\"\n          class=\"devise-product-modal__backdrop\"\n          data-devise-close-modal\n          aria-label=\"Stäng popup\"\n        ></button>\n\n        <div\n          class=\"devise-product-modal__panel\"\n          role=\"document\"\n        >\n\n          <button\n            type=\"button\"\n            class=\"devise-product-modal__close\"\n            data-devise-close-modal\n            aria-label=\"Stäng\"\n          >\n            ×\n          </button>\n\n          <div class=\"devise-product-modal__product\">\n\n            <div class=\"devise-product-modal__image\">\n\n              {% if product.featured_image %}\n\n                <img\n                  src=\"{{ product.featured_image | image_url: width: 420 }}\"\n                  alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                  loading=\"lazy\"\n                  width=\"{{ product.featured_image.width }}\"\n                  height=\"{{ product.featured_image.height }}\"\n                >\n\n              {% endif %}\n\n            </div>\n\n            <div class=\"devise-product-modal__intro\">\n\n              <span>\n                Anpassa produkt\n              </span>\n\n              <h3 id=\"deviseModalTitle-{{ product.id }}\">\n                {{ product.title }}\n              </h3>\n\n              <p>\n                {{ product.price | money }}\n              </p>\n\n            </div>\n\n          </div>\n\n          <form\n            method=\"post\"\n            action=\"/cart/add\"\n            class=\"devise-product-modal__form\"\n            data-devise-modal-atc\n          >\n\n            {% if product.variants.size > 1 %}\n\n              <label for=\"deviseVariant-{{ product.id }}\">\n                Välj storlek eller variant\n              </label>\n\n              <select\n                id=\"deviseVariant-{{ product.id }}\"\n                name=\"id\"\n                class=\"devise-product-modal__select\"\n                required\n              >\n\n                {% for variant in product.variants %}\n\n                  <option\n                    value=\"{{ variant.id }}\"\n                    {% if variant.id == product.selected_or_first_available_variant.id %}\n                      selected\n                    {% endif %}\n                    {% unless variant.available %}\n                      disabled\n                    {% endunless %}\n                  >\n                    {{ variant.title }}\n\n                    {% unless variant.available %}\n                      — Slutsåld\n                    {% endunless %}\n                  </option>\n\n                {% endfor %}\n\n              </select>\n\n            {% else %}\n\n              <input\n                type=\"hidden\"\n                name=\"id\"\n                value=\"{{ product.selected_or_first_available_variant.id }}\"\n              >\n\n            {% endif %}\n\n            <input\n              type=\"hidden\"\n              name=\"quantity\"\n              value=\"1\"\n            >\n\n            <input\n              type=\"hidden\"\n              name=\"return_to\"\n              value=\"{{ request.path }}\"\n            >\n\n            <button\n              type=\"submit\"\n              class=\"devise-product-modal__submit\"\n            >\n              Lägg i kundvagn\n            </button>\n\n            <p\n              class=\"devise-product-modal__feedback\"\n              data-devise-modal-feedback\n              aria-live=\"polite\"\n            ></p>\n\n          </form>\n\n        </div>\n\n      </div>\n\n    {% endif %}\n\n  {% endfor %}\n\n</section>\n\n<style>\n  .devise-summer-products {\n    --section-background: {{ color_section_background }};\n    --heading: {{ color_heading }};\n    --text: {{ color_text }};\n    --muted: {{ color_muted }};\n    --image-background: {{ color_image_background }};\n    --image-border: {{ color_image_border }};\n    --button-background: {{ color_button_background }};\n    --button-text: {{ color_button_text }};\n    --button-hover: {{ color_button_hover }};\n    --accent-green: {{ color_accent_green }};\n    --accent-yellow: {{ color_accent_yellow }};\n    --modal-background: {{ color_modal_background }};\n    --modal-border: {{ color_modal_border }};\n\n    position: relative;\n    isolation: isolate;\n    overflow: hidden;\n    width: 100%;\n    padding:\n      clamp(58px, 7vw, 104px)\n      clamp(16px, 3vw, 52px);\n\n    background: var(--section-background);\n    color: var(--heading);\n    font-family: Inter, Arial, sans-serif;\n  }\n\n  .devise-summer-products *,\n  .devise-summer-products *::before,\n  .devise-summer-products *::after {\n    box-sizing: border-box;\n  }\n\n  .devise-summer-products__inner {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    max-width: none;\n    margin: 0;\n  }\n\n  /* Ljusgul solform */\n\n  .devise-summer-products__sun {\n    position: absolute;\n    z-index: 0;\n    top: -72px;\n    right: clamp(16px, 5vw, 80px);\n\n    width: 190px;\n    height: 190px;\n\n    border-radius: 50%;\n    background: rgba(255, 222, 89, 0.42);\n    pointer-events: none;\n  }\n\n  /* Diskret grön våg */\n\n  .devise-summer-products__wave {\n    position: absolute;\n    z-index: 0;\n    left: -80px;\n    bottom: 34px;\n\n    width: 260px;\n    height: 88px;\n\n    border: 3px solid rgba(102, 138, 74, 0.34);\n    border-right-color: transparent;\n    border-bottom-color: transparent;\n    border-radius: 50%;\n\n    transform: rotate(-8deg);\n    pointer-events: none;\n  }\n\n  .devise-summer-products__head {\n    display: grid;\n    grid-template-columns:\n      minmax(0, 1.15fr)\n      minmax(280px, 0.85fr);\n\n    gap: clamp(28px, 5vw, 90px);\n    align-items: end;\n\n    margin-bottom: clamp(38px, 5vw, 72px);\n  }\n\n  .devise-summer-products__eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n\n    margin-bottom: 14px;\n\n    color: var(--accent-green);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n  }\n\n  .devise-summer-products__eyebrow::before {\n    content: \"\";\n\n    width: 9px;\n    height: 9px;\n\n    border-radius: 50%;\n    background: var(--accent-yellow);\n    box-shadow: 13px 0 0 rgba(102, 138, 74, 0.9);\n  }\n\n  .devise-summer-products__head h2 {\n    max-width: 820px;\n    margin: 0;\n\n    color: var(--heading);\n    font-size: clamp(38px, 5.8vw, 78px);\n    font-weight: 900;\n    line-height: 0.94;\n    letter-spacing: -0.065em;\n  }\n\n  .devise-summer-products__head p {\n    max-width: 560px;\n    margin: 0 0 4px;\n\n    color: var(--text);\n    font-size: clamp(14px, 1.15vw, 17px);\n    line-height: 1.7;\n  }\n\n  /* Produkterna går nästan hela vägen ut till sidorna */\n\n  .devise-summer-products__grid {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n\n    gap:\n      clamp(22px, 2.3vw, 42px)\n      clamp(14px, 1.7vw, 28px);\n\n    width: 100%;\n  }\n\n  .devise-summer-card {\n    min-width: 0;\n    background: transparent;\n  }\n\n  .devise-summer-card--hidden {\n    display: none;\n  }\n\n  .devise-summer-card__image {\n    position: relative;\n    overflow: hidden;\n\n    width: 100%;\n    aspect-ratio: 4 / 5;\n\n    border: 1px solid var(--image-border);\n    border-radius: 22px;\n\n    background: var(--image-background);\n    box-shadow: 0 16px 36px rgba(35, 29, 19, 0.08);\n  }\n\n  .devise-summer-card__image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    transition: transform 0.4s ease;\n  }\n\n  .devise-summer-card:hover .devise-summer-card__image img {\n    transform: scale(1.025);\n  }\n\n  .devise-summer-card__placeholder {\n    display: grid;\n    place-items: center;\n\n    width: 100%;\n    height: 100%;\n\n    color: var(--heading);\n    font-size: 15px;\n    font-weight: 900;\n  }\n\n  .devise-summer-card__content {\n    padding: 17px 3px 0;\n  }\n\n  .devise-summer-card__topline {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n\n    gap: 12px;\n    align-items: start;\n    min-height: 44px;\n  }\n\n  .devise-summer-card__topline h3 {\n    margin: 0;\n\n    color: var(--heading);\n    font-size: 15px;\n    font-weight: 800;\n    line-height: 1.35;\n  }\n\n  .devise-summer-card__price {\n    color: var(--heading);\n    font-size: 14px;\n    font-weight: 900;\n    white-space: nowrap;\n  }\n\n  .devise-summer-card__button {\n    width: 100%;\n    min-height: 46px;\n\n    margin-top: 17px;\n\n    border: 1px solid rgba(17, 17, 17, 0.12);\n    border-radius: 999px;\n\n    background: var(--button-background);\n    color: var(--button-text);\n\n    font: inherit;\n    font-size: 13px;\n    font-weight: 900;\n\n    cursor: pointer;\n\n    transition:\n      transform 0.2s ease,\n      background 0.2s ease,\n      box-shadow 0.2s ease;\n  }\n\n  .devise-summer-card__button:hover {\n    background: var(--button-hover);\n    transform: translateY(-2px);\n    box-shadow: 0 9px 20px rgba(31, 27, 15, 0.12);\n  }\n\n  .devise-summer-card__button--soldout {\n    background: #DDD8CD;\n    color: #777168;\n    cursor: not-allowed;\n  }\n\n  .devise-summer-card__button--soldout:hover {\n    transform: none;\n    box-shadow: none;\n  }\n\n  .devise-summer-card__custom-link {\n    display: inline-flex;\n    margin-top: 12px;\n\n    color: var(--muted);\n    font-size: 12px;\n    font-weight: 750;\n    line-height: 1.35;\n    text-decoration: none;\n\n    transition: color 0.2s ease;\n  }\n\n  .devise-summer-card__custom-link:hover {\n    color: var(--accent-green);\n  }\n\n  .devise-summer-products__more-wrap {\n    display: flex;\n    justify-content: center;\n\n    margin-top: clamp(38px, 5vw, 68px);\n  }\n\n  .devise-summer-products__more {\n    min-height: 50px;\n    padding: 0 28px;\n\n    border: 1px solid var(--heading);\n    border-radius: 999px;\n\n    background: transparent;\n    color: var(--heading);\n\n    font: inherit;\n    font-size: 13px;\n    font-weight: 900;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      color 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-summer-products__more:hover {\n    background: var(--heading);\n    color: #FFFFFF;\n    transform: translateY(-2px);\n  }\n\n  /* Popup */\n\n  .devise-product-modal[hidden] {\n    display: none !important;\n  }\n\n  .devise-product-modal {\n    position: fixed;\n    z-index: 9999;\n    inset: 0;\n\n    display: grid;\n    place-items: center;\n\n    padding: 18px;\n  }\n\n  .devise-product-modal__backdrop {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    border: 0;\n    background: rgba(12, 12, 10, 0.56);\n    backdrop-filter: blur(8px);\n\n    cursor: pointer;\n    opacity: 0;\n\n    transition: opacity 0.22s ease;\n  }\n\n  .devise-product-modal__panel {\n    position: relative;\n    z-index: 1;\n\n    width: min(100%, 560px);\n    max-height: calc(100vh - 36px);\n    overflow-y: auto;\n\n    padding: 24px;\n\n    border: 1px solid var(--modal-border);\n    border-radius: 24px;\n\n    background: var(--modal-background);\n    color: var(--heading);\n\n    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.26);\n\n    opacity: 0;\n    transform: translateY(18px) scale(0.98);\n\n    transition:\n      opacity 0.22s ease,\n      transform 0.22s ease;\n  }\n\n  .devise-product-modal.is-open\n  .devise-product-modal__backdrop {\n    opacity: 1;\n  }\n\n  .devise-product-modal.is-open\n  .devise-product-modal__panel {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n\n  .devise-product-modal__close {\n    position: absolute;\n    z-index: 2;\n    top: 14px;\n    right: 14px;\n\n    display: grid;\n    place-items: center;\n\n    width: 38px;\n    height: 38px;\n\n    border: 1px solid rgba(17, 17, 17, 0.12);\n    border-radius: 50%;\n\n    background: rgba(255, 255, 255, 0.88);\n    color: var(--heading);\n\n    font: inherit;\n    font-size: 25px;\n    line-height: 1;\n\n    cursor: pointer;\n  }\n\n  .devise-product-modal__product {\n    display: grid;\n    grid-template-columns: 116px minmax(0, 1fr);\n\n    gap: 20px;\n    align-items: center;\n\n    padding-right: 34px;\n  }\n\n  .devise-product-modal__image {\n    overflow: hidden;\n    aspect-ratio: 1 / 1;\n\n    border: 1px solid var(--image-border);\n    border-radius: 17px;\n\n    background: var(--image-background);\n  }\n\n  .devise-product-modal__image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n  }\n\n  .devise-product-modal__intro span {\n    color: var(--accent-green);\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n  }\n\n  .devise-product-modal__intro h3 {\n    margin: 7px 0 8px;\n\n    color: var(--heading);\n    font-size: clamp(22px, 4vw, 31px);\n    font-weight: 900;\n    line-height: 1.03;\n    letter-spacing: -0.04em;\n  }\n\n  .devise-product-modal__intro p {\n    margin: 0;\n\n    color: var(--heading);\n    font-size: 16px;\n    font-weight: 900;\n  }\n\n  .devise-product-modal__form {\n    margin-top: 24px;\n  }\n\n  .devise-product-modal__form label {\n    display: block;\n    margin-bottom: 8px;\n\n    color: var(--heading);\n    font-size: 12px;\n    font-weight: 850;\n  }\n\n  .devise-product-modal__select {\n    width: 100%;\n    min-height: 50px;\n\n    padding: 0 14px;\n\n    border: 1px solid #CFC7B8;\n    border-radius: 13px;\n\n    background: #FFFFFF;\n    color: var(--heading);\n\n    font: inherit;\n    font-size: 14px;\n    font-weight: 700;\n\n    outline: none;\n  }\n\n  .devise-product-modal__select:focus {\n    border-color: var(--accent-green);\n    box-shadow: 0 0 0 3px rgba(102, 138, 74, 0.14);\n  }\n\n  .devise-product-modal__submit {\n    width: 100%;\n    min-height: 52px;\n\n    margin-top: 13px;\n\n    border: 0;\n    border-radius: 999px;\n\n    background: var(--button-background);\n    color: var(--button-text);\n\n    font: inherit;\n    font-size: 14px;\n    font-weight: 900;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-product-modal__submit:hover {\n    background: var(--button-hover);\n    transform: translateY(-1px);\n  }\n\n  .devise-product-modal__submit:disabled {\n    opacity: 0.65;\n    cursor: wait;\n    transform: none;\n  }\n\n  .devise-product-modal__feedback {\n    min-height: 20px;\n    margin: 10px 0 0;\n\n    color: var(--accent-green);\n    font-size: 12px;\n    font-weight: 800;\n    text-align: center;\n  }\n\n  body.devise-modal-open {\n    overflow: hidden;\n  }\n\n  @media (max-width: 1350px) {\n    .devise-summer-products__grid {\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 980px) {\n    .devise-summer-products__head {\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    .devise-summer-products__head p {\n      max-width: 650px;\n    }\n\n    .devise-summer-products__grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 700px) {\n    .devise-summer-products {\n      padding: 48px 12px 58px;\n    }\n\n    .devise-summer-products__sun {\n      top: -54px;\n      right: -26px;\n\n      width: 130px;\n      height: 130px;\n    }\n\n    .devise-summer-products__wave {\n      display: none;\n    }\n\n    .devise-summer-products__head {\n      margin-bottom: 30px;\n    }\n\n    .devise-summer-products__head h2 {\n      max-width: 470px;\n      font-size: clamp(34px, 12vw, 52px);\n    }\n\n    .devise-summer-products__head p {\n      font-size: 13px;\n      line-height: 1.58;\n    }\n\n    /* Två mindre produkter per rad på mobil */\n\n    .devise-summer-products__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 26px 10px;\n    }\n\n    .devise-summer-card__image {\n      aspect-ratio: 4 / 5;\n      border-radius: 15px;\n      box-shadow: 0 10px 22px rgba(35, 29, 19, 0.07);\n    }\n\n    .devise-summer-card__content {\n      padding: 11px 1px 0;\n    }\n\n    .devise-summer-card__topline {\n      display: block;\n      min-height: 58px;\n    }\n\n    .devise-summer-card__topline h3 {\n      font-size: 12px;\n      line-height: 1.3;\n    }\n\n    .devise-summer-card__price {\n      display: block;\n      margin-top: 5px;\n      font-size: 13px;\n    }\n\n    .devise-summer-card__button {\n      min-height: 39px;\n      margin-top: 10px;\n      font-size: 11px;\n    }\n\n    .devise-summer-card__custom-link {\n      margin-top: 9px;\n      font-size: 10px;\n    }\n\n    .devise-product-modal {\n      align-items: end;\n      padding: 10px;\n    }\n\n    .devise-product-modal__panel {\n      width: 100%;\n      max-height: calc(100vh - 20px);\n\n      padding: 20px 16px 18px;\n\n      border-radius: 22px;\n      transform: translateY(26px);\n    }\n\n    .devise-product-modal__product {\n      grid-template-columns: 88px minmax(0, 1fr);\n      gap: 14px;\n\n      padding-right: 34px;\n    }\n\n    .devise-product-modal__image {\n      border-radius: 13px;\n    }\n\n    .devise-product-modal__intro h3 {\n      font-size: 22px;\n    }\n\n    .devise-product-modal__submit,\n    .devise-product-modal__select {\n      min-height: 48px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .devise-summer-products *,\n    .devise-summer-products *::before,\n    .devise-summer-products *::after {\n      scroll-behavior: auto !important;\n      transition: none !important;\n      animation: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function initDeviseProducts(section) {\n      if (\n        !section ||\n        section.dataset.deviseInitialized === \"true\"\n      ) {\n        return;\n      }\n\n      section.dataset.deviseInitialized = \"true\";\n\n      let lastFocusedElement = null;\n      let closeTimer = null;\n\n      function openModal(modal) {\n        if (!modal) {\n          return;\n        }\n\n        if (closeTimer) {\n          clearTimeout(closeTimer);\n        }\n\n        lastFocusedElement = document.activeElement;\n\n        modal.hidden = false;\n\n        document.body.classList.add(\n          \"devise-modal-open\"\n        );\n\n        requestAnimationFrame(function () {\n          modal.classList.add(\"is-open\");\n\n          const closeButton = modal.querySelector(\n            \".devise-product-modal__close\"\n          );\n\n          if (closeButton) {\n            closeButton.focus();\n          }\n        });\n      }\n\n      function closeModal(modal) {\n        if (!modal) {\n          return;\n        }\n\n        modal.classList.remove(\"is-open\");\n\n        closeTimer = window.setTimeout(function () {\n          modal.hidden = true;\n\n          document.body.classList.remove(\n            \"devise-modal-open\"\n          );\n\n          if (\n            lastFocusedElement &&\n            typeof lastFocusedElement.focus === \"function\"\n          ) {\n            lastFocusedElement.focus();\n          }\n        }, 220);\n      }\n\n      section\n        .querySelectorAll(\"[data-devise-open-modal]\")\n        .forEach(function (button) {\n          button.addEventListener(\"click\", function () {\n            const modalId = button.getAttribute(\n              \"data-devise-open-modal\"\n            );\n\n            const modal = document.getElementById(\n              modalId\n            );\n\n            openModal(modal);\n          });\n        });\n\n      section\n        .querySelectorAll(\"[data-devise-close-modal]\")\n        .forEach(function (button) {\n          button.addEventListener(\"click\", function () {\n            closeModal(\n              button.closest(\".devise-product-modal\")\n            );\n          });\n        });\n\n      document.addEventListener(\n        \"keydown\",\n        function (event) {\n          if (event.key !== \"Escape\") {\n            return;\n          }\n\n          const openModalElement =\n            section.querySelector(\n              \".devise-product-modal.is-open\"\n            );\n\n          if (openModalElement) {\n            closeModal(openModalElement);\n          }\n        }\n      );\n\n      section\n        .querySelectorAll(\"[data-devise-modal-atc]\")\n        .forEach(function (form) {\n          form.addEventListener(\n            \"submit\",\n            function (event) {\n              event.preventDefault();\n\n              const submitButton =\n                form.querySelector(\n                  \".devise-product-modal__submit\"\n                );\n\n              const select =\n                form.querySelector(\n                  'select[name=\"id\"]'\n                );\n\n              const hiddenInput =\n                form.querySelector(\n                  'input[name=\"id\"]'\n                );\n\n              const feedback =\n                form.querySelector(\n                  \"[data-devise-modal-feedback]\"\n                );\n\n              const variantId = select\n                ? select.value\n                : hiddenInput\n                  ? hiddenInput.value\n                  : null;\n\n              if (!variantId) {\n                feedback.textContent =\n                  \"Ingen tillgänglig variant hittades.\";\n\n                return;\n              }\n\n              const originalText =\n                submitButton.textContent;\n\n              submitButton.disabled = true;\n              submitButton.textContent =\n                \"Lägger till...\";\n\n              feedback.textContent = \"\";\n\n              fetch(\"/cart/add.js\", {\n                method: \"POST\",\n\n                headers: {\n                  \"Content-Type\":\n                    \"application/json\",\n\n                  \"Accept\":\n                    \"application/json\"\n                },\n\n                body: JSON.stringify({\n                  id: Number(variantId),\n                  quantity: 1\n                })\n              })\n\n              .then(function (response) {\n                if (!response.ok) {\n                  return response\n                    .json()\n                    .then(function (error) {\n                      throw error;\n                    });\n                }\n\n                return response.json();\n              })\n\n              .then(function () {\n                submitButton.textContent =\n                  \"Tillagd ✓\";\n\n                feedback.textContent =\n                  \"Produkten har lagts i kundvagnen.\";\n\n                window.setTimeout(function () {\n                  window.location.reload();\n                }, 650);\n              })\n\n              .catch(function (error) {\n                submitButton.disabled = false;\n\n                submitButton.textContent =\n                  originalText;\n\n                feedback.textContent =\n                  error && error.description\n                    ? error.description\n                    : \"Produkten kunde inte läggas till. Försök igen.\";\n              });\n            }\n          );\n        });\n\n      const moreButton =\n        section.querySelector(\n          \"[data-devise-show-more]\"\n        );\n\n      if (moreButton) {\n        moreButton.addEventListener(\n          \"click\",\n          function () {\n            const hiddenCards =\n              Array.prototype.slice.call(\n                section.querySelectorAll(\n                  \".devise-summer-card--hidden\"\n                )\n              );\n\n            hiddenCards\n              .slice(0, 10)\n              .forEach(function (card) {\n                card.classList.remove(\n                  \"devise-summer-card--hidden\"\n                );\n              });\n\n            if (\n              !section.querySelector(\n                \".devise-summer-card--hidden\"\n              )\n            ) {\n              moreButton.style.display = \"none\";\n            }\n          }\n        );\n\n        if (\n          !section.querySelector(\n            \".devise-summer-card--hidden\"\n          )\n        ) {\n          moreButton.style.display = \"none\";\n        }\n      }\n    }\n\n    function startDeviseProducts() {\n      document\n        .querySelectorAll(\n          \"[data-devise-products-section]\"\n        )\n        .forEach(initDeviseProducts);\n    }\n\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\n        \"DOMContentLoaded\",\n        startDeviseProducts\n      );\n    } else {\n      startDeviseProducts();\n    }\n\n    document.addEventListener(\n      \"shopify:section:load\",\n      startDeviseProducts\n    );\n  })();\n</script>",
