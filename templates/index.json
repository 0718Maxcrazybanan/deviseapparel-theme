{
  "sections": {
    "custom_liquid_ULmi8h": {
      "type": "custom-liquid",
      "name": "Produkter",
      "settings": {
        "custom_liquid": "{% assign devise_collection_handle = 'home-page' %}\n{% assign devise_collection = collections[devise_collection_handle] %}\n\n{% comment %}\n  =====================================================\n  FÄRG-INPUTS — ÄNDRA HEX-KODER HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign color_section_background = '#EEF1EA' %}\n\n{% assign color_label_text = '#0A0A0A' %}\n{% assign color_heading_text = '#0A0A0A' %}\n{% assign color_description_text = '#474747' %}\n\n{% assign color_card_background = '#111111' %}\n{% assign color_card_border = '#2A2A2A' %}\n{% assign color_card_border_hover = '#FFDE59' %}\n\n{% assign color_image_background = '#151515' %}\n{% assign color_placeholder_text = '#FFDE59' %}\n\n{% assign color_product_title = '#FFFFFF' %}\n{% assign color_product_title_hover = '#FFDE59' %}\n{% assign color_product_price = '#FFFFFF' %}\n\n{% assign color_select_background = '#0D0D0D' %}\n{% assign color_select_text = '#FFFFFF' %}\n{% assign color_select_border = '#333333' %}\n{% assign color_select_border_focus = '#FFDE59' %}\n\n{% assign color_add_button_background = '#FFDE59' %}\n{% assign color_add_button_text = '#0A0A0A' %}\n{% assign color_add_button_hover_background = '#FFDE59' %}\n{% assign color_add_button_hover_text = '#0A0A0A' %}\n\n{% assign color_soldout_background = '#252525' %}\n{% assign color_soldout_text = '#777777' %}\n\n{% assign color_custom_link = '#A0A0A0' %}\n{% assign color_custom_link_hover = '#FFDE59' %}\n\n{% assign color_more_button_background = 'transparent' %}\n{% assign color_more_button_text = '#0A0A0A' %}\n{% assign color_more_button_border = '#0A0A0A' %}\n{% assign color_more_button_hover_background = '#FFFFFF' %}\n{% assign color_more_button_hover_text = '#0A0A0A' %}\n\n{% comment %}\n  =====================================================\n  FORM / KANTER — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign card_radius = '0px' %}\n{% assign image_radius = '0px' %}\n{% assign button_radius = '0px' %}\n{% assign select_radius = '0px' %}\n\n<section class=\"devise-minimal-products\">\n  <div class=\"devise-minimal-inner\">\n\n    <div class=\"devise-minimal-head\">\n      <span>Senaste beställningarna</span>\n      <h2>Köp direkt</h2>\n      <p>Klicka in på en produkt eller lägg den direkt i kundvagnen.</p>\n    </div>\n\n    <div class=\"devise-minimal-grid\">\n      {% for product in devise_collection.products limit: 50 %}\n        <article class=\"devise-minimal-card{% if forloop.index > 8 %} devise-minimal-hidden{% endif %}\">\n\n          <a href=\"{{ product.url }}\" class=\"devise-minimal-image\">\n            {% if product.featured_image %}\n              <img\n                src=\"{{ product.featured_image | image_url: width: 800 }}\"\n                alt=\"{{ product.title | escape }}\"\n                loading=\"lazy\"\n              >\n            {% else %}\n              <div class=\"devise-minimal-placeholder\">\n                DeviseApparel\n              </div>\n            {% endif %}\n          </a>\n\n          <div class=\"devise-minimal-content\">\n            <a href=\"{{ product.url }}\" class=\"devise-minimal-title\">\n              {{ product.title }}\n            </a>\n\n            <div class=\"devise-minimal-price\">\n              {{ product.price | money }}\n            </div>\n\n            {% if product.available %}\n              <form method=\"post\" action=\"/cart/add\" class=\"devise-minimal-form\" data-devise-atc>\n                {% if product.variants.size > 1 %}\n                  <select name=\"id\" class=\"devise-minimal-select\">\n                    {% for variant in product.variants %}\n                      <option\n                        value=\"{{ variant.id }}\"\n                        {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}\n                        {% unless variant.available %}disabled{% endunless %}\n                      >\n                        {{ variant.title }}\n                        {% unless variant.available %} — Slutsåld{% endunless %}\n                      </option>\n                    {% endfor %}\n                  </select>\n                {% else %}\n                  <input\n                    type=\"hidden\"\n                    name=\"id\"\n                    value=\"{{ product.selected_or_first_available_variant.id }}\"\n                  >\n                {% endif %}\n\n                <input type=\"hidden\" name=\"quantity\" value=\"1\">\n\n                <!-- Säkerhet: om JS inte laddas, skickas kunden tillbaka till samma sida, inte kundvagnen -->\n                <input type=\"hidden\" name=\"return_to\" value=\"{{ request.path }}\">\n\n                <button type=\"submit\" class=\"devise-minimal-atc\">\n                  Lägg i kundvagn\n                </button>\n              </form>\n            {% else %}\n              <button class=\"devise-minimal-atc devise-minimal-soldout\" disabled>\n                Slutsåld\n              </button>\n            {% endif %}\n\n            <a href=\"/pages/custom-order\" class=\"devise-minimal-custom\">\n              Skapa liknande →\n            </a>\n          </div>\n\n        </article>\n      {% endfor %}\n    </div>\n\n    {% if devise_collection.products_count > 8 %}\n      <div class=\"devise-minimal-more-wrap\">\n        <button type=\"button\" class=\"devise-minimal-more\" id=\"deviseMinimalMore\">\n          Se mer\n        </button>\n      </div>\n    {% endif %}\n\n  </div>\n</section>\n\n<style>\n  .devise-minimal-products {\n    --color-section-background: {{ color_section_background }};\n\n    --color-label-text: {{ color_label_text }};\n    --color-heading-text: {{ color_heading_text }};\n    --color-description-text: {{ color_description_text }};\n\n    --color-card-background: {{ color_card_background }};\n    --color-card-border: {{ color_card_border }};\n    --color-card-border-hover: {{ color_card_border_hover }};\n\n    --color-image-background: {{ color_image_background }};\n    --color-placeholder-text: {{ color_placeholder_text }};\n\n    --color-product-title: {{ color_product_title }};\n    --color-product-title-hover: {{ color_product_title_hover }};\n    --color-product-price: {{ color_product_price }};\n\n    --color-select-background: {{ color_select_background }};\n    --color-select-text: {{ color_select_text }};\n    --color-select-border: {{ color_select_border }};\n    --color-select-border-focus: {{ color_select_border_focus }};\n\n    --color-add-button-background: {{ color_add_button_background }};\n    --color-add-button-text: {{ color_add_button_text }};\n    --color-add-button-hover-background: {{ color_add_button_hover_background }};\n    --color-add-button-hover-text: {{ color_add_button_hover_text }};\n\n    --color-soldout-background: {{ color_soldout_background }};\n    --color-soldout-text: {{ color_soldout_text }};\n\n    --color-custom-link: {{ color_custom_link }};\n    --color-custom-link-hover: {{ color_custom_link_hover }};\n\n    --color-more-button-background: {{ color_more_button_background }};\n    --color-more-button-text: {{ color_more_button_text }};\n    --color-more-button-border: {{ color_more_button_border }};\n    --color-more-button-hover-background: {{ color_more_button_hover_background }};\n    --color-more-button-hover-text: {{ color_more_button_hover_text }};\n\n    --card-radius: {{ card_radius }};\n    --image-radius: {{ image_radius }};\n    --button-radius: {{ button_radius }};\n    --select-radius: {{ select_radius }};\n\n    background: var(--color-section-background);\n    color: var(--color-heading-text);\n    font-family: Inter, Arial, sans-serif;\n    padding: 64px 20px;\n    overflow-x: hidden;\n  }\n\n  .devise-minimal-products * {\n    box-sizing: border-box;\n  }\n\n  .devise-minimal-inner {\n    max-width: 1280px;\n    margin: 0 auto;\n  }\n\n  .devise-minimal-head {\n    max-width: 680px;\n    margin-bottom: 30px;\n  }\n\n  .devise-minimal-head span {\n    display: inline-block;\n    color: var(--color-label-text);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    margin-bottom: 12px;\n  }\n\n  .devise-minimal-head h2 {\n    margin: 0;\n    color: var(--color-heading-text);\n    font-size: clamp(34px, 5vw, 58px);\n    line-height: 0.96;\n    letter-spacing: -0.06em;\n    font-weight: 950;\n  }\n\n  .devise-minimal-head p {\n    margin: 14px 0 0;\n    color: var(--color-description-text);\n    font-size: 15px;\n    line-height: 1.6;\n  }\n\n  .devise-minimal-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n  }\n\n  .devise-minimal-hidden {\n    display: none;\n  }\n\n  .devise-minimal-card {\n    background: var(--color-card-background);\n    border: 1px solid var(--color-card-border);\n    border-radius: var(--card-radius);\n    overflow: hidden;\n    transition: 0.22s ease;\n  }\n\n  .devise-minimal-card:hover {\n    transform: translateY(-3px);\n    border-color: var(--color-card-border-hover);\n  }\n\n  .devise-minimal-image {\n    display: block;\n    aspect-ratio: 1 / 1;\n    background: var(--color-image-background);\n    overflow: hidden;\n    text-decoration: none;\n    border-radius: var(--image-radius);\n  }\n\n  .devise-minimal-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: 0.25s ease;\n    border-radius: var(--image-radius);\n  }\n\n  .devise-minimal-card:hover .devise-minimal-image img {\n    transform: scale(1.035);\n  }\n\n  .devise-minimal-placeholder {\n    width: 100%;\n    height: 100%;\n    display: grid;\n    place-items: center;\n    color: var(--color-placeholder-text);\n    font-size: 18px;\n    font-weight: 900;\n  }\n\n  .devise-minimal-content {\n    padding: 15px;\n  }\n\n  .devise-minimal-title {\n    display: block;\n    color: var(--color-product-title);\n    text-decoration: none;\n    font-size: 15px;\n    line-height: 1.25;\n    font-weight: 850;\n    min-height: 38px;\n    transition: 0.2s ease;\n  }\n\n  .devise-minimal-title:hover {\n    color: var(--color-product-title-hover);\n  }\n\n  .devise-minimal-price {\n    color: var(--color-product-price);\n    font-size: 17px;\n    font-weight: 950;\n    margin-top: 10px;\n  }\n\n  .devise-minimal-form {\n    margin-top: 14px;\n  }\n\n  .devise-minimal-select {\n    width: 100%;\n    height: 42px;\n    margin-bottom: 9px;\n    background: var(--color-select-background);\n    color: var(--color-select-text);\n    border: 1px solid var(--color-select-border);\n    border-radius: var(--select-radius);\n    padding: 0 12px;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 700;\n    outline: none;\n  }\n\n  .devise-minimal-select:focus {\n    border-color: var(--color-select-border-focus);\n    box-shadow: none;\n  }\n\n  .devise-minimal-atc {\n    width: 100%;\n    min-height: 44px;\n    border: 0;\n    border-radius: var(--button-radius);\n    background: var(--color-add-button-background);\n    color: var(--color-add-button-text);\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 950;\n    cursor: pointer;\n    transition: 0.2s ease;\n  }\n\n  .devise-minimal-atc:hover {\n    background: var(--color-add-button-hover-background);\n    color: var(--color-add-button-hover-text);\n    transform: translateY(-2px);\n  }\n\n  .devise-minimal-atc.is-loading {\n    opacity: 0.75;\n    pointer-events: none;\n  }\n\n  .devise-minimal-soldout {\n    margin-top: 14px;\n    background: var(--color-soldout-background);\n    color: var(--color-soldout-text);\n    cursor: not-allowed;\n  }\n\n  .devise-minimal-soldout:hover {\n    transform: none;\n    box-shadow: none;\n  }\n\n  .devise-minimal-custom {\n    display: inline-flex;\n    margin-top: 12px;\n    color: var(--color-custom-link);\n    text-decoration: none;\n    font-size: 12px;\n    font-weight: 800;\n    transition: 0.2s ease;\n  }\n\n  .devise-minimal-custom:hover {\n    color: var(--color-custom-link-hover);\n  }\n\n  .devise-minimal-more-wrap {\n    display: flex;\n    justify-content: center;\n    margin-top: 26px;\n  }\n\n  .devise-minimal-more {\n    min-height: 46px;\n    padding: 0 28px;\n    border: 1px solid var(--color-more-button-border);\n    border-radius: 999px;\n    background: var(--color-more-button-background);\n    color: var(--color-more-button-text);\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 950;\n    cursor: pointer;\n    transition: 0.2s ease;\n  }\n\n  .devise-minimal-more:hover {\n    background: var(--color-more-button-hover-background);\n    color: var(--color-more-button-hover-text);\n    transform: translateY(-2px);\n  }\n\n  @media (max-width: 1100px) {\n    .devise-minimal-grid {\n      grid-template-columns: repeat(3, 1fr);\n    }\n  }\n\n  @media (max-width: 820px) {\n    .devise-minimal-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (max-width: 560px) {\n    .devise-minimal-products {\n      padding: 38px 12px;\n    }\n\n    .devise-minimal-head {\n      margin-bottom: 22px;\n    }\n\n    .devise-minimal-head span {\n      font-size: 10px;\n      margin-bottom: 9px;\n    }\n\n    .devise-minimal-head h2 {\n      font-size: 30px;\n      line-height: 1;\n      letter-spacing: -0.05em;\n    }\n\n    .devise-minimal-head p {\n      font-size: 13px;\n      margin-top: 10px;\n    }\n\n    .devise-minimal-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 10px;\n    }\n\n    .devise-minimal-card {\n      border-radius: var(--card-radius);\n    }\n\n    .devise-minimal-content {\n      padding: 10px;\n    }\n\n    .devise-minimal-title {\n      font-size: 12px;\n      line-height: 1.25;\n      min-height: 32px;\n      font-weight: 850;\n    }\n\n    .devise-minimal-price {\n      font-size: 14px;\n      margin-top: 7px;\n    }\n\n    .devise-minimal-form {\n      margin-top: 10px;\n    }\n\n    .devise-minimal-select {\n      height: 36px;\n      margin-bottom: 7px;\n      border-radius: var(--select-radius);\n      font-size: 11px;\n      padding: 0 8px;\n    }\n\n    .devise-minimal-atc {\n      min-height: 38px;\n      border-radius: var(--button-radius);\n      font-size: 11px;\n    }\n\n    .devise-minimal-custom {\n      margin-top: 8px;\n      font-size: 11px;\n    }\n  }\n\n  @media (max-width: 340px) {\n    .devise-minimal-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    document.querySelectorAll(\"[data-devise-atc]\").forEach(function (form) {\n      form.addEventListener(\"submit\", function (event) {\n        event.preventDefault();\n\n        const button = form.querySelector(\".devise-minimal-atc\");\n        const select = form.querySelector('select[name=\"id\"]');\n        const hiddenInput = form.querySelector('input[name=\"id\"]');\n\n        const variantId = select ? select.value : hiddenInput ? hiddenInput.value : null;\n\n        if (!variantId) {\n          alert(\"Ingen variant hittades. Klicka in på produkten istället.\");\n          return;\n        }\n\n        const originalText = button.textContent;\n\n        button.disabled = true;\n        button.textContent = \"Lägger till...\";\n\n        fetch(\"/cart/add.js\", {\n          method: \"POST\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            \"Accept\": \"application/json\"\n          },\n          body: JSON.stringify({\n            id: Number(variantId),\n            quantity: 1\n          })\n        })\n        .then(function (response) {\n          if (!response.ok) {\n            return response.json().then(function (error) {\n              throw error;\n            });\n          }\n\n          return response.json();\n        })\n        .then(function () {\n          window.location.reload();\n        })\n        .catch(function () {\n          button.disabled = false;\n          button.textContent = originalText;\n          alert(\"Produkten kunde inte läggas till. Testa att klicka in på produkten.\");\n        });\n      });\n    });\n\n    const moreButton = document.getElementById(\"deviseMinimalMore\");\n\n    if (moreButton) {\n      moreButton.addEventListener(\"click\", function () {\n        const hiddenCards = Array.prototype.slice.call(document.querySelectorAll(\".devise-minimal-card.devise-minimal-hidden\"));\n\n        hiddenCards.slice(0, 8).forEach(function (card) {\n          card.classList.remove(\"devise-minimal-hidden\");\n        });\n\n        if (!document.querySelector(\".devise-minimal-card.devise-minimal-hidden\")) {\n          moreButton.style.display = \"none\";\n        }\n      });\n\n      if (!document.querySelector(\".devise-minimal-card.devise-minimal-hidden\")) {\n        moreButton.style.display = \"none\";\n      }\n    }\n  });\n</script>",
