    "custom_liquid_PgpLgL": {
      "type": "custom-liquid",
      "name": "sticky pc",
      "settings": {
        "custom_liquid": "<div class=\"devise-sticky-custom-order\" id=\"deviseStickyCustomOrder\">\n  <div class=\"devise-sticky-custom-order__content\">\n    <span>Custom orders</span>\n    <strong>Skapa din egen hoodie</strong>\n    <p>Berätta din idé och få prisförslag snabbt.</p>\n  </div>\n\n  <a href=\"#devise-custom-order-form\" class=\"devise-sticky-custom-order__btn\">\n    Starta order →\n  </a>\n</div>\n\n<style>\n  .devise-sticky-custom-order {\n    position: fixed;\n    right: 28px;\n    bottom: 28px;\n    z-index: 9999;\n    width: 340px;\n    background:\n      linear-gradient(180deg, rgba(21,21,21,0.96) 0%, rgba(12,12,12,0.96) 100%);\n    border: 1px solid rgba(255, 222, 89, 0.22);\n    border-radius: 20px;\n    padding: 18px;\n    box-shadow:\n      0 24px 70px rgba(0,0,0,0.55),\n      0 0 35px rgba(255,222,89,0.08),\n      inset 0 1px 0 rgba(255,255,255,0.06);\n    font-family: Inter, Arial, sans-serif;\n    color: #FFFFFF;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: 14px;\n    align-items: center;\n    opacity: 0;\n    transform: translateY(18px) scale(0.96);\n    pointer-events: none;\n    transition:\n      opacity 0.25s ease,\n      transform 0.25s ease,\n      border-color 0.25s ease,\n      box-shadow 0.25s ease;\n    backdrop-filter: blur(14px);\n  }\n\n  .devise-sticky-custom-order.is-visible {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n    pointer-events: auto;\n  }\n\n  .devise-sticky-custom-order:hover {\n    border-color: rgba(255, 222, 89, 0.55);\n    box-shadow:\n      0 28px 80px rgba(0,0,0,0.62),\n      0 0 45px rgba(255,222,89,0.12),\n      inset 0 1px 0 rgba(255,255,255,0.08);\n  }\n\n  .devise-sticky-custom-order__content span {\n    display: inline-flex;\n    align-items: center;\n    width: fit-content;\n    background: rgba(255, 222, 89, 0.12);\n    border: 1px solid rgba(255, 222, 89, 0.22);\n    color: #FFDE59;\n    border-radius: 999px;\n    padding: 5px 9px;\n    font-size: 10px;\n    font-weight: 950;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-bottom: 8px;\n  }\n\n  .devise-sticky-custom-order__content strong {\n    display: block;\n    color: #FFFFFF;\n    font-size: 15px;\n    line-height: 1.15;\n    font-weight: 950;\n    letter-spacing: -0.03em;\n  }\n\n  .devise-sticky-custom-order__content p {\n    margin: 5px 0 0;\n    color: #A0A0A0;\n    font-size: 12px;\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  .devise-sticky-custom-order__btn {\n    min-height: 42px;\n    padding: 0 14px;\n    border-radius: 999px;\n    background: #FFDE59;\n    color: #0A0A0A;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    white-space: nowrap;\n    font-size: 12px;\n    font-weight: 950;\n    transition: 0.2s ease;\n  }\n\n  .devise-sticky-custom-order__btn:hover {\n    transform: translateY(-2px);\n    background: #FFFFFF;\n    color: #0A0A0A;\n  }\n\n  @media (max-width: 989px) {\n    .devise-sticky-custom-order {\n      display: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    const stickyBox = document.getElementById(\"deviseStickyCustomOrder\");\n    const formSelector = \"#devise-custom-order-form\";\n\n    if (!stickyBox) return;\n\n    function getTargetForm() {\n      return document.querySelector(formSelector);\n    }\n\n    function shouldShowSticky() {\n      const isDesktop = window.matchMedia(\"(min-width: 990px)\").matches;\n      if (!isDesktop) return false;\n\n      const scrollPassed = window.scrollY > 420;\n      if (!scrollPassed) return false;\n\n      const targetForm = getTargetForm();\n\n      if (!targetForm) {\n        return true;\n      }\n\n      const rect = targetForm.getBoundingClientRect();\n\n      const formIsClose =\n        rect.top < window.innerHeight * 0.88 &&\n        rect.bottom > 0;\n\n      return !formIsClose;\n    }\n\n    function updateSticky() {\n      stickyBox.classList.toggle(\"is-visible\", shouldShowSticky());\n    }\n\n    window.addEventListener(\"scroll\", updateSticky, { passive: true });\n    window.addEventListener(\"resize\", updateSticky);\n\n    document.addEventListener(\"shopify:section:load\", updateSticky);\n\n    stickyBox.querySelector(\"a\").addEventListener(\"click\", function (event) {\n      const targetForm = getTargetForm();\n\n      if (!targetForm) return;\n\n      event.preventDefault();\n\n      targetForm.scrollIntoView({\n        behavior: \"smooth\",\n        block: \"start\"\n      });\n    });\n\n    updateSticky();\n  })();\n</script>",
        "background_color": "{{ settings.color_palette.background }}",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_FqABND": {
      "type": "custom-liquid",
      "name": "popup",
      "settings": {
        "custom_liquid": "<div class=\"devise-email-popup\" id=\"deviseEmailPopup\" aria-hidden=\"true\">\n  <div class=\"devise-email-popup__overlay\" data-popup-close></div>\n\n  <div class=\"devise-email-popup__fx\" aria-hidden=\"true\">\n    <div class=\"devise-email-popup__sun\"></div>\n\n    <div class=\"devise-email-popup__surfer\">\n      <div class=\"devise-email-popup__surfer-head\"></div>\n      <div class=\"devise-email-popup__surfer-hair\"></div>\n      <div class=\"devise-email-popup__surfer-body\"></div>\n      <div class=\"devise-email-popup__surfer-arm devise-email-popup__surfer-arm--front\"></div>\n      <div class=\"devise-email-popup__surfer-arm devise-email-popup__surfer-arm--back\"></div>\n      <div class=\"devise-email-popup__surfer-leg devise-email-popup__surfer-leg--front\"></div>\n      <div class=\"devise-email-popup__surfer-leg devise-email-popup__surfer-leg--back\"></div>\n      <div class=\"devise-email-popup__surfboard\"></div>\n      <div class=\"devise-email-popup__surf-spray devise-email-popup__surf-spray--one\"></div>\n      <div class=\"devise-email-popup__surf-spray devise-email-popup__surf-spray--two\"></div>\n    </div>\n\n    <div class=\"devise-email-popup__screen-splash\">\n      <svg class=\"devise-email-popup__splash-svg devise-email-popup__splash-svg--back\" viewBox=\"0 0 1600 900\" preserveAspectRatio=\"none\">\n        <path d=\"M0,680\n                 C110,590 190,532 280,520\n                 C360,508 420,560 480,596\n                 C548,636 604,624 660,560\n                 C730,482 790,438 870,452\n                 C950,466 990,544 1058,590\n                 C1128,638 1204,620 1280,548\n                 C1380,452 1485,430 1600,520\n                 L1600,900 L0,900 Z\"/>\n      </svg>\n\n      <svg class=\"devise-email-popup__splash-svg devise-email-popup__splash-svg--front\" viewBox=\"0 0 1600 900\" preserveAspectRatio=\"none\">\n        <path d=\"M0,720\n                 C82,636 162,570 246,548\n                 C336,524 404,558 472,610\n                 C536,660 602,656 660,596\n                 C728,524 790,468 872,472\n                 C954,476 1002,542 1062,604\n                 C1128,670 1212,658 1290,582\n                 C1392,482 1494,458 1600,520\n                 L1600,900 L0,900 Z\"/>\n      </svg>\n\n      <div class=\"devise-email-popup__foam\"></div>\n\n      <span class=\"devise-water-pop devise-water-pop--1\"></span>\n      <span class=\"devise-water-pop devise-water-pop--2\"></span>\n      <span class=\"devise-water-pop devise-water-pop--3\"></span>\n      <span class=\"devise-water-pop devise-water-pop--4\"></span>\n      <span class=\"devise-water-pop devise-water-pop--5\"></span>\n      <span class=\"devise-water-pop devise-water-pop--6\"></span>\n\n      <span class=\"devise-drip devise-drip--1\"></span>\n      <span class=\"devise-drip devise-drip--2\"></span>\n      <span class=\"devise-drip devise-drip--3\"></span>\n      <span class=\"devise-drip devise-drip--4\"></span>\n      <span class=\"devise-drip devise-drip--5\"></span>\n    </div>\n  </div>\n\n  <div class=\"devise-email-popup__box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"devisePopupTitle\">\n    <button class=\"devise-email-popup__close\" type=\"button\" data-popup-close aria-label=\"Stäng popup\">\n      ×\n    </button>\n\n    <div class=\"devise-email-popup__badge\">\n      Sommarerbjudande\n    </div>\n\n    <h2 id=\"devisePopupTitle\">\n      10% rabatt\n    </h2>\n\n    <p>\n      Få din rabattkod och skapa något eget till sommaren.\n    </p>\n\n    {% form 'customer', id: 'devise-popup-newsletter-form', class: 'devise-email-popup__form' %}\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,popup_10_discount\">\n\n      {% if form.posted_successfully? %}\n        <div class=\"devise-email-popup__success\">\n          Tack! Kolla din inkorg för din rabattkod.\n        </div>\n      {% else %}\n        {% if form.errors %}\n          <div class=\"devise-email-popup__error\">\n            {{ form.errors | default_errors }}\n          </div>\n        {% endif %}\n\n        <div class=\"devise-email-popup__field\">\n          <input\n            type=\"email\"\n            name=\"contact[email]\"\n            id=\"devisePopupEmail\"\n            placeholder=\"din@email.se\"\n            required\n            autocomplete=\"email\"\n          >\n\n          <button type=\"submit\">\n            Få rabattkod →\n          </button>\n        </div>\n\n        <small>\n          Ingen spam. Bara erbjudanden, drops och viktig info från DeviseApparel.\n        </small>\n      {% endif %}\n    {% endform %}\n  </div>\n</div>\n\n<style>\n  .devise-email-popup {\n    position: fixed;\n    inset: 0;\n    z-index: 99999;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    padding: 18px;\n    font-family: Inter, Arial, sans-serif;\n    overflow: hidden;\n  }\n\n  .devise-email-popup.is-visible {\n    display: flex;\n  }\n\n  .devise-email-popup__overlay {\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255, 231, 167, 0.24) 0%,\n        rgba(89, 196, 232, 0.30) 34%,\n        rgba(7, 20, 40, 0.72) 100%\n      ),\n      rgba(6, 20, 38, 0.56);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    animation: deviseOverlayIn 0.6s ease forwards;\n  }\n\n  .devise-email-popup__fx {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    overflow: hidden;\n  }\n\n  .devise-email-popup__sun {\n    position: absolute;\n    top: 11%;\n    right: 16%;\n    width: 150px;\n    height: 150px;\n    border-radius: 50%;\n    background:\n      radial-gradient(circle, rgba(255, 236, 154, 0.85) 0%, rgba(255, 190, 92, 0.38) 46%, rgba(255, 190, 92, 0) 72%);\n    filter: blur(5px);\n    opacity: 0;\n    animation: deviseSunIn 1s ease forwards;\n  }\n\n  .devise-email-popup__surfer {\n    position: absolute;\n    left: -170px;\n    bottom: 30%;\n    width: 150px;\n    height: 120px;\n    z-index: 4;\n    opacity: 0;\n    transform-origin: 50% 80%;\n    animation: deviseSurferRide 1.18s cubic-bezier(0.18, 0.82, 0.22, 1) forwards;\n  }\n\n  .devise-email-popup__surfer-head {\n    position: absolute;\n    left: 66px;\n    top: 10px;\n    width: 26px;\n    height: 26px;\n    border-radius: 50%;\n    background: #F6C79B;\n    box-shadow: inset -4px -3px 0 rgba(120, 72, 36, 0.12);\n  }\n\n  .devise-email-popup__surfer-hair {\n    position: absolute;\n    left: 61px;\n    top: 5px;\n    width: 32px;\n    height: 18px;\n    border-radius: 999px 999px 6px 12px;\n    background: #2A1B12;\n    transform: rotate(-8deg);\n  }\n\n  .devise-email-popup__surfer-body {\n    position: absolute;\n    left: 58px;\n    top: 38px;\n    width: 38px;\n    height: 42px;\n    border-radius: 18px 18px 13px 13px;\n    background: linear-gradient(135deg, #FFDE59 0%, #FF8A4A 100%);\n    transform: rotate(-11deg);\n    box-shadow: inset 0 2px 0 rgba(255,255,255,0.32);\n  }\n\n  .devise-email-popup__surfer-arm {\n    position: absolute;\n    width: 48px;\n    height: 11px;\n    border-radius: 999px;\n    background: #F6C79B;\n  }\n\n  .devise-email-popup__surfer-arm--front {\n    left: 82px;\n    top: 46px;\n    transform: rotate(28deg);\n  }\n\n  .devise-email-popup__surfer-arm--back {\n    left: 28px;\n    top: 50px;\n    transform: rotate(-22deg);\n  }\n\n  .devise-email-popup__surfer-leg {\n    position: absolute;\n    width: 52px;\n    height: 12px;\n    border-radius: 999px;\n    background: #F6C79B;\n  }\n\n  .devise-email-popup__surfer-leg--front {\n    left: 76px;\n    top: 80px;\n    transform: rotate(15deg);\n  }\n\n  .devise-email-popup__surfer-leg--back {\n    left: 34px;\n    top: 82px;\n    transform: rotate(-19deg);\n  }\n\n  .devise-email-popup__surfboard {\n    position: absolute;\n    left: 14px;\n    top: 86px;\n    width: 132px;\n    height: 24px;\n    border-radius: 999px;\n    background:\n      linear-gradient(90deg, #FFFFFF 0%, #FFDE59 26%, #FF7A59 60%, #23C7D9 100%);\n    transform: rotate(-6deg);\n    box-shadow:\n      0 14px 22px rgba(0,0,0,0.22),\n      inset 0 2px 0 rgba(255,255,255,0.55);\n  }\n\n  .devise-email-popup__surfboard::after {\n    content: \"\";\n    position: absolute;\n    left: 18px;\n    right: 18px;\n    top: 50%;\n    height: 2px;\n    background: rgba(10,10,10,0.16);\n    transform: translateY(-50%);\n  }\n\n  .devise-email-popup__surf-spray {\n    position: absolute;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.92);\n    filter: blur(0.2px);\n    opacity: 0.95;\n  }\n\n  .devise-email-popup__surf-spray--one {\n    left: -5px;\n    top: 95px;\n    width: 52px;\n    height: 10px;\n    transform: rotate(-8deg);\n    animation: deviseSurfSprayOne 0.38s ease-in-out infinite;\n  }\n\n  .devise-email-popup__surf-spray--two {\n    left: 16px;\n    top: 105px;\n    width: 38px;\n    height: 8px;\n    opacity: 0.75;\n    transform: rotate(5deg);\n    animation: deviseSurfSprayTwo 0.44s ease-in-out infinite;\n  }\n\n  .devise-email-popup__screen-splash {\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n  }\n\n  .devise-email-popup__splash-svg {\n    position: absolute;\n    left: -10%;\n    width: 120%;\n    height: 76%;\n    bottom: -58%;\n    opacity: 0;\n    transform: translateY(100%);\n  }\n\n  .devise-email-popup__splash-svg--back path {\n    fill: rgba(124, 229, 255, 0.76);\n  }\n\n  .devise-email-popup__splash-svg--front path {\n    fill: rgba(28, 178, 220, 0.94);\n  }\n\n  .devise-email-popup__splash-svg--back {\n    filter: blur(2px);\n    animation: deviseSplashBack 1.24s cubic-bezier(0.2, 0.82, 0.2, 1) 0.72s forwards;\n  }\n\n  .devise-email-popup__splash-svg--front {\n    animation: deviseSplashFront 1.12s cubic-bezier(0.2, 0.82, 0.2, 1) 0.78s forwards;\n  }\n\n  .devise-email-popup__foam {\n    position: absolute;\n    left: -5%;\n    width: 110%;\n    height: 96px;\n    top: 43%;\n    opacity: 0;\n    background:\n      radial-gradient(circle at 5% 70%, rgba(255,255,255,0.96) 0 18px, transparent 19px),\n      radial-gradient(circle at 12% 52%, rgba(255,255,255,0.86) 0 13px, transparent 14px),\n      radial-gradient(circle at 20% 72%, rgba(255,255,255,0.96) 0 20px, transparent 21px),\n      radial-gradient(circle at 29% 50%, rgba(255,255,255,0.84) 0 14px, transparent 15px),\n      radial-gradient(circle at 38% 70%, rgba(255,255,255,0.96) 0 20px, transparent 21px),\n      radial-gradient(circle at 48% 54%, rgba(255,255,255,0.88) 0 14px, transparent 15px),\n      radial-gradient(circle at 58% 72%, rgba(255,255,255,0.96) 0 20px, transparent 21px),\n      radial-gradient(circle at 70% 54%, rgba(255,255,255,0.84) 0 14px, transparent 15px),\n      radial-gradient(circle at 82% 72%, rgba(255,255,255,0.96) 0 20px, transparent 21px),\n      radial-gradient(circle at 92% 56%, rgba(255,255,255,0.84) 0 14px, transparent 15px);\n    filter: blur(0.7px);\n    animation: deviseFoamIn 1.2s ease 0.76s forwards;\n  }\n\n  .devise-water-pop {\n    position: absolute;\n    width: 16px;\n    height: 16px;\n    border-radius: 50% 50% 55% 45%;\n    background: linear-gradient(180deg, rgba(226,250,255,0.96) 0%, rgba(83,207,238,0.92) 100%);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);\n    opacity: 0;\n  }\n\n  .devise-water-pop--1 { left: 12%; top: 30%; animation: deviseWaterPop1 1.1s ease 0.78s forwards; }\n  .devise-water-pop--2 { left: 26%; top: 22%; animation: deviseWaterPop2 1.05s ease 0.82s forwards; }\n  .devise-water-pop--3 { left: 43%; top: 26%; animation: deviseWaterPop3 1.14s ease 0.84s forwards; }\n  .devise-water-pop--4 { left: 61%; top: 23%; animation: deviseWaterPop4 1.06s ease 0.86s forwards; }\n  .devise-water-pop--5 { left: 78%; top: 28%; animation: deviseWaterPop5 1.12s ease 0.88s forwards; }\n  .devise-water-pop--6 { left: 88%; top: 20%; animation: deviseWaterPop6 1s ease 0.90s forwards; }\n\n  .devise-drip {\n    position: absolute;\n    top: -90px;\n    width: 14px;\n    height: 98px;\n    border-radius: 999px;\n    background: linear-gradient(\n      180deg,\n      rgba(232,250,255,0.98) 0%,\n      rgba(109,219,245,0.78) 42%,\n      rgba(48,173,211,0.10) 100%\n    );\n    opacity: 0;\n    filter: blur(0.25px);\n  }\n\n  .devise-drip::after {\n    content: \"\";\n    position: absolute;\n    bottom: -7px;\n    left: 50%;\n    width: 19px;\n    height: 19px;\n    transform: translateX(-50%);\n    border-radius: 50%;\n    background: rgba(104, 212, 242, 0.92);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);\n  }\n\n  .devise-drip--1 { left: 17%; animation: deviseDripRun 2.75s ease 1.28s forwards; }\n  .devise-drip--2 { left: 34%; height: 116px; animation: deviseDripRun 3.1s ease 1.38s forwards; }\n  .devise-drip--3 { left: 52%; height: 92px; animation: deviseDripRun 2.85s ease 1.32s forwards; }\n  .devise-drip--4 { left: 70%; height: 124px; animation: deviseDripRun 3.24s ease 1.42s forwards; }\n  .devise-drip--5 { left: 84%; height: 104px; animation: deviseDripRun 2.95s ease 1.34s forwards; }\n\n  .devise-email-popup__box {\n    position: relative;\n    z-index: 5;\n    width: min(100%, 470px);\n    background:\n      linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(255,249,235,0.97) 42%, rgba(234,250,255,0.99) 100%);\n    border: 1px solid rgba(255,255,255,0.80);\n    border-radius: 30px;\n    padding: 36px;\n    color: #0A0A0A;\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    box-shadow:\n      0 30px 90px rgba(0,0,0,0.34),\n      0 14px 34px rgba(34, 154, 194, 0.16),\n      inset 0 1px 0 rgba(255,255,255,0.82);\n    opacity: 0;\n    transform: translateY(22px) scale(0.95);\n    overflow: hidden;\n  }\n\n  .devise-email-popup__box::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(circle at 14% 0%, rgba(255, 222, 89, 0.24), transparent 32%),\n      radial-gradient(circle at 88% 18%, rgba(84, 214, 236, 0.24), transparent 30%),\n      linear-gradient(120deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.38) 48%, rgba(255,255,255,0) 100%);\n    pointer-events: none;\n  }\n\n  .devise-email-popup__box::after {\n    content: \"\";\n    position: absolute;\n    left: -12%;\n    right: -12%;\n    bottom: -18%;\n    height: 34%;\n    background:\n      radial-gradient(circle at 14% 0%, rgba(255,255,255,0.86) 0 10px, transparent 11px),\n      radial-gradient(circle at 34% 0%, rgba(255,255,255,0.70) 0 8px, transparent 9px),\n      radial-gradient(circle at 58% 0%, rgba(255,255,255,0.78) 0 10px, transparent 11px),\n      radial-gradient(circle at 78% 0%, rgba(255,255,255,0.68) 0 8px, transparent 9px),\n      linear-gradient(180deg, rgba(114, 225, 240, 0.18) 0%, rgba(18, 184, 205, 0.18) 100%);\n    opacity: 0.78;\n    pointer-events: none;\n  }\n\n  .devise-email-popup.is-visible .devise-email-popup__box {\n    animation: devisePopupCardIn 0.58s ease 1.18s forwards;\n  }\n\n  .devise-email-popup__close {\n    position: absolute;\n    top: 16px;\n    right: 16px;\n    width: 36px;\n    height: 36px;\n    border: 1px solid rgba(10,10,10,0.10);\n    border-radius: 999px;\n    background: rgba(255,255,255,0.74);\n    color: #0A0A0A;\n    font-size: 24px;\n    line-height: 1;\n    cursor: pointer;\n    transition: 0.18s ease;\n    z-index: 4;\n  }\n\n  .devise-email-popup__close:hover {\n    background: #0A0A0A;\n    color: #FFFFFF;\n    border-color: #0A0A0A;\n  }\n\n  .devise-email-popup__badge,\n  .devise-email-popup h2,\n  .devise-email-popup p,\n  .devise-email-popup__form,\n  .devise-email-popup small,\n  .devise-email-popup__success,\n  .devise-email-popup__error {\n    position: relative;\n    z-index: 2;\n  }\n\n  .devise-email-popup__badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: #0A0A0A;\n    color: #FFFFFF;\n    border-radius: 999px;\n    padding: 7px 13px;\n    font-size: 10px;\n    font-weight: 950;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-bottom: 16px;\n  }\n\n  .devise-email-popup h2 {\n    margin: 0;\n    font-size: clamp(36px, 6vw, 56px);\n    line-height: 0.94;\n    letter-spacing: -0.065em;\n    font-weight: 950;\n    color: #0A0A0A;\n  }\n\n  .devise-email-popup p {\n    margin: 14px 0 22px;\n    color: #334155;\n    font-size: 15px;\n    line-height: 1.55;\n    font-weight: 650;\n  }\n\n  .devise-email-popup__field {\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: 10px;\n    background: rgba(255,255,255,0.84);\n    border: 1px solid rgba(10,10,10,0.10);\n    border-radius: 16px;\n    padding: 7px;\n    box-shadow: 0 10px 24px rgba(10,10,10,0.06);\n  }\n\n  .devise-email-popup__field input {\n    min-width: 0;\n    height: 46px;\n    background: transparent;\n    border: 0;\n    outline: 0;\n    color: #0A0A0A;\n    font-family: inherit;\n    font-size: 14px;\n    padding: 0 10px;\n  }\n\n  .devise-email-popup__field input::placeholder {\n    color: #64748B;\n  }\n\n  .devise-email-popup__field button {\n    position: relative;\n    height: 46px;\n    border: 0;\n    border-radius: 12px;\n    padding: 0 16px;\n    background: linear-gradient(135deg, #FFDE59 0%, #FFB84A 100%);\n    color: #0A0A0A;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 950;\n    cursor: pointer;\n    white-space: nowrap;\n    overflow: hidden;\n    transition: 0.2s ease;\n  }\n\n  .devise-email-popup__field button::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: -80%;\n    width: 50%;\n    height: 100%;\n    background: linear-gradient(\n      120deg,\n      rgba(255,255,255,0) 0%,\n      rgba(255,255,255,0.55) 50%,\n      rgba(255,255,255,0) 100%\n    );\n    transform: skewX(-22deg);\n    transition: 0.35s ease;\n  }\n\n  .devise-email-popup__field button:hover {\n    transform: translateY(-1px);\n    background: #0A0A0A;\n    color: #FFFFFF;\n  }\n\n  .devise-email-popup__field button:hover::after {\n    left: 130%;\n  }\n\n  .devise-email-popup small {\n    display: block;\n    margin-top: 12px;\n    color: #64748B;\n    font-size: 11px;\n    line-height: 1.45;\n    text-align: center;\n  }\n\n  .devise-email-popup__success {\n    background: rgba(20, 184, 166, 0.12);\n    border: 1px solid rgba(20, 184, 166, 0.35);\n    color: #0F766E;\n    padding: 14px 16px;\n    border-radius: 12px;\n    font-size: 14px;\n    font-weight: 850;\n  }\n\n  .devise-email-popup__error {\n    background: rgba(239,68,68,0.10);\n    border: 1px solid rgba(239,68,68,0.35);\n    color: #EF4444;\n    padding: 12px 14px;\n    border-radius: 12px;\n    margin-bottom: 14px;\n    font-size: 13px;\n    font-weight: 750;\n  }\n\n  body.devise-popup-open {\n    overflow: hidden;\n  }\n\n  @keyframes deviseOverlayIn {\n    from { opacity: 0; }\n    to { opacity: 1; }\n  }\n\n  @keyframes deviseSunIn {\n    from {\n      opacity: 0;\n      transform: scale(0.75);\n    }\n\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n\n  @keyframes deviseSurferRide {\n    0% {\n      opacity: 0;\n      left: -170px;\n      transform: translateY(34px) rotate(-8deg) scale(0.96);\n    }\n\n    14% {\n      opacity: 1;\n    }\n\n    48% {\n      opacity: 1;\n      left: 41%;\n      transform: translateY(-22px) rotate(5deg) scale(1);\n    }\n\n    68% {\n      opacity: 1;\n      left: 56%;\n      transform: translateY(0) rotate(-2deg) scale(1);\n    }\n\n    100% {\n      opacity: 0;\n      left: 112%;\n      transform: translateY(20px) rotate(10deg) scale(0.98);\n    }\n  }\n\n  @keyframes deviseSurfSprayOne {\n    0%, 100% {\n      transform: translateX(0) rotate(-8deg);\n      opacity: 0.55;\n    }\n\n    50% {\n      transform: translateX(-13px) rotate(-8deg);\n      opacity: 1;\n    }\n  }\n\n  @keyframes deviseSurfSprayTwo {\n    0%, 100% {\n      transform: translateX(0) rotate(5deg);\n      opacity: 0.38;\n    }\n\n    50% {\n      transform: translateX(-8px) rotate(5deg);\n      opacity: 0.86;\n    }\n  }\n\n  @keyframes deviseSplashBack {\n    0% {\n      opacity: 0;\n      transform: translateY(100%) scaleY(1.06);\n    }\n\n    18% {\n      opacity: 1;\n    }\n\n    54% {\n      opacity: 1;\n      transform: translateY(8%) scaleY(1);\n    }\n\n    100% {\n      opacity: 0;\n      transform: translateY(112%) scaleY(1.04);\n    }\n  }\n\n  @keyframes deviseSplashFront {\n    0% {\n      opacity: 0;\n      transform: translateY(100%) scaleY(1.08);\n    }\n\n    16% {\n      opacity: 1;\n    }\n\n    50% {\n      opacity: 1;\n      transform: translateY(2%) scaleY(1);\n    }\n\n    100% {\n      opacity: 0;\n      transform: translateY(118%) scaleY(1.04);\n    }\n  }\n\n  @keyframes deviseFoamIn {\n    0% {\n      opacity: 0;\n      transform: translateY(70px) scaleY(0.9);\n    }\n\n    24% {\n      opacity: 1;\n    }\n\n    54% {\n      opacity: 0.96;\n      transform: translateY(0) scaleY(1);\n    }\n\n    100% {\n      opacity: 0;\n      transform: translateY(132px) scaleY(1.04);\n    }\n  }\n\n  @keyframes deviseWaterPop1 {\n    0% { opacity: 0; transform: translateY(220px) translateX(0) scale(0.5); }\n    30% { opacity: 1; transform: translateY(35px) translateX(-16px) scale(1); }\n    100% { opacity: 0; transform: translateY(340px) translateX(-24px) scale(0.72); }\n  }\n\n  @keyframes deviseWaterPop2 {\n    0% { opacity: 0; transform: translateY(220px) translateX(0) scale(0.5); }\n    28% { opacity: 1; transform: translateY(18px) translateX(-10px) scale(1.1); }\n    100% { opacity: 0; transform: translateY(330px) translateX(-18px) scale(0.75); }\n  }\n\n  @keyframes deviseWaterPop3 {\n    0% { opacity: 0; transform: translateY(220px) translateX(0) scale(0.5); }\n    31% { opacity: 1; transform: translateY(50px) translateX(8px) scale(1); }\n    100% { opacity: 0; transform: translateY(355px) translateX(16px) scale(0.72); }\n  }\n\n  @keyframes deviseWaterPop4 {\n    0% { opacity: 0; transform: translateY(220px) translateX(0) scale(0.5); }\n    30% { opacity: 1; transform: translateY(30px) translateX(12px) scale(1); }\n    100% { opacity: 0; transform: translateY(345px) translateX(24px) scale(0.75); }\n  }\n\n  @keyframes deviseWaterPop5 {\n    0% { opacity: 0; transform: translateY(220px) translateX(0) scale(0.5); }\n    28% { opacity: 1; transform: translateY(20px) translateX(18px) scale(1.08); }\n    100% { opacity: 0; transform: translateY(335px) translateX(30px) scale(0.7); }\n  }\n\n  @keyframes deviseWaterPop6 {\n    0% { opacity: 0; transform: translateY(220px) translateX(0) scale(0.5); }\n    27% { opacity: 1; transform: translateY(28px) translateX(20px) scale(1); }\n    100% { opacity: 0; transform: translateY(320px) translateX(34px) scale(0.72); }\n  }\n\n  @keyframes deviseDripRun {\n    0% {\n      opacity: 0;\n      transform: translateY(-100px) scaleY(0.4);\n    }\n\n    10% {\n      opacity: 1;\n      transform: translateY(0) scaleY(1);\n    }\n\n    80% {\n      opacity: 0.9;\n      transform: translateY(70vh) scaleY(1.06);\n    }\n\n    100% {\n      opacity: 0;\n      transform: translateY(88vh) scaleY(1.12);\n    }\n  }\n\n  @keyframes devisePopupCardIn {\n    0% {\n      opacity: 0;\n      transform: translateY(22px) scale(0.95);\n    }\n\n    72% {\n      opacity: 1;\n      transform: translateY(-4px) scale(1.01);\n    }\n\n    100% {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n    }\n  }\n\n  @media (max-width: 520px) {\n    .devise-email-popup {\n      padding: 14px;\n    }\n\n    .devise-email-popup__box {\n      padding: 28px 20px;\n      border-radius: 24px;\n    }\n\n    .devise-email-popup__surfer {\n      width: 122px;\n      height: 100px;\n      bottom: 34%;\n    }\n\n    .devise-email-popup__surfer-head {\n      left: 54px;\n      width: 22px;\n      height: 22px;\n    }\n\n    .devise-email-popup__surfer-hair {\n      left: 50px;\n      width: 28px;\n      height: 16px;\n    }\n\n    .devise-email-popup__surfer-body {\n      left: 49px;\n      top: 34px;\n      width: 32px;\n      height: 36px;\n    }\n\n    .devise-email-popup__surfboard {\n      left: 10px;\n      top: 76px;\n      width: 110px;\n      height: 21px;\n    }\n\n    .devise-email-popup__splash-svg {\n      height: 86%;\n      bottom: -64%;\n    }\n\n    .devise-drip {\n      width: 12px;\n    }\n\n    .devise-email-popup__field {\n      grid-template-columns: 1fr;\n    }\n\n    .devise-email-popup__field button {\n      width: 100%;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .devise-email-popup__fx {\n      display: none;\n    }\n\n    .devise-email-popup.is-visible .devise-email-popup__box {\n      animation: devisePopupCardIn 0.2s ease forwards;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const popup = document.getElementById(\"deviseEmailPopup\");\n    if (!popup) return;\n\n    const storageKey = \"devise_email_popup_closed\";\n    const submittedKey = \"devise_email_popup_submitted\";\n    const delay = 1200;\n    const hideDays = 7;\n\n    function setWithExpiry(key, value, days) {\n      const now = new Date();\n      const item = {\n        value: value,\n        expiry: now.getTime() + days * 24 * 60 * 60 * 1000\n      };\n      localStorage.setItem(key, JSON.stringify(item));\n    }\n\n    function getWithExpiry(key) {\n      const itemStr = localStorage.getItem(key);\n      if (!itemStr) return null;\n\n      try {\n        const item = JSON.parse(itemStr);\n        const now = new Date();\n\n        if (now.getTime() > item.expiry) {\n          localStorage.removeItem(key);\n          return null;\n        }\n\n        return item.value;\n      } catch (e) {\n        localStorage.removeItem(key);\n        return null;\n      }\n    }\n\n    function openPopup() {\n      popup.classList.add(\"is-visible\");\n      popup.setAttribute(\"aria-hidden\", \"false\");\n      document.body.classList.add(\"devise-popup-open\");\n\n      const emailInput = document.getElementById(\"devisePopupEmail\");\n      if (emailInput) {\n        setTimeout(function () {\n          emailInput.focus();\n        }, 1450);\n      }\n    }\n\n    function closePopup() {\n      popup.classList.remove(\"is-visible\");\n      popup.setAttribute(\"aria-hidden\", \"true\");\n      document.body.classList.remove(\"devise-popup-open\");\n      setWithExpiry(storageKey, \"true\", hideDays);\n    }\n\n    popup.querySelectorAll(\"[data-popup-close]\").forEach(function (button) {\n      button.addEventListener(\"click\", closePopup);\n    });\n\n    document.addEventListener(\"keydown\", function (event) {\n      if (event.key === \"Escape\" && popup.classList.contains(\"is-visible\")) {\n        closePopup();\n      }\n    });\n\n    const form = document.getElementById(\"devise-popup-newsletter-form\");\n    if (form) {\n      form.addEventListener(\"submit\", function () {\n        localStorage.setItem(submittedKey, \"true\");\n      });\n    }\n\n    const hasSubmitted = localStorage.getItem(submittedKey) === \"true\";\n    const hasClosed = getWithExpiry(storageKey) === \"true\";\n\n    {% if form.posted_successfully? %}\n      openPopup();\n      localStorage.setItem(submittedKey, \"true\");\n    {% else %}\n      if (!hasSubmitted && !hasClosed) {\n        setTimeout(openPopup, delay);\n      }\n    {% endif %}\n  });\n</script>",
