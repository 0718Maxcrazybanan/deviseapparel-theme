    "custom_liquid_BVaKUF": {
      "type": "custom-liquid",
      "name": "review liquid",
      "settings": {
        "custom_liquid": "{% assign jm_metafields = shop.metafields.judgeme %}\n{% assign jm_rating = jm_metafields.all_reviews_rating | default: 4.9 %}\n{% assign jm_count = jm_metafields.all_reviews_count | default: 100 %}\n\n<section class=\"devise-judgeme-reviews\">\n  <div class=\"devise-judgeme-reviews__inner\">\n\n    <div class=\"devise-judgeme-reviews__header\">\n      <span>Recensioner</span>\n      <h2>Älskad av våra kunder</h2>\n      <p>Riktiga recensioner  via Judge.me.</p>\n    </div>\n\n    <div class=\"devise-judgeme-reviews__stats\">\n      <div>\n        <strong>{{ jm_rating | round: 1 }}/5</strong>\n        <span>Betyg</span>\n      </div>\n\n      <div>\n        <strong>{{ jm_count }}</strong>\n        <span>Recensioner</span>\n      </div>\n\n      <div>\n        <strong>24h</strong>\n        <span>Respons</span>\n      </div>\n    </div>\n\n    <div class=\"devise-judgeme-reviews__carousel\">\n      <!-- Start of Judge.me Reviews Carousel -->\n      <div class=\"jdgm-carousel-wrapper devise-jdgm-wrapper\">\n        <div class=\"jdgm-carousel-title-and-link devise-jdgm-hide-title\">\n          <h2 class=\"jdgm-carousel-title\">Let customers speak for us</h2>\n          <span class=\"jdgm-all-reviews-rating-wrapper\" href=\"javascript:void(0)\">\n            <span\n              style=\"display:block\"\n              data-score=\"{{ jm_metafields.all_reviews_rating }}\"\n              class=\"jdgm-all-reviews-rating\"\n              aria-label=\"{{ jm_metafields.all_reviews_rating }} stars\"\n              tabindex=\"0\"\n              role=\"img\">\n            </span>\n\n            <span\n              style=\"display:block\"\n              class=\"jdgm-carousel-number-of-reviews\"\n              data-number-of-reviews=\"{{ jm_metafields.all_reviews_count }}\">\n              from {{ jm_metafields.all_reviews_count }} reviews\n            </span>\n          </span>\n        </div>\n\n        {{ jm_metafields.featured_carousel }}\n      </div>\n      <!-- End of Judge.me Reviews Carousel -->\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .devise-judgeme-reviews {\n    background: #0A0A0A;\n    color: #FFFFFF;\n    font-family: Inter, Arial, sans-serif;\n    padding: 58px 20px;\n    overflow: hidden;\n  }\n\n  .devise-judgeme-reviews * {\n    box-sizing: border-box;\n  }\n\n  .devise-judgeme-reviews__inner {\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  .devise-judgeme-reviews__header {\n    max-width: 620px;\n    margin: 0 auto 26px;\n    text-align: center;\n  }\n\n  .devise-judgeme-reviews__header span {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: #FFDE59;\n    color: #0A0A0A;\n    border-radius: 999px;\n    padding: 7px 13px;\n    font-size: 11px;\n    font-weight: 950;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-bottom: 13px;\n  }\n\n  .devise-judgeme-reviews__header h2 {\n    margin: 0;\n    font-size: clamp(32px, 5vw, 52px);\n    line-height: 0.98;\n    letter-spacing: -0.055em;\n    font-weight: 950;\n  }\n\n  .devise-judgeme-reviews__header p {\n    max-width: 520px;\n    margin: 14px auto 0;\n    color: #A0A0A0;\n    font-size: 15px;\n    line-height: 1.55;\n    font-weight: 500;\n  }\n\n  .devise-judgeme-reviews__stats {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 12px;\n    margin-bottom: 22px;\n  }\n\n  .devise-judgeme-reviews__stats div {\n    background: #111111;\n    border: 1px solid rgba(255, 222, 89, 0.16);\n    border-radius: 16px;\n    padding: 17px 12px;\n    text-align: center;\n  }\n\n  .devise-judgeme-reviews__stats strong {\n    display: block;\n    color: #FFDE59;\n    font-size: 24px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: -0.04em;\n  }\n\n  .devise-judgeme-reviews__stats span {\n    display: block;\n    color: #A0A0A0;\n    font-size: 12px;\n    font-weight: 750;\n    margin-top: 7px;\n  }\n\n  .devise-judgeme-reviews__carousel {\n    background: transparent;\n  }\n\n  .devise-jdgm-hide-title {\n    display: none !important;\n  }\n\n  .devise-jdgm-wrapper {\n    width: 100% !important;\n    max-width: 100% !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    background: transparent !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel {\n    width: 100% !important;\n    max-width: 100% !important;\n    background: transparent !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel__item-wrapper,\n  .devise-jdgm-wrapper .jdgm-carousel-item-container {\n    background: transparent !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel-item {\n    background: linear-gradient(180deg, #151515 0%, #101010 100%) !important;\n    border: 1px solid rgba(255, 222, 89, 0.16) !important;\n    border-radius: 18px !important;\n    padding: 20px !important;\n    min-height: 194px !important;\n    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.28) !important;\n    transition: 0.22s ease !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel-item:hover {\n    transform: translateY(-3px);\n    border-color: rgba(255, 222, 89, 0.7) !important;\n    box-shadow: 0 0 28px rgba(255, 222, 89, 0.10) !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-star,\n  .devise-jdgm-wrapper .jdgm-prev-badge__stars,\n  .devise-jdgm-wrapper .jdgm-carousel-item__review-rating {\n    color: #FFDE59 !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel-item__review,\n  .devise-jdgm-wrapper .jdgm-carousel-item__review-body,\n  .devise-jdgm-wrapper .jdgm-rev__body {\n    color: #FFFFFF !important;\n    font-size: 14px !important;\n    line-height: 1.5 !important;\n    font-weight: 550 !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel-item__reviewer-name,\n  .devise-jdgm-wrapper .jdgm-rev__author {\n    color: #FFFFFF !important;\n    font-size: 13px !important;\n    font-weight: 900 !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel-item__product,\n  .devise-jdgm-wrapper .jdgm-carousel-item__timestamp,\n  .devise-jdgm-wrapper .jdgm-rev__timestamp {\n    color: #A0A0A0 !important;\n    font-size: 11px !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel__left-arrow,\n  .devise-jdgm-wrapper .jdgm-carousel__right-arrow {\n    border-color: #FFDE59 !important;\n  }\n\n  .devise-jdgm-wrapper .jdgm-carousel__arrows {\n    margin-top: 18px !important;\n  }\n\n  .devise-jdgm-wrapper a {\n    color: #FFDE59 !important;\n  }\n\n  @media (max-width: 900px) {\n    .devise-judgeme-reviews {\n      padding: 48px 16px;\n    }\n  }\n\n  @media (max-width: 620px) {\n    .devise-judgeme-reviews {\n      padding: 42px 0;\n    }\n\n    .devise-judgeme-reviews__header {\n      padding: 0 16px;\n      margin-bottom: 22px;\n    }\n\n    .devise-judgeme-reviews__header span {\n      font-size: 10px;\n      padding: 6px 11px;\n      margin-bottom: 11px;\n    }\n\n    .devise-judgeme-reviews__header h2 {\n      font-size: 32px;\n      line-height: 1;\n      letter-spacing: -0.05em;\n    }\n\n    .devise-judgeme-reviews__header p {\n      font-size: 13px;\n      line-height: 1.5;\n      margin-top: 11px;\n    }\n\n    .devise-judgeme-reviews__stats {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 8px;\n      padding: 0 16px;\n      margin-bottom: 18px;\n    }\n\n    .devise-judgeme-reviews__stats div {\n      border-radius: 13px;\n      padding: 13px 6px;\n    }\n\n    .devise-judgeme-reviews__stats strong {\n      font-size: 18px;\n    }\n\n    .devise-judgeme-reviews__stats span {\n      font-size: 10px;\n      margin-top: 5px;\n    }\n\n    .devise-judgeme-reviews__carousel {\n      padding: 0 16px;\n    }\n\n    .devise-jdgm-wrapper .jdgm-carousel-item {\n      border-radius: 16px !important;\n      padding: 17px !important;\n      min-height: 180px !important;\n    }\n\n    .devise-jdgm-wrapper .jdgm-carousel-item__review,\n    .devise-jdgm-wrapper .jdgm-carousel-item__review-body,\n    .devise-jdgm-wrapper .jdgm-rev__body {\n      font-size: 13px !important;\n      line-height: 1.45 !important;\n    }\n  }\n\n  @media (max-width: 360px) {\n    .devise-judgeme-reviews__stats {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>",
