{
  "sections": {
    "custom_liquid_ULmi8h": {
      "type": "custom-liquid",
      "name": "Produkter",
      "settings": {
        "custom_liquid": "{% assign devise_collection_handle = 'home-page' %}\n{% assign devise_collection = collections[devise_collection_handle] %}\n{% assign devise_instance_id = section.id | default: 'devise-products' %}\n\n{% comment %}\n  =====================================================\n  FÄRGER\n  =====================================================\n{% endcomment %}\n\n{% assign color_section_background = '#EEF1EA' %}\n\n{% assign color_label_text = '#0A0A0A' %}\n{% assign color_heading_text = '#0A0A0A' %}\n{% assign color_description_text = '#474747' %}\n\n{% assign color_product_title = '#0A0A0A' %}\n{% assign color_product_title_hover = '#555555' %}\n{% assign color_product_price = '#0A0A0A' %}\n\n{% assign color_image_background = '#E4E7DF' %}\n{% assign color_image_border = '#CDD1C8' %}\n{% assign color_image_border_hover = '#0A0A0A' %}\n\n{% assign color_choose_background = '#0A0A0A' %}\n{% assign color_choose_text = '#FFFFFF' %}\n{% assign color_choose_hover = '#292929' %}\n\n{% assign color_design_link = '#FFDE59' %}\n{% assign color_design_link_hover = '#D1AA00' %}\n\n{% assign color_soldout_background = '#D6D9D2' %}\n{% assign color_soldout_text = '#777777' %}\n\n{% assign color_popup_background = '#FFFFFF' %}\n{% assign color_popup_border = '#0A0A0A' %}\n{% assign color_popup_overlay = 'rgba(0, 0, 0, 0.58)' %}\n\n<script\n  type=\"module\"\n  src=\"{{ 'product-form.js' | asset_url }}\"\n  fetchpriority=\"low\"\n></script>\n\n<section\n  class=\"devise-direct-products\"\n  data-devise-product-section\n>\n  <div class=\"devise-direct-inner\">\n\n    <div class=\"devise-direct-head\">\n      <span>Färdiga Produkter</span>\n\n      <h2>Köp direkt</h2>\n\n      <p>\n        Klicka in på en produkt eller lägg den direkt i kundvagnen\n      </p>\n    </div>\n\n    <div class=\"devise-direct-grid\">\n\n      {% for product in devise_collection.products limit: 50 %}\n\n        <article class=\"devise-direct-card\">\n\n          <a\n            href=\"{{ product.url }}\"\n            class=\"devise-direct-image\"\n            aria-label=\"Öppna {{ product.title | escape }}\"\n          >\n            {% if product.featured_image %}\n\n              <img\n                src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                srcset=\"\n                  {{ product.featured_image | image_url: width: 360 }} 360w,\n                  {{ product.featured_image | image_url: width: 540 }} 540w,\n                  {{ product.featured_image | image_url: width: 720 }} 720w,\n                  {{ product.featured_image | image_url: width: 900 }} 900w\n                \"\n                sizes=\"\n                  (max-width: 760px) 46vw,\n                  (max-width: 1050px) 31vw,\n                  (max-width: 1350px) 23vw,\n                  19vw\n                \"\n                alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                loading=\"lazy\"\n                width=\"{{ product.featured_image.width }}\"\n                height=\"{{ product.featured_image.height }}\"\n              >\n\n            {% else %}\n\n              <div class=\"devise-direct-placeholder\">\n                DeviseApparel\n              </div>\n\n            {% endif %}\n          </a>\n\n          <div class=\"devise-direct-content\">\n\n            <a\n              href=\"{{ product.url }}\"\n              class=\"devise-direct-title\"\n            >\n              {{ product.title }}\n            </a>\n\n            <div class=\"devise-direct-price\">\n              {{ product.price | money }}\n            </div>\n\n            {% if product.available %}\n\n              <button\n                type=\"button\"\n                class=\"devise-direct-choose\"\n                data-devise-open=\"devisePopup-{{ devise_instance_id }}-{{ product.id }}\"\n                aria-haspopup=\"dialog\"\n                aria-controls=\"devisePopup-{{ devise_instance_id }}-{{ product.id }}\"\n              >\n                Välj Alternativ\n              </button>\n\n            {% else %}\n\n              <button\n                type=\"button\"\n                class=\"devise-direct-choose devise-direct-soldout\"\n                disabled\n              >\n                Slutsåld\n              </button>\n\n            {% endif %}\n\n            <a\n              href=\"/pages/contact\"\n              class=\"devise-direct-design-link\"\n            >\n              Designa Själv\n            </a>\n\n          </div>\n\n        </article>\n\n      {% endfor %}\n\n    </div>\n\n    {% if devise_collection.products_count > 4 %}\n\n      <div\n        class=\"devise-direct-more-wrap\"\n        data-devise-more-wrap\n      >\n        <button\n          type=\"button\"\n          class=\"devise-direct-more\"\n          data-devise-more\n        >\n          Se mer\n        </button>\n      </div>\n\n    {% endif %}\n\n  </div>\n\n  {% comment %}\n    =====================================================\n    POPUPS MED HORIZONS VANLIGA PRODUKTFORMULÄR\n    =====================================================\n  {% endcomment %}\n\n  {% for product in devise_collection.products limit: 50 %}\n\n    {% if product.available %}\n\n      {% assign devise_form_id = 'DeviseProductForm-' | append: devise_instance_id | append: '-' | append: product.id %}\n\n      <dialog\n        class=\"devise-direct-popup\"\n        id=\"devisePopup-{{ devise_instance_id }}-{{ product.id }}\"\n        aria-labelledby=\"devisePopupTitle-{{ devise_instance_id }}-{{ product.id }}\"\n      >\n        <div class=\"devise-direct-popup-panel\">\n\n          <button\n            type=\"button\"\n            class=\"devise-direct-popup-close\"\n            data-devise-close\n            aria-label=\"Stäng popup\"\n          >\n            ×\n          </button>\n\n          <div class=\"devise-direct-popup-product\">\n\n            <a\n              href=\"{{ product.url }}\"\n              class=\"devise-direct-popup-image\"\n            >\n              {% if product.featured_image %}\n\n                <img\n                  src=\"{{ product.featured_image | image_url: width: 420 }}\"\n                  alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                  loading=\"lazy\"\n                  width=\"{{ product.featured_image.width }}\"\n                  height=\"{{ product.featured_image.height }}\"\n                >\n\n              {% endif %}\n            </a>\n\n            <div class=\"devise-direct-popup-info\">\n\n              <span>Välj alternativ</span>\n\n              <a\n                href=\"{{ product.url }}\"\n                id=\"devisePopupTitle-{{ devise_instance_id }}-{{ product.id }}\"\n              >\n                {{ product.title }}\n              </a>\n\n              <strong>\n                {{ product.price | money }}\n              </strong>\n\n            </div>\n\n          </div>\n\n          <product-form-component\n            id=\"DeviseProductComponent-{{ devise_instance_id }}-{{ product.id }}\"\n            data-section-id=\"{{ section.id }}\"\n            data-product-id=\"{{ product.id }}\"\n            on:submit=\"/handleSubmit\"\n          >\n            <div\n              class=\"devise-visually-hidden\"\n              aria-live=\"assertive\"\n              role=\"status\"\n              aria-atomic=\"true\"\n              ref=\"liveRegion\"\n            ></div>\n\n            {% form\n              'product',\n              product,\n              id: devise_form_id,\n              novalidate: 'novalidate',\n              data-type: 'add-to-cart-form',\n              class: 'devise-direct-popup-form'\n            %}\n\n              {% if product.variants.size > 1 %}\n\n                <label for=\"deviseVariantSelect-{{ devise_instance_id }}-{{ product.id }}\">\n                  Välj storlek eller alternativ\n                </label>\n\n                <select\n                  id=\"deviseVariantSelect-{{ devise_instance_id }}-{{ product.id }}\"\n                  class=\"devise-direct-popup-select\"\n                  data-devise-variant-select\n                  required\n                >\n                  {% for variant in product.variants %}\n\n                    <option\n                      value=\"{{ variant.id }}\"\n                      {% if variant.id == product.selected_or_first_available_variant.id %}\n                        selected\n                      {% endif %}\n                      {% unless variant.available %}\n                        disabled\n                      {% endunless %}\n                    >\n                      {{ variant.title }}\n\n                      {% unless variant.available %}\n                        — Slutsåld\n                      {% endunless %}\n                    </option>\n\n                  {% endfor %}\n                </select>\n\n              {% endif %}\n\n              <input\n                type=\"hidden\"\n                name=\"id\"\n                ref=\"variantId\"\n                value=\"{{ product.selected_or_first_available_variant.id }}\"\n                data-devise-variant-input\n              >\n\n              <input\n                type=\"hidden\"\n                name=\"quantity\"\n                value=\"1\"\n              >\n\n              <add-to-cart-component\n                ref=\"addToCartButtonContainer\"\n                data-product-variant-media=\"{{ product.featured_image | image_url: width: 100 }}\"\n                data-add-to-cart-animation=\"false\"\n              >\n                <button\n                  type=\"submit\"\n                  name=\"add\"\n                  ref=\"addToCartButton\"\n                  on:click=\"/handleClick\"\n                  class=\"devise-direct-popup-submit\"\n                >\n                  Lägg till i varukorgen\n                </button>\n              </add-to-cart-component>\n\n            {% endform %}\n\n          </product-form-component>\n\n        </div>\n      </dialog>\n\n    {% endif %}\n\n  {% endfor %}\n\n</section>\n\n<style>\n  .devise-direct-products {\n    --section-background: {{ color_section_background }};\n\n    --label-text: {{ color_label_text }};\n    --heading-text: {{ color_heading_text }};\n    --description-text: {{ color_description_text }};\n\n    --product-title: {{ color_product_title }};\n    --product-title-hover: {{ color_product_title_hover }};\n    --product-price: {{ color_product_price }};\n\n    --image-background: {{ color_image_background }};\n    --image-border: {{ color_image_border }};\n    --image-border-hover: {{ color_image_border_hover }};\n\n    --choose-background: {{ color_choose_background }};\n    --choose-text: {{ color_choose_text }};\n    --choose-hover: {{ color_choose_hover }};\n\n    --design-link: {{ color_design_link }};\n    --design-link-hover: {{ color_design_link_hover }};\n\n    --soldout-background: {{ color_soldout_background }};\n    --soldout-text: {{ color_soldout_text }};\n\n    --popup-background: {{ color_popup_background }};\n    --popup-border: {{ color_popup_border }};\n    --popup-overlay: {{ color_popup_overlay }};\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n\n    padding: 64px clamp(12px, 2vw, 32px);\n\n    background: var(--section-background);\n    color: var(--heading-text);\n\n    font-family: Inter, Arial, sans-serif;\n  }\n\n  .devise-direct-products *,\n  .devise-direct-products *::before,\n  .devise-direct-products *::after {\n    box-sizing: border-box;\n  }\n\n  .devise-direct-inner {\n    width: 100%;\n    max-width: none;\n    margin: 0;\n  }\n\n  /*\n    =====================================================\n    RUBRIK\n    =====================================================\n  */\n\n  .devise-direct-head {\n    max-width: 680px;\n    margin-bottom: 30px;\n  }\n\n  .devise-direct-head span {\n    display: inline-block;\n\n    margin-bottom: 12px;\n\n    color: var(--label-text);\n\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .devise-direct-head h2 {\n    margin: 0;\n\n    color: var(--heading-text);\n\n    font-size: clamp(34px, 5vw, 58px);\n    line-height: 0.96;\n    letter-spacing: -0.06em;\n    font-weight: 950;\n  }\n\n  .devise-direct-head p {\n    margin: 14px 0 0;\n\n    color: var(--description-text);\n\n    font-size: 15px;\n    line-height: 1.6;\n  }\n\n  /*\n    =====================================================\n    PRODUKTGRID\n    =====================================================\n  */\n\n  .devise-direct-grid {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n\n    gap:\n      38px\n      clamp(14px, 1.8vw, 30px);\n\n    width: 100%;\n  }\n\n  .devise-direct-card {\n    display: block;\n    min-width: 0;\n    background: transparent;\n  }\n\n  /*\n    Visa högst två rader:\n    5 kolumner × 2 rader = 10 produkter.\n  */\n\n  .devise-direct-card:nth-child(n + 11) {\n    display: none;\n  }\n\n  .devise-direct-products.devise-show-all\n  .devise-direct-card {\n    display: block !important;\n  }\n\n  .devise-direct-image {\n    position: relative;\n    display: block;\n\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n\n    border: 1px solid var(--image-border);\n    border-radius: 0;\n\n    background: var(--image-background);\n    text-decoration: none;\n\n    transition:\n      border-color 0.22s ease,\n      transform 0.22s ease;\n  }\n\n  .devise-direct-card:hover\n  .devise-direct-image {\n    border-color: var(--image-border-hover);\n    transform: translateY(-3px);\n  }\n\n  .devise-direct-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n\n    transition: transform 0.3s ease;\n  }\n\n  .devise-direct-card:hover\n  .devise-direct-image img {\n    transform: scale(1.025);\n  }\n\n  .devise-direct-placeholder {\n    display: grid;\n    place-items: center;\n\n    width: 100%;\n    height: 100%;\n\n    color: var(--heading-text);\n\n    font-size: 17px;\n    font-weight: 900;\n  }\n\n  .devise-direct-content {\n    padding: 15px 0 0;\n  }\n\n  .devise-direct-title {\n    display: block;\n    min-height: 38px;\n\n    color: var(--product-title);\n\n    font-size: 15px;\n    line-height: 1.25;\n    font-weight: 850;\n\n    text-decoration: none;\n\n    transition: color 0.2s ease;\n  }\n\n  .devise-direct-title:hover {\n    color: var(--product-title-hover);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .devise-direct-price {\n    margin-top: 9px;\n\n    color: var(--product-price);\n\n    font-size: 17px;\n    font-weight: 950;\n  }\n\n  /*\n    =====================================================\n    VÄLJ ALTERNATIV\n    =====================================================\n  */\n\n  .devise-direct-choose {\n    width: 100%;\n    min-height: 44px;\n\n    margin-top: 14px;\n\n    border: 1px solid var(--choose-background);\n    border-radius: 0;\n\n    background: var(--choose-background);\n    color: var(--choose-text);\n\n    font: inherit;\n    font-size: 13px;\n    font-weight: 950;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-direct-choose:hover {\n    background: var(--choose-hover);\n    transform: translateY(-2px);\n  }\n\n  .devise-direct-soldout {\n    border-color: var(--soldout-background);\n\n    background: var(--soldout-background);\n    color: var(--soldout-text);\n\n    cursor: not-allowed;\n  }\n\n  .devise-direct-soldout:hover {\n    transform: none;\n  }\n\n  /*\n    Gul Skapa design-text\n  */\n\n  .devise-direct-design-link {\n    display: inline-flex;\n\n    margin-top: 12px;\n\n    color: var(--design-link);\n\n    font-size: 12px;\n    font-weight: 950;\n    line-height: 1.4;\n\n    text-decoration: none;\n\n    transition: color 0.2s ease;\n  }\n\n  .devise-direct-design-link:hover {\n    color: var(--design-link-hover);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  /*\n    =====================================================\n    SE MER\n    =====================================================\n  */\n\n  .devise-direct-more-wrap {\n    display: flex;\n    justify-content: center;\n\n    margin-top: 42px;\n  }\n\n  .devise-direct-more-wrap[hidden] {\n    display: none !important;\n  }\n\n  .devise-direct-more {\n    min-width: 150px;\n    min-height: 48px;\n\n    padding: 0 28px;\n\n    border: 1px solid #0A0A0A;\n    border-radius: 0;\n\n    background: #0A0A0A;\n    color: #FFFFFF;\n\n    font: inherit;\n    font-size: 13px;\n    font-weight: 950;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-direct-more:hover {\n    background: #292929;\n    transform: translateY(-2px);\n  }\n\n  /*\n    =====================================================\n    POPUP\n    =====================================================\n  */\n\n  .devise-direct-popup {\n    width: min(540px, calc(100% - 40px));\n    max-width: 540px;\n    max-height: calc(100vh - 40px);\n\n    margin: auto;\n    padding: 0;\n\n    overflow: visible;\n\n    border: 0;\n    border-radius: 0;\n\n    background: transparent;\n    color: var(--heading-text);\n  }\n\n  .devise-direct-popup::backdrop {\n    background: var(--popup-overlay);\n  }\n\n  .devise-direct-popup-panel {\n    position: relative;\n\n    width: 100%;\n    max-height: calc(100vh - 40px);\n    overflow-y: auto;\n\n    padding: 24px;\n\n    border: 1px solid var(--popup-border);\n    border-radius: 0;\n\n    background: var(--popup-background);\n    color: var(--heading-text);\n\n    box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.18);\n  }\n\n  .devise-direct-popup-close {\n    position: absolute;\n    z-index: 2;\n\n    top: 12px;\n    right: 12px;\n\n    display: grid;\n    place-items: center;\n\n    width: 38px;\n    height: 38px;\n\n    padding: 0;\n\n    border: 1px solid var(--heading-text);\n    border-radius: 0;\n\n    background: #FFFFFF;\n    color: var(--heading-text);\n\n    font: inherit;\n    font-size: 25px;\n    line-height: 1;\n\n    cursor: pointer;\n  }\n\n  .devise-direct-popup-product {\n    display: grid;\n    grid-template-columns: 120px minmax(0, 1fr);\n\n    gap: 20px;\n    align-items: center;\n\n    padding-right: 36px;\n  }\n\n  .devise-direct-popup-image {\n    display: block;\n\n    overflow: hidden;\n    aspect-ratio: 1 / 1;\n\n    border: 1px solid var(--image-border);\n    border-radius: 0;\n\n    background: var(--image-background);\n  }\n\n  .devise-direct-popup-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n  }\n\n  .devise-direct-popup-info span {\n    display: block;\n\n    margin-bottom: 7px;\n\n    color: #606060;\n\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .devise-direct-popup-info a {\n    display: block;\n\n    margin: 0 0 10px;\n\n    color: var(--heading-text);\n\n    font-size: clamp(22px, 4vw, 30px);\n    line-height: 1.03;\n    font-weight: 950;\n    letter-spacing: -0.04em;\n\n    text-decoration: none;\n  }\n\n  .devise-direct-popup-info a:hover {\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .devise-direct-popup-info strong {\n    color: var(--heading-text);\n\n    font-size: 16px;\n    font-weight: 950;\n  }\n\n  .devise-direct-popup-form {\n    margin-top: 24px;\n  }\n\n  .devise-direct-popup-form label {\n    display: block;\n\n    margin-bottom: 8px;\n\n    color: var(--heading-text);\n\n    font-size: 12px;\n    font-weight: 850;\n  }\n\n  .devise-direct-popup-select {\n    width: 100%;\n    min-height: 50px;\n\n    padding: 0 12px;\n\n    border: 1px solid var(--heading-text);\n    border-radius: 0;\n\n    background: #FFFFFF;\n    color: var(--heading-text);\n\n    font: inherit;\n    font-size: 14px;\n    font-weight: 700;\n\n    outline: none;\n  }\n\n  .devise-direct-popup-select:focus {\n    outline: 2px solid #FFDE59;\n    outline-offset: 2px;\n  }\n\n  add-to-cart-component {\n    display: block;\n  }\n\n  .devise-direct-popup-submit {\n    width: 100%;\n    min-height: 50px;\n\n    margin-top: 12px;\n\n    border: 1px solid #0A0A0A;\n    border-radius: 0;\n\n    background: #0A0A0A;\n    color: #FFFFFF;\n\n    font: inherit;\n    font-size: 14px;\n    font-weight: 950;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .devise-direct-popup-submit:hover {\n    background: #292929;\n    transform: translateY(-2px);\n  }\n\n  .devise-direct-popup-submit:disabled {\n    opacity: 0.6;\n    cursor: wait;\n    transform: none;\n  }\n\n  .devise-visually-hidden {\n    position: absolute !important;\n\n    width: 1px !important;\n    height: 1px !important;\n\n    padding: 0 !important;\n    margin: -1px !important;\n\n    overflow: hidden !important;\n    clip: rect(0, 0, 0, 0) !important;\n\n    white-space: nowrap !important;\n    border: 0 !important;\n  }\n\n  /*\n    =====================================================\n    FYRA KOLUMNER — MAX TVÅ RADER\n    =====================================================\n  */\n\n  @media (max-width: 1350px) {\n    .devise-direct-grid {\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n    }\n\n    .devise-direct-card:nth-child(n + 9) {\n      display: none;\n    }\n  }\n\n  /*\n    =====================================================\n    TRE KOLUMNER — MAX TVÅ RADER\n    =====================================================\n  */\n\n  @media (max-width: 1050px) {\n    .devise-direct-grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n\n    .devise-direct-card:nth-child(n + 7) {\n      display: none;\n    }\n  }\n\n  /*\n    =====================================================\n    MOBIL — TVÅ KOLUMNER OCH MAX TVÅ RADER\n    =====================================================\n  */\n\n  @media (max-width: 760px) {\n    .devise-direct-products {\n      padding: 44px 12px 56px;\n    }\n\n    .devise-direct-head {\n      margin-bottom: 26px;\n    }\n\n    .devise-direct-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 30px 10px;\n    }\n\n    .devise-direct-card:nth-child(n + 5) {\n      display: none;\n    }\n  }\n\n  @media (max-width: 560px) {\n    .devise-direct-head span {\n      margin-bottom: 9px;\n      font-size: 10px;\n    }\n\n    .devise-direct-head h2 {\n      font-size: 30px;\n      line-height: 1;\n      letter-spacing: -0.05em;\n    }\n\n    .devise-direct-head p {\n      margin-top: 10px;\n      font-size: 13px;\n    }\n\n    .devise-direct-grid {\n      gap: 28px 9px;\n    }\n\n    .devise-direct-content {\n      padding-top: 10px;\n    }\n\n    .devise-direct-title {\n      min-height: 32px;\n\n      font-size: 12px;\n      line-height: 1.25;\n    }\n\n    .devise-direct-price {\n      margin-top: 6px;\n      font-size: 14px;\n    }\n\n    .devise-direct-choose {\n      min-height: 38px;\n      margin-top: 10px;\n\n      font-size: 11px;\n    }\n\n    .devise-direct-design-link {\n      margin-top: 8px;\n      font-size: 10px;\n    }\n\n    .devise-direct-more {\n      min-height: 44px;\n      font-size: 12px;\n    }\n\n    .devise-direct-popup {\n      width: calc(100% - 24px);\n      max-height: calc(100vh - 24px);\n    }\n\n    .devise-direct-popup-panel {\n      max-height: calc(100vh - 24px);\n\n      padding: 18px 14px;\n\n      box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.18);\n    }\n\n    .devise-direct-popup-product {\n      grid-template-columns: 82px minmax(0, 1fr);\n\n      gap: 13px;\n      padding-right: 34px;\n    }\n\n    .devise-direct-popup-info a {\n      font-size: 20px;\n    }\n\n    .devise-direct-popup-info strong {\n      font-size: 14px;\n    }\n\n    .devise-direct-popup-form {\n      margin-top: 18px;\n    }\n\n    .devise-direct-popup-select,\n    .devise-direct-popup-submit {\n      min-height: 46px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .devise-direct-products *,\n    .devise-direct-products *::before,\n    .devise-direct-products *::after {\n      transition: none !important;\n      animation: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function initializeDeviseProducts(section) {\n      if (\n        !section ||\n        section.dataset.deviseInitialized === \"true\"\n      ) {\n        return;\n      }\n\n      section.dataset.deviseInitialized = \"true\";\n\n      const grid = section.querySelector(\n        \".devise-direct-grid\"\n      );\n\n      const cards = Array.prototype.slice.call(\n        section.querySelectorAll(\n          \".devise-direct-card\"\n        )\n      );\n\n      const moreButton = section.querySelector(\n        \"[data-devise-more]\"\n      );\n\n      const moreWrap = section.querySelector(\n        \"[data-devise-more-wrap]\"\n      );\n\n      /*\n        Gör så att Horizons sidovarukorg öppnas\n        automatiskt efter Lägg till i varukorgen.\n      */\n\n      function enableCartDrawerAutoOpen() {\n        const cartDrawerComponent =\n          document.querySelector(\n            \"cart-drawer-component\"\n          );\n\n        if (cartDrawerComponent) {\n          cartDrawerComponent.setAttribute(\n            \"auto-open\",\n            \"\"\n          );\n        }\n      }\n\n      enableCartDrawerAutoOpen();\n\n      customElements\n        .whenDefined(\"cart-drawer-component\")\n        .then(enableCartDrawerAutoOpen)\n        .catch(function () {});\n\n      /*\n        Räkna hur många kolumner som visas och\n        visa Se mer endast när fler än två rader finns.\n      */\n\n      function getColumnCount() {\n        if (!grid) {\n          return 1;\n        }\n\n        const templateColumns =\n          window\n            .getComputedStyle(grid)\n            .gridTemplateColumns;\n\n        if (!templateColumns) {\n          return 1;\n        }\n\n        return templateColumns\n          .split(\" \")\n          .filter(Boolean)\n          .length;\n      }\n\n      function updateMoreButton() {\n        if (!moreWrap) {\n          return;\n        }\n\n        if (\n          section.classList.contains(\n            \"devise-show-all\"\n          )\n        ) {\n          moreWrap.hidden = true;\n          return;\n        }\n\n        const columns = getColumnCount();\n        const twoRows = columns * 2;\n\n        moreWrap.hidden =\n          cards.length <= twoRows;\n      }\n\n      if (moreButton) {\n        moreButton.addEventListener(\n          \"click\",\n          function () {\n            section.classList.add(\n              \"devise-show-all\"\n            );\n\n            if (moreWrap) {\n              moreWrap.hidden = true;\n            }\n          }\n        );\n      }\n\n      let resizeTimer = null;\n\n      window.addEventListener(\n        \"resize\",\n        function () {\n          window.clearTimeout(resizeTimer);\n\n          resizeTimer = window.setTimeout(\n            updateMoreButton,\n            120\n          );\n        }\n      );\n\n      updateMoreButton();\n\n      /*\n        Öppna popup.\n      */\n\n      section\n        .querySelectorAll(\"[data-devise-open]\")\n        .forEach(function (button) {\n          button.addEventListener(\n            \"click\",\n            function () {\n              const popupId =\n                button.getAttribute(\n                  \"data-devise-open\"\n                );\n\n              const popup =\n                document.getElementById(\n                  popupId\n                );\n\n              if (\n                popup &&\n                typeof popup.showModal ===\n                  \"function\"\n              ) {\n                popup.showModal();\n\n                const select =\n                  popup.querySelector(\n                    \"[data-devise-variant-select]\"\n                  );\n\n                if (select) {\n                  select.focus();\n                }\n              }\n            }\n          );\n        });\n\n      /*\n        Stäng popup med kryss.\n      */\n\n      section\n        .querySelectorAll(\n          \"[data-devise-close]\"\n        )\n        .forEach(function (button) {\n          button.addEventListener(\n            \"click\",\n            function () {\n              const popup =\n                button.closest(\n                  \".devise-direct-popup\"\n                );\n\n              if (\n                popup &&\n                typeof popup.close ===\n                  \"function\"\n              ) {\n                popup.close();\n              }\n            }\n          );\n        });\n\n      /*\n        Stäng popup när kunden trycker utanför rutan.\n      */\n\n      section\n        .querySelectorAll(\n          \".devise-direct-popup\"\n        )\n        .forEach(function (popup) {\n          popup.addEventListener(\n            \"click\",\n            function (event) {\n              if (event.target === popup) {\n                popup.close();\n              }\n            }\n          );\n        });\n\n      /*\n        Synka dropdownens variant med Shopifys\n        riktiga dolda variantfält.\n      */\n\n      section\n        .querySelectorAll(\n          \"[data-devise-variant-select]\"\n        )\n        .forEach(function (select) {\n          const form =\n            select.closest(\"form\");\n\n          const variantInput =\n            form\n              ? form.querySelector(\n                  \"[data-devise-variant-input]\"\n                )\n              : null;\n\n          function updateVariantInput() {\n            if (variantInput) {\n              variantInput.value =\n                select.value;\n\n              variantInput.dispatchEvent(\n                new Event(\"change\", {\n                  bubbles: true\n                })\n              );\n            }\n          }\n\n          select.addEventListener(\n            \"change\",\n            updateVariantInput\n          );\n\n          updateVariantInput();\n        });\n\n      /*\n        Stäng val-popupen när formuläret skickas.\n        Horizons sidovarukorg öppnas sedan när\n        produkten har lagts till.\n      */\n\n      section\n        .querySelectorAll(\n          \".devise-direct-popup-form\"\n        )\n        .forEach(function (form) {\n          form.addEventListener(\n            \"submit\",\n            function () {\n              const popup =\n                form.closest(\n                  \".devise-direct-popup\"\n                );\n\n              window.setTimeout(\n                function () {\n                  if (\n                    popup &&\n                    popup.open\n                  ) {\n                    popup.close();\n                  }\n                },\n                80\n              );\n            }\n          );\n        });\n    }\n\n    function initializeAllDeviseProducts() {\n      document\n        .querySelectorAll(\n          \"[data-devise-product-section]\"\n        )\n        .forEach(\n          initializeDeviseProducts\n        );\n    }\n\n    if (\n      document.readyState === \"loading\"\n    ) {\n      document.addEventListener(\n        \"DOMContentLoaded\",\n        initializeAllDeviseProducts\n      );\n    } else {\n      initializeAllDeviseProducts();\n    }\n\n    document.addEventListener(\n      \"shopify:section:load\",\n      initializeAllDeviseProducts\n    );\n  })();\n</script>",
