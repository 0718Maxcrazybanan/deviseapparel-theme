==========================================\n  */\n\n  #DeviseEditorial-{{ devise_editorial_id }}\n  .devise-editorial-v4__reveal {\n    transition:\n      opacity 0.55s ease,\n      transform 0.55s\n      cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  #DeviseEditorial-{{ devise_editorial_id }}.is-ready:not(.is-visible)\n  .devise-editorial-v4__reveal {\n    opacity: 0;\n\n    transform:\n      translateY(18px);\n  }\n\n  /*\n    =====================================================\n    MINDRE DATOR OCH SURFPLATTA\n    =====================================================\n  */\n\n  @media (max-width: 1100px) {\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__title {\n      width: 100%;\n      max-width: 10ch;\n\n      white-space: normal;\n\n      font-size:\n        clamp(36px, 4.4vw, 56px);\n    }\n  }\n\n  @media (max-width: 980px) {\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__shell {\n      grid-template-columns: 1fr;\n\n      grid-template-areas:\n        \"content\"\n        \"media\";\n\n      min-height: 0;\n\n      box-shadow:\n        7px 7px 0 #d8b900;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__content {\n      padding:\n        32px\n        clamp(22px, 6vw, 34px)\n        28px;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__content::before {\n      display: none;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__media {\n      padding: 12px;\n\n      border-top:\n        1px solid\n        var(--devise-dark-border);\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__image-frame {\n      min-height: 0;\n\n      aspect-ratio:\n        16 / 10;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__image {\n      max-height: none;\n    }\n\n    #DeviseEditorial-{{ devise_editorial_id }}\n    .devise-editorial-v4__title {\n      width