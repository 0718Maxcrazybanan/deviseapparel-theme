        "custom_liquid": "{% if request.path == '/pages/contact' %}\n  <section class=\"da-contact-design-hero\">\n    <div class=\"da-contact-design-overlay\"></div>\n\n    <div class=\"da-contact-design-content\">\n      <span>Devise Apparel Custom Studio</span>\n\n      <h1>Skapa kläder med ditt eget motiv</h1>\n\n      <p>\n        Ladda upp en bild, skriv egen text eller beskriv din idé. Vi hjälper dig göra den till en färdig hoodie, t-shirt eller sweatshirt.\n      </p>\n\n      <div class=\"da-contact-design-actions\">\n        <a href=\"/pages/custom-order\" class=\"da-contact-design-btn da-contact-design-main\">\n          Designa nu\n        </a>\n\n        <a href=\"/collections/all\" class=\"da-contact-design-btn da-contact-design-second\">\n          Se exempel\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <style>\n    .da-contact-design-hero {\n      position: relative;\n      min-height: 540px;\n      background-image: url(\"https://cdn.shopify.com/s/files/1/1008/9958/6435/files/ChatGPT_Image_4_juli_2026_18_28_38.png?v=1783182538\");\n      background-size: cover;\n     background-position: center top;\n      background-repeat: no-repeat;\n      color: #FFFFFF;\n      font-family: Inter, Arial, sans-serif;\n      overflow: hidden;\n      display: flex;\n      align-items: flex-end;\n      padding: 64px 7vw;\n    }\n\n    .da-contact-design-hero::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background:\n        linear-gradient(90deg, rgba(10,10,10,0.94) 0%, rgba(10,10,10,0.68) 42%, rgba(10,10,10,0.10) 100%);\n      z-index: 1;\n    }\n\n    .da-contact-design-hero::after {\n      content: \"\";\n      position: absolute;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      height: 68%;\n      background:\n        linear-gradient(to top, rgba(10,10,10,1) 0%, rgba(10,10,10,0.78) 42%, rgba(10,10,10,0) 100%);\n      z-index: 2;\n      pointer-events: none;\n    }\n\n    .da-contact-design-overlay {\n      position: absolute;\n      inset: 0;\n      background:\n        radial-gradient(circle at 78% 35%, rgba(255,222,89,0.13), transparent 30%);\n      z-index: 2;\n      pointer-events: none;\n    }\n\n    .da-contact-design-content {\n      position: relative;\n      z-index: 3;\n      max-width: 690px;\n    }\n\n    .da-contact-design-content span {\n      display: inline-block;\n      margin-bottom: 13px;\n      color: #FFDE59;\n      font-size: 12px;\n      font-weight: 950;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n    }\n\n    .da-contact-design-content h1 {\n      margin: 0;\n      color: #FFFFFF;\n      font-size: clamp(40px, 5.4vw, 76px);\n      line-height: 0.95;\n      font-weight: 950;\n      letter-spacing: -0.055em;\n    }\n\n    .da-contact-design-content p {\n      max-width: 560px;\n      margin: 16px 0 0;\n      color: #A0A0A0;\n      font-size: 16px;\n      line-height: 1.55;\n      font-weight: 600;\n    }\n\n    .da-contact-design-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n      margin-top: 26px;\n    }\n\n    .da-contact-design-btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 50px;\n      padding: 0 25px;\n      border-radius: 10px;\n      text-decoration: none;\n      font-size: 14px;\n      font-weight: 950;\n      transition: 0.2s ease;\n    }\n\n    .da-contact-design-main {\n      background: #FFDE59;\n      color: #0A0A0A;\n      box-shadow: 0 0 28px rgba(255,222,89,0.22);\n    }\n\n    .da-contact-design-second {\n      background: rgba(255,255,255,0.08);\n      color: #FFFFFF;\n      border: 1px solid rgba(255,255,255,0.16);\n    }\n\n    .da-contact-design-btn:hover {\n      transform: translateY(-2px);\n    }\n\n    @media (max-width: 760px) {\n      .da-contact-design-hero {\n        min-height: 520px;\n        padding: 42px 18px;\n        background-position: 58% top;\n      }\n\n      .da-contact-design-hero::before {\n        background:\n          linear-gradient(0deg, rgba(10,10,10,0.97) 0%, rgba(10,10,10,0.72) 58%, rgba(10,10,10,0.22) 100%);\n      }\n\n      .da-contact-design-content h1 {\n        font-size: 40px;\n        line-height: 0.98;\n      }\n\n      .da-contact-design-content p {\n        font-size: 15px;\n      }\n\n      .da-contact-design-btn {\n        width: 100%;\n      }\n    }\n  </style>\n{% endif %}",
