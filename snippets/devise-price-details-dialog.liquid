{%- doc -%}
  Renders the live price breakdown dialog for Shopify's selected variant and quantity picker.

  @param {object} product - Current product.
  @param {object} section - Current section.
  @param {object} variant - Initially selected variant.
  @param {string} currency - ISO currency code.
{%- enddoc -%}

{%- liquid
  assign dialog_id = 'DevisePriceDialog-' | append: section.id | append: '-' | append: product.id
  assign selected_options = ''

  for product_option in product.options_with_values
    if selected_options != ''
      assign selected_options = selected_options | append: ' / '
    endif
    assign selected_options = selected_options | append: product_option.name | append: ': ' | append: product_option.selected_value
  endfor

  assign initial_quantity = variant.quantity_rule.min | default: 1
  assign initial_total = variant.price | times: initial_quantity
-%}

<dialog-component
  id="{{ dialog_id }}"
  class="devise-product-dialog devise-product-price-dialog"
  data-devise-price-dialog
  data-product-title="{{ product.title | escape }}"
  data-currency="{{ currency | escape }}"
>
  <button
    type="button"
    class="button button-unstyled devise-product-dialog__trigger"
    on:click="/showDialog"
  >
    Prisuppgifter
  </button>

  <dialog
    ref="dialog"
    class="devise-product-dialog__surface dialog-modal color-custom-popover"
    scroll-lock
    aria-labelledby="{{ dialog_id }}-heading"
  >
    <header class="devise-product-dialog__header">
      <div>
        <span class="devise-product-dialog__eyebrow">Din sammanställning</span>
        <h2 id="{{ dialog_id }}-heading">Prisuppgifter</h2>
      </div>
      <button
        type="button"
        class="button button-unstyled close-button devise-product-dialog__close"
        on:click="/closeDialog"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </header>

    <div class="devise-price-dialog__product">
      <strong>{{ product.title | escape }}</strong>
      <span data-devise-price-options>{{ selected_options | escape }}</span>
    </div>

    <div class="devise-price-dialog__table-wrap" data-devise-price-table>
      <table class="devise-price-dialog__table">
        <thead>
          <tr>
            <th scope="col">Val</th>
            <th scope="col">Antal</th>
            <th scope="col">Pris/st</th>
            <th scope="col">Summa</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" data-devise-price-line-options>{{ selected_options | escape }}</th>
            <td data-devise-price-line-quantity>{{ initial_quantity }}</td>
            <td data-devise-price-line-unit>{{ variant.price | money }}</td>
            <td data-devise-price-line-total>{{ initial_total | money }}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer class="devise-price-dialog__total" data-devise-price-total-wrapper>
      <span>
        Totalt
        <small data-devise-price-total-quantity>{{ initial_quantity }} plagg</small>
      </span>
      <strong data-devise-price-total>{{ initial_total | money }}</strong>
    </footer>
  </dialog>
</dialog-component>
