{%- doc -%}
  Renders the live price breakdown dialog for the multi-size product picker.

  @param {object} product - Current product.
  @param {object} section - Current section.
  @param {object} variant - Initially selected variant.
  @param {string} currency - ISO currency code.
{%- enddoc -%}

{%- assign dialog_id = 'DevisePriceDialog-' | append: section.id | append: '-' | append: product.id -%}

<dialog-component
  id="{{ dialog_id }}"
  class="devise-product-dialog devise-product-price-dialog"
  data-devise-price-dialog
  data-product-title="{{ product.title | escape }}"
  data-currency="{{ currency | escape }}"
>
  <button
    type="button"
    class="button button-unstyled devise-product-dialog__trigger"
    on:click="/showDialog"
  >
    Prisuppgifter
  </button>

  <dialog
    ref="dialog"
    class="devise-product-dialog__surface dialog-modal color-custom-popover"
    scroll-lock
    aria-labelledby="{{ dialog_id }}-heading"
  >
    <header class="devise-product-dialog__header">
      <div>
        <span class="devise-product-dialog__eyebrow">Din sammanställning</span>
        <h2 id="{{ dialog_id }}-heading">Prisuppgifter</h2>
      </div>
      <button
        type="button"
        class="button button-unstyled close-button devise-product-dialog__close"
        on:click="/closeDialog"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </header>

    <div class="devise-price-dialog__product">
      <strong>{{ product.title | escape }}</strong>
      <span data-devise-price-options>Välj färg, tryckteknik och storlek</span>
    </div>

    <p class="devise-price-dialog__empty" data-devise-price-empty>
      Inga storlekar är valda ännu. Välj minst en storlek och ange antal för att se prisuppgifterna.
    </p>

    <div class="devise-price-dialog__table-wrap" data-devise-price-table hidden>
      <table class="devise-price-dialog__table">
        <thead>
          <tr>
            <th scope="col">Storlek</th>
            <th scope="col">Antal</th>
            <th scope="col">Pris/st</th>
            <th scope="col">Summa</th>
          </tr>
        </thead>
        <tbody data-devise-price-lines></tbody>
      </table>
    </div>

    <footer class="devise-price-dialog__total" data-devise-price-total-wrapper hidden>
      <span>
        Totalt
        <small data-devise-price-total-quantity>0 plagg</small>
      </span>
      <strong data-devise-price-total>{{ variant.price | money }}</strong>
    </footer>
  </dialog>
</dialog-component>
