{%- doc -%}
  Renders a product-specific size guide dialog with measurement tabs and a size table.

  @param {object} product - Current product.
  @param {object} section - Current section.
  @param {object} block - Buy buttons block, used for editable guide settings.
  @param {object} size_option - Product size option.
{%- enddoc -%}

{%- liquid
  assign dialog_id = 'DeviseSizeGuide-' | append: section.id | append: '-' | append: product.id
  assign guide_heading = block.settings.size_guide_heading | default: 'Storleksguide'
  assign guide_page = block.settings.size_guide_page
  assign product_measurement_image = block.settings.size_guide_product_image
  assign body_measurement_image = block.settings.size_guide_body_image
-%}

<dialog-component
  id="{{ dialog_id }}"
  class="devise-product-dialog devise-size-guide"
>
  <button
    type="button"
    class="button button-unstyled size-quantity-dropdown__guide-trigger"
    on:click="/showDialog"
  >
    {{ guide_heading | escape }}
  </button>

  <dialog
    ref="dialog"
    class="devise-product-dialog__surface devise-size-guide__surface dialog-modal color-custom-popover"
    scroll-lock
    aria-labelledby="{{ dialog_id }}-heading"
  >
    <header class="devise-product-dialog__header">
      <div>
        <span class="devise-product-dialog__eyebrow">Passform och mått</span>
        <h2 id="{{ dialog_id }}-heading">{{ guide_heading | escape }}</h2>
      </div>
      <button
        type="button"
        class="button button-unstyled close-button devise-product-dialog__close"
        on:click="/closeDialog"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </header>

    {% if guide_page != blank %}
      <div class="devise-size-guide__custom-content rte">{{ guide_page.content }}</div>
    {% else %}
    <div
      class="devise-size-guide__tabs"
      role="tablist"
      aria-label="Välj mätmetod"
      data-devise-dialog-tabs
    >
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="{{ dialog_id }}-product-panel"
        id="{{ dialog_id }}-product-tab"
        data-devise-dialog-tab="product"
      >
        Produktmått
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="{{ dialog_id }}-body-panel"
        id="{{ dialog_id }}-body-tab"
        data-devise-dialog-tab="body"
      >
        Mät dig själv
      </button>
    </div>

    <section
      id="{{ dialog_id }}-product-panel"
      class="devise-size-guide__panel"
      role="tabpanel"
      aria-labelledby="{{ dialog_id }}-product-tab"
      data-devise-dialog-panel="product"
    >
      <div class="devise-size-guide__intro">
        <h3>Så mäts produkten</h3>
        <p>Måtten anges i centimeter. Lägg ett plagg som passar dig plant och jämför med tabellen.</p>
      </div>

      <div class="devise-size-guide__measurement-card">
          <div class="devise-size-guide__visual">
            {% if product_measurement_image != blank %}
              {{
                product_measurement_image
                | image_url: width: 720
                | image_tag: loading: 'lazy', alt: product_measurement_image.alt, widths: '360, 540, 720'
              }}
            {% else %}
              <svg viewBox="0 0 360 300" role="img" aria-label="T-shirt med måttlinjer för längd, bredd och ärm">
                <defs>
                  <linearGradient id="shirt-{{ dialog_id }}" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#ffffff"/>
                    <stop offset="1" stop-color="#e9e9e6"/>
                  </linearGradient>
                  <filter id="shadow-{{ dialog_id }}" x="-30%" y="-30%" width="160%" height="160%">
                    <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#000000" flood-opacity=".12"/>
                  </filter>
                </defs>
                <path d="M108 55 151 35c7 18 51 18 58 0l43 20 65 43-31 51-40-22v137H114V127l-40 22-31-51 65-43Z" fill="url(#shirt-{{ dialog_id }})" stroke="#c7c7c2" stroke-width="2" filter="url(#shadow-{{ dialog_id }})"/>
                <path d="M151 35c4 20 54 20 58 0" fill="none" stroke="#c7c7c2" stroke-width="2"/>
                <g fill="none" stroke="#ef3f3f" stroke-width="3" stroke-linecap="round" stroke-dasharray="7 6">
                  <path d="M96 62v202"/>
                  <path d="M114 170h132"/>
                  <path d="m253 62 52 39"/>
                </g>
                <g fill="#ef3f3f" font-family="Arial, sans-serif" font-size="18" font-weight="800">
                  <text x="75" y="82">A</text>
                  <text x="170" y="161">B</text>
                  <text x="298" y="91">C</text>
                </g>
              </svg>
            {% endif %}
          </div>
          <dl class="devise-size-guide__definitions">
            <div><dt>A Längd</dt><dd>Från axelns högsta punkt ner till plaggets nederkant.</dd></div>
            <div><dt>B Bredd</dt><dd>Tvärs över plagget, cirka 2 cm under ärmhålet.</dd></div>
            <div><dt>C Ärmlängd</dt><dd>Från axelsömmen till ärmens ytterkant.</dd></div>
          </dl>
        </div>
    </section>

    <section
      id="{{ dialog_id }}-body-panel"
      class="devise-size-guide__panel"
      role="tabpanel"
      aria-labelledby="{{ dialog_id }}-body-tab"
      data-devise-dialog-panel="body"
      hidden
    >
      <div class="devise-size-guide__intro">
        <h3>Mät dig själv</h3>
        <p>Använd ett mjukt måttband och håll det plant utan att dra åt. Jämför sedan med produktmåtten.</p>
      </div>
      <div class="devise-size-guide__measurement-card">
        <div class="devise-size-guide__visual devise-size-guide__visual--body">
          {% if body_measurement_image != blank %}
            {{
              body_measurement_image
              | image_url: width: 720
              | image_tag: loading: 'lazy', alt: body_measurement_image.alt, widths: '360, 540, 720'
            }}
          {% else %}
            <svg viewBox="0 0 300 320" role="img" aria-label="Person med måttlinjer för längd, bröst och ärm">
              <defs>
                <linearGradient id="body-shirt-{{ dialog_id }}" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#ffffff"/>
                  <stop offset="1" stop-color="#e7e7e4"/>
                </linearGradient>
              </defs>
              <circle cx="150" cy="49" r="30" fill="#c98e6b"/>
              <path d="M95 94c18-16 92-16 110 0l30 47-34 22-13-25v154H112V138l-13 25-34-22 30-47Z" fill="url(#body-shirt-{{ dialog_id }})" stroke="#c8c8c4" stroke-width="2"/>
              <path d="M113 292h31l-4 26h-31Zm43 0h31l4 26h-31Z" fill="#2f3945"/>
              <g fill="none" stroke="#ef3f3f" stroke-width="3" stroke-linecap="round" stroke-dasharray="7 6">
                <path d="M99 103v189"/>
                <path d="M105 151h90"/>
                <path d="m204 104 27 48"/>
              </g>
              <g fill="#ef3f3f" font-family="Arial, sans-serif" font-size="17" font-weight="800">
                <text x="76" y="119">A</text>
                <text x="146" y="142">B</text>
                <text x="229" y="132">C</text>
              </g>
            </svg>
          {% endif %}
        </div>
        <dl class="devise-size-guide__definitions">
          <div><dt>A Kroppslängd</dt><dd>Mät från axelns högsta punkt till önskad nederkant.</dd></div>
          <div><dt>B Bröst</dt><dd>Mät runt den bredaste delen av bröstet och håll bandet vågrätt.</dd></div>
          <div><dt>C Ärm</dt><dd>Mät från axeln längs armen till önskad ärmlängd.</dd></div>
        </dl>
      </div>
    </section>

    <section class="devise-size-guide__chart" aria-labelledby="{{ dialog_id }}-chart-heading">
      <div class="devise-size-guide__chart-heading">
        <div>
          <span>Hitta din storlek</span>
          <h3 id="{{ dialog_id }}-chart-heading">Storlekstabell</h3>
        </div>
        <strong>Centimeter</strong>
      </div>
      <div class="devise-size-guide__table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Storlek</th>
              <th scope="col">Längd</th>
              <th scope="col">Bredd</th>
              <th scope="col">Ärm</th>
            </tr>
          </thead>
          <tbody>
            {%- for option_value in size_option.values -%}
              {%- liquid
                assign normalized_size = option_value.name | default: option_value | upcase | replace: ' ', ''
                assign length = '–'
                assign width = '–'
                assign sleeve = '–'

                case normalized_size
                  when 'XS'
                    assign length = '68,5'
                    assign width = '40,6'
                    assign sleeve = '36,8'
                  when 'S'
                    assign length = '71'
                    assign width = '45,7'
                    assign sleeve = '39,7'
                  when 'M'
                    assign length = '73,7'
                    assign width = '50,8'
                    assign sleeve = '43,2'
                  when 'L'
                    assign length = '76,2'
                    assign width = '56'
                    assign sleeve = '47'
                  when 'XL'
                    assign length = '78,7'
                    assign width = '61'
                    assign sleeve = '50,8'
                  when '2XL', 'XXL'
                    assign length = '81,3'
                    assign width = '66'
                    assign sleeve = '54,6'
                  when '3XL', 'XXXL'
                    assign length = '83,8'
                    assign width = '71'
                    assign sleeve = '58'
                  when '4XL'
                    assign length = '86,4'
                    assign width = '76,2'
                    assign sleeve = '61,5'
                  when '5XL'
                    assign length = '89'
                    assign width = '81,3'
                    assign sleeve = '64,3'
                endcase
              -%}
              <tr>
                <th scope="row">{{ option_value | escape }}</th>
                <td>{{ length }}</td>
                <td>{{ width }}</td>
                <td>{{ sleeve }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <p class="devise-size-guide__note">Produktmått kan variera med upp till 5 cm.</p>
    </section>
    {% endif %}
  </dialog>
</dialog-component>
