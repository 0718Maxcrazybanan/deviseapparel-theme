{%- doc -%}
  Renders a product-specific size guide image from the product metafield.

  @param {object} product - Current product.
  @param {object} section - Current section.
{%- enddoc -%}

{%- liquid
  assign size_guide_file = product.metafields.custom.size_guide_image.value
  assign size_guide_image = blank

  if size_guide_file != blank and size_guide_file.media_type == 'image'
    assign size_guide_image = size_guide_file.preview_image | default: size_guide_file
  endif
-%}

{%- if size_guide_image != blank -%}
  {%- liquid
    assign dialog_id = 'DeviseSizeGuide-' | append: section.id | append: '-' | append: product.id
    assign guide_heading = 'Storleksguide'
    assign image_alt = size_guide_image.alt | default: guide_heading
  -%}

  <dialog-component
    id="{{ dialog_id }}"
    class="devise-product-dialog devise-size-guide"
  >
    <button
      type="button"
      class="button button-unstyled devise-size-guide__trigger"
      on:click="/showDialog"
    >
      {{ guide_heading }}
    </button>

    <dialog
      ref="dialog"
      class="devise-product-dialog__surface devise-size-guide__surface dialog-modal color-custom-popover"
      scroll-lock
      aria-labelledby="{{ dialog_id }}-heading"
    >
      <header class="devise-product-dialog__header">
        <div>
          <span class="devise-product-dialog__eyebrow">Passform</span>
          <h2 id="{{ dialog_id }}-heading">{{ guide_heading }}</h2>
        </div>
        <button
          type="button"
          class="button button-unstyled close-button devise-product-dialog__close"
          on:click="/closeDialog"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </header>

      <div style="padding: 16px;">
        {{
          size_guide_image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900, 1200, 1600, 1800',
            sizes: '(max-width: 749px) calc(100vw - 32px), min(90vw, 1200px)',
            alt: image_alt,
            style: 'display:block;width:auto;max-width:100%;height:auto;max-height:calc(100vh - 160px);margin:0 auto;object-fit:contain;'
        }}
      </div>
    </dialog>
  </dialog-component>
{%- endif -%}
