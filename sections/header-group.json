        "custom_liquid": "<a href=\"/pages/faq\" class=\"devise-process-sticky\">\n  <span>?</span>\n  Så fungerar det\n</a>\n\n<style>\n  .devise-process-sticky {\n    position: fixed;\n    left: 14px;\n    bottom: 86px;\n    z-index: 9998;\n\n    display: none;\n    align-items: center;\n    gap: 9px;\n\n    min-height: 44px;\n    padding: 0 15px 0 10px;\n    border-radius: 999px;\n\n    background: rgba(17, 17, 17, 0.94);\n    color: #FFFFFF;\n    border: 1px solid rgba(255, 222, 89, 0.28);\n\n    font-family: Inter, Arial, sans-serif;\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    text-decoration: none;\n\n    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.45);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n  }\n\n  .devise-process-sticky span {\n    width: 26px;\n    height: 26px;\n    border-radius: 999px;\n\n    background: #FFDE59;\n    color: #0A0A0A;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    font-size: 14px;\n    font-weight: 950;\n  }\n\n  .devise-process-sticky:active {\n    transform: scale(0.97);\n  }\n\n  @media (max-width: 768px) {\n    .devise-process-sticky {\n      display: inline-flex;\n    }\n  }\n</style>",
