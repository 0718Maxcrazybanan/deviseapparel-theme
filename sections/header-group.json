    "custom_liquid_B66N9k": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% if request.page_type == 'index' %}\n\n{% comment %}\n  =====================================================\n  BILDER — ÄNDRA HÄR\n  Ladda upp bilder i Shopify: Content > Files\n  Kopiera bildens länk och klistra in mellan ''\n  =====================================================\n{% endcomment %}\n\n{% assign hero_background_image = 'https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=1800&q=85' %}\n\n{% assign usecase_image_1 = 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=900&q=85' %}\n{% assign usecase_image_2 = 'https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=900&q=85' %}\n{% assign usecase_image_3 = 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=900&q=85' %}\n\n{% comment %}\n  =====================================================\n  FÄRGER — ÄNDRA HEX-KODER HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign color_hero_top = '#080808' %}\n{% assign color_hero_bottom = '#181818' %}\n{% assign color_next_section = '#FFFFFF' %}\n\n{% assign color_main_text = '#FFFFFF' %}\n{% assign color_muted_text = '#D6D6D6' %}\n{% assign color_small_text = '#A8A8A8' %}\n\n{% assign color_yellow_detail = '#FFDE59' %}\n{% assign color_black_detail = '#0A0A0A' %}\n{% assign color_white_detail = '#FFFFFF' %}\n\n{% assign color_primary_button_bg = '#FFDE59' %}\n{% assign color_primary_button_text = '#0A0A0A' %}\n{% assign color_primary_button_border = '#FFDE59' %}\n\n{% assign color_secondary_button_bg = 'transparent' %}\n{% assign color_secondary_button_text = '#FFFFFF' %}\n{% assign color_secondary_button_border = '#FFFFFF' %}\n\n{% assign color_image_card_bg = '#111111' %}\n{% assign color_image_card_border = '#2A2A2A' %}\n{% assign color_image_card_text = '#FFFFFF' %}\n{% assign color_image_card_label_bg = '#FFFFFF' %}\n{% assign color_image_card_label_text = '#0A0A0A' %}\n\n{% assign color_bottom_card_bg = '#F7F7F7' %}\n{% assign color_bottom_card_border = '#DDDDDD' %}\n{% assign color_bottom_icon_bg = '#0A0A0A' %}\n{% assign color_bottom_icon_text = '#FFFFFF' %}\n{% assign color_bottom_title = '#0A0A0A' %}\n{% assign color_bottom_text = '#555555' %}\n{% assign color_bottom_line = '#0A0A0A' %}\n\n{% comment %}\n  =====================================================\n  TEXT — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign eyebrow_text = 'Custom tröjor · Din design, ditt tillfälle' %}\n\n{% assign hero_title_1 = 'Skapa tröjan' %}\n{% assign hero_title_2 = 'ingen annan har.' %}\n\n{% assign hero_description = 'Ladda upp en bild, logga eller egen text och skapa en personlig tröja för festen, svensexan, företaget eller din egen merch.' %}\n\n{% assign primary_button_text = 'Skapa design' %}\n{% assign secondary_button_text = 'Se katalogen' %}\n\n<section class=\"devise-hero-modern\">\n  <div class=\"devise-hero-modern__bg\"></div>\n\n  <div class=\"devise-hero-modern__inner\">\n    <div class=\"devise-hero-modern__content\">\n      <div class=\"devise-hero-modern__eyebrow\">\n        <span></span>\n        {{ eyebrow_text }}\n      </div>\n\n      <h1 class=\"devise-hero-modern__title\">\n        <span>{{ hero_title_1 }}</span>\n        <span>{{ hero_title_2 }}</span>\n      </h1>\n\n      <p class=\"devise-hero-modern__text\">\n        {{ hero_description }}\n      </p>\n\n      <div class=\"devise-hero-modern__buttons\">\n        <a href=\"/pages/contact\" class=\"devise-hero-btn devise-hero-btn--primary\">\n          {{ primary_button_text }}\n          <span>→</span>\n        </a>\n\n        <a href=\"/collections/frontpage\" class=\"devise-hero-btn devise-hero-btn--secondary\">\n          {{ secondary_button_text }}\n          <span>→</span>\n        </a>\n      </div>\n    </div>\n\n    <div class=\"devise-usecase-stack\" aria-label=\"Exempel på användningsområden\">\n      <a href=\"/pages/contact\" class=\"devise-usecase-card devise-usecase-card--one\" style=\"--usecase-image: url('{{ usecase_image_1 }}');\">\n        <div>\n          <span>01</span>\n          <strong>Fester</strong>\n          <p>Matchande tröjor för kvällen.</p>\n        </div>\n      </a>\n\n      <a href=\"/pages/contact\" class=\"devise-usecase-card devise-usecase-card--two\" style=\"--usecase-image: url('{{ usecase_image_2 }}');\">\n        <div>\n          <span>02</span>\n          <strong>Svensexor</strong>\n          <p>Personligt, roligt och enkelt.</p>\n        </div>\n      </a>\n\n      <a href=\"/pages/contact\" class=\"devise-usecase-card devise-usecase-card--three\" style=\"--usecase-image: url('{{ usecase_image_3 }}');\">\n        <div>\n          <span>03</span>\n          <strong>Företagsevent</strong>\n          <p>Clean merch med egen logga.</p>\n        </div>\n      </a>\n    </div>\n  </div>\n\n  <div class=\"devise-hero-bottom\">\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">1</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>SKICKA IDÉ</strong>\n          <p>Beskriv designen eller ladda upp en bild.</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">2</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>VI HJÄLPER</strong>\n          <p>Du får hjälp att få trycket rätt.</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">3</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>TRYCK KLART</strong>\n          <p>En personlig tröja redo att användas.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .devise-hero-modern {\n    --hero-top: {{ color_hero_top }};\n    --hero-bottom: {{ color_hero_bottom }};\n    --next-section: {{ color_next_section }};\n\n    --main-text: {{ color_main_text }};\n    --muted-text: {{ color_muted_text }};\n    --small-text: {{ color_small_text }};\n\n    --yellow-detail: {{ color_yellow_detail }};\n    --black-detail: {{ color_black_detail }};\n    --white-detail: {{ color_white_detail }};\n\n    --primary-button-bg: {{ color_primary_button_bg }};\n    --primary-button-text: {{ color_primary_button_text }};\n    --primary-button-border: {{ color_primary_button_border }};\n\n    --secondary-button-bg: {{ color_secondary_button_bg }};\n    --secondary-button-text: {{ color_secondary_button_text }};\n    --secondary-button-border: {{ color_secondary_button_border }};\n\n    --image-card-bg: {{ color_image_card_bg }};\n    --image-card-border: {{ color_image_card_border }};\n    --image-card-text: {{ color_image_card_text }};\n    --image-card-label-bg: {{ color_image_card_label_bg }};\n    --image-card-label-text: {{ color_image_card_label_text }};\n\n    --bottom-card-bg: {{ color_bottom_card_bg }};\n    --bottom-card-border: {{ color_bottom_card_border }};\n    --bottom-icon-bg: {{ color_bottom_icon_bg }};\n    --bottom-icon-text: {{ color_bottom_icon_text }};\n    --bottom-title: {{ color_bottom_title }};\n    --bottom-text: {{ color_bottom_text }};\n    --bottom-line: {{ color_bottom_line }};\n\n    position: relative;\n    isolation: isolate;\n    background:\n      linear-gradient(\n        180deg,\n        var(--hero-top) 0%,\n        var(--hero-bottom) 72%,\n        var(--next-section) 100%\n      );\n    color: var(--main-text);\n    font-family: Inter, Arial, sans-serif;\n    padding: 88px 20px 30px;\n    overflow: hidden;\n  }\n\n  .devise-hero-modern * {\n    box-sizing: border-box;\n  }\n\n  .devise-hero-modern__bg {\n    position: absolute;\n    inset: 0;\n    background-image:\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.88) 0%,\n        rgba(0, 0, 0, 0.78) 48%,\n        rgba(0, 0, 0, 0.52) 100%\n      ),\n      linear-gradient(\n        180deg,\n        rgba(0, 0, 0, 0.18) 0%,\n        rgba(0, 0, 0, 0.66) 72%,\n        rgba(255, 255, 255, 0.92) 100%\n      ),\n      url(\"{{ hero_background_image }}\");\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n    filter: grayscale(100%) contrast(1.06) brightness(0.72);\n    z-index: -2;\n    pointer-events: none;\n  }\n\n  .devise-hero-modern::after {\n    content: \"\";\n    position: absolute;\n    inset: auto 0 0;\n    height: 170px;\n    background: linear-gradient(\n      180deg,\n      rgba(255, 255, 255, 0) 0%,\n      var(--next-section) 100%\n    );\n    z-index: -1;\n    pointer-events: none;\n  }\n\n  .devise-hero-modern__inner {\n    position: relative;\n    z-index: 2;\n    max-width: 1160px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1.12fr 0.88fr;\n    align-items: center;\n    gap: 50px;\n  }\n\n  .devise-hero-modern__content {\n    min-width: 0;\n  }\n\n  .devise-hero-modern__eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    color: var(--yellow-detail);\n    background: rgba(255, 255, 255, 0.04);\n    border: 1px solid rgba(255, 255, 255, 0.16);\n    border-radius: 999px;\n    padding: 8px 13px;\n    font-size: 12px;\n    font-weight: 850;\n    letter-spacing: 0.03em;\n    margin-bottom: 22px;\n  }\n\n  .devise-hero-modern__eyebrow span {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--yellow-detail);\n  }\n\n  .devise-hero-modern__title {\n    margin: 0;\n    max-width: 760px;\n    font-size: clamp(46px, 7vw, 88px);\n    line-height: 0.92;\n    letter-spacing: -0.078em;\n    font-weight: 950;\n  }\n\n  .devise-hero-modern__title span {\n    display: block;\n    color: var(--main-text);\n  }\n\n  .devise-hero-modern__title span:last-child {\n    color: var(--yellow-detail);\n  }\n\n  .devise-hero-modern__text {\n    max-width: 610px;\n    margin: 26px 0 0;\n    color: var(--muted-text);\n    font-size: 18px;\n    line-height: 1.65;\n    font-weight: 520;\n  }\n\n  .devise-hero-modern__buttons {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    margin-top: 34px;\n  }\n\n  .devise-hero-btn {\n    min-height: 56px;\n    padding: 0 22px;\n    border-radius: 8px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    text-decoration: none;\n    font-size: 14px;\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: 0.03em;\n    transition: 0.2s ease;\n  }\n\n  .devise-hero-btn span {\n    font-size: 18px;\n    line-height: 1;\n  }\n\n  .devise-hero-btn--primary {\n    background: var(--primary-button-bg);\n    color: var(--primary-button-text);\n    border: 1px solid var(--primary-button-border);\n  }\n\n  .devise-hero-btn--primary:hover {\n    transform: translateY(-2px);\n  }\n\n  .devise-hero-btn--secondary {\n    background: var(--secondary-button-bg);\n    color: var(--secondary-button-text);\n    border: 1px solid var(--secondary-button-border);\n  }\n\n  .devise-hero-btn--secondary:hover {\n    color: var(--yellow-detail);\n    border-color: var(--yellow-detail);\n    transform: translateY(-2px);\n  }\n\n  .devise-usecase-stack {\n    position: relative;\n    width: 100%;\n    max-width: 430px;\n    margin-left: auto;\n    display: grid;\n    gap: 14px;\n  }\n\n  .devise-usecase-card {\n    position: relative;\n    min-height: 148px;\n    overflow: hidden;\n    border-radius: 14px;\n    border: 1px solid var(--image-card-border);\n    background-color: var(--image-card-bg);\n    background-image:\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.70) 0%,\n        rgba(0, 0, 0, 0.36) 100%\n      ),\n      var(--usecase-image);\n    background-size: cover;\n    background-position: center;\n    text-decoration: none;\n    display: flex;\n    align-items: flex-end;\n    padding: 18px;\n    transition: 0.2s ease;\n  }\n\n  .devise-usecase-card:hover {\n    transform: translateY(-2px);\n    border-color: var(--yellow-detail);\n  }\n\n  .devise-usecase-card--one {\n    width: 88%;\n    margin-left: auto;\n  }\n\n  .devise-usecase-card--two {\n    width: 100%;\n    margin-left: 0;\n  }\n\n  .devise-usecase-card--three {\n    width: 90%;\n    margin-left: 34px;\n  }\n\n  .devise-usecase-card div {\n    position: relative;\n    z-index: 2;\n  }\n\n  .devise-usecase-card span {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 26px;\n    padding: 0 9px;\n    margin-bottom: 8px;\n    border-radius: 999px;\n    background: var(--image-card-label-bg);\n    color: var(--image-card-label-text);\n    font-size: 11px;\n    font-weight: 950;\n    letter-spacing: 0.06em;\n  }\n\n  .devise-usecase-card strong {\n    display: block;\n    color: var(--image-card-text);\n    font-size: 24px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: -0.045em;\n  }\n\n  .devise-usecase-card p {\n    margin: 7px 0 0;\n    color: rgba(255, 255, 255, 0.82);\n    font-size: 13px;\n    line-height: 1.35;\n    font-weight: 650;\n  }\n\n  .devise-hero-bottom {\n    position: relative;\n    z-index: 2;\n    max-width: 1160px;\n    margin: 48px auto 0;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 14px;\n  }\n\n  .devise-bottom-item {\n    background: var(--bottom-card-bg);\n    border: 1px solid var(--bottom-card-border);\n    border-radius: 12px;\n    padding: 16px;\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n\n  .devise-bottom-icon {\n    width: 42px;\n    height: 42px;\n    border-radius: 9px;\n    background: var(--bottom-icon-bg);\n    color: var(--bottom-icon-text);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 950;\n    flex-shrink: 0;\n  }\n\n  .devise-bottom-text {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .devise-bottom-text > span {\n    width: 3px;\n    height: 34px;\n    border-radius: 999px;\n    background: var(--bottom-line);\n    flex-shrink: 0;\n  }\n\n  .devise-bottom-text strong {\n    display: block;\n    font-size: 13px;\n    color: var(--bottom-title);\n    font-weight: 900;\n    letter-spacing: 0.05em;\n  }\n\n  .devise-bottom-text p {\n    margin: 4px 0 0;\n    color: var(--bottom-text);\n    font-size: 13px;\n    font-weight: 650;\n    line-height: 1.35;\n  }\n\n  @media (max-width: 950px) {\n    .devise-hero-modern {\n      padding: 62px 16px 26px;\n    }\n\n    .devise-hero-modern__inner {\n      grid-template-columns: 1fr;\n      gap: 34px;\n      text-align: center;\n      max-width: 680px;\n    }\n\n    .devise-hero-modern__text {\n      margin-left: auto;\n      margin-right: auto;\n      font-size: 15px;\n      line-height: 1.55;\n    }\n\n    .devise-hero-modern__buttons {\n      justify-content: center;\n      margin-top: 26px;\n    }\n\n    .devise-usecase-stack {\n      margin: 0 auto;\n      max-width: 520px;\n      text-align: left;\n    }\n\n    .devise-usecase-card--one {\n      width: 90%;\n      margin-left: auto;\n    }\n\n    .devise-usecase-card--two {\n      width: 100%;\n    }\n\n    .devise-usecase-card--three {\n      width: 90%;\n      margin-left: 0;\n    }\n\n    .devise-hero-bottom {\n      max-width: 520px;\n      grid-template-columns: 1fr;\n      margin-top: 30px;\n      gap: 10px;\n    }\n  }\n\n  @media (max-width: 560px) {\n    .devise-hero-modern {\n      padding: 46px 14px 22px;\n    }\n\n    .devise-hero-modern__bg {\n      background-position: center top;\n    }\n\n    .devise-hero-modern__eyebrow {\n      font-size: 10px;\n      padding: 6px 10px;\n      margin-bottom: 16px;\n    }\n\n    .devise-hero-modern__title {\n      font-size: clamp(35px, 11vw, 48px);\n      line-height: 0.96;\n      letter-spacing: -0.06em;\n    }\n\n    .devise-hero-modern__text {\n      font-size: 14px;\n      margin-top: 18px;\n    }\n\n    .devise-hero-modern__buttons {\n      flex-direction: column;\n      gap: 10px;\n      margin-top: 24px;\n    }\n\n    .devise-hero-btn {\n      width: 100%;\n      min-height: 52px;\n      border-radius: 8px;\n      font-size: 12px;\n      padding: 0 16px;\n    }\n\n    .devise-usecase-stack {\n      gap: 10px;\n    }\n\n    .devise-usecase-card {\n      min-height: 126px;\n      border-radius: 12px;\n      padding: 15px;\n    }\n\n    .devise-usecase-card--one,\n    .devise-usecase-card--two,\n    .devise-usecase-card--three {\n      width: 100%;\n      margin-left: 0;\n    }\n\n    .devise-usecase-card strong {\n      font-size: 21px;\n    }\n\n    .devise-usecase-card p {\n      font-size: 12px;\n    }\n\n    .devise-hero-bottom {\n      display: flex;\n      gap: 10px;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      margin-top: 24px;\n      padding-bottom: 4px;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .devise-hero-bottom::-webkit-scrollbar {\n      display: none;\n    }\n\n    .devise-bottom-item {\n      min-width: 84%;\n      scroll-snap-align: start;\n      padding: 13px;\n      border-radius: 10px;\n    }\n\n    .devise-bottom-icon {\n      width: 38px;\n      height: 38px;\n    }\n\n    .devise-bottom-text > span {\n      height: 30px;\n    }\n\n    .devise-bottom-text strong {\n      font-size: 12px;\n    }\n\n    .devise-bottom-text p {\n      font-size: 12px;\n    }\n  }\n\n  @media (max-width: 380px) {\n    .devise-hero-modern__title {\n      font-size: clamp(31px, 10vw, 40px);\n    }\n\n    .devise-bottom-item {\n      min-width: 88%;\n    }\n  }\n</style>\n\n{% endif %}",
