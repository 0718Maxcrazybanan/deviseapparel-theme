   animation: devise-announcement-scroll 9s linear infinite;\n    will-change: transform;\n  }\n\n  .devise-announcement-bar:hover .devise-announcement-track {\n    animation-play-state: paused;\n  }\n\n  .devise-announcement-group {\n    display: flex;\n    align-items: center;\n    gap: 130px;\n    padding-right: 130px;\n    flex-shrink: 0;\n  }\n\n  .devise-announcement-group span,\n  .devise-announcement-group a {\n    color: #FFFFFF;\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1;\n    text-decoration: none;\n    letter-spacing: 0.01em;\n  }\n\n  .devise-announcement-group b {\n    color: #FFDE59;\n    font-weight: 700;\n  }\n\n  .devise-announcement-group a {\n    color: #FFFFFF;\n    transition: color 0.2s ease;\n  }\n\n  .devise-announcement-group a:hover {\n    color: #FFDE59;\n  }\n\n  @keyframes devise-announcement-scroll {\n    from {\n      transform: translateX(0);\n    }\n    to {\n      transform: translateX(-25%);\n    }\n  }\n\n  @media (max-width: 1000px) {\n    .devise-announcement-bar {\n      height: 36px;\n    }\n\n    .devise-announcement-track {\n      animation-duration: 7s;\n    }\n\n    .devise-announcement-group {\n      gap: 32px;\n      padding-right: 32px;\n    }\n\n    .devise-announcement-group span,\n    .devise-announcement-group a {\n      font-size: 12px;\n    }\n  }\n</style>",
