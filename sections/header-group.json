      "settings": {
        "custom_liquid": "{% if request.page_type == 'index' %}\n\n{% comment %}\n  =====================================================\n  1. BILDER — ÄNDRA HÄR\n  Endast EN bild syns åt gången.\n  Bilden byts automatiskt efter 30 sekunder.\n  =====================================================\n{% endcomment %}\n\n{% assign slide_1_image = 'https://cdn.shopify.com/s/files/1/1008/9958/6435/files/ChatGPT_Image_9_juli_2026_21_08_35.png?v=1783624153' %}\n{% assign slide_2_image = 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=1800&q=85' %}\n{% assign slide_3_image = 'https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1800&q=85' %}\n\n{% comment %}\n  =====================================================\n  2. TEXT — ÄNDRA RUBRIKER HÄR\n  Liten text = överst\n  Stor text = under\n  =====================================================\n{% endcomment %}\n\n{% assign slide_1_small_text = 'Skapa din egen tröja' %}\n{% assign slide_1_big_text = 'Något eget som faktiskt känns som er grej.' %}\n\n{% assign slide_2_small_text = 'Till fester och grupper' %}\n{% assign slide_2_big_text = 'En kväll blir lättare att minnas tillsammans.' %}\n\n{% assign slide_3_small_text = 'Till svensexa och firmafest' %}\n{% assign slide_3_big_text = 'Egen design för saker ni gör ihop.' %}\n\n{% comment %}\n  =====================================================\n  3. KNAPPAR / LÄNKAR\n  Gamla länkarna är kvar.\n  =====================================================\n{% endcomment %}\n\n{% assign primary_button_text = 'Skapa design' %}\n{% assign primary_button_link = '/pages/contact' %}\n\n{% assign secondary_button_text = 'Se katalogen' %}\n{% assign secondary_button_link = '/collections/frontpage' %}\n\n{% comment %}\n  =====================================================\n  4. FÄRGER — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign color_text_main = '#FFFFFF' %}\n{% assign color_text_small = '#FFFFFF' %}\n\n{% assign color_primary_button_background = '#FFDE59' %}\n{% assign color_primary_button_text = '#0A0A0A' %}\n{% assign color_primary_button_border = '#FFDE59' %}\n\n{% assign color_secondary_button_background = '#000000' %}\n{% assign color_secondary_button_text = '#FFFFFF' %}\n{% assign color_secondary_button_border = '#000000' %}\n\n{% assign color_section_under = '#FFFFFF' %}\n\n{% comment %}\n  =====================================================\n  5. INSTÄLLNINGAR\n  =====================================================\n{% endcomment %}\n\n{% assign slide_speed_ms = 30000 %}\n{% assign hero_height_desktop = '760px' %}\n{% assign hero_height_mobile = '680px' %}\n{% assign content_width_desktop = '1120px' %}\n{% assign content_width_mobile = '320px' %}\n{% assign button_radius = '0px' %}\n\n<section\n  class=\"devise-rotating-hero\"\n  data-devise-rotating-hero\n  data-slide-speed=\"{{ slide_speed_ms }}\"\n>\n  <div class=\"devise-rotating-hero__image devise-rotating-hero__image--active\" data-hero-image-a></div>\n  <div class=\"devise-rotating-hero__image\" data-hero-image-b></div>\n\n  <div class=\"devise-rotating-hero__contrast\"></div>\n  <div class=\"devise-rotating-hero__fade\"></div>\n\n  <div class=\"devise-rotating-hero__inner\">\n    <div class=\"devise-rotating-hero__content\">\n      <p class=\"devise-rotating-hero__small-text\" data-hero-text>\n        {{ slide_1_small_text }}\n      </p>\n\n      <h1 data-hero-title>\n        {{ slide_1_big_text }}\n      </h1>\n\n      <div class=\"devise-rotating-hero__buttons\">\n        <a href=\"{{ primary_button_link }}\" class=\"devise-rotating-hero__btn devise-rotating-hero__btn--primary\">\n          <span>{{ primary_button_text }}</span>\n        </a>\n\n        <a href=\"{{ secondary_button_link }}\" class=\"devise-rotating-hero__btn devise-rotating-hero__btn--secondary\">\n          <span>{{ secondary_button_text }}</span>\n        </a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .devise-rotating-hero {\n    --text-main: {{ color_text_main }};\n    --text-small: {{ color_text_small }};\n\n    --primary-button-background: {{ color_primary_button_background }};\n    --primary-button-text: {{ color_primary_button_text }};\n    --primary-button-border: {{ color_primary_button_border }};\n\n    --secondary-button-background: {{ color_secondary_button_background }};\n    --secondary-button-text: {{ color_secondary_button_text }};\n    --secondary-button-border: {{ color_secondary_button_border }};\n\n    --section-under: {{ color_section_under }};\n\n    --hero-height-desktop: {{ hero_height_desktop }};\n    --hero-height-mobile: {{ hero_height_mobile }};\n    --content-width-desktop: {{ content_width_desktop }};\n    --content-width-mobile: {{ content_width_mobile }};\n    --button-radius: {{ button_radius }};\n\n    position: relative;\n    isolation: isolate;\n    min-height: var(--hero-height-desktop);\n    background: #000000;\n    color: var(--text-main);\n    font-family: Inter, Arial, sans-serif;\n    overflow: hidden;\n  }\n\n  .devise-rotating-hero * {\n    box-sizing: border-box;\n  }\n\n  .devise-rotating-hero__image {\n    position: absolute;\n    inset: 0;\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n    opacity: 0;\n    transition: opacity 900ms ease;\n    filter: brightness(0.88) contrast(1.06) saturate(0.96);\n    z-index: -4;\n  }\n\n  .devise-rotating-hero__image--active {\n    opacity: 1;\n  }\n\n  .devise-rotating-hero__contrast {\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.66) 0%,\n        rgba(0, 0, 0, 0.48) 28%,\n        rgba(0, 0, 0, 0.18) 62%,\n        rgba(0, 0, 0, 0.04) 100%\n      );\n    z-index: -3;\n    pointer-events: none;\n  }\n\n  .devise-rotating-hero__fade {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: -1px;\n    height: 360px;\n    background: linear-gradient(\n      180deg,\n      rgba(255, 255, 255, 0) 0%,\n      rgba(255, 255, 255, 0.015) 36%,\n      rgba(255, 255, 255, 0.08) 56%,\n      rgba(255, 255, 255, 0.28) 74%,\n      rgba(255, 255, 255, 0.68) 91%,\n      var(--section-under) 100%\n    );\n    z-index: -2;\n    pointer-events: none;\n  }\n\n  .devise-rotating-hero__inner {\n    position: relative;\n    z-index: 2;\n    min-height: var(--hero-height-desktop);\n    width: 100%;\n    display: flex;\n    align-items: flex-end;\n    padding: 0 42px 142px;\n  }\n\n  .devise-rotating-hero__content {\n    width: 100%;\n    max-width: var(--content-width-desktop);\n    margin: 0;\n    text-align: left;\n  }\n\n  .devise-rotating-hero__small-text {\n    margin: 0 0 18px;\n    color: var(--text-small);\n    font-size: clamp(15px, 1.1vw, 18px);\n    line-height: 1.4;\n    font-weight: 900;\n    max-width: 380px;\n    text-align: left;\n    filter: brightness(1.24) contrast(1.16);\n  }\n\n  .devise-rotating-hero__content h1 {\n    margin: 0;\n    color: var(--text-main);\n    font-size: clamp(32px, 3.55vw, 52px);\n    line-height: 1.12;\n    letter-spacing: -0.035em;\n    font-weight: 950;\n    max-width: 960px;\n    text-align: left;\n    white-space: normal;\n    filter: brightness(1.26) contrast(1.20);\n  }\n\n  .devise-rotating-hero__buttons {\n    display: flex;\n    gap: 18px;\n    margin-top: 44px;\n    max-width: 540px;\n    text-align: left;\n  }\n\n  .devise-rotating-hero__btn {\n    position: relative;\n    min-height: 56px;\n    padding: 0 26px;\n    border-radius: var(--button-radius);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    text-decoration: none;\n    font-size: 15px;\n    font-weight: 950;\n    transition:\n      transform 0.22s ease,\n      border-color 0.22s ease,\n      background 0.22s ease,\n      color 0.22s ease;\n  }\n\n  .devise-rotating-hero__btn span {\n    position: relative;\n    z-index: 2;\n  }\n\n  .devise-rotating-hero__btn--primary {\n    background: var(--primary-button-background);\n    color: var(--primary-button-text);\n    border: 1px solid var(--primary-button-border);\n  }\n\n  .devise-rotating-hero__btn--primary::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: -90%;\n    width: 55%;\n    height: 100%;\n    background: linear-gradient(\n      120deg,\n      rgba(255, 255, 255, 0) 0%,\n      rgba(255, 255, 255, 0.55) 48%,\n      rgba(255, 255, 255, 0) 100%\n    );\n    transform: skewX(-22deg);\n    animation: deviseButtonShine 3.2s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  .devise-rotating-hero__btn--primary::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: #FFFFFF;\n    opacity: 0;\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.26s ease, opacity 0.26s ease;\n    pointer-events: none;\n  }\n\n  .devise-rotating-hero__btn--primary:hover::after {\n    opacity: 0.16;\n    transform: scaleX(1);\n  }\n\n  .devise-rotating-hero__btn--secondary {\n    background: var(--secondary-button-background);\n    color: var(--secondary-button-text);\n    border: 1px solid var(--secondary-button-border);\n  }\n\n  .devise-rotating-hero__btn--secondary::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: #FFFFFF;\n    opacity: 0;\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.26s ease, opacity 0.26s ease;\n    pointer-events: none;\n  }\n\n  .devise-rotating-hero__btn--secondary:hover::before {\n    opacity: 0.12;\n    transform: scaleX(1);\n  }\n\n  .devise-rotating-hero__btn:hover {\n    transform: translateY(-2px) scale(1.015);\n  }\n\n  @keyframes deviseButtonShine {\n    0% {\n      left: -90%;\n    }\n\n    42% {\n      left: -90%;\n    }\n\n    72% {\n      left: 130%;\n    }\n\n    100% {\n      left: 130%;\n    }\n  }\n\n  @media (max-width: 1050px) {\n    .devise-rotating-hero__content h1 {\n      max-width: 720px;\n    }\n  }\n\n  @media (max-width: 700px) {\n    .devise-rotating-hero {\n      min-height: var(--hero-height-mobile);\n    }\n\n    .devise-rotating-hero__image {\n      filter: brightness(0.86) contrast(1.04) saturate(0.96);\n      background-position: center top;\n    }\n\n    .devise-rotating-hero__contrast {\n      background:\n        linear-gradient(\n          180deg,\n          rgba(0, 0, 0, 0.02) 0%,\n          rgba(0, 0, 0, 0.10) 34%,\n          rgba(0, 0, 0, 0.48) 74%,\n          rgba(0, 0, 0, 0.74) 100%\n        ),\n        linear-gradient(\n          90deg,\n          rgba(0, 0, 0, 0.28) 0%,\n          rgba(0, 0, 0, 0.08) 100%\n        );\n    }\n\n    .devise-rotating-hero__fade {\n      display: none;\n    }\n\n    .devise-rotating-hero__inner {\n      min-height: var(--hero-height-mobile);\n      align-items: flex-end;\n      padding: 0 22px 44px;\n    }\n\n    .devise-rotating-hero__content {\n      margin: 0;\n      max-width: var(--content-width-mobile);\n      padding: 0;\n      background: transparent;\n      border: 0;\n      text-align: left;\n    }\n\n    .devise-rotating-hero__small-text {\n      margin: 0 0 14px;\n      font-size: 13px;\n      line-height: 1.35;\n      font-weight: 850;\n      max-width: 220px;\n      text-align: left;\n      filter: brightness(1.16) contrast(1.10);\n    }\n\n    .devise-rotating-hero__content h1 {\n      font-size: clamp(27px, 8vw, 34px);\n      line-height: 1.12;\n      letter-spacing: -0.032em;\n      text-transform: uppercase;\n      max-width: var(--content-width-mobile);\n      text-align: left;\n      white-space: normal;\n      filter: brightness(1.18) contrast(1.12);\n    }\n\n    .devise-rotating-hero__buttons {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n      margin-top: 32px;\n      max-width: var(--content-width-mobile);\n      text-align: left;\n    }\n\n    .devise-rotating-hero__btn {\n      min-height: 54px;\n      padding: 0 10px;\n      font-size: 13px;\n      border-radius: 0;\n    }\n  }\n\n  @media (max-width: 390px) {\n    .devise-rotating-hero {\n      min-height: 650px;\n    }\n\n    .devise-rotating-hero__inner {\n      min-height: 650px;\n      padding: 0 18px 38px;\n    }\n\n    .devise-rotating-hero__content {\n      max-width: 300px;\n    }\n\n    .devise-rotating-hero__small-text {\n      font-size: 12.5px;\n      max-width: 210px;\n    }\n\n    .devise-rotating-hero__content h1 {\n      font-size: clamp(25px, 7.8vw, 32px);\n      max-width: 300px;\n    }\n\n    .devise-rotating-hero__buttons {\n      max-width: 300px;\n    }\n\n    .devise-rotating-hero__btn {\n      min-height: 50px;\n      font-size: 12.5px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const hero = document.querySelector(\"[data-devise-rotating-hero]\");\n    if (!hero) return;\n\n    const imageA = hero.querySelector(\"[data-hero-image-a]\");\n    const imageB = hero.querySelector(\"[data-hero-image-b]\");\n    const title = hero.querySelector(\"[data-hero-title]\");\n    const text = hero.querySelector(\"[data-hero-text]\");\n    const speed = Number(hero.getAttribute(\"data-slide-speed\")) || 30000;\n\n    const slides = [\n      {\n        image: {{ slide_1_image | json }},\n        title: {{ slide_1_big_text | json }},\n        text: {{ slide_1_small_text | json }}\n      },\n      {\n        image: {{ slide_2_image | json }},\n        title: {{ slide_2_big_text | json }},\n        text: {{ slide_2_small_text | json }}\n      },\n      {\n        image: {{ slide_3_image | json }},\n        title: {{ slide_3_big_text | json }},\n        text: {{ slide_3_small_text | json }}\n      }\n    ];\n\n    slides.forEach(function (slide) {\n      const img = new Image();\n      img.src = slide.image;\n    });\n\n    let index = 0;\n    let activeLayer = imageA;\n    let inactiveLayer = imageB;\n\n    function setBackground(layer, image) {\n      layer.style.backgroundImage = 'url(\"' + image + '\")';\n    }\n\n    setBackground(imageA, slides[0].image);\n    title.textContent = slides[0].title;\n    text.textContent = slides[0].text;\n\n    setInterval(function () {\n      index = (index + 1) % slides.length;\n      const slide = slides[index];\n\n      setBackground(inactiveLayer, slide.image);\n\n      inactiveLayer.classList.add(\"devise-rotating-hero__image--active\");\n      activeLayer.classList.remove(\"devise-rotating-hero__image--active\");\n\n      title.textContent = slide.title;\n      text.textContent = slide.text;\n\n      const temp = activeLayer;\n      activeLayer = inactiveLayer;\n      inactiveLayer = temp;\n    }, speed);\n  });\n</script>\n\n{% endif %}",
