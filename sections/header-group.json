      "settings": {
        "custom_liquid": "{% if request.page_type == 'index' %}\n<section class=\"devise-hero-card\">\n  <div class=\"devise-hero-card__inner\">\n\n    <div class=\"devise-hero-card__left\">\n      <div class=\"devise-hero-card__eyebrow\">\n        <span></span>\n        Custom hoodies · Designhjälp ingår\n      </div>\n\n      <h1 class=\"devise-hero-title\">\n        <span>Din idé.</span>\n        <span>Vår design.</span>\n        <span class=\"yellow\">Din perfekta tröja.</span>\n      </h1>\n\n      <p>\n        Skicka din idé så hjälper vi dig skapa en custom hoodie med premium känsla,\n        clean design och tryck som håller.\n      </p>\n\n      <div class=\"devise-hero-card__buttons\">\n        <a href=\"/pages/contact\" class=\"devise-square-btn devise-square-btn--main\">\n          Skapa Design\n          <span>→</span>\n        </a>\n\n        <a href=\"/collections/frontpage\" class=\"devise-square-btn devise-square-btn--ghost\">\n          Se katalogen\n          <span>→</span>\n        </a>\n      </div>\n    </div>\n\n    <div class=\"devise-live-card\">\n      <div class=\"devise-live-card__top\">\n        <span>LIVE NU</span>\n        <span><i></i> 3 IDÉER I KÖ</span>\n      </div>\n\n      <h2 id=\"deviseRotatingIdea\">\n        \"JAG VILL HA MIN MORMORS RECEPT PÅ BULLAR TRYCKT PÅ RYGG.\"\n      </h2>\n\n      <p>— Inkommande förfrågan, för 4 min sen</p>\n\n      <div class=\"devise-live-card__line\"></div>\n\n      <div class=\"devise-live-card__stats\">\n        <div>\n          <strong>24H</strong>\n          <span>Svar</span>\n        </div>\n\n        <div>\n          <strong>100+</strong>\n          <span>Kunder</span>\n        </div>\n\n        <div>\n          <strong>4.8</strong>\n          <span>Snittbetyg</span>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"devise-hero-bottom\">\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">✓</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>ENKELT</strong>\n          <p>Skicka din idé</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">⚡</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>SNABBT</strong>\n          <p>Svar inom 24h</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">★</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>PREMIUM</strong>\n          <p>Tryck som håller</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .devise-hero-card {\n    position: relative;\n    isolation: isolate;\n    background: #0A0A0A;\n    color: #FFFFFF;\n    font-family: Inter, Arial, sans-serif;\n    padding: 88px 20px 38px;\n    overflow: hidden;\n  }\n\n  .devise-hero-card::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background-image:\n      linear-gradient(rgba(10, 10, 10, 0.82), rgba(10, 10, 10, 0.9)),\n      url(\"https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=1800&q=85\");\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n    filter: grayscale(100%) contrast(1.15) brightness(0.55);\n    transform: scale(1.04);\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  .devise-hero-card::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(circle at 18% 18%, rgba(255, 222, 89, 0.16), transparent 28%),\n      radial-gradient(circle at 82% 42%, rgba(255, 222, 89, 0.07), transparent 30%),\n      linear-gradient(\n        90deg,\n        rgba(10, 10, 10, 0.96) 0%,\n        rgba(10, 10, 10, 0.86) 48%,\n        rgba(10, 10, 10, 0.78) 100%\n      ),\n      linear-gradient(\n        180deg,\n        rgba(10, 10, 10, 0.22) 0%,\n        rgba(5, 5, 5, 0.96) 100%\n      );\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  .devise-hero-card * {\n    box-sizing: border-box;\n  }\n\n  .devise-hero-card__inner {\n    position: relative;\n    z-index: 2;\n    max-width: 1120px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1.25fr 0.75fr;\n    align-items: center;\n    gap: 44px;\n  }\n\n  .devise-hero-card__eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    color: #FFDE59;\n    background: rgba(255, 222, 89, 0.08);\n    border: 1px solid rgba(255, 222, 89, 0.2);\n    border-radius: 999px;\n    padding: 8px 13px;\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.03em;\n    margin-bottom: 22px;\n    backdrop-filter: blur(12px);\n  }\n\n  .devise-hero-card__eyebrow span {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #FFDE59;\n    box-shadow: 0 0 14px rgba(255, 222, 89, 0.9);\n  }\n\n  .devise-hero-title {\n    margin: 0;\n    font-size: clamp(46px, 7vw, 86px);\n    line-height: 0.92;\n    letter-spacing: -0.075em;\n    font-weight: 950;\n  }\n\n  .devise-hero-title span {\n    display: block;\n    color: #FFFFFF;\n    white-space: nowrap;\n  }\n\n  .devise-hero-title .yellow {\n    color: #FFDE59;\n  }\n\n  .devise-hero-card__left > p {\n    max-width: 560px;\n    margin: 26px 0 0;\n    color: #D0D0D0;\n    font-size: 18px;\n    line-height: 1.65;\n    font-weight: 500;\n  }\n\n  .devise-hero-card__buttons {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    margin-top: 34px;\n  }\n\n  .devise-square-btn {\n    min-height: 58px;\n    padding: 0 22px;\n    border-radius: 10px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    text-decoration: none;\n    font-size: 14px;\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: 0.03em;\n    transition: 0.22s ease;\n  }\n\n  .devise-square-btn span {\n    font-size: 18px;\n    line-height: 1;\n  }\n\n  .devise-square-btn--main {\n    background: #FFDE59;\n    color: #0A0A0A;\n    box-shadow:\n      0 0 0 1px rgba(255, 222, 89, 0.45),\n      0 0 34px rgba(255, 222, 89, 0.34);\n  }\n\n  .devise-square-btn--main:hover {\n    transform: translateY(-2px);\n    box-shadow:\n      0 0 0 1px rgba(255, 222, 89, 0.75),\n      0 0 52px rgba(255, 222, 89, 0.48);\n  }\n\n  .devise-square-btn--ghost {\n    background: rgba(17, 17, 17, 0.72);\n    color: #FFFFFF;\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    backdrop-filter: blur(12px);\n  }\n\n  .devise-square-btn--ghost:hover {\n    border-color: #FFDE59;\n    color: #FFDE59;\n    transform: translateY(-2px);\n  }\n\n  .devise-live-card {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    max-width: 410px;\n    margin-left: auto;\n    background: rgba(10, 10, 10, 0.72);\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    padding: 28px;\n    min-height: 320px;\n    backdrop-filter: blur(18px);\n    box-shadow:\n      0 30px 80px rgba(0, 0, 0, 0.5),\n      0 0 50px rgba(255, 222, 89, 0.08);\n  }\n\n  .devise-live-card__top {\n    display: flex;\n    justify-content: space-between;\n    gap: 18px;\n    margin-bottom: 22px;\n  }\n\n  .devise-live-card__top span {\n    color: #A0A0A0;\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.12em;\n    white-space: nowrap;\n  }\n\n  .devise-live-card__top i {\n    display: inline-block;\n    width: 7px;\n    height: 7px;\n    background: #FFDE59;\n    border-radius: 50%;\n    margin-right: 7px;\n    box-shadow: 0 0 12px rgba(255, 222, 89, 0.9);\n  }\n\n  .devise-live-card h2 {\n    margin: 0;\n    font-size: clamp(22px, 2.3vw, 31px);\n    line-height: 1.05;\n    letter-spacing: -0.06em;\n    font-weight: 950;\n    color: #FFFFFF;\n  }\n\n  .devise-live-card > p {\n    color: #A0A0A0;\n    font-size: 14px;\n    font-weight: 750;\n    margin: 16px 0 0;\n  }\n\n  .devise-live-card__line {\n   