    "custom_liquid_B66N9k": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% if request.page_type == 'index' %}\n\n{% comment %}\n  =====================================================\n  1. BILDER — ÄNDRA HÄR\n  Ladda upp egna bilder i Shopify:\n  Content > Files > Upload files\n  Kopiera bildlänken och klistra in här\n  =====================================================\n{% endcomment %}\n\n{% assign slide_1_image = 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=1800&q=85' %}\n{% assign slide_2_image = 'https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1800&q=85' %}\n{% assign slide_3_image = 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1800&q=85' %}\n\n{% comment %}\n  =====================================================\n  2. LÄNKAR — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign primary_button_link = '/pages/contact' %}\n{% assign secondary_button_link = '/collections/frontpage' %}\n\n{% comment %}\n  =====================================================\n  3. TEXT — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign hero_small_title = 'Designa själv' %}\n{% assign hero_title_1 = 'Skapa tröjan' %}\n{% assign hero_title_2 = 'ingen annan har.' %}\n{% assign hero_description = 'Egen text, egen bild eller egen logga. Enkelt att skapa för fest, svensexa eller företag.' %}\n\n{% assign primary_button_text = 'Skapa design' %}\n{% assign secondary_button_text = 'Se katalogen' %}\n\n{% assign slide_1_label = 'Fest' %}\n{% assign slide_1_text = 'Matchande tröjor för kvällen.' %}\n\n{% assign slide_2_label = 'Svensexa' %}\n{% assign slide_2_text = 'Roligt, personligt och enkelt.' %}\n\n{% assign slide_3_label = 'Firmafest' %}\n{% assign slide_3_text = 'Tröjor med egen logga eller text.' %}\n\n{% assign rotate_interval_ms = 4500 %}\n\n{% comment %}\n  =====================================================\n  4. FÄRGER — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign color_header_blend = '#000000' %}\n{% assign color_hero_top = '#050505' %}\n{% assign color_hero_middle = '#0D0D0D' %}\n{% assign color_hero_bottom = '#171717' %}\n{% assign color_next_section = '#FFFFFF' %}\n\n{% assign color_main_text = '#FFFFFF' %}\n{% assign color_secondary_text = '#D7D7D7' %}\n{% assign color_small_text = '#B5B5B5' %}\n\n{% assign color_primary_button_bg = '#FFDE59' %}\n{% assign color_primary_button_text = '#0A0A0A' %}\n{% assign color_primary_button_border = '#FFDE59' %}\n\n{% assign color_secondary_button_bg = '#000000' %}\n{% assign color_secondary_button_text = '#FFFFFF' %}\n{% assign color_secondary_button_border = '#000000' %}\n\n{% assign color_preview_border = '#2E2E2E' %}\n{% assign color_preview_label_bg = '#FFFFFF' %}\n{% assign color_preview_label_text = '#0A0A0A' %}\n{% assign color_preview_text = '#FFFFFF' %}\n{% assign color_preview_subtext = '#E8E8E8' %}\n\n{% comment %}\n  =====================================================\n  5. FORM / STORLEK — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign hero_max_width = '1460px' %}\n{% assign preview_radius = '16px' %}\n{% assign button_radius = '4px' %}\n\n<section\n  class=\"devise-hero-simple\"\n  data-devise-hero\n  style=\"--hero-image: url('{{ slide_1_image }}'); --preview-image: url('{{ slide_1_image }}');\"\n>\n  <div class=\"devise-hero-simple__bg\"></div>\n\n  <div class=\"devise-hero-simple__inner\">\n    <div class=\"devise-hero-simple__content\">\n      <div class=\"devise-hero-simple__small-title\">\n        {{ hero_small_title }}\n      </div>\n\n      <h1 class=\"devise-hero-simple__title\">\n        <span>{{ hero_title_1 }}</span>\n        <span>{{ hero_title_2 }}</span>\n      </h1>\n\n      <p class=\"devise-hero-simple__text\">\n        {{ hero_description }}\n      </p>\n\n      <div class=\"devise-hero-simple__buttons\">\n        <a href=\"{{ primary_button_link }}\" class=\"devise-hero-simple__btn devise-hero-simple__btn--primary\">\n          {{ primary_button_text }}\n        </a>\n\n        <a href=\"{{ secondary_button_link }}\" class=\"devise-hero-simple__btn devise-hero-simple__btn--secondary\">\n          {{ secondary_button_text }}\n        </a>\n      </div>\n    </div>\n\n    <div class=\"devise-hero-simple__preview\" data-devise-preview>\n      <div class=\"devise-hero-simple__preview-content\">\n        <span class=\"devise-hero-simple__preview-label\" data-devise-preview-label>\n          {{ slide_1_label }}\n        </span>\n        <p class=\"devise-hero-simple__preview-text\" data-devise-preview-text>\n          {{ slide_1_text }}\n        </p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .devise-hero-simple {\n    --header-blend: {{ color_header_blend }};\n    --hero-top: {{ color_hero_top }};\n    --hero-middle: {{ color_hero_middle }};\n    --hero-bottom: {{ color_hero_bottom }};\n    --next-section: {{ color_next_section }};\n\n    --main-text: {{ color_main_text }};\n    --secondary-text: {{ color_secondary_text }};\n    --small-text: {{ color_small_text }};\n\n    --primary-button-bg: {{ color_primary_button_bg }};\n    --primary-button-text: {{ color_primary_button_text }};\n    --primary-button-border: {{ color_primary_button_border }};\n\n    --secondary-button-bg: {{ color_secondary_button_bg }};\n    --secondary-button-text: {{ color_secondary_button_text }};\n    --secondary-button-border: {{ color_secondary_button_border }};\n\n    --preview-border: {{ color_preview_border }};\n    --preview-label-bg: {{ color_preview_label_bg }};\n    --preview-label-text: {{ color_preview_label_text }};\n    --preview-text: {{ color_preview_text }};\n    --preview-subtext: {{ color_preview_subtext }};\n\n    --hero-max-width: {{ hero_max_width }};\n    --preview-radius: {{ preview_radius }};\n    --button-radius: {{ button_radius }};\n\n    position: relative;\n    isolation: isolate;\n    background:\n      linear-gradient(\n        180deg,\n        var(--header-blend) 0%,\n        var(--hero-top) 12%,\n        var(--hero-middle) 58%,\n        var(--hero-bottom) 80%,\n        var(--next-section) 100%\n      );\n    color: var(--main-text);\n    font-family: Inter, Arial, sans-serif;\n    padding: 96px 22px 36px;\n    overflow: hidden;\n  }\n\n  .devise-hero-simple * {\n    box-sizing: border-box;\n  }\n\n  .devise-hero-simple__bg {\n    position: absolute;\n    inset: 0;\n    background-image:\n      linear-gradient(\n        180deg,\n        rgba(0, 0, 0, 0.12) 0%,\n        rgba(0, 0, 0, 0.26) 28%,\n        rgba(0, 0, 0, 0.42) 68%,\n        rgba(255, 255, 255, 0.00) 100%\n      ),\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.72) 0%,\n        rgba(0, 0, 0, 0.50) 42%,\n        rgba(0, 0, 0, 0.18) 100%\n      ),\n      var(--hero-image);\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n    filter: contrast(1.03) brightness(0.78);\n    transition: background-image 0.4s ease;\n    z-index: -2;\n    pointer-events: none;\n  }\n\n  .devise-hero-simple::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 180px;\n    background: linear-gradient(\n      180deg,\n      rgba(255, 255, 255, 0) 0%,\n      var(--next-section) 100%\n    );\n    z-index: -1;\n    pointer-events: none;\n  }\n\n  .devise-hero-simple__inner {\n    position: relative;\n    z-index: 2;\n    max-width: var(--hero-max-width);\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.85fr);\n    align-items: center;\n    gap: clamp(32px, 5vw, 78px);\n  }\n\n  .devise-hero-simple__content {\n    min-width: 0;\n    padding-left: clamp(0px, 1.2vw, 18px);\n  }\n\n  .devise-hero-simple__small-title {\n    color: var(--main-text);\n    font-size: 18px;\n    font-weight: 900;\n    letter-spacing: -0.03em;\n    margin-bottom: 12px;\n  }\n\n  .devise-hero-simple__title {\n    margin: 0;\n    max-width: 650px;\n    font-size: clamp(42px, 6.2vw, 78px);\n    line-height: 0.95;\n    letter-spacing: -0.06em;\n    font-weight: 950;\n  }\n\n  .devise-hero-simple__title span {\n    display: block;\n    color: var(--main-text);\n  }\n\n  .devise-hero-simple__text {\n    max-width: 560px;\n    margin: 20px 0 0;\n    color: var(--secondary-text);\n    font-size: 16px;\n    line-height: 1.55;\n    font-weight: 520;\n  }\n\n  .devise-hero-simple__buttons {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n    margin-top: 28px;\n  }\n\n  .devise-hero-simple__btn {\n    min-height: 54px;\n    padding: 0 22px;\n    border-radius: var(--button-radius);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    text-decoration: none;\n    font-size: 14px;\n    font-weight: 900;\n    letter-spacing: 0.01em;\n    transition: 0.2s ease;\n  }\n\n  .devise-hero-simple__btn--primary {\n    background: var(--primary-button-bg);\n    color: var(--primary-button-text);\n    border: 1px solid var(--primary-button-border);\n  }\n\n  .devise-hero-simple__btn--primary:hover {\n    transform: translateY(-2px);\n  }\n\n  .devise-hero-simple__btn--secondary {\n    background: var(--secondary-button-bg);\n    color: var(--secondary-button-text);\n    border: 1px solid var(--secondary-button-border);\n  }\n\n  .devise-hero-simple__btn--secondary:hover {\n    transform: translateY(-2px);\n  }\n\n  .devise-hero-simple__preview {\n    width: min(100%, 470px);\n    min-height: 420px;\n    justify-self: end;\n    border-radius: var(--preview-radius);\n    border: 1px solid var(--preview-border);\n    overflow: hidden;\n    background-image:\n      linear-gradient(\n        180deg,\n        rgba(0, 0, 0, 0.10) 0%,\n        rgba(0, 0, 0, 0.12) 38%,\n        rgba(0, 0, 0, 0.46) 100%\n      ),\n      var(--preview-image);\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n    display: flex;\n    align-items: flex-end;\n    padding: 22px;\n    transition: background-image 0.4s ease;\n  }\n\n  .devise-hero-simple__preview-content {\n    max-width: 260px;\n  }\n\n  .devise-hero-simple__preview-label {\n    display: inline-flex;\n    align-items: center;\n    min-height: 28px;\n    padding: 0 10px;\n    border-radius: 999px;\n    background: var(--preview-label-bg);\n    color: var(--preview-label-text);\n    font-size: 11px;\n    font-weight: 950;\n    letter-spacing: 0.05em;\n    margin-bottom: 10px;\n  }\n\n  .devise-hero-simple__preview-text {\n    margin: 0;\n    color: var(--preview-text);\n    font-size: 22px;\n    line-height: 1.08;\n    font-weight: 900;\n    letter-spacing: -0.04em;\n  }\n\n  @media (max-width: 980px) {\n    .devise-hero-simple {\n      padding: 72px 18px 30px;\n    }\n\n    .devise-hero-simple__inner {\n      grid-template-columns: 1fr;\n      gap: 28px;\n      text-align: center;\n      max-width: 760px;\n    }\n\n    .devise-hero-simple__content {\n      padding-left: 0;\n    }\n\n    .devise-hero-simple__text {\n      margin-left: auto;\n      margin-right: auto;\n    }\n\n    .devise-hero-simple__buttons {\n      justify-content: center;\n    }\n\n    .devise-hero-simple__preview {\n      justify-self: center;\n      width: min(100%, 560px);\n      min-height: 300px;\n    }\n\n    .devise-hero-simple__preview-content {\n      max-width: 300px;\n      text-align: left;\n    }\n  }\n\n  @media (max-width: 700px) {\n    .devise-hero-simple {\n      min-height: 640px;\n      padding: 0 28px 34px;\n      display: flex;\n      align-items: flex-end;\n      background: #000000;\n    }\n\n    .devise-hero-simple__bg {\n      background-image:\n        linear-gradient(\n          180deg,\n          rgba(0, 0, 0, 0.04) 0%,\n          rgba(0, 0, 0, 0.12) 36%,\n          rgba(0, 0, 0, 0.58) 72%,\n          rgba(0, 0, 0, 0.84) 100%\n        ),\n        var(--hero-image);\n      background-position: center top;\n      background-size: cover;\n      filter: contrast(1.02) brightness(0.90);\n    }\n\n    .devise-hero-simple::after {\n      display: none;\n    }\n\n    .devise-hero-simple__inner {\n      width: 100%;\n      display: block;\n      text-align: left;\n      max-width: 100%;\n      margin: 0;\n    }\n\n    .devise-hero-simple__content {\n      padding: 0;\n      width: 100%;\n    }\n\n    .devise-hero-simple__small-title {\n      font-size: 22px;\n      line-height: 1;\n      font-weight: 950;\n      letter-spacing: -0.05em;\n      margin-bottom: 8px;\n    }\n\n    .devise-hero-simple__title {\n      max-width: 100%;\n      font-size: clamp(34px, 11vw, 50px);\n      line-height: 0.98;\n      letter-spacing: -0.05em;\n      font-weight: 950;\n      text-transform: uppercase;\n    }\n\n    .devise-hero-simple__text {\n      display: none;\n    }\n\n    .devise-hero-simple__buttons {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n      margin-top: 24px;\n      width: 100%;\n    }\n\n    .devise-hero-simple__btn {\n      width: 100%;\n      min-height: 56px;\n      border-radius: 0;\n      font-size: 14px;\n      padding: 0 10px;\n      letter-spacing: 0;\n      text-transform: none;\n    }\n\n    .devise-hero-simple__preview {\n      display: none;\n    }\n  }\n\n  @media (max-width: 390px) {\n    .devise-hero-simple {\n      min-height: 600px;\n      padding: 0 22px 30px;\n    }\n\n    .devise-hero-simple__small-title {\n      font-size: 20px;\n    }\n\n    .devise-hero-simple__title {\n      font-size: clamp(31px, 10.8vw, 42px);\n    }\n\n    .devise-hero-simple__btn {\n      min-height: 52px;\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const hero = document.querySelector(\"[data-devise-hero]\");\n    if (!hero) return;\n\n    const previewLabel = hero.querySelector(\"[data-devise-preview-label]\");\n    const previewText = hero.querySelector(\"[data-devise-preview-text]\");\n\n    const slides = [\n      {\n        image: {{ slide_1_image | json }},\n        label: {{ slide_1_label | json }},\n        text: {{ slide_1_text | json }}\n      },\n      {\n        image: {{ slide_2_image | json }},\n        label: {{ slide_2_label | json }},\n        text: {{ slide_2_text | json }}\n      },\n      {\n        image: {{ slide_3_image | json }},\n        label: {{ slide_3_label | json }},\n        text: {{ slide_3_text | json }}\n      }\n    ];\n\n    let currentIndex = 0;\n\n    function updateSlide(index) {\n      const slide = slides[index];\n      hero.style.setProperty(\"--hero-image\", 'url(\"' + slide.image + '\")');\n      hero.style.setProperty(\"--preview-image\", 'url(\"' + slide.image + '\")');\n\n      if (previewLabel) previewLabel.textContent = slide.label;\n      if (previewText) previewText.textContent = slide.text;\n    }\n\n    updateSlide(currentIndex);\n\n    setInterval(function () {\n      currentIndex = (currentIndex + 1) % slides.length;\n      updateSlide(currentIndex);\n    }, {{ rotate_interval_ms }});\n  });\n</script>\n\n{% endif %}",
        "background_color": "{{ settings.color_palette.background }}",
