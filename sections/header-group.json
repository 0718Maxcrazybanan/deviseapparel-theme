er {\n      grid-template-columns: 1fr;\n      gap: 28px;\n      text-align: center;\n      max-width: 620px;\n    }\n\n    .devise-hero-card__eyebrow {\n      font-size: 11px;\n      padding: 7px 11px;\n      margin-bottom: 18px;\n    }\n\n    .devise-hero-title {\n      font-size: clamp(38px, 9vw, 58px);\n      line-height: 0.94;\n      letter-spacing: -0.065em;\n    }\n\n    .devise-hero-card__left > p {\n      max-width: 480px;\n      margin: 20px auto 0;\n      font-size: 15px;\n      line-height: 1.55;\n    }\n\n    .devise-hero-card__buttons {\n      justify-content: center;\n      margin-top: 26px;\n    }\n\n    .devise-square-btn {\n      min-height: 54px;\n      padding: 0 20px;\n      font-size: 12px;\n    }\n\n    .devise-live-card {\n      max-width: 460px;\n      margin: 0 auto;\n      padding: 22px;\n      min-height: auto;\n      text-align: left;\n    }\n\n    .devise-live-card h2 {\n      font-size: clamp(22px, 5vw, 28px);\n    }\n\n    .devise-hero-bottom {\n      max-width: 460px;\n      grid-template-columns: 1fr;\n      gap: 10px;\n      margin-top: 24px;\n    }\n\n    .devise-bottom-item {\n      padding: 13px;\n    }\n  }\n\n  @media (max-width: 560px) {\n    .devise-hero-card {\n      padding: 44px 14px 24px;\n    }\n\n    .devise-hero-card::before {\n      background-position: center top;\n      transform: scale(1.08);\n    }\n\n    .devise-hero-card__inner {\n      gap: 24px;\n    }\n\n    .devise-hero-card__eyebrow {\n      font-size: 10px;\n      padding: 6px 10px;\n      margin-bottom: 16px;\n    }\n\n    .devise-hero-title {\n      font-size: clamp(32px, 10.2vw, 45px);\n      line-height: 0.98;\n      letter-spacing: -0.055em;\n    }\n\n    .devise-hero-title span {\n      white-space: nowrap;\n    }\n\n    .devise-hero-card__left > p {\n      font-size: 14px;\n      line-height: 1.5;\n      margin-top: 18px;\n    }\n\n    .devise-hero-card__buttons {\n      flex-direction: column;\n      gap: 10px;\n      margin-top: 24px;\n    }\n\n    .devise-square-btn {\n      width: 100%;\n      min-height: 52px;\n      border-radius: 10px;\n      font-size: 12px;\n      padding: 0 16px;\n    }\n\n    .devise-live-card {\n      padding: 18px;\n      border-radius: 14px;\n    }\n\n    .devise-live-card__top {\n      flex-direction: row;\n      align-items: center;\n      gap: 10px;\n      margin-bottom: 16px;\n    }\n\n    .devise-live-card__top span {\n      font-size: 10px;\n      letter-spacing: 0.08em;\n    }\n\n    .devise-live-card h2 {\n      font-size: 22px;\n      line-height: 1.08;\n    }\n\n    .devise-live-card > p {\n      font-size: 12px;\n      margin-top: 12px;\n    }\n\n    .devise-live-card__line {\n      margin: 18px 0 16px;\n    }\n\n    .devise-live-card__stats {\n      gap: 8px;\n    }\n\n    .devise-live-card__stats strong {\n      font-size: 19px;\n    }\n\n    .devise-live-card__stats span {\n      font-size: 10px;\n    }\n\n    .devise-hero-bottom {\n      display: flex;\n      gap: 10px;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      margin-top: 20px;\n      padding-bottom: 4px;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .devise-hero-bottom::-webkit-scrollbar {\n      display: none;\n    }\n\n    .devise-bottom-item {\n      min-width: 78%;\n      scroll-snap-align: start;\n      padding: 13px;\n      border-radius: 12px;\n    }\n\n    .devise-bottom-icon {\n      width: 38px;\n      height: 38px;\n    }\n\n    .devise-bottom-text > span {\n      height: 30px;\n    }\n\n    .devise-bottom-text strong {\n      font-size: 12px;\n    }\n\n    .devise-bottom-text p {\n      font-size: 12px;\n    }\n  }\n\n  @media (max-width: 380px) {\n    .devise-hero-title {\n      font-size: clamp(29px, 9.7vw, 38px);\n    }\n\n    .devise-live-card__top {\n      flex-direction: column;\n      align-items: flex-start;\n    }\n\n    .devise-bottom-item {\n      min-width: 86%;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const ideaElement = document.getElementById(\"deviseRotatingIdea\");\n    if (!ideaElement) return;\n\n    const ideas = [\n      \"JAG VILL HA MIN MORMORS RECEPT PÅ BULLAR TRYCKT PÅ RYGG.\",\n      \"JAG VILL GÖRA EN HOODIE MED MITT EGET BRANDNAMN.\",\n      \"JAG VILL HA EN CLEAN TEXT PÅ BRÖSTET OCH STORT TRYCK PÅ RYGGEN.\",\n      \"JAG VILL TRYCKA MIN HUNDS ANSIKTE PÅ EN SVART HOODIE.\",\n      \"JAG VILL HA EN MATCHANDE HOODIE TILL MITT FOTBOLLSLAG.\",\n      \"JAG VILL GÖRA EN HOODIE TILL MIN BÄSTA VÄN.\",\n      \"JAG VILL HA MIN LOGGA TRYCKT PÅ EN PREMIUM HOODIE.\",\n      \"JAG VILL SKAPA MERCH TILL MIN TIKTOK.\",\n      \"JAG VILL HA EN VINTAGE DESIGN MED MIN EGEN TEXT.\",\n      \"JAG VILL GÖRA EN HOODIE TILL VÅR KLASS.\",\n      \"JAG VILL HA EN MINIMAL DESIGN MED GUL TEXT.\",\n      \"JAG VILL TRYCKA ETT DATUM SOM BETYDER MYCKET FÖR MIG.\",\n      \"JAG VILL GÖRA EN HOODIE MED MIN MUSIKGRUPP.\",\n      \"JAG VILL HA EN OVERSIZED HOODIE MED CLEAN RYGGTRYCK.\",\n      \"JAG VILL SKAPA EN TRÖJA TILL MIN FÖRENING.\",\n      \"JAG VILL HA EN DESIGN SOM SER UT SOM STREETWEAR.\",\n      \"JAG VILL TRYCKA MIN EGEN ILLUSTRATION PÅ RYGGEN.\",\n      \"JAG VILL HA EN HOODIE MED MITT GAMINGNAMN.\",\n      \"JAG VILL GÖRA MERCH TILL MITT UF-FÖRETAG.\",\n      \"JAG VILL HA EN SVART HOODIE MED EN LITEN LOGGA FRAM.\",\n      \"JAG VILL SKAPA EN TRÖJA TILL EN FÖDELSEDAG.\",\n      \"JAG VILL HA EN HOODIE MED EN INTERN JOKE PÅ RYGGEN.\",\n      \"JAG VILL GÖRA EN MATCHANDE DESIGN TILL MINA VÄNNER.\",\n      \"JAG VILL HA EN CLEAN HOODIE MED MITT NAMN.\",\n      \"JAG VILL TRYCKA EN BILD FRÅN EN RESA PÅ EN HOODIE.\",\n      \"JAG VILL HA MIN FÖRETAGSGRAFIK PÅ EN HOODIE.\",\n      \"JAG VILL GÖRA EN HOODIE TILL MITT GYM.\",\n      \"JAG VILL HA EN DESIGN MED STORT TRYCK OCH LITEN TEXT.\",\n      \"JAG VILL SKAPA EN HOODIE TILL MITT EVENT.\",\n      \"JAG VILL HA EN HOODIE SOM INTE SER UT SOM VANLIG MERCH.\",\n      \"JAG VILL TRYCKA ETT CITAT SOM BETYDER NÅG