        "custom_liquid": "<div class=\"devise-announcement-bar\">\n  <div class=\"devise-announcement-marquee\">\n    <div class=\"devise-announcement-track\">\n      \n      <div class=\"devise-announcement-group\">\n        <span><b>⭐</b> 100+ nöjda kunder</span>\n        <span>Gratis frakt över 500 SEK</span>\n        <span>Svar inom 24h</span>\n        <a href=\"https://www.tiktok.com/@deviseapparels\" aria-label=\"Följ vår TikTok\">Följ våran TikTok →</a>\n      </div>\n\n      <div class=\"devise-announcement-group\" aria-hidden=\"true\">\n        <span><b>⭐</b> 100+ nöjda kunder</span>\n        <span>Gratis frakt över 500 SEK</span>\n        <span>Svar inom 24h</span>\n        <a href=\"https://www.tiktok.com/@deviseapparels\" tabindex=\"-1\">Följ våran TikTok →</a>\n      </div>\n\n      <div class=\"devise-announcement-group\" aria-hidden=\"true\">\n        <span><b>⭐</b> 100+ nöjda kunder</span>\n        <span>Gratis frakt över 500 SEK</span>\n        <span>Svar inom 24h</span>\n        <a href=\"https://www.tiktok.com/@deviseapparels\" tabindex=\"-1\">Följ våran TikTok →</a>\n      </div>\n\n      <div class=\"devise-announcement-group\" aria-hidden=\"true\">\n        <span><b>⭐</b> 100+ nöjda kunder</span>\n        <span>Gratis frakt över 500 SEK</span>\n        <span>Svar inom 24h</span>\n        <a href=\"https://www.tiktok.com/@deviseapparels\" tabindex=\"-1\">Följ våran TikTok →</a>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n  .devise-announcement-bar {\n    width: 100%;\n    height: 38px;\n    background: #0A0A0A;\n    color: #FFFFFF;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    font-family: Inter, Arial, sans-serif;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n    position: relative;\n    z-index: 50;\n  }\n\n  .devise-announcement-marquee {\n    width: 100%;\n    overflow: hidden;\n    white-space: nowrap;\n  }\n\n  .devise-announcement-track {\n    display: flex;\n    width: max-content;\n    animation: devise-announcement-scroll 9s linear infinite;\n    will-change: transform;\n  }\n\n  .devise-announcement-bar:hover .devise-announcement-track {\n    animation-play-state: paused;\n  }\n\n  .devise-announcement-group {\n    display: flex;\n    align-items: center;\n    gap: 130px;\n    padding-right: 130px;\n    flex-shrink: 0;\n  }\n\n  .devise-announcement-group span,\n  .devise-announcement-group a {\n    color: #FFFFFF;\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1;\n    text-decoration: none;\n    letter-spacing: 0.01em;\n  }\n\n  .devise-announcement-group b {\n    color: #FFDE59;\n    font-weight: 700;\n  }\n\n  .devise-announcement-group a {\n    color: #FFFFFF;\n    transition: color 0.2s ease;\n  }\n\n  .devise-announcement-group a:hover {\n    color: #FFDE59;\n  }\n\n  @keyframes devise-announcement-scroll {\n    from {\n      transform: translateX(0);\n    }\n    to {\n      transform: translateX(-25%);\n    }\n  }\n\n  @media (max-width: 1000px) {\n    .devise-announcement-bar {\n      height: 36px;\n    }\n\n    .devise-announcement-track {\n      animation-duration: 7s;\n    }\n\n    .devise-announcement-group {\n      gap: 32px;\n      padding-right: 32px;\n    }\n\n    .devise-announcement-group span,\n    .devise-announcement-group a {\n      font-size: 12px;\n    }\n  }\n</style>",
