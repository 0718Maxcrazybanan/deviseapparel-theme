    "custom_liquid_B66N9k": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% if request.page_type == 'index' %}\n\n{% comment %}\n  =====================================================\n  1. BILDER — ÄNDRA HÄR\n  Ladda upp egna bilder i Shopify:\n  Content > Files > Upload files\n  Kopiera bildlänken och klistra in här\n  =====================================================\n{% endcomment %}\n\n{% assign hero_background_image = 'https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=1800&q=85' %}\n\n{% assign usecase_image_1 = 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=900&q=85' %}\n{% assign usecase_image_2 = 'https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=900&q=85' %}\n{% assign usecase_image_3 = 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=900&q=85' %}\n\n{% comment %}\n  =====================================================\n  2. LÄNKAR — ÄNDRA HÄR\n  Jag behöll dina gamla länkar\n  =====================================================\n{% endcomment %}\n\n{% assign primary_button_link = '/pages/contact' %}\n{% assign secondary_button_link = '/collections/frontpage' %}\n\n{% comment %}\n  =====================================================\n  3. TEXT — ÄNDRA HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign hero_small_title = 'Designa själv' %}\n{% assign hero_title_1 = 'Skapa tröjan' %}\n{% assign hero_title_2 = 'ingen annan har.' %}\n\n{% assign hero_description = 'Ladda upp en bild, logga eller egen text och skapa en personlig tröja för festen, svensexan, företaget eller din egen merch.' %}\n\n{% assign primary_button_text = 'Skapa design' %}\n{% assign secondary_button_text = 'Se katalogen' %}\n\n{% assign usecase_1_number = '01' %}\n{% assign usecase_1_title = 'Fester' %}\n{% assign usecase_1_text = 'Matchande tröjor som gör kvällen roligare.' %}\n\n{% assign usecase_2_number = '02' %}\n{% assign usecase_2_title = 'Svensexor' %}\n{% assign usecase_2_text = 'Personligt, roligt och enkelt att beställa.' %}\n\n{% assign usecase_3_number = '03' %}\n{% assign usecase_3_title = 'Företagsevent' %}\n{% assign usecase_3_text = 'Clean merch med logga, text eller egen design.' %}\n\n{% assign bottom_1_number = '1' %}\n{% assign bottom_1_title = 'SKICKA IDÉ' %}\n{% assign bottom_1_text = 'Beskriv designen eller ladda upp en bild.' %}\n\n{% assign bottom_2_number = '2' %}\n{% assign bottom_2_title = 'VI HJÄLPER' %}\n{% assign bottom_2_text = 'Du får hjälp att få trycket rätt.' %}\n\n{% assign bottom_3_number = '3' %}\n{% assign bottom_3_title = 'TRYCK KLART' %}\n{% assign bottom_3_text = 'En personlig tröja redo att användas.' %}\n\n{% comment %}\n  =====================================================\n  4. FÄRGER — ÄNDRA HEX-KODER HÄR\n  =====================================================\n{% endcomment %}\n\n{% assign color_header_blend = '#000000' %}\n{% assign color_hero_top = '#050505' %}\n{% assign color_hero_middle = '#0D0D0D' %}\n{% assign color_hero_bottom = '#171717' %}\n{% assign color_next_section = '#FFFFFF' %}\n\n{% assign color_main_text = '#FFFFFF' %}\n{% assign color_second_text = '#D8D8D8' %}\n{% assign color_muted_text = '#A8A8A8' %}\n\n{% assign color_yellow = '#FFDE59' %}\n{% assign color_black = '#0A0A0A' %}\n{% assign color_white = '#FFFFFF' %}\n\n{% assign color_primary_button_bg = '#FFDE59' %}\n{% assign color_primary_button_text = '#0A0A0A' %}\n{% assign color_primary_button_border = '#FFDE59' %}\n\n{% assign color_secondary_button_bg = '#000000' %}\n{% assign color_secondary_button_text = '#FFFFFF' %}\n{% assign color_secondary_button_border = '#000000' %}\n\n{% assign color_image_card_border = '#2E2E2E' %}\n{% assign color_image_card_text = '#FFFFFF' %}\n{% assign color_image_card_label_bg = '#FFFFFF' %}\n{% assign color_image_card_label_text = '#0A0A0A' %}\n\n{% assign color_bottom_card_bg = '#F8F8F8' %}\n{% assign color_bottom_card_border = '#DDDDDD' %}\n{% assign color_bottom_icon_bg = '#0A0A0A' %}\n{% assign color_bottom_icon_text = '#FFFFFF' %}\n{% assign color_bottom_title = '#0A0A0A' %}\n{% assign color_bottom_text = '#555555' %}\n{% assign color_bottom_line = '#0A0A0A' %}\n\n{% comment %}\n  =====================================================\n  5. FORM / STORLEK — ÄNDRA VID BEHOV\n  =====================================================\n{% endcomment %}\n\n{% assign hero_max_width = '1480px' %}\n{% assign card_radius = '14px' %}\n{% assign button_radius = '4px' %}\n\n<section class=\"devise-hero-modern\">\n  <div class=\"devise-hero-modern__bg\"></div>\n\n  <div class=\"devise-hero-modern__inner\">\n    <div class=\"devise-hero-modern__content\">\n      <div class=\"devise-hero-modern__small-title\">\n        {{ hero_small_title }}\n      </div>\n\n      <h1 class=\"devise-hero-modern__title\">\n        <span>{{ hero_title_1 }}</span>\n        <span>{{ hero_title_2 }}</span>\n      </h1>\n\n      <p class=\"devise-hero-modern__text\">\n        {{ hero_description }}\n      </p>\n\n      <div class=\"devise-hero-modern__buttons\">\n        <a href=\"{{ primary_button_link }}\" class=\"devise-hero-btn devise-hero-btn--primary\">\n          {{ primary_button_text }}\n          <span>→</span>\n        </a>\n\n        <a href=\"{{ secondary_button_link }}\" class=\"devise-hero-btn devise-hero-btn--secondary\">\n          {{ secondary_button_text }}\n          <span>→</span>\n        </a>\n      </div>\n    </div>\n\n    <div class=\"devise-usecase-stack\" aria-label=\"Exempel på användningsområden\">\n      <a href=\"{{ primary_button_link }}\" class=\"devise-usecase-card devise-usecase-card--one\" style=\"--usecase-image: url('{{ usecase_image_1 }}');\">\n        <div>\n          <span>{{ usecase_1_number }}</span>\n          <strong>{{ usecase_1_title }}</strong>\n          <p>{{ usecase_1_text }}</p>\n        </div>\n      </a>\n\n      <a href=\"{{ primary_button_link }}\" class=\"devise-usecase-card devise-usecase-card--two\" style=\"--usecase-image: url('{{ usecase_image_2 }}');\">\n        <div>\n          <span>{{ usecase_2_number }}</span>\n          <strong>{{ usecase_2_title }}</strong>\n          <p>{{ usecase_2_text }}</p>\n        </div>\n      </a>\n\n      <a href=\"{{ primary_button_link }}\" class=\"devise-usecase-card devise-usecase-card--three\" style=\"--usecase-image: url('{{ usecase_image_3 }}');\">\n        <div>\n          <span>{{ usecase_3_number }}</span>\n          <strong>{{ usecase_3_title }}</strong>\n          <p>{{ usecase_3_text }}</p>\n        </div>\n      </a>\n    </div>\n  </div>\n\n  <div class=\"devise-hero-bottom\">\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">{{ bottom_1_number }}</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>{{ bottom_1_title }}</strong>\n          <p>{{ bottom_1_text }}</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">{{ bottom_2_number }}</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>{{ bottom_2_title }}</strong>\n          <p>{{ bottom_2_text }}</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"devise-bottom-item\">\n      <div class=\"devise-bottom-icon\">{{ bottom_3_number }}</div>\n      <div class=\"devise-bottom-text\">\n        <span></span>\n        <div>\n          <strong>{{ bottom_3_title }}</strong>\n          <p>{{ bottom_3_text }}</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .devise-hero-modern {\n    --header-blend: {{ color_header_blend }};\n    --hero-top: {{ color_hero_top }};\n    --hero-middle: {{ color_hero_middle }};\n    --hero-bottom: {{ color_hero_bottom }};\n    --next-section: {{ color_next_section }};\n\n    --main-text: {{ color_main_text }};\n    --second-text: {{ color_second_text }};\n    --muted-text: {{ color_muted_text }};\n\n    --yellow: {{ color_yellow }};\n    --black: {{ color_black }};\n    --white: {{ color_white }};\n\n    --primary-button-bg: {{ color_primary_button_bg }};\n    --primary-button-text: {{ color_primary_button_text }};\n    --primary-button-border: {{ color_primary_button_border }};\n\n    --secondary-button-bg: {{ color_secondary_button_bg }};\n    --secondary-button-text: {{ color_secondary_button_text }};\n    --secondary-button-border: {{ color_secondary_button_border }};\n\n    --image-card-border: {{ color_image_card_border }};\n    --image-card-text: {{ color_image_card_text }};\n    --image-card-label-bg: {{ color_image_card_label_bg }};\n    --image-card-label-text: {{ color_image_card_label_text }};\n\n    --bottom-card-bg: {{ color_bottom_card_bg }};\n    --bottom-card-border: {{ color_bottom_card_border }};\n    --bottom-icon-bg: {{ color_bottom_icon_bg }};\n    --bottom-icon-text: {{ color_bottom_icon_text }};\n    --bottom-title: {{ color_bottom_title }};\n    --bottom-text: {{ color_bottom_text }};\n    --bottom-line: {{ color_bottom_line }};\n\n    --hero-max-width: {{ hero_max_width }};\n    --card-radius: {{ card_radius }};\n    --button-radius: {{ button_radius }};\n\n    position: relative;\n    isolation: isolate;\n    background:\n      linear-gradient(\n        180deg,\n        var(--header-blend) 0%,\n        var(--hero-top) 12%,\n        var(--hero-middle) 58%,\n        var(--hero-bottom) 78%,\n        var(--next-section) 100%\n      );\n    color: var(--main-text);\n    font-family: Inter, Arial, sans-serif;\n    padding: 96px 22px 32px;\n    overflow: hidden;\n  }\n\n  .devise-hero-modern * {\n    box-sizing: border-box;\n  }\n\n  .devise-hero-modern__bg {\n    position: absolute;\n    inset: 0;\n    background-image:\n      linear-gradient(\n        180deg,\n        var(--header-blend) 0%,\n        rgba(0, 0, 0, 0.14) 18%,\n        rgba(0, 0, 0, 0.68) 72%,\n        var(--next-section) 100%\n      ),\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.90) 0%,\n        rgba(0, 0, 0, 0.72) 45%,\n        rgba(0, 0, 0, 0.44) 100%\n      ),\n      url(\"{{ hero_background_image }}\");\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n    filter: grayscale(100%) contrast(1.05) brightness(0.76);\n    z-index: -2;\n    pointer-events: none;\n  }\n\n  .devise-hero-modern::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 220px;\n    background: linear-gradient(\n      180deg,\n      rgba(255, 255, 255, 0) 0%,\n      var(--next-section) 100%\n    );\n    z-index: -1;\n    pointer-events: none;\n  }\n\n  .devise-hero-modern__inner {\n    position: relative;\n    z-index: 2;\n    max-width: var(--hero-max-width);\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);\n    align-items: center;\n    gap: clamp(38px, 5vw, 82px);\n  }\n\n  .devise-hero-modern__content {\n    min-width: 0;\n    padding-left: clamp(0px, 1.5vw, 18px);\n  }\n\n  .devise-hero-modern__small-title {\n    color: var(--main-text);\n    font-size: 20px;\n    font-weight: 950;\n    letter-spacing: -0.04em;\n    margin-bottom: 14px;\n  }\n\n  .devise-hero-modern__title {\n    margin: 0;\n    max-width: 820px;\n    font-size: clamp(50px, 7.4vw, 98px);\n    line-height: 0.9;\n    letter-spacing: -0.08em;\n    font-weight: 950;\n  }\n\n  .devise-hero-modern__title span {\n    display: block;\n    color: var(--main-text);\n  }\n\n  .devise-hero-modern__title span:last-child {\n    color: var(--yellow);\n  }\n\n  .devise-hero-modern__text {\n    max-width: 640px;\n    margin: 26px 0 0;\n    color: var(--second-text);\n    font-size: 18px;\n    line-height: 1.65;\n    font-weight: 520;\n  }\n\n  .devise-hero-modern__buttons {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    margin-top: 34px;\n  }\n\n  .devise-hero-btn {\n    min-height: 56px;\n    padding: 0 22px;\n    border-radius: var(--button-radius);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    text-decoration: none;\n    font-size: 14px;\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: 0.03em;\n    transition: 0.2s ease;\n  }\n\n  .devise-hero-btn span {\n    font-size: 18px;\n    line-height: 1;\n  }\n\n  .devise-hero-btn--primary {\n    background: var(--primary-button-bg);\n    color: var(--primary-button-text);\n    border: 1px solid var(--primary-button-border);\n  }\n\n  .devise-hero-btn--primary:hover {\n    transform: translateY(-2px);\n  }\n\n  .devise-hero-btn--secondary {\n    background: var(--secondary-button-bg);\n    color: var(--secondary-button-text);\n    border: 1px solid var(--secondary-button-border);\n  }\n\n  .devise-hero-btn--secondary:hover {\n    color: var(--yellow);\n    border-color: var(--yellow);\n    transform: translateY(-2px);\n  }\n\n  .devise-usecase-stack {\n    position: relative;\n    width: min(100%, 540px);\n    justify-self: end;\n    margin-right: clamp(-24px, -1.6vw, -8px);\n    display: grid;\n    gap: 14px;\n  }\n\n  .devise-usecase-card {\n    position: relative;\n    min-height: 156px;\n    overflow: hidden;\n    border-radius: var(--card-radius);\n    border: 1px solid var(--image-card-border);\n    background-image:\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.76) 0%,\n        rgba(0, 0, 0, 0.38) 100%\n      ),\n      var(--usecase-image);\n    background-size: cover;\n    background-position: center;\n    text-decoration: none;\n    display: flex;\n    align-items: flex-end;\n    padding: 18px;\n    transition: 0.2s ease;\n  }\n\n  .devise-usecase-card:hover {\n    transform: translateY(-2px);\n    border-color: var(--yellow);\n  }\n\n  .devise-usecase-card--one {\n    width: 88%;\n    margin-left: auto;\n  }\n\n  .devise-usecase-card--two {\n    width: 100%;\n    margin-left: 0;\n  }\n\n  .devise-usecase-card--three {\n    width: 90%;\n    margin-left: 44px;\n  }\n\n  .devise-usecase-card span {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 26px;\n    padding: 0 9px;\n    margin-bottom: 8px;\n    border-radius: 999px;\n    background: var(--image-card-label-bg);\n    color: var(--image-card-label-text);\n    font-size: 11px;\n    font-weight: 950;\n    letter-spacing: 0.06em;\n  }\n\n  .devise-usecase-card strong {\n    display: block;\n    color: var(--image-card-text);\n    font-size: 25px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: -0.045em;\n  }\n\n  .devise-usecase-card p {\n    margin: 7px 0 0;\n    color: rgba(255, 255, 255, 0.84);\n    font-size: 13px;\n    line-height: 1.35;\n    font-weight: 650;\n  }\n\n  .devise-hero-bottom {\n    position: relative;\n    z-index: 2;\n    max-width: var(--hero-max-width);\n    margin: 54px auto 0;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 14px;\n  }\n\n  .devise-bottom-item {\n    background: var(--bottom-card-bg);\n    border: 1px solid var(--bottom-card-border);\n    border-radius: 12px;\n    padding: 16px;\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n\n  .devise-bottom-icon {\n    width: 42px;\n    height: 42px;\n    border-radius: 9px;\n    background: var(--bottom-icon-bg);\n    color: var(--bottom-icon-text);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 950;\n    flex-shrink: 0;\n  }\n\n  .devise-bottom-text {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .devise-bottom-text > span {\n    width: 3px;\n    height: 34px;\n    border-radius: 999px;\n    background: var(--bottom-line);\n    flex-shrink: 0;\n  }\n\n  .devise-bottom-text strong {\n    display: block;\n    font-size: 13px;\n    color: var(--bottom-title);\n    font-weight: 900;\n    letter-spacing: 0.05em;\n  }\n\n  .devise-bottom-text p {\n    margin: 4px 0 0;\n    color: var(--bottom-text);\n    font-size: 13px;\n    font-weight: 650;\n    line-height: 1.35;\n  }\n\n  @media (max-width: 1050px) {\n    .devise-hero-modern {\n      padding: 72px 18px 28px;\n    }\n\n    .devise-hero-modern__inner {\n      grid-template-columns: 1fr;\n      gap: 38px;\n      text-align: center;\n      max-width: 760px;\n    }\n\n    .devise-hero-modern__content {\n      padding-left: 0;\n    }\n\n    .devise-hero-modern__text {\n      margin-left: auto;\n      margin-right: auto;\n      font-size: 16px;\n      line-height: 1.55;\n    }\n\n    .devise-hero-modern__buttons {\n      justify-content: center;\n      margin-top: 28px;\n    }\n\n    .devise-usecase-stack {\n      margin: 0 auto;\n      justify-self: center;\n      max-width: 560px;\n      text-align: left;\n    }\n\n    .devise-usecase-card--one {\n      width: 90%;\n      margin-left: auto;\n    }\n\n    .devise-usecase-card--two {\n      width: 100%;\n    }\n\n    .devise-usecase-card--three {\n      width: 90%;\n      margin-left: 0;\n    }\n\n    .devise-hero-bottom {\n      max-width: 760px;\n      grid-template-columns: 1fr;\n      margin-top: 34px;\n      gap: 10px;\n    }\n  }\n\n  @media (max-width: 700px) {\n    .devise-hero-modern {\n      min-height: 640px;\n      padding: 0 28px 34px;\n      display: flex;\n      align-items: flex-end;\n      background: var(--black);\n    }\n\n    .devise-hero-modern__bg {\n      background-image:\n        linear-gradient(\n          180deg,\n          rgba(0, 0, 0, 0.04) 0%,\n          rgba(0, 0, 0, 0.10) 34%,\n          rgba(0, 0, 0, 0.62) 72%,\n          rgba(0, 0, 0, 0.84) 100%\n        ),\n        url(\"{{ hero_background_image }}\");\n      background-position: center top;\n      background-size: cover;\n      filter: grayscale(0%) contrast(1.02) brightness(0.92);\n    }\n\n    .devise-hero-modern::after {\n      display: none;\n    }\n\n    .devise-hero-modern__inner {\n      width: 100%;\n      display: block;\n      text-align: left;\n      max-width: 100%;\n      margin: 0;\n    }\n\n    .devise-hero-modern__content {\n      padding: 0;\n      width: 100%;\n    }\n\n    .devise-hero-modern__small-title {\n      color: var(--main-text);\n      font-size: 23px;\n      line-height: 1;\n      font-weight: 950;\n      letter-spacing: -0.05em;\n      margin-bottom: 8px;\n      text-shadow: none;\n    }\n\n    .devise-hero-modern__title {\n      max-width: 100%;\n      font-size: clamp(38px, 11.5vw, 58px);\n      line-height: 0.98;\n      letter-spacing: -0.055em;\n      font-weight: 950;\n      text-transform: uppercase;\n    }\n\n    .devise-hero-modern__title span {\n      color: var(--main-text);\n    }\n\n    .devise-hero-modern__title span:last-child {\n      color: var(--main-text);\n    }\n\n    .devise-hero-modern__text {\n      display: none;\n    }\n\n    .devise-hero-modern__buttons {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n      margin-top: 26px;\n      width: 100%;\n    }\n\n    .devise-hero-btn {\n      width: 100%;\n      min-height: 56px;\n      border-radius: 0;\n      font-size: 14px;\n      padding: 0 10px;\n      letter-spacing: 0;\n      text-transform: none;\n    }\n\n    .devise-hero-btn span {\n      display: none;\n    }\n\n    .devise-hero-btn--primary {\n      background: var(--primary-button-bg);\n      color: var(--primary-button-text);\n      border-color: var(--primary-button-border);\n    }\n\n    .devise-hero-btn--secondary {\n      background: var(--secondary-button-bg);\n      color: var(--secondary-button-text);\n      border-color: var(--secondary-button-border);\n    }\n\n    .devise-usecase-stack {\n      display: none;\n    }\n\n    .devise-hero-bottom {\n      display: none;\n    }\n  }\n\n  @media (max-width: 390px) {\n    .devise-hero-modern {\n      min-height: 600px;\n      padding: 0 22px 30px;\n    }\n\n    .devise-hero-modern__small-title {\n      font-size: 21px;\n    }\n\n    .devise-hero-modern__title {\n      font-size: clamp(34px, 11vw, 48px);\n    }\n\n    .devise-hero-btn {\n      min-height: 52px;\n      font-size: 13px;\n    }\n  }\n</style>\n\n{% endif %}",
