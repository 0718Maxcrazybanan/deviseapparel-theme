{{ 'devise-email-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'devise-email-popup.js' | asset_url }}" defer></script>

{%- liquid
  assign popup_id = 'DeviseEmailPopup-' | append: section.id
  assign popup_title_id = popup_id | append: '-title'
  assign popup_form_id = popup_id | append: '-form'
-%}

{%- if section.settings.enabled -%}
  <div
    id="{{ popup_id }}"
    class="devise-email-popup"
    data-devise-email-popup
    data-delay="{{ section.settings.delay_ms }}"
    data-hide-days="{{ section.settings.hide_days }}"
    aria-hidden="true"
    style="
      --dep-accent: {{ section.settings.accent_color }};
      --dep-ocean: {{ section.settings.ocean_color }};
      --dep-card: {{ section.settings.card_color }};
    "
    {{ section.shopify_attributes }}
  >
    <button
      class="devise-email-popup__overlay"
      type="button"
      data-devise-email-popup-close
      aria-label="Stäng popup"
    ></button>

    <div class="devise-email-popup__motion" aria-hidden="true">
      <div class="devise-email-popup__sun"></div>

      <svg class="devise-email-popup__palm devise-email-popup__palm--left" viewBox="0 0 170 220" focusable="false" aria-hidden="true">
        <path class="devise-email-popup__palm-trunk-fill" d="M84 75C73 112 70 157 80 211L100 209C90 158 93 113 105 80Z" />
        <path class="devise-email-popup__palm-trunk-mark" d="M82 104C89 108 95 109 102 106M78 132C87 137 95 138 102 134M77 160C86 165 94 166 102 162M80 189C88 193 95 193 101 190" />
        <path class="devise-email-popup__palm-leaf-fill" d="M94 79C59 56 31 53 8 68C42 72 67 86 86 107Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M97 76C73 39 50 24 20 25C49 46 72 67 88 101Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M101 74C93 35 104 12 129 3C122 36 116 62 106 101Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M105 76C136 44 157 41 169 56C142 63 121 81 108 108Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M102 82C132 83 151 96 160 118C133 107 113 105 96 116Z" />
        <path class="devise-email-popup__palm-leaf-vein" d="M96 82C67 70 43 68 17 71M99 81C78 57 57 41 27 29M102 78C104 49 111 25 126 6M105 81C126 62 145 56 166 56M100 89C123 91 141 101 158 118" />
      </svg>

      <svg class="devise-email-popup__palm devise-email-popup__palm--right" viewBox="0 0 170 220" focusable="false" aria-hidden="true">
        <path class="devise-email-popup__palm-trunk-fill" d="M82 76C95 113 98 158 87 212L67 209C78 158 75 114 62 81Z" />
        <path class="devise-email-popup__palm-trunk-mark" d="M64 106C71 110 78 110 86 106M66 134C74 139 82 139 90 135M67 162C75 167 83 167 90 163M68 190C76 195 84 195 90 191" />
        <path class="devise-email-popup__palm-leaf-fill" d="M74 79C39 60 16 64 1 84C35 78 59 87 76 110Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M72 75C47 42 27 35 3 43C33 56 55 76 74 104Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M69 72C58 33 67 10 91 0C88 34 84 61 75 101Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M65 75C94 44 122 43 150 60C118 65 94 80 72 108Z" />
        <path class="devise-email-popup__palm-leaf-fill" d="M67 82C99 83 123 98 138 124C108 110 85 107 69 119Z" />
        <path class="devise-email-popup__palm-leaf-vein" d="M73 85C48 73 24 73 4 83M72 80C52 58 33 47 4 43M70 76C70 46 77 23 90 3M68 80C92 62 119 57 148 61M68 90C95 92 116 104 136 123" />
      </svg>

      <svg class="devise-email-popup__surfer" viewBox="0 0 220 140" focusable="false" aria-hidden="true">
        <defs>
          <linearGradient id="{{ popup_id }}-board" x1="36" x2="190" y1="110" y2="98" gradientUnits="userSpaceOnUse">
            <stop stop-color="#FFDE59" />
            <stop offset="1" stop-color="#36D6DA" />
          </linearGradient>
          <linearGradient id="{{ popup_id }}-water" x1="20" x2="205" y1="112" y2="112" gradientUnits="userSpaceOnUse">
            <stop stop-color="#8EF4FF" />
            <stop offset="1" stop-color="#FFFFFF" />
          </linearGradient>
        </defs>
        <path class="devise-email-popup__surfer-trail" d="M18 111C55 98 93 102 127 108C158 113 183 108 205 95" />
        <path class="devise-email-popup__surfer-board" d="M34 109C75 91 142 88 190 100C177 117 81 122 34 109Z" fill="url(#{{ popup_id }}-board)" />
        <path class="devise-email-popup__surfer-board-line" d="M57 109C89 102 135 100 171 103" />
        <path class="devise-email-popup__surfer-leg" d="M110 82C101 91 96 99 93 111" />
        <path class="devise-email-popup__surfer-leg" d="M127 83C132 93 139 99 151 105" />
        <path class="devise-email-popup__surfer-short" d="M103 76C114 70 128 72 136 81C130 89 114 91 103 82Z" />
        <path class="devise-email-popup__surfer-body" d="M121 39C111 49 106 62 108 78C119 83 130 82 139 75C136 60 132 47 121 39Z" />
        <path class="devise-email-popup__surfer-arm" d="M113 51C101 57 91 66 82 78" />
        <path class="devise-email-popup__surfer-arm" d="M133 54C146 55 158 61 169 72" />
        <circle class="devise-email-popup__surfer-head" cx="122" cy="29" r="11" />
        <path class="devise-email-popup__surfer-hair" d="M112 28C115 16 129 15 137 24C130 22 122 26 119 34C116 32 114 30 112 28Z" />
        <path class="devise-email-popup__surfer-water" d="M23 117C56 104 94 106 131 112C164 118 190 111 207 101" fill="none" stroke="url(#{{ popup_id }}-water)" />
      </svg>

      <div class="devise-email-popup__splash">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="devise-email-popup__screen-splash">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="devise-email-popup__droplets">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>

    <div
      class="devise-email-popup__card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ popup_title_id }}"
      tabindex="-1"
      data-devise-email-popup-dialog
    >
      <button
        class="devise-email-popup__close"
        type="button"
        data-devise-email-popup-close
        aria-label="Stäng popup"
      >
        &times;
      </button>

      <div class="devise-email-popup__card-palms" aria-hidden="true">
        <svg class="devise-email-popup__card-palm devise-email-popup__card-palm--left" viewBox="0 0 150 220" focusable="false" aria-hidden="true">
          <path class="devise-email-popup__card-palm-trunk" d="M72 64C58 103 56 153 68 215L89 213C76 154 80 105 96 67Z" />
          <path class="devise-email-popup__card-palm-trunk-mark" d="M69 94C76 99 83 100 91 97M65 123C74 130 83 131 93 126M64 152C73 159 82 160 92 155M67 184C76 190 84 190 91 186" />
          <path class="devise-email-popup__card-palm-leaf" d="M83 66C47 41 20 39 2 55C34 61 59 76 79 103Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M87 62C64 24 39 9 9 15C38 34 62 59 78 98Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M91 60C85 24 95 5 119 0C112 28 105 55 94 96Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M94 63C124 36 144 36 150 52C127 58 108 76 96 103Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M91 71C122 72 140 86 146 111C119 101 101 100 86 111Z" />
          <path class="devise-email-popup__card-palm-vein" d="M84 70C55 56 31 55 5 57M87 67C66 43 45 27 12 17M91 64C91 40 99 18 118 2M94 67C114 51 132 47 149 53M89 78C113 80 130 91 145 110" />
        </svg>

        <svg class="devise-email-popup__card-palm devise-email-popup__card-palm--right" viewBox="0 0 150 220" focusable="false" aria-hidden="true">
          <path class="devise-email-popup__card-palm-trunk" d="M72 64C58 103 56 153 68 215L89 213C76 154 80 105 96 67Z" />
          <path class="devise-email-popup__card-palm-trunk-mark" d="M69 94C76 99 83 100 91 97M65 123C74 130 83 131 93 126M64 152C73 159 82 160 92 155M67 184C76 190 84 190 91 186" />
          <path class="devise-email-popup__card-palm-leaf" d="M83 66C47 41 20 39 2 55C34 61 59 76 79 103Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M87 62C64 24 39 9 9 15C38 34 62 59 78 98Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M91 60C85 24 95 5 119 0C112 28 105 55 94 96Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M94 63C124 36 144 36 150 52C127 58 108 76 96 103Z" />
          <path class="devise-email-popup__card-palm-leaf" d="M91 71C122 72 140 86 146 111C119 101 101 100 86 111Z" />
          <path class="devise-email-popup__card-palm-vein" d="M84 70C55 56 31 55 5 57M87 67C66 43 45 27 12 17M91 64C91 40 99 18 118 2M94 67C114 51 132 47 149 53M89 78C113 80 130 91 145 110" />
        </svg>
      </div>

      <div class="devise-email-popup__content">
        <div class="devise-email-popup__badge">Sommarerbjudande</div>

        <h2 id="{{ popup_title_id }}">10% rabatt</h2>

        <p>Få din rabattkod och skapa något eget till sommaren.</p>

        {% form 'customer', id: popup_form_id, class: 'devise-email-popup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,popup_10_discount">

          {% if form.posted_successfully? %}
            <div class="devise-email-popup__success" data-devise-email-popup-success>
              Tack! Kolla din inkorg för din rabattkod.
            </div>
          {% else %}
            {% if form.errors %}
              <div class="devise-email-popup__error" data-devise-email-popup-error>
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="devise-email-popup__field">
              <label class="visually-hidden" for="{{ popup_id }}-email">Email</label>
              <input
                id="{{ popup_id }}-email"
                type="email"
                name="contact[email]"
                placeholder="din@email.se"
                autocomplete="email"
                required
              >

              <button type="submit">Få rabattkod →</button>
            </div>

            <small>Ingen spam. Bara erbjudanden, drops och viktig info från DeviseApparel.</small>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Devise email popup",
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_ms",
      "label": "Delay before popup opens",
      "min": 0,
      "max": 5000,
      "step": 100,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "range",
      "id": "hide_days",
      "label": "Days to hide after closing",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 7
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Yellow accent",
      "default": "#FFDE59"
    },
    {
      "type": "color",
      "id": "ocean_color",
      "label": "Ocean accent",
      "default": "#36D6DA"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card cream",
      "default": "#FFF4E4"
    }
  ],
  "presets": [
    {
      "name": "Devise email popup"
    }
  ]
}
{% endschema %}
