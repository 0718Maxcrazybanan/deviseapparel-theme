{{ 'devise-email-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'devise-email-popup.js' | asset_url }}" defer></script>

{%- liquid
  assign popup_id = 'DeviseEmailPopup-' | append: section.id
  assign popup_title_id = popup_id | append: '-title'
  assign popup_form_id = popup_id | append: '-form'
-%}

{%- if section.settings.enabled -%}
  <div
    id="{{ popup_id }}"
    class="devise-email-popup"
    data-devise-email-popup
    data-delay="{{ section.settings.delay_ms }}"
    data-hide-days="{{ section.settings.hide_days }}"
    aria-hidden="true"
    style="
      --dep-accent: {{ section.settings.accent_color }};
      --dep-ocean: {{ section.settings.ocean_color }};
      --dep-card: {{ section.settings.card_color }};
    "
    {{ section.shopify_attributes }}
  >
    <button
      class="devise-email-popup__overlay"
      type="button"
      data-devise-email-popup-close
      aria-label="Stäng popup"
    ></button>

    <div class="devise-email-popup__motion" aria-hidden="true">
      <div class="devise-email-popup__surfer-path">
        <svg class="devise-email-popup__surfer" viewBox="0 0 260 160" focusable="false" aria-hidden="true">
          <defs>
            <linearGradient id="{{ popup_id }}-board" x1="35" x2="218" y1="121" y2="105" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FFDE59" />
              <stop offset="0.55" stop-color="#FFE98E" />
              <stop offset="1" stop-color="#36D6DA" />
            </linearGradient>
            <linearGradient id="{{ popup_id }}-spray" x1="12" x2="230" y1="126" y2="96" gradientUnits="userSpaceOnUse">
              <stop stop-color="#EFFFFF" stop-opacity="0" />
              <stop offset="0.26" stop-color="#EFFFFF" />
              <stop offset="1" stop-color="#9AF8FF" />
            </linearGradient>
          </defs>
          <path class="devise-email-popup__surfer-wake devise-email-popup__surfer-wake--back" d="M16 130C54 105 94 112 128 122C164 134 199 121 236 92" />
          <path class="devise-email-popup__surfer-wake devise-email-popup__surfer-wake--front" d="M28 132C66 115 102 116 136 124C174 133 204 119 232 101" />
          <path class="devise-email-popup__surfer-board" d="M34 119C76 96 164 89 224 105C204 130 88 138 34 119Z" fill="url(#{{ popup_id }}-board)" />
          <path class="devise-email-popup__surfer-board-shadow" d="M54 121C95 112 158 107 204 110" />
          <path class="devise-email-popup__surfer-leg" d="M128 89C116 100 109 110 105 124" />
          <path class="devise-email-popup__surfer-leg" d="M145 88C151 101 163 109 180 113" />
          <path class="devise-email-popup__surfer-shorts" d="M122 80C135 73 151 75 160 86C153 96 134 98 122 90Z" />
          <path class="devise-email-popup__surfer-body" d="M142 39C128 52 123 65 126 82C139 89 154 87 164 77C160 60 154 47 142 39Z" />
          <path class="devise-email-popup__surfer-arm" d="M132 53C116 60 103 70 92 84" />
          <path class="devise-email-popup__surfer-arm" d="M158 56C176 58 191 66 204 80" />
          <circle class="devise-email-popup__surfer-head" cx="144" cy="28" r="12" />
          <path class="devise-email-popup__surfer-hair" d="M132 28C137 14 153 13 162 24C153 22 145 26 141 36C136 34 133 31 132 28Z" />
          <path class="devise-email-popup__surfer-spray" d="M27 128C65 111 103 112 140 122C178 132 211 116 238 96" fill="none" stroke="url(#{{ popup_id }}-spray)" />
        </svg>
      </div>

      <div class="devise-email-popup__impact-splash">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="devise-email-popup__glass-wash">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="devise-email-popup__water-drops">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>

    <div
      class="devise-email-popup__card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ popup_title_id }}"
      tabindex="-1"
      data-devise-email-popup-dialog
    >
      <button
        class="devise-email-popup__close"
        type="button"
        data-devise-email-popup-close
        aria-label="Stäng popup"
      >
        &times;
      </button>

      <div class="devise-email-popup__card-palms" aria-hidden="true">
        <img
          class="devise-email-popup__card-palm devise-email-popup__card-palm--left"
          src="{{ 'devise-popup-palm.png' | asset_url }}"
          width="1024"
          height="1024"
          alt=""
          loading="eager"
          decoding="async"
        >
        <img
          class="devise-email-popup__card-palm devise-email-popup__card-palm--right"
          src="{{ 'devise-popup-palm.png' | asset_url }}"
          width="1024"
          height="1024"
          alt=""
          loading="eager"
          decoding="async"
        >
      </div>

      <div class="devise-email-popup__content">
        <div class="devise-email-popup__badge">Sommarerbjudande</div>

        <h2 id="{{ popup_title_id }}">10% rabatt</h2>

        <p>Få din rabattkod och skapa något eget till sommaren.</p>

        {% form 'customer', id: popup_form_id, class: 'devise-email-popup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,popup_10_discount">

          {% if form.posted_successfully? %}
            <div class="devise-email-popup__success" data-devise-email-popup-success>
              Tack! Kolla din inkorg för din rabattkod.
            </div>
          {% else %}
            {% if form.errors %}
              <div class="devise-email-popup__error" data-devise-email-popup-error>
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="devise-email-popup__field">
              <label class="visually-hidden" for="{{ popup_id }}-email">Email</label>
              <input
                id="{{ popup_id }}-email"
                type="email"
                name="contact[email]"
                placeholder="din@email.se"
                autocomplete="email"
                required
              >

              <button type="submit">Få rabattkod →</button>
            </div>

            <small>Ingen spam. Bara erbjudanden, drops och viktig info från DeviseApparel.</small>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Devise email popup",
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_ms",
      "label": "Delay before popup opens",
      "min": 0,
      "max": 5000,
      "step": 100,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "range",
      "id": "hide_days",
      "label": "Days to hide after closing",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 7
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Yellow accent",
      "default": "#FFDE59"
    },
    {
      "type": "color",
      "id": "ocean_color",
      "label": "Ocean accent",
      "default": "#36D6DA"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card cream",
      "default": "#FFF4E4"
    }
  ],
  "presets": [
    {
      "name": "Devise email popup"
    }
  ]
}
{% endschema %}
