  "sections": {
    "custom_liquid_rcE9GE": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% if page.handle == 'contact-1' or page.handle == 'kontakt' %}\n<section class=\"devise-contact-page\">\n  <div class=\"devise-contact-container\">\n\n    <div class=\"devise-contact-hero\">\n      <span class=\"devise-contact-eyebrow\">Kontakt</span>\n      <h1>Hur kan vi hjälpa dig?</h1>\n      <p>\n        Har du frågor om en produkt, en beställning, custom-tryck eller ett samarbete?\n        Skicka ett meddelande så återkommer vi så snart vi kan.\n      </p>\n    </div>\n\n    <div class=\"devise-contact-main\">\n\n      <div class=\"devise-contact-info-card\">\n        <div>\n          <span class=\"devise-contact-label\">Devise Apparel</span>\n\n          <h2>Skicka ett meddelande</h2>\n\n          <p class=\"devise-contact-info-text\">\n            Beskriv ditt ärende så tydligt som möjligt. Om det gäller en beställning,\n            skriv gärna ordernummer eller vilken produkt det gäller.\n          </p>\n\n          <div class=\"devise-contact-benefits\">\n            <div class=\"devise-contact-benefit\">\n              <span>01</span>\n              <p>Frågor om produkter, storlekar och tryck</p>\n            </div>\n\n            <div class=\"devise-contact-benefit\">\n              <span>02</span>\n              <p>Hjälp med custom-plagg och egna motiv</p>\n            </div>\n\n            <div class=\"devise-contact-benefit\">\n              <span>03</span>\n              <p>Förfrågningar från företag, grupper och föreningar</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"devise-contact-details\">\n          <div>\n            <small>E-post</small>\n            <a href=\"mailto:support@deviseapparel.se\">support@deviseapparel.se</a>\n          </div>\n\n          <div>\n            <small>Svarstid</small>\n            <strong>Vanligtvis inom 24 timmar</strong>\n          </div>\n\n          <div>\n            <small>Företagsinformation</small>\n            <strong>Registrering hos Skatteverket inväntar beslut</strong>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"devise-contact-form-card\">\n        {% form 'contact', id: 'devise-contact-form', class: 'devise-contact-form' %}\n\n          {% if form.posted_successfully? %}\n            <div class=\"devise-contact-alert devise-contact-alert--success\">\n              Tack! Ditt meddelande har skickats. Vi återkommer så snart vi kan.\n            </div>\n          {% endif %}\n\n          {% if form.errors %}\n            <div class=\"devise-contact-alert devise-contact-alert--error\">\n              {{ form.errors | default_errors }}\n            </div>\n          {% endif %}\n\n          <input type=\"hidden\" name=\"contact[Formulär]\" value=\"Kontaktformulär\">\n\n          <div class=\"devise-contact-row\">\n            <div class=\"devise-contact-field\">\n              <label for=\"deviseContactName\">Namn <span>*</span></label>\n              <input\n                id=\"deviseContactName\"\n                type=\"text\"\n                name=\"contact[name]\"\n                placeholder=\"Ditt namn\"\n                autocomplete=\"name\"\n                required\n              >\n            </div>\n\n            <div class=\"devise-contact-field\">\n              <label for=\"deviseContactEmail\">E-post <span>*</span></label>\n              <input\n                id=\"deviseContactEmail\"\n                type=\"email\"\n                name=\"contact[email]\"\n                placeholder=\"din@email.se\"\n                autocomplete=\"email\"\n                required\n              >\n            </div>\n          </div>\n\n          <div class=\"devise-contact-row\">\n            <div class=\"devise-contact-field\">\n              <label for=\"deviseContactPhone\">Telefon</label>\n              <input\n                id=\"deviseContactPhone\"\n                type=\"tel\"\n                name=\"contact[phone]\"\n                placeholder=\"070 000 00 00\"\n                autocomplete=\"tel\"\n              >\n            </div>\n\n            <div class=\"devise-contact-field\">\n              <label for=\"deviseContactSubject\">Ämne <span>*</span></label>\n              <select\n                id=\"deviseContactSubject\"\n                name=\"contact[Ämne]\"\n                required\n              >\n                <option value=\"\">Välj ämne</option>\n                <option value=\"Allmän fråga\">Allmän fråga</option>\n                <option value=\"Produktfråga\">Produktfråga</option>\n                <option value=\"Custom order\">Custom order</option>\n                <option value=\"Leverans\">Leverans</option>\n                <option value=\"Retur eller reklamation\">Retur eller reklamation</option>\n                <option value=\"Företagsbeställning\">Företagsbeställning</option>\n                <option value=\"Samarbete\">Samarbete</option>\n                <option value=\"Annat\">Annat</option>\n              </select>\n            </div>\n          </div>\n\n          <div class=\"devise-contact-field\">\n            <label for=\"deviseContactMessage\">Meddelande <span>*</span></label>\n\n            <div class=\"devise-contact-message-wrap\">\n              <textarea\n                id=\"deviseContactMessage\"\n                name=\"contact[body]\"\n                maxlength=\"1200\"\n                placeholder=\"Skriv ditt meddelande här...\"\n                required\n              ></textarea>\n\n              <small>\n                <span id=\"deviseContactCount\">0</span>/1200\n              </small>\n            </div>\n          </div>\n\n          <button type=\"submit\" class=\"devise-contact-submit\">\n            Skicka meddelande\n          </button>\n\n          <p class=\"devise-contact-note\">\n            Genom att skicka formuläret godkänner du att vi kontaktar dig angående ditt ärende.\n          </p>\n\n        {% endform %}\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .devise-contact-page {\n    background: #ffffff;\n    color: #0b0b0b;\n    padding: clamp(48px, 7vw, 96px) 18px;\n    font-family: inherit;\n  }\n\n  .devise-contact-page * {\n    box-sizing: border-box;\n  }\n\n  .devise-contact-container {\n    width: min(1180px, 100%);\n    margin: 0 auto;\n  }\n\n  .devise-contact-hero {\n    max-width: 760px;\n    margin: 0 auto clamp(34px, 5vw, 54px);\n    text-align: center;\n  }\n\n  .devise-contact-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 16px;\n    padding: 8px 13px;\n    border: 1px solid #dcdcdc;\n    border-radius: 999px;\n    color: #555555;\n    background: #ffffff;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  .devise-contact-hero h1 {\n    margin: 0;\n    color: #0b0b0b;\n    font-size: clamp(38px, 6vw, 72px);\n    line-height: 0.95;\n    letter-spacing: -0.06em;\n    font-weight: 850;\n  }\n\n  .devise-contact-hero p {\n    max-width: 620px;\n    margin: 18px auto 0;\n    color: #5f5f5f;\n    font-size: 15px;\n    line-height: 1.65;\n  }\n\n  .devise-contact-main {\n    display: grid;\n    grid-template-columns: 0.9fr 1.1fr;\n    gap: 22px;\n    align-items: stretch;\n  }\n\n  .devise-contact-info-card {\n    background: #0b0b0b;\n    color: #ffffff;\n    border-radius: 28px;\n    padding: clamp(26px, 3.4vw, 40px);\n    min-height: 100%;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.14);\n  }\n\n  .devise-contact-label {\n    display: inline-flex;\n    width: fit-content;\n    margin-bottom: 24px;\n    padding: 8px 12px;\n    border: 1px solid rgba(255, 255, 255, 0.18);\n    border-radius: 999px;\n    color: #ffffff;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .devise-contact-info-card h2 {\n    margin: 0;\n    color: #ffffff;\n    font-size: clamp(28px, 3.2vw, 42px);\n    line-height: 1;\n    letter-spacing: -0.05em;\n    font-weight: 850;\n  }\n\n  .devise-contact-info-text {\n    margin: 16px 0 0;\n    max-width: 430px;\n    color: rgba(255, 255, 255, 0.72);\n    font-size: 14px;\n    line-height: 1.65;\n  }\n\n  .devise-contact-benefits {\n    display: grid;\n    gap: 12px;\n    margin-top: 34px;\n  }\n\n  .devise-contact-benefit {\n    display: grid;\n    grid-template-columns: 42px 1fr;\n    gap: 12px;\n    align-items: center;\n    padding: 14px;\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    border-radius: 16px;\n    background: rgba(255, 255, 255, 0.055);\n  }\n\n  .devise-contact-benefit span {\n    width: 34px;\n    height: 34px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 999px;\n    background: #ffffff;\n    color: #0b0b0b;\n    font-size: 11px;\n    font-weight: 850;\n  }\n\n  .devise-contact-benefit p {\n    margin: 0;\n    color: #ffffff;\n    font-size: 13px;\n    line-height: 1.4;\n    font-weight: 650;\n  }\n\n  .devise-contact-details {\n    display: grid;\n    gap: 18px;\n    margin-top: 38px;\n    padding-top: 24px;\n    border-top: 1px solid rgba(255, 255, 255, 0.16);\n  }\n\n  .devise-contact-details small {\n    display: block;\n    margin-bottom: 5px;\n    color: rgba(255, 255, 255, 0.55);\n    font-size: 11px;\n    line-height: 1.4;\n    text-transform: uppercase;\n    letter-spacing: 0.12em;\n    font-weight: 750;\n  }\n\n  .devise-contact-details a,\n  .devise-contact-details strong {\n    color: #ffffff;\n    font-size: 14px;\n    line-height: 1.45;\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .devise-contact-details a:hover {\n    text-decoration: underline;\n  }\n\n  .devise-contact-form-card {\n    background: #f6f6f6;\n    border: 1px solid #e3e3e3;\n    border-radius: 28px;\n    padding: clamp(24px, 3.4vw, 40px);\n    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.08);\n  }\n\n  .devise-contact-alert {\n    margin-bottom: 18px;\n    padding: 14px 16px;\n    border-radius: 14px;\n    font-size: 14px;\n    line-height: 1.45;\n    font-weight: 650;\n  }\n\n  .devise-contact-alert--success {\n    background: #ecfdf3;\n    border: 1px solid #bbf7d0;\n    color: #166534;\n  }\n\n  .devise-contact-alert--error {\n    background: #fef2f2;\n    border: 1px solid #fecaca;\n    color: #991b1b;\n  }\n\n  .devise-contact-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n\n  .devise-contact-field {\n    margin-bottom: 16px;\n  }\n\n  .devise-contact-field label {\n    display: block;\n    margin-bottom: 8px;\n    color: #0b0b0b;\n    font-size: 13px;\n    font-weight: 750;\n  }\n\n  .devise-contact-field label span {\n    color: #dc2626;\n  }\n\n  .devise-contact-field input,\n  .devise-contact-field select,\n  .devise-contact-field textarea {\n    width: 100%;\n    border: 1px solid #d8d8d8;\n    border-radius: 14px;\n    background: #ffffff;\n    color: #0b0b0b;\n    font-family: inherit;\n    font-size: 14px;\n    outline: none;\n    transition:\n      border-color 0.18s ease,\n      box-shadow 0.18s ease,\n      background 0.18s ease;\n  }\n\n  .devise-contact-field input,\n  .devise-contact-field select {\n    min-height: 52px;\n    padding: 0 14px;\n  }\n\n  .devise-contact-field select {\n    cursor: pointer;\n  }\n\n  .devise-contact-field textarea {\n    min-height: 172px;\n    padding: 14px;\n    resize: vertical;\n  }\n\n  .devise-contact-field input::placeholder,\n  .devise-contact-field textarea::placeholder {\n    color: #969696;\n  }\n\n  .devise-contact-field input:focus,\n  .devise-contact-field select:focus,\n  .devise-contact-field textarea:focus {\n    border-color: #0b0b0b;\n    box-shadow: 0 0 0 3px rgba(11, 11, 11, 0.08);\n  }\n\n  .devise-contact-message-wrap {\n    position: relative;\n  }\n\n  .devise-contact-message-wrap small {\n    position: absolute;\n    right: 14px;\n    bottom: 12px;\n    color: #777777;\n    font-size: 11px;\n    pointer-events: none;\n  }\n\n  .devise-contact-submit {\n    width: 100%;\n    min-height: 54px;\n    border: 1px solid #0b0b0b;\n    border-radius: 14px;\n    background: #0b0b0b;\n    color: #ffffff;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 850;\n    cursor: pointer;\n    transition:\n      transform 0.18s ease,\n      background 0.18s ease,\n      color 0.18s ease,\n      opacity 0.18s ease;\n  }\n\n  .devise-contact-submit:hover {\n    transform: translateY(-1px);\n    background: #ffffff;\n    color: #0b0b0b;\n  }\n\n  .devise-contact-submit:active {\n    transform: translateY(0);\n    opacity: 0.86;\n  }\n\n  .devise-contact-note {\n    max-width: 520px;\n    margin: 13px auto 0;\n    color: #6b6b6b;\n    font-size: 11px;\n    line-height: 1.5;\n    text-align: center;\n  }\n\n  @media (max-width: 920px) {\n    .devise-contact-main {\n      grid-template-columns: 1fr;\n    }\n\n    .devise-contact-info-card {\n      min-height: auto;\n    }\n  }\n\n  @media (max-width: 640px) {\n    .devise-contact-page {\n      padding: 42px 14px;\n    }\n\n    .devise-contact-hero {\n      text-align: left;\n      margin-bottom: 28px;\n    }\n\n    .devise-contact-hero p {\n      margin-left: 0;\n      margin-right: 0;\n      font-size: 14px;\n    }\n\n    .devise-contact-row {\n      grid-template-columns: 1fr;\n      gap: 0;\n    }\n\n    .devise-contact-info-card,\n    .devise-contact-form-card {\n      border-radius: 22px;\n    }\n\n    .devise-contact-benefit {\n      grid-template-columns: 38px 1fr;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const message = document.getElementById(\"deviseContactMessage\");\n    const count = document.getElementById(\"deviseContactCount\");\n\n    if (!message || !count) return;\n\n    function updateCount() {\n      count.textContent = message.value.length;\n    }\n\n    updateCount();\n    message.addEventListener(\"input\", updateCount);\n  });\n</script>\n{% endif %}",
